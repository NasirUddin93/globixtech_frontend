# GlobixTech Environment Variables
# Copy this to .env and fill in the values

# Admin dashboard password
ADMIN_PASSWORD=your-secure-password-here

# Resend API key (for sending email notifications from contact form)
# Get your free key at: https://resend.com
RESEND_API_KEY=

# Email to receive contact form submissions
CONTACT_EMAIL=info@globix.tech

# Google Gemini API Key (for AI features)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
