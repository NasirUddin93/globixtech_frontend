---
// ChatWidget.astro - A premium AI Sales & Support Agent widget
---

<div id="ai-chat-widget" class="fixed bottom-6 right-6 z-[100] font-sans">
    <!-- Chat Toggle Bubble -->
    <button
        id="chat-toggle"
        class="w-16 h-16 bg-[#0c1b3d] text-white rounded-full shadow-2xl flex items-center justify-center hover:scale-110 active:scale-95 transition-all duration-300 relative group"
        aria-label="Open Chat"
    >
        <div
            class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full opacity-40 blur group-hover:opacity-75 transition duration-500"
        >
        </div>
        <i class="fas fa-comment-dots text-2xl relative z-10"></i>
        <span
            class="absolute -top-1 -right-1 w-4 h-4 bg-green-500 border-2 border-white rounded-full"
        ></span>
    </button>

    <!-- Chat Window -->
    <div
        id="chat-window"
        class="absolute bottom-20 right-0 w-[350px] md:w-[400px] h-[500px] md:h-[600px] bg-white rounded-[2rem] shadow-2xl flex flex-col overflow-hidden transition-all duration-500 translate-y-4 opacity-0 pointer-events-none border border-gray-100"
    >
        <!-- Header -->
        <div class="p-6 bg-[#0c1b3d] text-white relative overflow-hidden">
            <div
                class="absolute top-0 right-0 w-32 h-32 bg-cyan-500/10 rounded-full -mr-16 -mt-16 blur-2xl"
            >
            </div>
            <div class="flex items-center gap-4 relative z-10">
                <div
                    class="w-12 h-12 bg-gradient-to-br from-cyan-400 to-blue-500 rounded-2xl flex items-center justify-center shadow-lg"
                >
                    <i class="fas fa-robot text-xl"></i>
                </div>
                <div>
                    <h3 class="font-bold text-lg leading-tight">
                        Globix Agent
                    </h3>
                    <div class="flex items-center gap-2">
                        <span
                            class="w-2 h-2 bg-green-400 rounded-full animate-pulse"
                        ></span>
                        <span
                            class="text-xs text-cyan-100/70 font-medium uppercase tracking-wider"
                            >Online | AI Powered</span
                        >
                    </div>
                </div>
                <button
                    id="close-chat"
                    class="ml-auto text-white/50 hover:text-white transition-colors"
                >
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Messages Area -->
        <div
            id="chat-messages"
            class="flex-1 overflow-y-auto p-6 space-y-4 bg-gray-50/50 scroll-smooth"
        >
            <!-- Initial Message -->
            <div class="flex flex-col gap-1 max-w-[85%]">
                <div
                    class="bg-white border border-gray-100 p-4 rounded-2xl rounded-tl-none shadow-sm text-gray-700 text-sm leading-relaxed"
                >
                    Hello! I'm your **Globix AI Agent**. How can I help you
                    today?
                </div>
                <span class="text-[10px] text-gray-400 ml-1">Just now</span>
            </div>
        </div>

        <!-- Quick Actions -->
        <div
            id="quick-actions"
            class="px-4 py-2 flex gap-2 overflow-x-auto no-scrollbar border-t border-gray-50"
        >
            <button
                class="quick-action shrink-0 px-3 py-1.5 bg-cyan-50 text-cyan-700 rounded-full text-[11px] font-medium border border-cyan-100 hover:bg-cyan-100 transition-colors whitespace-nowrap"
            >
                🏠 Tell me about Globix
            </button>
            <button
                class="quick-action shrink-0 px-3 py-1.5 bg-cyan-50 text-cyan-700 rounded-full text-[11px] font-medium border border-cyan-100 hover:bg-cyan-100 transition-colors whitespace-nowrap"
            >
                🎓 School Management (SMS)
            </button>
            <button
                class="quick-action shrink-0 px-3 py-1.5 bg-cyan-50 text-cyan-700 rounded-full text-[11px] font-medium border border-cyan-100 hover:bg-cyan-100 transition-colors whitespace-nowrap"
            >
                🛍️ E-commerce Solutions
            </button>
            <button
                class="quick-action shrink-0 px-3 py-1.5 bg-cyan-50 text-cyan-700 rounded-full text-[11px] font-medium border border-cyan-100 hover:bg-cyan-100 transition-colors whitespace-nowrap"
            >
                💼 Get a Quote
            </button>
        </div>

        <!-- Input Area -->
        <div class="p-4 bg-white border-t border-gray-100">
            <div
                class="flex gap-2 items-center bg-gray-50 border border-gray-200 rounded-2xl p-2 focus-within:border-cyan-500 focus-within:ring-1 focus-within:ring-cyan-500 transition-all"
            >
                <input
                    type="text"
                    id="chat-input"
                    placeholder="Ask me anything..."
                    class="flex-1 bg-transparent border-none focus:ring-0 text-sm py-2 px-2 text-gray-700 placeholder:text-gray-400"
                />
                <button
                    id="send-message"
                    class="w-10 h-10 bg-[#0c1b3d] text-white rounded-xl flex items-center justify-center hover:bg-cyan-600 transition-all"
                >
                    <i class="fas fa-paper-plane text-sm"></i>
                </button>
            </div>
            <p class="text-[9px] text-center text-gray-400 mt-2">
                Powered by Gemini AI • GlobixTech Solutions
            </p>
        </div>
    </div>
</div>

<script>
    const widget = document.getElementById("ai-chat-widget");
    const toggle = document.getElementById("chat-toggle");
    const chatWindow = document.getElementById("chat-window");
    const closeBtn = document.getElementById("close-chat");
    const messages = document.getElementById("chat-messages");
    const input = document.getElementById("chat-input") as HTMLInputElement;
    const sendBtn = document.getElementById("send-message");

    let isChatOpen = false;
    let chatHistory = JSON.parse(
        localStorage.getItem("globix_chat_history") || "[]",
    );

    // Load history on start
    window.addEventListener("DOMContentLoaded", () => {
        if (chatHistory.length > 0) {
            chatHistory.forEach((item) => {
                if (item.role === "user") {
                    appendMessage(item.parts[0].text, "user", false);
                } else if (item.role === "model") {
                    appendMessage(item.parts[0].text, "ai", false);
                }
            });
        }
    });

    // Toggle Chat
    function toggleChat() {
        isChatOpen = !isChatOpen;
        if (isChatOpen) {
            chatWindow?.classList.remove(
                "opacity-0",
                "pointer-events-none",
                "translate-y-4",
            );
            chatWindow?.classList.add("opacity-100", "translate-y-0");
            input?.focus();
        } else {
            chatWindow?.classList.remove("opacity-100", "translate-y-0");
            chatWindow?.classList.add(
                "opacity-0",
                "pointer-events-none",
                "translate-y-4",
            );
        }
    }

    toggle?.addEventListener("click", toggleChat);
    closeBtn?.addEventListener("click", toggleChat);

    // Messaging Logic
    async function sendMessage() {
        const text = input?.value.trim();
        if (!text) return;

        // Add User Message
        appendMessage(text, "user");
        if (input) input.value = "";

        // Add Loading State
        const loadingId = addLoadingIndicator();

        try {
            const response = await fetch("/api/ai-chat", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    message: text,
                    history: chatHistory,
                }),
            });

            const data = await response.json();
            removeElement(loadingId);

            if (data.reply) {
                // Update history before displaying to include user message
                chatHistory.push({ role: "user", parts: [{ text: text }] });
                chatHistory.push({
                    role: "model",
                    parts: [{ text: data.reply }],
                });

                // Keep history manageable (last 20 messages)
                if (chatHistory.length > 20)
                    chatHistory = chatHistory.slice(-20);

                localStorage.setItem(
                    "globix_chat_history",
                    JSON.stringify(chatHistory),
                );

                appendMessage(data.reply, "ai");
            } else {
                appendMessage(
                    "I'm sorry, I'm having trouble connecting right now. Please try again later.",
                    "ai",
                );
            }
        } catch (error) {
            removeElement(loadingId);
            appendMessage(
                "Something went wrong. Please check your connection.",
                "ai",
            );
        }
    }

    function appendMessage(text, sender, isNew = true) {
        const div = document.createElement("div");
        div.className =
            sender === "user"
                ? "flex flex-col gap-1 items-end ml-auto max-w-[85%]"
                : "flex flex-col gap-1 max-w-[85%]";

        const bubbleClass =
            sender === "user"
                ? "bg-[#0c1b3d] text-white p-4 rounded-2xl rounded-tr-none shadow-md text-sm leading-relaxed"
                : "bg-white border border-gray-100 p-4 rounded-2xl rounded-tl-none shadow-sm text-gray-700 text-sm leading-relaxed";

        // Simple Markdown-like parsing for bold and lists
        let formattedText = text
            .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>") // Bold: **text**
            .replace(/^\* (.*)/gm, "• $1") // Lists: * item
            .replace(/\n/g, "<br>"); // Transitions

        div.innerHTML = `
            <div class="${bubbleClass}">
                ${formattedText}
            </div>
            <span class="text-[10px] text-gray-400 ${sender === "user" ? "mr-1" : "ml-1"}">${isNew ? "Just now" : "Earlier"}</span>
        `;

        messages?.appendChild(div);
        if (messages) {
            messages.scrollTop = messages.scrollHeight;
        }
    }

    function addLoadingIndicator() {
        const id = "loading-" + Date.now();
        const div = document.createElement("div");
        div.id = id;
        div.className = "flex flex-col gap-1 max-w-[85%]";
        div.innerHTML = `
            <div class="bg-gray-100 p-4 rounded-2xl rounded-tl-none flex gap-1">
                <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce"></span>
                <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce [animation-delay:-0.15s]"></span>
                <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce [animation-delay:-0.3s]"></span>
            </div>
        `;
        messages?.appendChild(div);
        if (messages) {
            messages.scrollTop = messages.scrollHeight;
        }
        return id;
    }

    function removeElement(id) {
        document.getElementById(id)?.remove();
    }

    sendBtn?.addEventListener("click", sendMessage);
    input?.addEventListener("keypress", (e) => {
        if (e.key === "Enter") sendMessage();
    });

    // Quick Actions Logic
    document.querySelectorAll(".quick-action").forEach((btn) => {
        btn.addEventListener("click", () => {
            if (input) {
                // Strip emoji for search if needed, but here we just use the text
                const query =
                    btn.textContent
                        ?.trim()
                        .replace(
                            /^[\u1F600-\u1F64F\u1F300-\u1F5FF\u1F680-\u1F6FF\u2600-\u26FF\u2700-\u27BF] /u,
                            "",
                        ) || "";
                input.value = query;
                sendMessage();
            }
        });
    });
</script>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    #chat-messages::-webkit-scrollbar {
        width: 4px;
    }
    #chat-messages::-webkit-scrollbar-track {
        background: transparent;
    }
    #chat-messages::-webkit-scrollbar-thumb {
        background: #e5e7eb;
        border-radius: 10px;
    }
    #chat-messages::-webkit-scrollbar-thumb:hover {
        background: #d1d5db;
    }
</style>
