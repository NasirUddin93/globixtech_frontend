---

---

<section id="contact" class="py-20 bg-white">
    <div class="container mx-auto px-6">
        <h2 class="text-4xl font-bold text-center mb-4 text-dark">
            📞 Book a Free Demo
        </h2>
        <p class="text-gray-600 text-center text-lg mb-16 max-w-3xl mx-auto">
            Get in touch with us to see our software in action or discuss your project requirements.
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <!-- Contact Info -->
            <div
                class="bg-light p-8 rounded-2xl border border-gray-100 shadow-sm"
            >
                <h3 class="text-2xl font-bold mb-8 text-dark">Get in Touch</h3>
                <div class="space-y-8">
                    {
                        [
                            {
                                icon: "fa-map-marker-alt",
                                title: "Our Office",
                                desc: "House-30, Road-11, Sector-10, Uttara, Dhaka, Bangladesh",
                            },
                            {
                                icon: "fa-phone-alt",
                                title: "Phone / WhatsApp",
                                desc: "+880 1707-568468",
                            },
                            {
                                icon: "fa-envelope",
                                title: "Email Address",
                                desc: "info@globix.tech",
                            },
                            {
                                icon: "fa-clock",
                                title: "Working Hours",
                                desc: "Sunday - Thursday: 9:00 AM - 6:00 PM",
                            },
                        ].map((item) => (
                            <div class="flex items-start">
                                <div class="w-12 h-12 bg-primary bg-opacity-10 rounded-lg flex items-center justify-center mr-6 flex-shrink-0">
                                    <i
                                        class={`fas ${item.icon} text-primary text-xl`}
                                    />
                                </div>
                                <div>
                                    <h4 class="font-bold text-lg mb-1 text-dark">
                                        {item.title}
                                    </h4>
                                    <p class="text-gray-600">{item.desc}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <div class="mt-12 text-center lg:text-left">
                    <h4
                        class="font-bold text-lg mb-6 text-dark tracking-wide uppercase"
                    >
                        Follow Us
                    </h4>
                    <div class="flex justify-center lg:justify-start space-x-4">
                        {
                            [
                                {
                                    icon: "fa-facebook-f",
                                    hover: "hover:bg-blue-600",
                                    url: "https://www.facebook.com/globixtech/",
                                },
                                {
                                    icon: "fa-twitter",
                                    hover: "hover:bg-sky-400",
                                    url: "#",
                                },
                                {
                                    icon: "fa-linkedin-in",
                                    hover: "hover:bg-blue-700",
                                    url: "#",
                                },
                                {
                                    icon: "fa-instagram",
                                    hover: "hover:bg-pink-600",
                                    url: "#",
                                },
                            ].map((social) => (
                                <a
                                    href={social.url}
                                    target={
                                        social.url !== "#"
                                            ? "_blank"
                                            : undefined
                                    }
                                    rel={
                                        social.url !== "#"
                                            ? "noopener noreferrer"
                                            : undefined
                                    }
                                    class={`w-12 h-12 bg-white border border-gray-200 shadow-sm rounded-lg flex items-center justify-center text-gray-500 transition-all duration-300 ${social.hover} hover:text-white transform hover:-translate-y-1`}
                                >
                                    <i class={`fab ${social.icon} text-lg`} />
                                </a>
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div
                class="bg-white p-8 rounded-2xl shadow-xl border border-gray-100"
            >
                <form id="contact-form" class="space-y-6">
                    <!-- Form contents remain mostly same, but we handle submission via JS completely -->
                    <div>
                        <label
                            for="name"
                            class="block text-gray-700 font-semibold mb-2"
                            >Full Name</label
                        >
                        <input
                            type="text"
                            id="name"
                            name="name"
                            class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                            placeholder="Your Name"
                            required
                        />
                    </div>

                    <div>
                        <label
                            for="email"
                            class="block text-gray-700 font-semibold mb-2"
                            >Email Address</label
                        >
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                            placeholder="you@example.com"
                            required
                        />
                    </div>

                    <div>
                        <label
                            for="phone"
                            class="block text-gray-700 font-semibold mb-2"
                            >Phone Number (Optional)</label
                        >
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                            placeholder="+880 1XXX-XXXXXX"
                        />
                    </div>

                    <div>
                        <label
                            for="service"
                            class="block text-gray-700 font-semibold mb-2"
                            >Service Interested In</label
                        >
                        <select
                            id="service"
                            name="service"
                            class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition bg-white cursor-pointer"
                        >
                            <option value="">Select a service</option>
                            <option value="pos">POS System</option>
                            <option value="inventory">Inventory Management</option>
                            <option value="ecommerce">E-commerce Solutions</option>
                            <option value="education">Education Software</option>
                            <option value="erp">ERP System</option>
                            <option value="web-apps">Web Applications</option>
                            <option value="mobile-apps">Mobile Apps</option>
                            <option value="custom">Custom Software</option>
                            <option value="server">Server Management</option>
                            <option value="network">Network Solutions</option>
                            <option value="security">Security Services</option>
                            <option value="other">Other</option>
                        </select>
                    </div>

                    <div>
                        <label
                            for="message"
                            class="block text-gray-700 font-semibold mb-2"
                            >Message</label
                        >
                        <textarea
                            id="message"
                            name="message"
                            rows="5"
                            class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition resize-none"
                            placeholder="Tell us about your project..."
                            required></textarea>
                    </div>

                    <button
                        type="submit"
                        id="submit-btn"
                        class="w-full bg-gradient-to-r from-primary to-secondary text-white py-4 rounded-xl font-bold text-lg hover:shadow-lg hover:scale-[1.02] transition-all transform duration-300 disabled:opacity-70 disabled:cursor-not-allowed"
                    >
                        <span>Send Message</span>
                        <i class="fas fa-paper-plane ml-2"></i>
                    </button>
                    <p
                        id="form-message"
                        class="mt-4 text-center font-semibold text-sm hidden"
                    >
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    const contactForm = document.getElementById(
        "contact-form",
    ) as HTMLFormElement;
    const formMessage = document.getElementById("form-message");
    const submitBtn = document.getElementById("submit-btn");
    const btnText = submitBtn?.querySelector("span");
    const btnIcon = submitBtn?.querySelector("i");

    contactForm?.addEventListener("submit", async (e) => {
        e.preventDefault();

        // UI Loading State
        if (submitBtn) {
            (submitBtn as HTMLButtonElement).disabled = true;
            if (btnText) btnText.textContent = "Sending...";
            if (btnIcon) btnIcon.className = "fas fa-spinner fa-spin ml-2";
        }

        const formData = new FormData(contactForm);

        try {
            const response = await fetch("/api/contact", {
                method: "POST",
                body: formData,
            });

            const data = await response.json();

            if (data.success) {
                if (formMessage) {
                    formMessage.textContent = data.message;
                    formMessage.classList.remove("hidden", "text-red-500");
                    formMessage.classList.add(
                        "text-green-600",
                        "animate-bounce",
                    );
                }
                contactForm.reset();
            } else {
                throw new Error(data.message || "Submission failed");
            }
        } catch (error: any) {
            if (formMessage) {
                formMessage.textContent = error.message;
                formMessage.classList.remove("hidden", "text-green-600");
                formMessage.classList.add("text-red-500");
            }
        } finally {
            // UI Reset State
            setTimeout(() => {
                if (submitBtn) {
                    (submitBtn as HTMLButtonElement).disabled = false;
                    if (btnText) btnText.textContent = "Send Message";
                    if (btnIcon) btnIcon.className = "fas fa-paper-plane ml-2";
                }
                if (formMessage) {
                    formMessage.classList.add("hidden");
                    formMessage.classList.remove("animate-bounce");
                }
            }, 5000);
        }
    });
</script>
