---
import { Image } from "astro:assets";
import heroBg from "../assets/hero-bg.jpg";
---

<section
    id="home"
    class="relative text-white pt-24 pb-20 md:pt-48 md:pb-40 overflow-hidden"
>
    <!-- Animated Background -->
    <div class="absolute inset-0 z-0">
        <Image
            src={heroBg}
            alt="Digital Technology Background"
            class="w-full h-full object-cover opacity-20 dark:opacity-10"
            quality="mid"
            format="webp"
        />
        <div
            class="absolute inset-0 bg-gradient-to-b from-[#1a1a2e]/90 to-[#1a1a2e]/80 dark:from-[#0f172a]/95 dark:to-[#0f172a]/90 mix-blend-multiply"
        >
        </div>
        <!-- Animated gradient overlay -->
        <div class="absolute inset-0 bg-gradient-to-r from-blue-600/10 via-purple-600/10 to-cyan-600/10 animate-gradient-x"></div>
    </div>

    <!-- Floating Product Icons -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute top-1/4 left-[8%] opacity-10 animate-float-slow">
            <i class="fas fa-cash-register text-6xl text-green-400"></i>
        </div>
        <div class="absolute top-1/3 right-[10%] opacity-10 animate-float-medium">
            <i class="fas fa-boxes text-6xl text-blue-400"></i>
        </div>
        <div class="absolute bottom-1/4 left-[15%] opacity-10 animate-float-fast">
            <i class="fas fa-shopping-cart text-6xl text-purple-400"></i>
        </div>
        <div class="absolute bottom-1/3 right-[15%] opacity-10 animate-float-slow">
            <i class="fas fa-graduation-cap text-6xl text-cyan-400"></i>
        </div>
        <div class="absolute top-1/2 left-[5%] opacity-10 animate-float-medium">
            <i class="fas fa-th-large text-6xl text-indigo-400"></i>
        </div>
    </div>

    <div class="container mx-auto px-6 text-center relative z-10">
        <div
            class="inline-block bg-blue-500/20 backdrop-blur-sm border border-blue-400/30 px-5 py-2 rounded-full text-blue-100 text-[10px] md:text-sm font-semibold mb-6 animate-fade-in"
        >
            <i class="fas fa-bolt mr-1 text-yellow-400"></i> Leading Software Innovation in Bangladesh
        </div>
        <h1
            class="text-3xl md:text-7xl font-bold mb-6 md:mb-8 leading-[1.2] md:leading-tight max-w-5xl mx-auto tracking-tight px-2 animate-slide-up"
        >
            POS, Inventory & ERP Software That Help Bangladesh Businesses Grow
        </h1>
        <p
            class="text-base md:text-2xl mb-8 md:mb-12 max-w-4xl mx-auto text-blue-50 leading-relaxed font-light px-4 animate-slide-up-delay"
        >
            From POS Systems to E-commerce Platforms to ERP Solutions - We Build
            Custom Software That Works. <br class="hidden md:block" />
            Trusted by 80+ Businesses Across Bangladesh.
        </p>
        <div class="flex flex-col md:flex-row justify-center gap-6 animate-slide-up-delay-2">
            <a
                href="/solutions/pos-system"
                class="bg-gradient-to-r from-primary to-blue-600 text-white px-10 py-5 rounded-xl font-bold text-lg hover:shadow-2xl hover:shadow-primary/30 hover:scale-105 transition-all transform duration-300 flex items-center justify-center gap-2"
            >
                Explore POS System <i class="fas fa-arrow-right text-sm"></i>
            </a>
            <a
                href="#contact"
                class="bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white px-10 py-5 rounded-xl font-bold text-lg hover:bg-white hover:text-dark hover:border-white transition-all transform duration-300 flex items-center justify-center gap-2"
            >
                <i class="fas fa-play-circle"></i> Get Free Demo
            </a>
        </div>

        <!-- Animated Counters -->
        <div class="mt-20 grid grid-cols-3 gap-6 max-w-2xl mx-auto">
            <div class="text-center group">
                <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 counter" data-target="80">0</div>
                <div class="text-xs md:text-sm text-blue-200/70 font-medium">Projects Delivered</div>
            </div>
            <div class="text-center group">
                <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 counter" data-target="80">0</div>
                <div class="text-xs md:text-sm text-blue-200/70 font-medium">Happy Clients</div>
            </div>
            <div class="text-center group">
                <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 counter" data-target="5">0</div>
                <div class="text-xs md:text-sm text-blue-200/70 font-medium">Years Experience</div>
            </div>
        </div>

        <!-- Scroll indicator -->
        <div class="mt-16 animate-bounce">
            <a href="#featured-products" class="inline-flex flex-col items-center text-white/40 hover:text-white/70 transition-colors">
                <span class="text-xs font-medium mb-2">Scroll to explore</span>
                <i class="fas fa-chevron-down text-lg"></i>
            </a>
        </div>
    </div>

    <style>
        @keyframes gradient-x {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        .animate-gradient-x {
            animation: gradient-x 8s ease infinite;
            background-size: 200% 200%;
        }
        @keyframes float-slow {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(5deg); }
        }
        @keyframes float-medium {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(-3deg); }
        }
        @keyframes float-fast {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }
        .animate-float-slow { animation: float-slow 6s ease-in-out infinite; }
        .animate-float-medium { animation: float-medium 4s ease-in-out infinite; }
        .animate-float-fast { animation: float-fast 3s ease-in-out infinite; }
        @keyframes fade-in {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fade-in 0.8s ease-out forwards; }
        @keyframes slide-up {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-slide-up { animation: slide-up 0.8s ease-out 0.2s forwards; opacity: 0; }
        .animate-slide-up-delay { animation: slide-up 0.8s ease-out 0.4s forwards; opacity: 0; }
        .animate-slide-up-delay-2 { animation: slide-up 0.8s ease-out 0.6s forwards; opacity: 0; }
    </style>

    <script>
        // Counter animation on scroll
        const observerCallback = (entries: IntersectionObserverEntry[]) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const counters = entry.target.querySelectorAll('.counter');
                    counters.forEach((counter) => {
                        const target = parseInt(counter.getAttribute('data-target') || '0');
                        const duration = 2000;
                        const step = target / (duration / 16);
                        let current = 0;
                        const timer = setInterval(() => {
                            current += step;
                            if (current >= target) {
                                counter.textContent = target + '+';
                                clearInterval(timer);
                            } else {
                                counter.textContent = Math.floor(current) + '+';
                            }
                        }, 16);
                    });
                    counterObserver.unobserve(entry.target);
                }
            });
        };
        const counterObserver = new IntersectionObserver(observerCallback, { threshold: 0.5 });
        const heroSection = document.getElementById('home');
        if (heroSection) counterObserver.observe(heroSection);
    </script>
</section>
