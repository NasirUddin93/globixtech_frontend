</header>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuBtn = document.getElementById('menu-btn');
        const menuIcon = document.getElementById('menu-icon');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileBackdrop = document.getElementById('mobile-backdrop');

        const solutionsBtn = document.getElementById('mobile-solutions-btn');
        const solutionsContent = document.getElementById('mobile-solutions-content');
        const solutionsChevron = document.getElementById('mobile-solutions-chevron');

        const closeMobileMenu = () => {
            if (!mobileMenu || !menuIcon) return;
            mobileMenu.classList.remove('scale-100', 'opacity-100');
            mobileMenu.classList.add('scale-95', 'opacity-0');
            if (mobileBackdrop) {
                mobileBackdrop.classList.remove('opacity-100');
                mobileBackdrop.classList.add('opacity-0');
            }
            menuIcon.classList.remove('fa-times');
            menuIcon.classList.add('fa-bars');
            document.body.classList.remove('overflow-hidden');
            setTimeout(() => {
                mobileMenu.classList.add('hidden');
                if (mobileBackdrop) mobileBackdrop.classList.add('hidden');
            }, 300);
        };

        if (menuBtn && mobileMenu && menuIcon) {
            menuBtn.addEventListener('click', () => {
                const isHidden = mobileMenu.classList.contains('hidden');
                
                if (isHidden) {
                    mobileMenu.classList.remove('hidden');
                    if (mobileBackdrop) {
                        mobileBackdrop.classList.remove('hidden');
                    }
                    document.body.classList.add('overflow-hidden');
                    setTimeout(() => {
                        mobileMenu.classList.remove('scale-95', 'opacity-0');
                        mobileMenu.classList.add('scale-100', 'opacity-100');
                        if (mobileBackdrop) {
                            mobileBackdrop.classList.remove('opacity-0');
                            mobileBackdrop.classList.add('opacity-100');
                        }
                    }, 10);
                    menuIcon.classList.remove('fa-bars');
                    menuIcon.classList.add('fa-times');
                } else {
                    closeMobileMenu();
                }
            });

            if (mobileBackdrop) {
                mobileBackdrop.addEventListener('click', () => {
                    closeMobileMenu();
                });
            }

            // Close mobile menu when clicking any nav link inside it
            const navLinks = mobileMenu.querySelectorAll('a');
            navLinks.forEach(link => {
                link.addEventListener('click', () => {
                    closeMobileMenu();
                });
            });
        }

        if (solutionsBtn && solutionsContent && solutionsChevron) {
            solutionsBtn.addEventListener('click', () => {
                const isHidden = solutionsContent.classList.contains('hidden');
                if (isHidden) {
                    solutionsContent.classList.remove('hidden');
                    solutionsChevron.classList.add('rotate-180');
                } else {
                    solutionsContent.classList.add('hidden');
                    solutionsChevron.classList.remove('rotate-180');
                }
            });
        }
    });
</script>
