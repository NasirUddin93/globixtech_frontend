        <!-- Right Action Pill -->
        <div class="flex items-center gap-2 sm:gap-3">
            <a href="/login" class="hidden sm:flex text-xs font-semibold text-[#1d1d1f] hover:text-[#0071e3] px-3.5 py-2 rounded-full hover:bg-black/5 transition-all items-center gap-1.5">
