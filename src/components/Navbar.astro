                        </a>
                        <a href="/solutions/data-science" class="flex items-center gap-3 p-2 rounded-xl hover:bg-white transition-colors">
                            <div class="w-6 h-6 rounded-lg bg-fuchsia-50 flex items-center justify-center text-fuchsia-600 text-[10px]"><i class="fas fa-chart-line"></i></div>
