                        <div class="text-[10px] font-extrabold uppercase tracking-widest text-[#86868b] px-2">Apps & AI</div>
                        <a href="/solutions/web-apps" class="flex items-center gap-3 p-2 rounded-xl hover:bg-white transition-colors">
                            <div class="w-6 h-6 rounded-lg bg-cyan-50 flex items-center justify-center text-cyan-600 text-[10px]"><i class="fas fa-code"></i></div>
