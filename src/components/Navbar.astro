                    <!-- Infrastructure -->
                    <div class="space-y-1">
                        <div class="text-[10px] font-extrabold uppercase tracking-widest text-[#86868b] px-2">Infrastructure & Custom</div>
                        <a href="/solutions/server-management" class="flex items-center gap-3 p-2 rounded-xl hover:bg-white transition-colors">
                            <div class="w-6 h-6 rounded-lg bg-slate-100 flex items-center justify-center text-slate-700 text-[10px]"><i class="fas fa-server"></i></div>
