                        <a href="/solutions/ecommerce" class="flex items-center gap-3 p-2 rounded-xl hover:bg-white transition-colors">
                            <div class="w-6 h-6 rounded-lg bg-rose-50 flex items-center justify-center text-rose-500 text-[10px]"><i class="fas fa-shopping-cart"></i></div>
