                    <div class="bg-white/95 backdrop-blur-3xl border border-white/90 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.12)] rounded-3xl p-6 grid grid-cols-3 gap-4">
                    
                    <!-- Column 1: Core Software Systems -->
                    <div class="space-y-1">
