---
const categories = [
    {
        id: "core-products",
        title: "Core Products",
        icon: "fa-star",
        color: "text-blue-600",
        services: [
            {
                name: "POS System",
                desc: "Lightning-fast checkout with multi-payment support, barcode scanning, and real-time inventory sync. Perfect for retail, restaurants, and pharmacies.",
                icon: "fa-cash-register",
                link: "/solutions/pos-system"
            },
            {
                name: "Inventory Management",
                desc: "Track stock in real-time across multiple locations. Automated reordering, barcode support, and comprehensive reporting.",
                icon: "fa-boxes",
                link: "/solutions/inventory"
            },
            {
                name: "E-commerce Solutions",
                desc: "Scalable multi-vendor marketplaces and custom retail platforms designed for high conversion.",
                icon: "fa-shopping-cart",
                link: "/solutions/ecommerce"
            },
            {
                name: "Education Software",
                desc: "Comprehensive LMS and student management ecosystems tailored for modern institutions.",
                icon: "fa-graduation-cap",
                link: "/solutions/school-management-system"
            },
            {
                name: "ERP System",
                desc: "Unified platform for finance, HR, inventory, and sales. Eliminate data silos and make smarter business decisions.",
                icon: "fa-th-large",
                link: "/solutions/erp-system"
            }
        ]
    },
    {
        id: "ai-data",
        title: "AI & Data Science",
        icon: "fa-brain",
        color: "text-purple-600",
        services: [
            {
                name: "AI Business Assistants",
                desc: "Smart virtual assistants integrated into your ERP/CRM to analyze trends and suggest business actions.",
                icon: "fa-robot"
            },
            {
                name: "Data Science Solutions",
                desc: "Turning raw data into actionable insights through predictive analytics, visualization, and machine learning models.",
                icon: "fa-chart-network"
            },
            {
                name: "Web Application Services",
                desc: "Bespoke web apps built on robust frameworks (React, Laravel, Python) to automate complex business workflows.",
                icon: "fa-code"
            }
        ]
    },
    {
        id: "infrastructure",
        title: "Infrastructure & Security",
        icon: "fa-shield-halved",
        color: "text-green-600",
        services: [
            {
                name: "Network Security Services",
                desc: "Advanced threat detection, firewall management, and penetration testing to protect your digital assets.",
                icon: "fa-user-shield"
            },
            {
                name: "Server Management",
                desc: "End-to-end Linux/Windows server administration, cloud migration (AWS/Azure), and 24/7 uptime monitoring.",
                icon: "fa-server"
            },
            {
                name: "Network Services",
                desc: "Design and implementation of scalable enterprise network architectures.",
                icon: "fa-network-wired"
            }
        ]
    }
];
---
<section class="py-24 bg-white overflow-hidden">
    <div class="container mx-auto px-6">
        <div class="text-center mb-20">
            <span class="text-primary font-bold uppercase tracking-widest text-sm">Industrial Expertise</span>
            <h2 class="text-4xl md:text-5xl font-bold mt-3 mb-6">Our Solutions Ecosystem</h2>
            <div class="w-24 h-1 bg-primary mx-auto rounded-full"></div>
        </div>

        {categories.map((cat, idx) => (
            <div id={cat.id} class={`mb-24 last:mb-0 ${idx % 2 !== 0 ? 'lg:flex-row-reverse' : ''}`}>
                <div class="flex items-center gap-4 mb-10">
                    <div class={`w-14 h-14 bg-slate-50 border border-slate-100 rounded-2xl flex items-center justify-center ${cat.color} text-2xl shadow-sm`}>
                        <i class={`fas ${cat.icon}`}></i>
                    </div>
                    <h3 class="text-3xl font-bold text-dark tracking-tight">{cat.title}</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {cat.services.map(service => (
                        <div class="group bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-primary/20 transition-all duration-300 relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-24 h-24 bg-primary/5 rounded-bl-full -mr-12 -mt-12 group-hover:scale-150 transition-transform duration-500"></div>
                            <div class={`w-12 h-12 bg-slate-50 rounded-xl flex items-center justify-center mb-6 ${cat.color} group-hover:bg-primary group-hover:text-white transition-colors duration-300`}>
                                <i class={`fas ${service.icon} text-xl`}></i>
                            </div>
                            <h4 class="text-xl font-bold mb-4 text-dark group-hover:text-primary transition-colors">{service.name}</h4>
                            <p class="text-slate-600 leading-relaxed text-sm md:text-base mb-6">{service.desc}</p>
                            {service.link && (
                                <a href={service.link} class="text-primary font-bold text-sm hover:underline flex items-center gap-1">
                                    Learn More & View Modules <i class="fas fa-arrow-right text-[10px]"></i>
                                </a>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        ))}
    </div>
</section>
