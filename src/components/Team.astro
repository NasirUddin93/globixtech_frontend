---
const teamMembers = [
  { name: "Md Anwar Hossain", role: "Senior Network Engineer", image: "/team/Team_Member01.jpeg" },
  { name: "Ashraful Islam", role: "Senior DotNet Developer", image: "/team/Team_member02.jpeg" },
  { name: "Aslam Shikder", role: "AI Engineer", image: "/team/Team_member03.jpeg" },
  { name: "Md Tanver rana sobur", role: "Researchers & AI engineer", image: "/team/Team_member04.jpeg" },
  { name: "Farid Ahmed", role: "Senior Codeigniter Developer", image: "/team/team_member05.png" },
  { name: "Saimum Islam Shagor", role: "Senior QA Engineer", image: "/team/Team_member06.jpeg" },
  { name: "Joy Krishna Mondal", role: "Marketing Head", image: "/team/Team_member07.jpeg" },
  { name: "Sharar Hossain", role: "Web Developer (Intern)", image: "/team/Team_member08.jpeg" },
  { name: "Sourav Rahman", role: "Graphic & Brand Designer", image: "/team/Team_member09.jpeg" },
];
---

<section class="py-24 bg-[#f5f5f7]" id="team">
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-[#0071e3] bg-blue-50 px-4 py-1.5 rounded-full border border-blue-100 shadow-xs">
        Engineering Expertise
      </span>
      <h2 class="text-3xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-4 mb-4">
        Meet The Team
      </h2>
      <p class="text-[#86868b] text-base md:text-lg">
        The talented individuals behind our innovative solutions, dedicated to delivering excellence in every line of code.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        teamMembers.map((member, index) => (
          <!-- Stack wrapper -->
          <div class="card-stack" style={`--delay: ${index * 0.25}s`}>

            <!-- THE REAL CARD -->
            <div class="card-float group relative bg-white/80 backdrop-blur-2xl rounded-[2rem] overflow-hidden border border-white shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] transition-shadow duration-300">
              <div class="aspect-[4/5] overflow-hidden bg-gray-100 relative">
                <div class="absolute inset-0 bg-gradient-to-t from-[#1d1d1f]/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10" />
                <img
                  src={member.image}
                  alt={member.name}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-x-0 bottom-0 p-6 z-20 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
                  <div class="flex justify-center gap-3 text-white">
                    <a href="#" class="w-9 h-9 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center hover:bg-[#0071e3] transition-colors text-xs">
                      <i class="fab fa-linkedin-in" />
                    </a>
                    <a href="#" class="w-9 h-9 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center hover:bg-sky-400 transition-colors text-xs">
                      <i class="fab fa-twitter" />
                    </a>
                    <a href="#" class="w-9 h-9 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center hover:bg-gray-800 transition-colors text-xs">
                      <i class="fab fa-github" />
                    </a>
                  </div>
                </div>
              </div>
              <div class="p-6 text-center relative z-20 bg-white/90 backdrop-blur-md">
                <h3 class="text-lg font-extrabold text-[#1d1d1f] mb-1 group-hover:text-[#0071e3] transition-colors">
                  {member.name}
                </h3>
                <p class="text-[#0071e3] font-bold text-xs uppercase tracking-wider">
                  {member.role}
                </p>
              </div>
            </div>

            <!-- SURFACE SHADOW LINE (FLOATS & RESIZES IN SYNC) -->
            <div class="card-surface-shadow" aria-hidden="true"></div>

            <!-- REFLECTION -->
            <div class="card-reflection" aria-hidden="true">
              <div class="card-reflection-clone">
                <div class="aspect-[4/5] bg-gray-100 overflow-hidden">
                  <img
                    src={member.image}
                    alt=""
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="p-6 text-center bg-white/90">
                  <h3 class="text-lg font-extrabold text-[#1d1d1f] mb-1">{member.name}</h3>
                  <p class="text-[#0071e3] font-bold text-xs uppercase tracking-wider">{member.role}</p>
                </div>
              </div>
            </div>

          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ─── Stack wrapper ─────────────────────────────────────────────────────── */
  .card-stack {
    display: flex;
    flex-direction: column;
    overflow: visible;
  }

  /* ─── Card floats UP ──────────────────────────────────────────────────── */
  .card-float {
    animation: floatUp 5s ease-in-out infinite;
    animation-delay: var(--delay);
    will-change: transform;
    flex-shrink: 0;
  }

  .card-stack:hover .card-float,
  .card-stack:hover .card-surface-shadow,
  .card-stack:hover .card-reflection {
    animation-play-state: paused;
  }

  @keyframes floatUp {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }

  /* ─── Ground Surface Shadow ────────────────────────────────────────────── */
  .card-surface-shadow {
    height: 10px;
    width: 80%;
    margin: 3px auto;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.45) 0%, transparent 70%);
    filter: blur(4px);
    pointer-events: none;
    flex-shrink: 0;
    z-index: 10;
    animation: shadowScale 5s ease-in-out infinite;
    animation-delay: var(--delay);
    will-change: transform, opacity;
  }

  /* Shadow contracts & darkens when card is low; expands & fades when card is high */
  @keyframes shadowScale {
    0%, 100% {
      transform: scaleX(0.7) scaleY(0.8);
      opacity: 0.7;
    }
    50% {
      transform: scaleX(1.2) scaleY(1.3);
      opacity: 0.2;
    }
  }

  /* ─── Reflection container & Opacity Fade ───────────────────────────────── */
  .card-reflection {
    margin-top: 2px; 
    height: 64px;
    overflow: hidden;
    flex-shrink: 0;
    pointer-events: none;
    position: relative;

    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.3) 35%,
      transparent 80%
    );
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.3) 35%,
      transparent 80%
    );

    animation: floatDown 5s ease-in-out infinite;
    animation-delay: var(--delay);
    will-change: transform;
  }

  /* ─── Progressive Blur Layer ───────────────────────────────────────────── */
  .card-reflection::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;

    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);

    -webkit-mask-image: linear-gradient(
      to bottom, 
      transparent 0%, 
      black 60%
    );
    mask-image: linear-gradient(
      to bottom, 
      transparent 0%, 
      black 60%
    );
  }

  /* Reflection drifts slightly downward as card floats up */
  @keyframes floatDown {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(4px); }
  }

  /* Clone is flipped vertically */
  .card-reflection-clone {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    transform: scaleY(-1);
    transform-origin: bottom center;
    border-radius: 0 0 2rem 2rem;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-float,
    .card-surface-shadow,
    .card-reflection {
      animation: none;
    }
  }
</style>