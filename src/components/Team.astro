---
const teamMembers = [
  {
    name: "Md Anwar Hossain",
    role: "Senior Network Engineer",
    image: "/team/Team_Member01.jpeg",
  },
  {
    name: "Ashraful Islam",
    role: "Senior DotNet Developer",
    image: "/team/Team_member02.jpeg",
  },
  {
    name: "Aslam Shikder",
    role: "AI Engineer",
    image: "/team/Team_member03.jpeg",
  },
  {
    name: "Md Tanver rana sobur",
    role: "Researchers & AI engineer",
    image: "/team/Team_member04.jpeg",
  },
  {
    name: "Farid Ahmed",
    role: "Senior Codeigniter Developer",
    image: "/team/team_member05.png",
  },
  {
    name: "Saimum Islam Shagor",
    role: "Senior QA Engineer",
    image: "/team/Team_member06.jpeg",
  },
  {
    name: "Joy Krishna Mondal",
    role: "Marketing Head",
    image: "/team/Team_member07.jpeg",
  },
  {
    name: "Md. Sharar Hussain",
    role: "Web Developer (Intern)",
    image: "/team/Team_member08.jpeg",
  },{
    name: "Sourav Rahman",
    role: "Graphic & Brand Designer",
    image: "/team/Team_member09.jpeg",
  },
];
---

<section class="py-24 bg-white" id="team">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <div
        class="inline-block bg-blue-100 text-blue-600 px-4 py-2 rounded-full text-sm font-bold mb-4 uppercase tracking-wider"
      >
        Our Experts
      </div>
      <h2 class="text-3xl md:text-5xl font-bold text-[#0c1b3d] mb-4">
        Meet The Team
      </h2>
      <p class="text-gray-600 max-w-2xl mx-auto text-lg">
        The talented individuals behind our innovative solutions, dedicated to delivering excellence in every line of code.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        teamMembers.map((member) => (
          <div class="group relative bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-100 transform hover:-translate-y-2">
            <!-- Image Container -->
            <div class="aspect-[4/5] overflow-hidden bg-gray-100 relative">
               <div class="absolute inset-0 bg-gradient-to-t from-[#0c1b3d] via-transparent to-transparent opacity-0 group-hover:opacity-90 transition-opacity duration-300 z-10"></div>
              <img
                src={member.image}
                alt={member.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
              
              <!-- Hover Content -->
              <div class="absolute inset-x-0 bottom-0 p-6 z-20 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
                 <div class="flex justify-center gap-4 text-white">
                    <a href="#" class="w-10 h-10 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-blue-600 transition-colors">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                    <a href="#" class="w-10 h-10 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-blue-400 transition-colors">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="#" class="w-10 h-10 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-gray-800 transition-colors">
                        <i class="fab fa-github"></i>
                    </a>
                 </div>
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-6 text-center relative z-20 bg-white">
              <h3 class="text-xl font-bold text-[#0c1b3d] mb-1 group-hover:text-blue-600 transition-colors">
                {member.name}
              </h3>
              <p class="text-blue-500 font-medium text-sm uppercase tracking-wide">
                {member.role}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
