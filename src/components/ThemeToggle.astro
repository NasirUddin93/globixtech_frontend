<button
    id="theme-toggle"
    class="relative w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-100 hover:bg-gray-200 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors duration-300 flex items-center justify-center overflow-hidden"
    aria-label="Toggle Dark Mode"
>
    <!-- Sun Icon (shown in light mode) -->
    <i
        class="fas fa-sun text-yellow-500 absolute transition-transform duration-500 rotate-0 scale-100 dark:rotate-180 dark:scale-0"
    ></i>

    <!-- Moon Icon (shown in dark mode) -->
    <i
        class="fas fa-moon text-blue-300 absolute transition-transform duration-500 -rotate-180 scale-0 dark:rotate-0 dark:scale-100"
    ></i>
</button>

<script>
    const themeToggleBtn = document.getElementById("theme-toggle");
    const html = document.documentElement;

    // Toggle Theme
    themeToggleBtn?.addEventListener("click", () => {
        if (html.classList.contains("dark")) {
            html.classList.remove("dark");
            localStorage.setItem("theme", "light");
        } else {
            html.classList.add("dark");
            localStorage.setItem("theme", "dark");
        }
    });
</script>
