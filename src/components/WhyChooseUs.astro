---
const reasons = [
    { num: "01", icon: "fa-users-cog", title: "Experienced Team", desc: "Our skilled developers have years of experience in POS systems, inventory management, e-commerce, and ERP solutions." },
    { num: "02", icon: "fa-wand-magic-sparkles", title: "Custom Solutions", desc: "We tailor every solution to match your specific business needs, ensuring maximum efficiency and ROI." },
    { num: "03", icon: "fa-layer-group", title: "Modern Architecture", desc: "We build with clean, scalable architecture that grows with your business and adapts to future needs." },
    { num: "04", icon: "fa-tag", title: "Affordable Pricing", desc: "High-quality solutions at competitive prices with transparent costing and no hidden fees." },
    { num: "05", icon: "fa-clock", title: "On-Time Delivery", desc: "We respect deadlines and ensure your project is completed on time with regular progress updates." },
    { num: "06", icon: "fa-headset", title: "Long-Term Support", desc: "We provide ongoing maintenance and support to ensure your systems remain secure and up-to-date." },
];
---
<section class="py-20 bg-gradient-to-r from-primary to-secondary text-white relative overflow-hidden">
    <!-- Decorative elements -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -mr-32 -mt-32"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full -ml-24 -mb-24"></div>

    <div class="container mx-auto px-6 relative z-10">
        <h2 class="text-4xl font-bold text-center mb-4">Why Choose Globix Tech?</h2>
        <p class="text-center text-xl mb-16 max-w-3xl mx-auto opacity-90">Your Trusted Technology Partner for Digital Transformation</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {reasons.map((item) => (
                <div class="bg-white bg-opacity-10 p-6 rounded-xl backdrop-blur-sm border border-white border-opacity-10 hover:bg-opacity-20 transition-all duration-300 group">
                    <div class="flex items-start gap-4 mb-3">
                        <span class="text-3xl font-extrabold text-white/20 group-hover:text-white/40 transition-colors">{item.num}</span>
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-2">
                                <i class={`fas ${item.icon} text-xl text-accent`}></i>
                                <h3 class="text-xl font-bold">{item.title}</h3>
                            </div>
                            <p class="opacity-90 leading-relaxed">{item.desc}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
