---
const steps = [
    {
        number: "01",
        title: "Discovery",
        desc: "We schedule a call to understand your goals, challenges, and requirements in depth.",
        icon: "fa-search",
    },
    {
        number: "02",
        title: "Strategy",
        desc: "We maximize value by creating a tailored roadmap and proposal for your specific needs.",
        icon: "fa-chess-board",
    },
    {
        number: "03",
        title: "Development",
        desc: "Our agile team brings the solution to life with clean code and regular updates.",
        icon: "fa-code",
    },
    {
        number: "04",
        title: "Launch",
        desc: "We deploy your solution and provide ongoing support to ensure long-term success.",
        icon: "fa-rocket",
    },
];
import VideoBackground from "./landing/VideoBackground.astro";
---

<section class="py-24 bg-[#f5f5f7] relative overflow-hidden">
    <!-- Video with faded borders -->
    <div
        class="absolute inset-6 overflow-hidden pointer-events-none z-0 rounded-3xl"
        style="-webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent), linear-gradient(to bottom, transparent, black 12%, black 88%, transparent); mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent), linear-gradient(to bottom, transparent, black 12%, black 88%, transparent); -webkit-mask-composite: destination-in; mask-composite: intersect;"
    >
        <VideoBackground mp4="/videos/generated_video_july_24.mp4" overlay="light" />
    </div>
    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-16">
            <div
                class="inline-block bg-blue-100 text-blue-600 px-4 py-2 rounded-full text-sm font-bold mb-4 uppercase tracking-wider"
            >
                How We Work
            </div>
            <h2 class="text-3xl md:text-5xl font-bold text-[#0c1b3d] mb-4">
                Our Process
            </h2>
            <p class="text-gray-600 max-w-2xl mx-auto text-lg">
                A simple, transparent journey from idea to reality.
            </p>
        </div>

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative"
        >
            <!-- Connecting Line (Desktop) -->
            <div
                class="hidden lg:block absolute top-1/2 left-0 w-full h-1 bg-gradient-to-r from-blue-100 via-blue-200 to-blue-100 -translate-y-1/2 z-0"
            >
            </div>

            {
                steps.map((step, index) => (
                    <div class="relative z-10 group">
                        <div class="bg-white p-8 rounded-2xl shadow-lg border border-gray-100 h-full hover:translate-y-[-10px] transition-all duration-300">
                            <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-2xl flex items-center justify-center text-white text-2xl mb-6 shadow-blue-500/30 font-bold">
                                {step.number}
                            </div>
                            <h3 class="text-xl font-bold text-[#0c1b3d] mb-3 group-hover:text-blue-600 transition-colors">
                                {step.title}
                            </h3>
                            <p class="text-gray-600 leading-relaxed">
                                {step.desc}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
