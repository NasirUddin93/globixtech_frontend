---
interface Props {
    contactName: string;
}

const { contactName } = Astro.props;
---

<!-- ══════════════ DONE MODAL ══════════════ -->
<div id="done-modal" style="display:none;position:fixed;inset:0;z-index:1000;align-items:center;justify-content:center;">
    <!-- Backdrop -->
    <div id="modal-backdrop" style="position:absolute;inset:0;background:rgba(15,25,60,.45);backdrop-filter:blur(4px);"></div>
    <!-- Panel (2-column layout) -->
    <div style="position:relative;z-index:1;background:#fff;border-radius:32px;padding:0;width:100%;max-width:1080px;margin:24px;box-shadow:0 30px 80px rgba(0,0,0,.22);animation:slideUp .25s ease;overflow:hidden;">
        <!-- Header -->
        <div style="display:flex;align-items:center;gap:18px;padding:32px 40px 0;">
            <div style="width:56px;height:56px;border-radius:16px;background:#f0fdf4;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="fas fa-circle-check" style="color:#16a34a;font-size:26px;"></i>
            </div>
            <div style="flex:1;">
                <div style="font-size:22px;font-weight:700;color:#0c1b3d;">Mark as Done</div>
                <div id="modal-contact-name" style="font-size:15px;color:#64748b;margin-top:4px;">{contactName}</div>
            </div>
            <button id="modal-close" style="width:42px;height:42px;border:none;background:#f1f5f9;border-radius:12px;cursor:pointer;color:#64748b;font-size:18px;display:flex;align-items:center;justify-content:center;">✕</button>
        </div>

        <!-- 2-Panel Body: Customer Message (Left) + Conversation Summary (Right) -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;margin:24px 40px 32px;border:1px solid #e8ecf1;border-radius:20px;overflow:hidden;">
            <!-- Left: Customer Original Message -->
            <div style="padding:28px;background:#fafbff;border-right:1px solid #e8ecf1;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
                    <div style="width:38px;height:38px;border-radius:10px;background:#eff6ff;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-user" style="color:#0071e3;font-size:15px;"></i>
                    </div>
                    <div style="font-size:15px;font-weight:700;color:#0c1b3d;text-transform:uppercase;letter-spacing:.03em;">Customer Message</div>
                </div>
                <div id="modal-customer-message" class="msg-cell-full" style="font-size:16px;line-height:1.7;color:#334155;"></div>
            </div>

            <!-- Right: Conversation Summary Input -->
            <div style="padding:28px;background:#f8fafc;display:flex;flex-direction:column;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
                    <div style="width:38px;height:38px;border-radius:10px;background:#f0fdf4;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-pen-to-square" style="color:#16a34a;font-size:15px;"></i>
                    </div>
                    <div style="font-size:15px;font-weight:700;color:#0c1b3d;text-transform:uppercase;letter-spacing:.03em;">Conversation Summary <span style="color:#dc2626;font-weight:700;">*</span></div>
                </div>
                <textarea
                    id="modal-note"
                    rows="8"
                    placeholder="Write a brief conversation summary of what was discussed or agreed upon…"
                    style="width:100%;padding:16px 18px;border:1.5px solid #e2e8f0;border-radius:16px;font-size:15px;font-family:'Inter',sans-serif;color:#334155;resize:vertical;outline:none;transition:border .18s;line-height:1.6;flex:1;"
                ></textarea>
                <div id="modal-error" style="display:none;margin-top:14px;padding:12px 18px;background:#fef2f2;border:1px solid #fecaca;border-radius:12px;color:#dc2626;font-size:14px;"></div>
            </div>
        </div>

        <!-- Footer Actions -->
        <div style="display:flex;gap:14px;padding:0 40px 32px;">
            <button id="modal-cancel" style="flex:1;padding:16px;border:1.5px solid #e2e8f0;border-radius:16px;background:#fff;font-size:15px;font-weight:600;color:#64748b;cursor:pointer;transition:background .18s;">Cancel</button>
            <button id="modal-submit" style="flex:2;padding:16px;border:none;border-radius:16px;background:linear-gradient(135deg,#16a34a,#22c55e);color:#fff;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;box-shadow:0 6px 18px rgba(22,163,74,.35);transition:opacity .18s;">
                <i class="fas fa-circle-check" style="font-size:16px;"></i>
                <span id="modal-submit-text">Mark as Done</span>
            </button>
        </div>
    </div>
</div>

<!-- ══════════════ CONFIRMATION MODAL ══════════════ -->
<div id="confirm-done-modal" style="display:none;position:fixed;inset:0;z-index:1050;align-items:center;justify-content:center;">
    <div id="confirm-modal-backdrop" style="position:absolute;inset:0;background:rgba(15,25,60,.45);backdrop-filter:blur(4px);"></div>
    <div style="position:relative;z-index:1;background:#fff;border-radius:32px;padding:48px;width:100%;max-width:660px;margin:24px;text-align:center;box-shadow:0 30px 80px rgba(0,0,0,.22);animation:slideUp .25s ease;">
        <div style="width:78px;height:78px;margin:0 auto 24px;border-radius:20px;background:#fef3c7;display:flex;align-items:center;justify-content:center;color:#d97706;font-size:34px;">
            <i class="fas fa-circle-question"></i>
        </div>
        <h3 style="font-size:24px;font-weight:800;color:#0c1b3d;margin-bottom:12px;">Are you sure?</h3>
        <p style="font-size:16px;color:#64748b;line-height:1.6;margin-bottom:32px;">
            Are you sure you want to mark this request as <span style="font-weight:700;color:#16a34a;">Done</span> with your conversation summary?
        </p>
        <div style="display:flex;gap:14px;">
            <button id="confirm-modal-cancel" style="flex:1;padding:16px;border:1.5px solid #e2e8f0;border-radius:16px;background:#fff;font-size:15px;font-weight:600;color:#64748b;cursor:pointer;transition:background .18s;">Cancel</button>
            <button id="confirm-modal-proceed" style="flex:1;padding:16px;border:none;border-radius:16px;background:#0071e3;color:#fff;font-size:15px;font-weight:700;cursor:pointer;box-shadow:0 6px 18px rgba(0,113,227,.35);transition:opacity .18s;">Yes, Confirm</button>
        </div>
    </div>
</div>

<!-- ══════════════ SUCCESS POPUP MODAL ══════════════ -->
<div id="success-done-modal" style="display:none;position:fixed;inset:0;z-index:1100;align-items:center;justify-content:center;">
    <div id="success-modal-backdrop" style="position:absolute;inset:0;background:rgba(15,25,60,.45);backdrop-filter:blur(4px);"></div>
    <div style="position:relative;z-index:1;background:#fff;border-radius:32px;padding:48px;width:100%;max-width:660px;margin:24px;text-align:center;box-shadow:0 30px 80px rgba(0,0,0,.22);animation:slideUp .25s ease;">
        <div style="width:84px;height:84px;margin:0 auto 24px;border-radius:50%;background:#dcfce7;display:flex;align-items:center;justify-content:center;color:#16a34a;font-size:38px;box-shadow:inset 0 2px 4px rgba(0,0,0,.05);">
            <i class="fas fa-circle-check"></i>
        </div>
        <h3 style="font-size:26px;font-weight:800;color:#0c1b3d;margin-bottom:12px;">Status Updated!</h3>
        <p style="font-size:16px;color:#64748b;line-height:1.6;margin-bottom:32px;">
            The contact request has been marked as <span style="font-weight:700;color:#16a34a;">Done</span> and your conversation summary was saved successfully.
        </p>
        <button id="success-modal-close" style="width:100%;padding:16px;border:none;border-radius:16px;background:#16a34a;color:#fff;font-size:16px;font-weight:700;cursor:pointer;box-shadow:0 6px 18px rgba(22,163,74,.35);">Awesome</button>
    </div>
</div>

<!-- ══════════════ VIEW MESSAGE MODAL ══════════════ -->
<div id="view-modal" style="display:none;position:fixed;inset:0;z-index:1000;align-items:center;justify-content:center;">
    <div id="view-modal-backdrop" style="position:absolute;inset:0;background:rgba(15,25,60,.45);backdrop-filter:blur(4px);"></div>
    <div style="position:relative;z-index:1;background:#fff;border-radius:32px;padding:0;width:100%;max-width:1080px;margin:24px;box-shadow:0 30px 80px rgba(0,0,0,.22);animation:slideUp .25s ease;overflow:hidden;">
        <!-- Header -->
        <div style="display:flex;align-items:center;gap:18px;padding:32px 40px 0;">
            <div style="width:56px;height:56px;border-radius:16px;background:#eff6ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="fas fa-envelope-open-text" style="color:#0071e3;font-size:26px;"></i>
            </div>
            <div style="flex:1;">
                <div style="font-size:22px;font-weight:700;color:#0c1b3d;">Contact Message</div>
                <div id="view-modal-subject" style="font-size:15px;color:#64748b;margin-top:4px;"></div>
            </div>
            <button id="view-modal-close" style="width:42px;height:42px;border:none;background:#f1f5f9;border-radius:12px;cursor:pointer;color:#64748b;font-size:18px;display:flex;align-items:center;justify-content:center;">✕</button>
        </div>

        <!-- Two-panel body -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;margin:24px 40px 32px;border:1px solid #e8ecf1;border-radius:20px;overflow:hidden;">
            <!-- Left: Customer Message -->
            <div style="padding:28px;background:#fafbff;border-right:1px solid #e8ecf1;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
                    <div style="width:38px;height:38px;border-radius:10px;background:#eff6ff;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-user" style="color:#0071e3;font-size:15px;"></i>
                    </div>
                    <div style="font-size:15px;font-weight:700;color:#0c1b3d;text-transform:uppercase;letter-spacing:.03em;">Customer Message</div>
                </div>
                <div id="view-modal-message" class="msg-cell-full" style="font-size:16px;line-height:1.7;color:#334155;"></div>
            </div>
            <!-- Right: Conversation Summary (Editable) -->
            <div style="padding:28px;background:#f8fafc;display:flex;flex-direction:column;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
                    <div style="width:38px;height:38px;border-radius:10px;background:#f0fdf4;display:flex;align-items:center;justify-content:center;">
                        <i class="fas fa-pen-to-square" style="color:#16a34a;font-size:15px;"></i>
                    </div>
                    <div style="font-size:15px;font-weight:700;color:#0c1b3d;text-transform:uppercase;letter-spacing:.03em;">Conversation Summary</div>
                    <button id="view-note-edit-btn" style="margin-left:auto;padding:6px 14px;border:1px solid #e2e8f0;border-radius:8px;background:#fff;font-size:12px;font-weight:600;color:#64748b;cursor:pointer;transition:all .15s;font-family:'Inter',sans-serif;display:flex;align-items:center;gap:6px;">
                        <i class="fas fa-pencil" style="font-size:12px;"></i> Edit
                    </button>
                </div>
                <textarea
                    id="view-modal-note"
                    rows="8"
                    placeholder="Write a brief summary of what this contact was about, what was discussed, or any follow-up actions taken…"
                    style="width:100%;padding:14px 16px;border:1.5px solid #e2e8f0;border-radius:14px;font-size:15px;font-family:'Inter',sans-serif;color:#334155;resize:vertical;outline:none;transition:border-color .18s,box-shadow .18s;line-height:1.6;flex:1;"
                    readonly
                ></textarea>
                <div id="view-note-save-area" style="display:none;margin-top:14px;gap:12px;">
                    <button id="view-note-save" style="flex:1;padding:12px 18px;border:none;border-radius:12px;background:#0071e3;color:#fff;font-size:14px;font-weight:600;cursor:pointer;transition:opacity .15s;font-family:'Inter',sans-serif;display:flex;align-items:center;justify-content:center;gap:8px;">
                        <i class="fas fa-check" style="font-size:12px;"></i> Save Summary
                    </button>
                    <button id="view-note-cancel" style="padding:12px 18px;border:1.5px solid #e2e8f0;border-radius:12px;background:#fff;font-size:14px;font-weight:600;color:#64748b;cursor:pointer;transition:background .15s;font-family:'Inter',sans-serif;">Cancel</button>
                </div>
                <div id="view-note-error" style="display:none;margin-top:12px;padding:10px 16px;background:#fef2f2;border:1px solid #fecaca;border-radius:10px;color:#dc2626;font-size:13px;"></div>
            </div>
        </div>

        <!-- Footer info -->
        <div style="display:flex;align-items:center;gap:24px;padding:0 40px 32px;flex-wrap:wrap;">
            <div style="display:inline-flex;align-items:center;gap:8px;font-size:14px;color:#94a3b8;">
                <i class="fas fa-flag"></i> Status: <span id="view-modal-status-badge"></span>
            </div>
            <div style="display:inline-flex;align-items:center;gap:8px;font-size:14px;color:#94a3b8;">
                <i class="fas fa-calendar"></i> <span id="view-modal-date"></span>
            </div>
            <div style="margin-left:auto;">
                <button id="view-modal-dismiss" style="padding:12px 24px;border:1.5px solid #e2e8f0;border-radius:12px;background:#fff;font-size:14px;font-weight:600;color:#64748b;cursor:pointer;transition:background .15s;font-family:'Inter',sans-serif;">Close</button>
            </div>
        </div>
    </div>
</div>
