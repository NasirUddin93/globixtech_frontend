---
interface Props {
    adminName: string;
    newContacts: number;
}

const { adminName, newContacts } = Astro.props;
---

<aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <div class="brand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
        </div>
        <div class="brand-text">
            <div class="brand-name">Globix Tech</div>
            <div class="brand-sub">Admin Panel</div>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section">Menu</div>
        <a href="#" class="nav-item active" id="nav-overview" data-tab="overview">
            <i class="fas fa-chart-pie"></i>
            <span class="nav-label">Overview</span>
        </a>
        <a href="#" class="nav-item" id="nav-contacts" data-tab="contacts">
            <i class="fas fa-envelope-open-text"></i>
            <span class="nav-label">
                Contact Submissions
                {newContacts > 0 && <span class="nav-badge">{newContacts}</span>}
            </span>
        </a>

        <div class="nav-section" style="margin-top:10px;">Account</div>
        <a href="/admin?logout=true" class="nav-item nav-item-logout">
            <i class="fas fa-right-from-bracket"></i>
            <span class="nav-label">Logout</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <div class="user-card">
            <div class="user-avatar">{adminName.charAt(0).toUpperCase()}</div>
            <div class="user-info">
                <div class="user-name">{adminName}</div>
                <div class="user-role">Administrator</div>
            </div>
        </div>
    </div>
</aside>
