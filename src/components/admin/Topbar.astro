---
---

<header class="topbar">
    <div class="topbar-left">
        <button class="toggle-btn" id="toggle-sidebar" title="Toggle Navigation Sidebar">
            <i class="fas fa-bars"></i>
        </button>
        <div class="title-wrapper">
            <h1 class="page-title" id="page-title">Dashboard Overview</h1>
            <span class="live-indicator"><span class="pulse-dot"></span> Live System</span>
        </div>
    </div>
    <div class="topbar-right">
        <div class="topbar-date">
            <i class="fas fa-calendar-alt"></i>
            <span>{new Date().toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',year:'numeric'})}</span>
        </div>
        <a href="/admin?logout=true" class="logout-btn" title="Logout from Admin Panel">
            <i class="fas fa-right-from-bracket"></i>
            <span>Logout</span>
        </a>
    </div>
</header>
