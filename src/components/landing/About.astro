---
import VideoBackground from "./VideoBackground.astro";
---

<section id="about" class="py-14 sm:py-20 lg:py-24 bg-[#f5f5f7] relative overflow-hidden">
    <!-- Transparent Background Video with White Overlay & Soft Faded Borders -->
    <VideoBackground mp4="/videos/generated_video_july_24.mp4" overlay="light" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-center">
            <div class="lg:col-span-6 space-y-4 sm:space-y-6 text-left">
                <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-[#0071e3]">Our Story & Mission</span>
                <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight">
                    Architecting the future of software in Bangladesh.
                </h2>
                <p class="text-[#86868b] text-xs sm:text-sm md:text-base leading-relaxed">
                    Globix Tech is a premier Bangladesh IT and software engineering firm based in Uttara, Dhaka. We specialize in high-performance POS platforms, intelligent inventory ecosystems, enterprise ERP systems, and custom web applications.
                </p>
                <p class="text-[#86868b] text-xs sm:text-sm md:text-base leading-relaxed">
                    Our mission is to create weightless, reliable, and scalable software that empowers local businesses to operate with enterprise efficiency.
                </p>

                <div class="grid grid-cols-3 gap-2 sm:gap-4 pt-3 sm:pt-4 border-t border-gray-200">
                    <div class="bg-white/60 backdrop-blur-xl p-2.5 sm:p-4 rounded-xl sm:rounded-2xl border border-white text-center sm:text-left">
                        <div class="text-lg sm:text-2xl font-extrabold text-[#0071e3]" data-counter="100+">100+</div>
                        <div class="text-[10px] sm:text-xs text-[#86868b] font-medium">Projects Done</div>
                    </div>
                    <div class="bg-white/60 backdrop-blur-xl p-2.5 sm:p-4 rounded-xl sm:rounded-2xl border border-white text-center sm:text-left">
                        <div class="text-lg sm:text-2xl font-extrabold text-[#0071e3]" data-counter="80+">80+</div>
                        <div class="text-[10px] sm:text-xs text-[#86868b] font-medium">Happy Clients</div>
                    </div>
                    <div class="bg-white/60 backdrop-blur-xl p-2.5 sm:p-4 rounded-xl sm:rounded-2xl border border-white text-center sm:text-left">
                        <div class="text-lg sm:text-2xl font-extrabold text-[#0071e3]" data-counter="5+">5+</div>
                        <div class="text-[10px] sm:text-xs text-[#86868b] font-medium">Years Exp</div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-6">
                <div class="bg-white/80 backdrop-blur-2xl border border-white rounded-2xl sm:rounded-[2.5rem] p-6 sm:p-8 md:p-10 shadow-[0_20px_60px_rgba(0,0,0,0.03)] text-left">
                    <h3 class="text-xl sm:text-2xl font-bold text-[#1d1d1f] mb-3 sm:mb-4 pb-2 border-b border-gray-100">Our Vision & Core Principles</h3>
                    <p class="text-[#86868b] text-xs sm:text-sm leading-relaxed mb-5 sm:mb-6">
                        To stand as the leading software innovation hub in Bangladesh, recognized globally for engineering elegance, rock-solid security, and client commitment.
                    </p>

                    <div class="space-y-2.5 sm:space-y-3">
                        {[
                            "Customer-Centric Architecture",
                            "Continuous Innovation & Research",
                            "Uncompromising Integrity & Security",
                            "Dedicated Local Developer Support"
                        ].map((val) => (
                            <div class="flex items-center gap-2.5 sm:gap-3 text-xs sm:text-sm font-semibold text-[#1d1d1f]">
                                <div class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-[10px] sm:text-xs shrink-0"><i class="fas fa-check"></i></div>
                                <span>{val}</span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
