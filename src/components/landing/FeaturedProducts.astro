---
const products = [
    {
        title: "POS System",
        tag: "High Velocity",
        desc: "Lightning checkout, offline mode, multi-register support and instant thermal receipt printing.",
        icon: "fa-cash-register",
        color: "from-blue-500 to-indigo-600",
        link: "/solutions/pos-system"
    },
    {
        title: "Inventory Suite",
        tag: "Automated",
        desc: "Track stock across warehouses, barcode generation, batch management and reorder alerts.",
        icon: "fa-boxes",
        color: "from-indigo-500 to-purple-600",
        link: "/solutions/inventory"
    },
    {
        title: "ERP Platform",
        tag: "Enterprise",
        desc: "Complete integration of Finance, General Ledger, HR Payroll, Supply Chain and CRM.",
        icon: "fa-th-large",
        color: "from-purple-500 to-pink-600",
        link: "/solutions/erp-system"
    },
    {
        title: "School Management",
        tag: "Education",
        desc: "Student admissions, attendance SMS, online fees, exam results, and parents portal.",
        icon: "fa-graduation-cap",
        color: "from-emerald-500 to-teal-600",
        link: "/solutions/school-management-system"
    }
];
---

<section id="featured-products" class="py-24 bg-[#fbfbfd]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-[#0071e3]">Engineered Products</span>
                <h2 class="text-3xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-3">Refined for absolute reliability.</h2>
            </div>
            <p class="text-[#86868b] max-w-md mt-4 md:mt-0 text-sm md:text-base">
                Discover enterprise software created specifically for Bangladesh business environments.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {products.map((p) => (
                <a href={p.link} class="group relative bg-white/70 backdrop-blur-2xl border border-white/80 rounded-[2rem] p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-6">
                            <div class={`w-12 h-12 rounded-2xl bg-gradient-to-br ${p.color} text-white flex items-center justify-center text-xl shadow-lg shadow-indigo-500/10`}>
                                <i class={`fas ${p.icon}`}></i>
                            </div>
                            <span class="text-[11px] font-bold text-[#86868b] bg-[#f5f5f7] px-3 py-1 rounded-full border border-gray-200/50">{p.tag}</span>
                        </div>
                        <h3 class="text-xl font-bold text-[#1d1d1f] mb-3 group-hover:text-[#0071e3] transition-colors">{p.title}</h3>
                        <p class="text-[#86868b] text-sm leading-relaxed mb-6">{p.desc}</p>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-bold text-[#0071e3] group-hover:translate-x-1 transition-transform">
                        Explore Product <i class="fas fa-chevron-right text-[10px]"></i>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>
