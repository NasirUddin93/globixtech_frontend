---
import { Image } from "astro:assets";
import logo from "../../assets/logo.png";
---

<footer class="bg-[#f5f5f7] border-t border-gray-200/60 pt-16 pb-12 text-left">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 mb-12">
            <div class="space-y-4">
                <Image src={logo} alt="GlobixTech Logo" class="h-8 w-auto" />
                <p class="text-xs text-[#86868b] leading-relaxed">
                    Globix Tech provides high-performance POS, Inventory, and ERP systems for businesses across Bangladesh.
                </p>
            </div>

            <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-[#1d1d1f] mb-4">Solutions</h4>
                <ul class="space-y-2.5 text-xs text-[#86868b]">
                    <li><a href="/solutions/pos-system" class="hover:text-[#0071e3] transition-colors">POS System</a></li>
                    <li><a href="/solutions/inventory" class="hover:text-[#0071e3] transition-colors">Inventory Suite</a></li>
                    <li><a href="/solutions/erp-system" class="hover:text-[#0071e3] transition-colors">ERP System</a></li>
                    <li><a href="/solutions/school-management-system" class="hover:text-[#0071e3] transition-colors">School Management</a></li>
                </ul>
            </div>

            <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-[#1d1d1f] mb-4">Company</h4>
                <ul class="space-y-2.5 text-xs text-[#86868b]">
                    <li><a href="#about" class="hover:text-[#0071e3] transition-colors">About Us</a></li>
                    <li><a href="#rd-wing" class="hover:text-[#0071e3] transition-colors">R&D Lab</a></li>
                    <li><a href="#portfolio" class="hover:text-[#0071e3] transition-colors">Portfolio</a></li>
                    <li><a href="#contact" class="hover:text-[#0071e3] transition-colors">Contact</a></li>
                </ul>
            </div>

            <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-[#1d1d1f] mb-4">Dhaka HQ</h4>
                <p class="text-xs text-[#86868b] leading-relaxed">
                    Uttara, Dhaka, Bangladesh<br/>
                    Phone: +880 1707-568468<br/>
                    Email: info@globix.tech
                </p>
            </div>
        </div>

        <div class="pt-8 border-t border-gray-200/60 flex flex-col sm:flex-row items-center justify-between text-[11px] text-[#86868b]">
            <p>© {new Date().getFullYear()} Globix Tech Ltd. All rights reserved.</p>
            <p class="mt-2 sm:mt-0 font-medium">Apple-Inspired Glassmorphic Aesthetic</p>
        </div>
    </div>
</footer>
