---
import VideoBackground from "./VideoBackground.astro";
import Navbar from "../Navbar.astro";
---

<section id="home" class="relative pb-16 sm:pb-20 md:pb-32 overflow-hidden">
    <!-- Top-most Background Video with 100% Crisp Visibility & Edge Fade -->
    <div class="absolute inset-x-0 top-0 w-full h-[75%] overflow-hidden z-0 pointer-events-none"
         style="-webkit-mask-image: linear-gradient(to bottom, black 0%, black 35%, rgba(0,0,0,0.5) 65%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, black 35%, rgba(0,0,0,0.5) 65%, transparent 100%);">
        <video 
            id="hero-bg-video" 
            autoplay 
            loop 
            muted 
            playsinline 
            preload="auto" 
            class="w-full h-full object-cover scale-[1.01]"
            style="filter: blur(1px) contrast(1.12) brightness(1.04) saturate(1.15); image-rendering: -webkit-optimize-contrast; image-rendering: crisp-edges;"
        >
            <source src="/videos/Globix Tech Smooth.mp4" type="video/mp4" />
        </video>
    </div>

    <!-- Header Navbar inside Hero Container -->
    <Navbar />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10 pt-24 sm:pt-28 md:pt-32">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-center">
            
            <!-- Left Side Text & CTAs -->
            <div class="lg:col-span-6 space-y-5 sm:space-y-6 text-left">
                <!-- Hero Pill Tag -->
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/80 backdrop-blur-xl border border-white shadow-[0_4px_20px_rgba(0,0,0,0.03)] text-[11px] sm:text-xs font-semibold text-[#0071e3]">
                    <i class="fas fa-sparkles text-amber-500"></i> Built for High-Performance Bangladesh Enterprise
                </div>

                <!-- Typography Headline -->
                <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-[#1d1d1f] leading-[1.15]">
                    Software built with <br class="hidden sm:block"/>
                    <span class="bg-gradient-to-r from-[#0071e3] via-indigo-600 to-purple-600 bg-clip-text text-transparent">purity, power & speed.</span>
                </h1>

                <!-- Subheading -->
                <p class="text-sm sm:text-base md:text-xl text-[#1d1d1f] font-medium leading-relaxed">
                    Intelligent POS, Inventory, and Custom ERP platforms engineered to automate operations with seamless elegance.
                </p>

                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4 pt-2">
                    <a href="#contact" class="w-full sm:w-auto bg-[#0071e3] hover:bg-[#0077ed] text-white font-semibold text-sm md:text-base px-6 sm:px-7 py-3.5 rounded-full shadow-xl shadow-blue-500/25 hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-2">
                        Explore Solutions <i class="fas fa-arrow-right text-xs"></i>
                    </a>
                    <a href="#video-showcase" class="w-full sm:w-auto bg-white/80 hover:bg-white text-[#1d1d1f] font-semibold text-sm md:text-base px-6 sm:px-7 py-3.5 rounded-full border border-white shadow-lg shadow-gray-200/50 backdrop-blur-xl hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-2">
                        <i class="fas fa-play text-xs text-[#0071e3]"></i> Watch Experience Loop
                    </a>
                </div>
            </div>

            <!-- Right Side Interactive Video Showcase Container -->
            <div class="lg:col-span-6">
                <div class="relative w-full rounded-2xl sm:rounded-3xl p-2 sm:p-3 bg-white/50 backdrop-blur-2xl border border-white/80 shadow-[0_30px_100px_rgba(0,0,0,0.08)] group">
                    <!-- Glass Header Dots -->
                    <div class="flex items-center gap-2 px-3 sm:px-4 py-2 sm:py-3 border-b border-gray-100/50 bg-white/40 rounded-t-xl sm:rounded-t-2xl">
                        <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-rose-400"></div>
                        <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-amber-400"></div>
                        <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-emerald-400"></div>
                        <span class="text-[10px] sm:text-[11px] font-medium text-[#86868b] mx-auto tracking-wide truncate max-w-[200px] sm:max-w-none">Globix OS — Realtime POS & Analytics Suite</span>
                    </div>

                    <!-- Video Container Frame -->
                    <div class="relative overflow-hidden rounded-2xl bg-slate-900 aspect-video shadow-inner">
                        <video 
                            class="w-full h-full object-cover rounded-2xl opacity-95 group-hover:scale-105 transition-transform duration-700" 
                            autoplay 
                            loop 
                            muted 
                            playsinline
                        >
                            <source src="/videos/landing page/Cinematography_Fast_paced_k.mp4" type="video/mp4" />
                            Your browser does not support video preview.
                        </video>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
