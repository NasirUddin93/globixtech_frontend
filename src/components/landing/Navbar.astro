---
---

<header class="fixed top-0 inset-x-0 z-50 w-full px-4 sm:px-8 py-3 transition-all duration-300">
    <!-- Floating Glass Navigation Pill -->
    <nav class="max-w-7xl mx-auto bg-white/80 backdrop-blur-2xl border border-white/90 rounded-full shadow-[0_8px_32px_0_rgba(0,0,0,0.04)] px-6 py-3 flex items-center justify-between transition-all transform-gpu backface-hidden" style="-webkit-backdrop-filter: blur(40px);">
        <a href="/" class="flex items-center gap-2 group relative overflow-hidden rounded-2xl">
            <img src="/logo.png" alt="GlobixTech Logo" class="h-10 w-auto group-hover:scale-105 transition-transform" />
        </a>

        <!-- Desktop Links -->
        <div class="hidden lg:flex items-center gap-7 text-sm font-medium text-[#1d1d1f]">
            <a href="/" class="hover:text-[#0071e3] transition-colors">Home</a>

            <!-- Comprehensive Solutions Mega Dropdown -->
            <div class="relative group">
                <button class="flex items-center gap-1.5 hover:text-[#0071e3] transition-colors py-2 focus:outline-none">
                    Solutions <i class="fas fa-chevron-down text-[10px] text-[#86868b] group-hover:rotate-180 transition-transform"></i>
                </button>
                <div class="absolute top-full left-1/2 -translate-x-1/2 -mt-1 w-[780px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform group-hover:translate-y-0 translate-y-1 z-50 pointer-events-none group-hover:pointer-events-auto">
                    <div class="bg-white/95 backdrop-blur-3xl border border-white/90 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.12)] rounded-3xl p-6 grid grid-cols-3 gap-4">
                    
                    <!-- Column 1: Core Software Systems -->
                    <div class="space-y-1">
                        <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#86868b] px-3">Software Systems</span>
                        <a href="/solutions/pos-system" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-blue-50 flex items-center justify-center text-[#0071e3] text-xs"><i class="fas fa-cash-register"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">POS System</div>
                                <div class="text-[10px] text-[#86868b]">Retail & Checkout</div>
                            </div>
                        </a>
                        <a href="/solutions/inventory" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-purple-50 flex items-center justify-center text-purple-600 text-xs"><i class="fas fa-boxes"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">Inventory Control</div>
                                <div class="text-[10px] text-[#86868b]">Multi-warehouse</div>
                            </div>
                        </a>
                        <a href="/solutions/erp-system" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 text-xs"><i class="fas fa-th-large"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">Enterprise ERP</div>
                                <div class="text-[10px] text-[#86868b]">Finance & HR</div>
                            </div>
                        </a>
                        <a href="/solutions/school-management-system" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-xs"><i class="fas fa-graduation-cap"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">Education (SMS)</div>
                                <div class="text-[10px] text-[#86868b]">School Ecosystem</div>
                            </div>
                        </a>
                        <a href="/solutions/ecommerce" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-rose-50 flex items-center justify-center text-rose-500 text-xs"><i class="fas fa-shopping-cart"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">E-commerce</div>
                                <div class="text-[10px] text-[#86868b]">Multi-vendor retail</div>
                            </div>
                        </a>
                        <a href="/solutions/accounting" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600 text-xs"><i class="fas fa-calculator"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">Accounts & Finance</div>
                                <div class="text-[10px] text-[#86868b]">Ledger & Invoicing</div>
                            </div>
                        </a>
                    </div>

                    <!-- Column 2: Digital Apps & AI -->
                    <div class="space-y-1">
                        <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#86868b] px-3">Apps & AI</span>
                        <a href="/solutions/web-apps" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-cyan-50 flex items-center justify-center text-cyan-600 text-xs"><i class="fas fa-code"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">Web Apps</div>
                                <div class="text-[10px] text-[#86868b]">Custom portals</div>
                            </div>
                        </a>
                        <a href="/solutions/mobile-app-development" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-teal-50 flex items-center justify-center text-teal-600 text-xs"><i class="fas fa-mobile-alt"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">Mobile Apps</div>
                                <div class="text-[10px] text-[#86868b]">iOS & Android</div>
                            </div>
                        </a>
                        <a href="/solutions/business-ai" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-violet-50 flex items-center justify-center text-violet-600 text-xs"><i class="fas fa-robot"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">Business AI</div>
                                <div class="text-[10px] text-[#86868b]">LLMs & Agents</div>
                            </div>
                        </a>
                        <a href="/solutions/data-science" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-fuchsia-50 flex items-center justify-center text-fuchsia-600 text-xs"><i class="fas fa-chart-line"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">Data Science</div>
                                <div class="text-[10px] text-[#86868b]">Predictive Models</div>
                            </div>
                        </a>
                    </div>

                    <!-- Column 3: Infrastructure & Security -->
                    <div class="space-y-1">
                        <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#86868b] px-3">Infrastructure</span>
                        <a href="/solutions/server-management" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-slate-100 flex items-center justify-center text-slate-700 text-xs"><i class="fas fa-server"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">Server Mgmt</div>
                                <div class="text-[10px] text-[#86868b]">Linux & AWS Cloud</div>
                            </div>
                        </a>
                        <a href="/solutions/network" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-xs"><i class="fas fa-network-wired"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">Network Services</div>
                                <div class="text-[10px] text-[#86868b]">ISP & Mikrotik</div>
                            </div>
                        </a>
                        <a href="/solutions/security" class="flex items-center gap-3 p-2 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                            <div class="w-7 h-7 rounded-xl bg-red-50 flex items-center justify-center text-red-600 text-xs"><i class="fas fa-shield-halved"></i></div>
                            <div>
                                <div class="font-semibold text-xs text-[#1d1d1f]">Security & Audit</div>
                                <div class="text-[10px] text-[#86868b]">Pentesting</div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>

            <a href="/rd-wing" class="hover:text-[#0071e3] transition-colors">R&D Lab</a>
            <a href="/#featured-products" class="hover:text-[#0071e3] transition-colors">Products</a>
            <a href="/portfolio" class="hover:text-[#0071e3] transition-colors">Portfolio</a>
            <a href="/about" class="hover:text-[#0071e3] transition-colors">About Us</a>
            <a href="/blog" class="hover:text-[#0071e3] transition-colors">Blog</a>
            <a href="/contact" class="hover:text-[#0071e3] transition-colors">Contact</a>
        </div>

        <!-- Right Action Pill -->
        <div class="flex items-center gap-2 sm:gap-3">
            <a href="/login" class="text-xs font-semibold text-[#1d1d1f] hover:text-[#0071e3] px-3.5 py-2 rounded-full hover:bg-black/5 transition-all flex items-center gap-1.5">
                <i class="far fa-user-circle text-sm text-[#0071e3]"></i>
                <span>Login</span>
            </a>
            <a href="/contact" class="bg-[#0071e3] hover:bg-[#0077ed] text-white text-xs font-semibold px-5 py-2.5 rounded-full shadow-md shadow-blue-500/20 hover:shadow-lg hover:scale-[1.02] active:scale-95 transition-all">
                Get Free Demo
            </a>
            <button id="menu-btn" class="lg:hidden w-8 h-8 flex items-center justify-center rounded-full bg-[#f5f5f7] text-[#1d1d1f]">
                <i class="fas fa-bars text-sm"></i>
            </button>
        </div>
    </nav>
</header>
