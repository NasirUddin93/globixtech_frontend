---
import VideoBackground from "./VideoBackground.astro";
---

<section id="video-showcase" class="py-14 sm:py-20 lg:py-24 bg-[#f5f5f7] relative overflow-hidden">
    <!-- Transparent Background Video with White Overlay -->
    <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" overlay="light" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-[#0071e3] bg-blue-50 px-3.5 sm:px-4 py-1.5 rounded-full border border-blue-100">Live AI & Automation</span>
            <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-3 sm:mt-4 mb-3 sm:mb-6">
                Intelligent core. Effortless control.
            </h2>
            <p class="text-[#86868b] text-sm sm:text-base md:text-lg">
                Watch our POS and AI Inventory sync data across multiple physical stores in real time with zero latency.
            </p>
        </div>

        <!-- ATTRACTION VIDEO #2 CARD -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center bg-white/70 backdrop-blur-2xl border border-white rounded-2xl sm:rounded-[2.5rem] p-4 sm:p-6 lg:p-10 shadow-[0_20px_60px_rgba(0,0,0,0.03)]">
            <div class="lg:col-span-7 relative overflow-hidden rounded-2xl sm:rounded-3xl shadow-xl aspect-video bg-black group">
                <video 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-100" 
                    autoplay 
                    loop 
                    muted 
                    playsinline
                >
                    <source src="/videos/landing page/Cinematography_High_tempo_k.mp4" type="video/mp4">
                </video>
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
                <div class="absolute top-3 left-3 sm:top-4 sm:left-4 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full bg-black/50 backdrop-blur-md text-white text-[10px] sm:text-xs font-semibold flex items-center gap-2 border border-white/20 shadow-sm">
                    <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-red-500 animate-ping"></span> Live AI Feed
                </div>
            </div>

            <div class="lg:col-span-5 space-y-4 sm:space-y-6 lg:pl-6 text-left">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-blue-50 text-[#0071e3] flex items-center justify-center text-lg sm:text-xl font-bold">
                    <i class="fas fa-brain"></i>
                </div>
                <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-[#1d1d1f]">Predictive Inventory & Auto Reordering</h3>
                <p class="text-[#86868b] leading-relaxed text-xs sm:text-sm md:text-base">
                    Our machine learning algorithms analyze historical sales trends, alert you before stock-outs happen, and automatically generate purchase orders for suppliers.
                </p>
                <ul class="space-y-2 sm:space-y-3 pt-1 sm:pt-2 text-xs sm:text-sm text-[#1d1d1f]">
                    <li class="flex items-center gap-2.5 sm:gap-3"><i class="fas fa-check-circle text-[#0071e3]"></i> Automated stock level forecasting</li>
                    <li class="flex items-center gap-2.5 sm:gap-3"><i class="fas fa-check-circle text-[#0071e3]"></i> bKash, Nagad & Card payment sync</li>
                    <li class="flex items-center gap-2.5 sm:gap-3"><i class="fas fa-check-circle text-[#0071e3]"></i> Instant SMS invoice sending</li>
                </ul>
            </div>
        </div>
    </div>
</section>
