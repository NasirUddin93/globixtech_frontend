---
---
<section id="rd-wing" class="py-14 sm:py-20 lg:py-28 bg-[#f5f5f7] relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-center">
            <div class="lg:col-span-5 text-left space-y-4 sm:space-y-6">
                <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-indigo-600 bg-indigo-50 px-3.5 sm:px-4 py-1.5 rounded-full border border-indigo-100">R&D Innovation Hub</span>
                <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight">
                    Where deep tech meets academic science.
                </h2>
                <p class="text-[#86868b] leading-relaxed text-xs sm:text-sm md:text-base">
                    Our Research & Development center explores next-generation algorithm design, machine learning pipelines, and publishes peer-reviewed research papers in international journals.
                </p>

                <div class="space-y-3 sm:space-y-4 pt-2 sm:pt-4">
                    <div class="p-3.5 sm:p-4 rounded-xl sm:rounded-2xl bg-white/80 backdrop-blur-xl border border-white shadow-sm flex items-center gap-3 sm:gap-4">
                        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-sm sm:text-base"><i class="fas fa-file-alt"></i></div>
                        <div>
                            <h4 class="font-bold text-xs sm:text-sm text-[#1d1d1f]">Academic Publishing Assistance</h4>
                            <p class="text-[11px] sm:text-xs text-[#86868b]">Drafting & peer-reviewing technical journal papers.</p>
                        </div>
                    </div>
                    <div class="p-3.5 sm:p-4 rounded-xl sm:rounded-2xl bg-white/80 backdrop-blur-xl border border-white shadow-sm flex items-center gap-3 sm:gap-4">
                        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-blue-50 text-[#0071e3] flex items-center justify-center font-bold text-sm sm:text-base"><i class="fas fa-microchip"></i></div>
                        <div>
                            <h4 class="font-bold text-xs sm:text-sm text-[#1d1d1f]">Neural Business Automation</h4>
                            <p class="text-[11px] sm:text-xs text-[#86868b]">Smart predictive models tailored for localized commerce.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ATTRACTION VIDEO #3 CARD: R&D Video Loop -->
            <div class="lg:col-span-7">
                <div class="relative p-2 sm:p-3 rounded-2xl sm:rounded-[2.5rem] bg-white/60 backdrop-blur-2xl border border-white shadow-[0_20px_70px_rgba(0,0,0,0.04)]">
                    <div class="relative rounded-xl sm:rounded-3xl overflow-hidden aspect-video bg-black shadow-inner group">
                        <video 
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                            autoplay 
                            loop 
                            muted 
                            playsinline
                        >
                            <source src="/videos/landing page/Cinematography_Rapid_kineti.mp4" type="video/mp4">
                        </video>
                        <div class="absolute bottom-3 right-3 sm:bottom-6 sm:right-6 px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl sm:rounded-2xl bg-white/80 backdrop-blur-2xl border border-white text-left text-[10px] sm:text-xs text-[#1d1d1f] font-bold shadow-xl">
                            <i class="fas fa-flask text-indigo-600 mr-1.5 sm:mr-2"></i> R&D Paper Published 2026
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
