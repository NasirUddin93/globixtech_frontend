---
import VideoBackground from "./VideoBackground.astro";

const categories = [
    {
        id: "core-products",
        title: "Core Products",
        tag: "Software Engineering",
        icon: "fa-star",
        color: "text-[#0071e3]",
        bg: "bg-blue-50",
        services: [
            {
                name: "POS System",
                desc: "Lightning-fast checkout with multi-payment support, barcode scanning, and real-time inventory sync. Perfect for retail, restaurants, and pharmacies.",
                icon: "fa-cash-register",
                link: "/solutions/pos-system"
            },
            {
                name: "Inventory Management",
                desc: "Track stock in real-time across multiple locations. Automated reordering, barcode support, and comprehensive reporting.",
                icon: "fa-boxes",
                link: "/solutions/inventory"
            },
            {
                name: "E-commerce Solutions",
                desc: "Scalable multi-vendor marketplaces and custom retail platforms designed for high conversion.",
                icon: "fa-shopping-cart",
                link: "/solutions/ecommerce"
            },
            {
                name: "Education Software (SMS)",
                desc: "Comprehensive LMS and student management ecosystems tailored for modern institutions.",
                icon: "fa-graduation-cap",
                link: "/solutions/school-management-system"
            },
            {
                name: "Enterprise ERP System",
                desc: "Unified platform for finance, HR, inventory, and sales. Eliminate data silos and make smarter business decisions.",
                icon: "fa-th-large",
                link: "/solutions/erp-system"
            }
        ]
    },
    {
        id: "ai-data",
        title: "AI & Data Science",
        tag: "Deep Intelligence",
        icon: "fa-brain",
        color: "text-purple-600",
        bg: "bg-purple-50",
        services: [
            {
                name: "AI Business Assistants",
                desc: "Smart virtual assistants integrated into your ERP/CRM to analyze trends and suggest business actions.",
                icon: "fa-robot"
            },
            {
                name: "Data Science Solutions",
                desc: "Turning raw data into actionable insights through predictive analytics, visualization, and machine learning models.",
                icon: "fa-diagram-project"
            },
            {
                name: "Web Application Services",
                desc: "Bespoke web apps built on robust frameworks (React, Laravel, Python) to automate complex business workflows.",
                icon: "fa-code"
            }
        ]
    },
    {
        id: "infrastructure",
        title: "Infrastructure & Security",
        tag: "Enterprise Grade",
        icon: "fa-shield-halved",
        color: "text-emerald-600",
        bg: "bg-emerald-50",
        services: [
            {
                name: "Network Security Services",
                desc: "Advanced threat detection, firewall management, and penetration testing to protect your digital assets.",
                icon: "fa-user-shield"
            },
            {
                name: "Server Management",
                desc: "End-to-end Linux/Windows server administration, cloud migration (AWS/Azure), and 24/7 uptime monitoring.",
                icon: "fa-server"
            },
            {
                name: "Network Services",
                desc: "Design and implementation of scalable enterprise network architectures.",
                icon: "fa-network-wired"
            }
        ]
    }
];
---

<section id="services" class="py-14 sm:py-20 lg:py-24 bg-[#f5f5f7] relative overflow-hidden">
    <!-- Full Background Video Container (100% Full Height & Width) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <VideoBackground mp4="/videos/generated_video_july_24.mp4" overlay="light" />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-20">
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-[#0071e3] bg-blue-50 px-3.5 sm:px-4 py-1.5 rounded-full border border-blue-100">Industrial Ecosystem</span>
            <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-3 sm:mt-4 mb-3 sm:mb-6">
                Complete Suite of Solutions
            </h2>
            <p class="text-[#86868b] text-sm sm:text-base md:text-lg">
                Explore our full spectrum of software engineering, artificial intelligence, and infrastructure services.
            </p>
        </div>

        {categories.map((cat) => (
            <div id={cat.id} class="mb-12 sm:mb-20 last:mb-0">
                <div class="flex items-center gap-3 sm:gap-4 mb-5 sm:mb-8">
                    <div class={`w-10 h-10 sm:w-12 sm:h-12 ${cat.bg} rounded-xl sm:rounded-2xl flex items-center justify-center ${cat.color} text-lg sm:text-xl shadow-xs`}>
                        <i class={`fas ${cat.icon}`}></i>
                    </div>
                    <div>
                        <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-widest text-[#86868b]">{cat.tag}</span>
                        <h3 class="text-xl sm:text-2xl font-bold text-[#1d1d1f]">{cat.title}</h3>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                    {cat.services.map((service) => (
                        <div class="group bg-white/70 backdrop-blur-2xl border border-white/80 rounded-2xl sm:rounded-[2rem] p-6 sm:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
                            <div>
                                <div class={`w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl ${cat.bg} ${cat.color} flex items-center justify-center text-lg sm:text-xl mb-4 sm:mb-6 group-hover:scale-110 transition-transform duration-300`}>
                                    <i class={`fas ${service.icon}`}></i>
                                </div>
                                <h4 class="text-lg sm:text-xl font-bold text-[#1d1d1f] mb-2 sm:mb-3 group-hover:text-[#0071e3] transition-colors">{service.name}</h4>
                                <p class="text-[#86868b] text-xs sm:text-sm leading-relaxed mb-5 sm:mb-6">{service.desc}</p>
                            </div>
                            {service.link && (
                                <a href={service.link} class="flex items-center gap-2 text-xs font-bold text-[#0071e3] group-hover:translate-x-1 transition-transform">
                                    Learn More & View Modules <i class="fas fa-chevron-right text-[10px]"></i>
                                </a>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        ))}
    </div>
</section>
