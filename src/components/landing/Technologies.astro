---
import VideoBackground from "./VideoBackground.astro";

const techs = [
    { icon: "fa-react", color: "text-blue-400", name: "React", type: "fab" },
    { icon: "fa-node-js", color: "text-emerald-600", name: "Node.js", type: "fab" },
    { icon: "fa-python", color: "text-blue-500", name: "Python", type: "fab" },
    { icon: "fa-laravel", color: "text-red-500", name: "Laravel", type: "fab" },
    { icon: "fa-database", color: "text-indigo-600", name: "PostgreSQL", type: "fas" },
    { icon: "fa-docker", color: "text-blue-600", name: "Docker", type: "fab" },
    { icon: "fa-aws", color: "text-amber-500", name: "AWS Cloud", type: "fab" },
    { icon: "fa-js-square", color: "text-yellow-500", name: "TypeScript", type: "fab" },
    { icon: "fa-vuejs", color: "text-emerald-500", name: "Vue.js", type: "fab" },
    { icon: "fa-git-alt", color: "text-orange-600", name: "Git", type: "fab" },
    { icon: "fa-bolt", color: "text-amber-400", name: "REST / GraphQL", type: "fas" },
    { icon: "fa-shield-halved", color: "text-cyan-500", name: "CyberSecurity", type: "fas" }
];
---

<section id="technologies" class="py-14 sm:py-20 lg:py-24 bg-[#f5f5f7] relative overflow-hidden">
    <!-- Transparent Background Video with White Overlay & Soft Faded Borders -->
    <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" overlay="light" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-[#0071e3]">Engineering Stack</span>
            <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-2 sm:mt-3 mb-3 sm:mb-4">
                Powered by Modern Core Technologies
            </h2>
            <p class="text-[#86868b] text-xs sm:text-sm md:text-base">
                We leverage rock-solid frameworks to build lightning-fast, high-availability software ecosystems.
            </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-6">
            {techs.map((tech) => (
                <div class="group bg-white/70 backdrop-blur-2xl border border-white/80 rounded-2xl sm:rounded-[2rem] p-4 sm:p-6 text-center shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.05)] hover:-translate-y-1.5 transition-all duration-300">
                    <i class={`${tech.type} ${tech.icon} text-3xl sm:text-4xl ${tech.color} mb-2 sm:mb-3 group-hover:scale-110 transition-transform duration-300`}></i>
                    <div class="font-bold text-[11px] sm:text-xs text-[#1d1d1f]">{tech.name}</div>
                </div>
            ))}
        </div>
    </div>
</section>
