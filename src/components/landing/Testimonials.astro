---
import VideoBackground from "./VideoBackground.astro";

const testimonials = [
    {
        name: "Md. Kamal Hossain",
        role: "Principal, Dhaka International School",
        content: "GlobixTech's School Management System reduced our administrative workload by 60%. The team understood our needs perfectly and delivered a solution that works seamlessly for our 2,000+ students.",
    },
    {
        name: "Fatima Rahman",
        role: "CEO, ShopBD E-commerce",
        content: "Our online sales increased by 45% within 3 months of launching the e-commerce platform built by GlobixTech. Their support team is always responsive and helpful.",
    },
    {
        name: "Ahmed Iqbal",
        role: "Director, TechFlow Solutions Ltd.",
        content: "Professional team with excellent technical expertise. They delivered our custom ERP system on time and within budget. Highly recommended for any enterprise looking for reliable software solutions in Bangladesh.",
    },
];
---

<section id="testimonials" class="py-14 sm:py-20 lg:py-24 bg-[#f5f5f7] relative overflow-hidden">
    <!-- Transparent Background Video with White Overlay & Soft Faded Borders -->
    <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" overlay="light" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-[#0071e3]">Client Endorsements</span>
            <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-2 sm:mt-3 mb-3 sm:mb-4">
                Trusted by Leaders Across Bangladesh
            </h2>
            <p class="text-[#86868b] text-xs sm:text-sm md:text-base">
                Delivering exceptional engineering and building long-term digital partnerships.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-8">
            {testimonials.map((t) => (
                <div class="bg-white/70 backdrop-blur-2xl border border-white/80 rounded-2xl sm:rounded-[2.5rem] p-6 sm:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.05)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <div class="flex gap-1 text-amber-400 mb-6 text-sm">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                        </div>
                        <p class="text-[#1d1d1f] text-sm leading-relaxed italic mb-8">
                            "{t.content}"
                        </p>
                    </div>

                    <div class="flex items-center gap-4 pt-4 border-t border-gray-100">
                        <div class="w-11 h-11 bg-[#0071e3]/10 text-[#0071e3] rounded-full flex items-center justify-center font-bold text-sm">
                            {t.name.charAt(0)}
                        </div>
                        <div>
                            <h4 class="font-bold text-sm text-[#1d1d1f]">{t.name}</h4>
                            <p class="text-xs text-[#86868b]">{t.role}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
