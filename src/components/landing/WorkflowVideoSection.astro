<section id="workflow-showcase" class="py-14 sm:py-20 lg:py-24 bg-[#fbfbfd]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-emerald-600 bg-emerald-50 px-3.5 sm:px-4 py-1.5 rounded-full border border-emerald-100">Unified Architecture</span>
            <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-3 sm:mt-4 mb-3 sm:mb-6">
                Connected workflow across every department.
            </h2>
            <p class="text-[#86868b] text-xs sm:text-sm md:text-base">
                Synchronize your Point of Sale, E-commerce, Inventory, and Accounting into one unified visual engine.
            </p>
        </div>

        <!-- ATTRACTION VIDEO #4 CARD -->
        <div class="relative max-w-5xl mx-auto p-2 sm:p-4 rounded-2xl sm:rounded-[2.5rem] bg-gradient-to-b from-white/80 to-white/40 backdrop-blur-2xl border border-white shadow-[0_30px_90px_rgba(0,0,0,0.05)]">
            <div class="relative rounded-xl sm:rounded-2xl overflow-hidden aspect-video bg-slate-900 group">
                <video 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                    autoplay 
                    loop 
                    muted 
                    playsinline
                >
                    <source src="/videos/Globix Tech Smooth.mp4" type="video/mp4">
                </video>
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
                <div class="absolute bottom-3 left-3 right-3 sm:bottom-8 sm:left-8 sm:right-8 flex flex-col md:flex-row items-start md:items-center justify-between text-white gap-2 sm:gap-4">
                    <div>
                        <div class="text-[10px] sm:text-xs uppercase tracking-widest text-emerald-400 font-bold mb-0.5 sm:mb-1">Ecosystem Live Status</div>
                        <div class="text-sm sm:text-xl md:text-2xl font-bold">80+ Bangladesh Enterprises Online</div>
                    </div>
                    <a href="#contact" class="w-full md:w-auto text-center mt-1 md:mt-0 bg-white text-[#1d1d1f] hover:bg-gray-100 font-bold text-xs px-5 sm:px-6 py-2.5 sm:py-3 rounded-full shadow-lg transition-all">
                        Schedule Enterprise Consultation
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
