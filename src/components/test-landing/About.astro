---
---
<section id="about" class="py-24 bg-[#f5f5f7]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-6 space-y-6 text-left">
                <span class="text-xs font-bold uppercase tracking-widest text-[#0071e3]">Our Story & Mission</span>
                <h2 class="text-3xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight">
                    Architecting the future of software in Bangladesh.
                </h2>
                <p class="text-[#86868b] text-base leading-relaxed">
                    Globix Tech is a premier Bangladesh IT and software engineering firm based in Uttara, Dhaka. We specialize in high-performance POS platforms, intelligent inventory ecosystems, enterprise ERP systems, and custom web applications.
                </p>
                <p class="text-[#86868b] text-base leading-relaxed">
                    Our mission is to create weightless, reliable, and scalable software that empowers local businesses to operate with enterprise efficiency.
                </p>

                <div class="grid grid-cols-3 gap-4 pt-4 border-t border-gray-200">
                    <div class="bg-white/60 backdrop-blur-xl p-4 rounded-2xl border border-white">
                        <div class="text-2xl font-extrabold text-[#0071e3]">100+</div>
                        <div class="text-xs text-[#86868b] font-medium">Projects Done</div>
                    </div>
                    <div class="bg-white/60 backdrop-blur-xl p-4 rounded-2xl border border-white">
                        <div class="text-2xl font-extrabold text-[#0071e3]">80+</div>
                        <div class="text-xs text-[#86868b] font-medium">Happy Clients</div>
                    </div>
                    <div class="bg-white/60 backdrop-blur-xl p-4 rounded-2xl border border-white">
                        <div class="text-2xl font-extrabold text-[#0071e3]">5+</div>
                        <div class="text-xs text-[#86868b] font-medium">Years Experience</div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-6">
                <div class="bg-white/80 backdrop-blur-2xl border border-white rounded-[2.5rem] p-8 md:p-10 shadow-[0_20px_60px_rgba(0,0,0,0.03)] text-left">
                    <h3 class="text-2xl font-bold text-[#1d1d1f] mb-4 pb-2 border-b border-gray-100">Our Vision & Core Principles</h3>
                    <p class="text-[#86868b] text-sm leading-relaxed mb-6">
                        To stand as the leading software innovation hub in Bangladesh, recognized globally for engineering elegance, rock-solid security, and client commitment.
                    </p>

                    <div class="space-y-3">
                        {[
                            "Customer-Centric Architecture",
                            "Continuous Innovation & Research",
                            "Uncompromising Integrity & Security",
                            "Dedicated Local Developer Support"
                        ].map((val) => (
                            <div class="flex items-center gap-3 text-sm font-semibold text-[#1d1d1f]">
                                <div class="w-6 h-6 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs"><i class="fas fa-check"></i></div>
                                <span>{val}</span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
