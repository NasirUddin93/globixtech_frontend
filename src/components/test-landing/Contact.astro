---
---
<section id="contact" class="py-28 bg-[#f5f5f7]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-4xl mx-auto bg-white/80 backdrop-blur-2xl border border-white rounded-[2.5rem] p-8 md:p-14 shadow-[0_20px_60px_rgba(0,0,0,0.03)] text-left">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <span class="text-xs font-bold uppercase tracking-widest text-[#0071e3]">Get Started</span>
                <h2 class="text-3xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-3 mb-4">Request a Live System Demo</h2>
                <p class="text-[#86868b] text-sm md:text-base">Talk to our software engineers in Uttara, Dhaka to plan your digital transformation.</p>
            </div>

            <form id="contact-form" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-[#1d1d1f] uppercase tracking-wider mb-2">Full Name</label>
                        <input type="text" name="name" required placeholder="Your Name" class="w-full px-5 py-4 rounded-2xl bg-[#f5f5f7] border border-transparent focus:border-[#0071e3] focus:bg-white outline-none transition-all text-sm font-medium" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#1d1d1f] uppercase tracking-wider mb-2">Phone Number</label>
                        <input type="tel" name="phone" placeholder="+880 1XXX-XXXXXX" class="w-full px-5 py-4 rounded-2xl bg-[#f5f5f7] border border-transparent focus:border-[#0071e3] focus:bg-white outline-none transition-all text-sm font-medium" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-[#1d1d1f] uppercase tracking-wider mb-2">Email Address</label>
                        <input type="email" name="email" required placeholder="name@company.com" class="w-full px-5 py-4 rounded-2xl bg-[#f5f5f7] border border-transparent focus:border-[#0071e3] focus:bg-white outline-none transition-all text-sm font-medium" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[#1d1d1f] uppercase tracking-wider mb-2">Software Solution</label>
                        <select name="service" class="w-full px-5 py-4 rounded-2xl bg-[#f5f5f7] border border-transparent focus:border-[#0071e3] focus:bg-white outline-none transition-all text-sm font-medium">
                            <option value="pos">POS System</option>
                            <option value="inventory">Inventory Management</option>
                            <option value="erp">ERP System</option>
                            <option value="education">School Management System</option>
                            <option value="custom">Custom Software Solution</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-[#1d1d1f] uppercase tracking-wider mb-2">Project Brief</label>
                    <textarea name="message" rows="4" required placeholder="Tell us about your business goals..." class="w-full px-5 py-4 rounded-2xl bg-[#f5f5f7] border border-transparent focus:border-[#0071e3] focus:bg-white outline-none transition-all text-sm font-medium resize-none"></textarea>
                </div>

                <button type="submit" class="w-full bg-[#0071e3] hover:bg-[#0077ed] text-white font-bold py-4 rounded-2xl shadow-xl shadow-blue-500/20 hover:scale-[1.01] active:scale-95 transition-all text-base">
                    Submit Request &rarr;
                </button>
            </form>
        </div>
    </div>
</section>
