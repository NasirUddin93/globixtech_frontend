---
import VideoBackground from "./VideoBackground.astro";
---

<section id="home" class="relative pt-12 pb-24 md:pt-20 md:pb-36 overflow-hidden">
    <!-- Transparent Overlay Background Video for Hero Section -->
    <VideoBackground mp4="/videos/test-hero.mp4" overlay="light" />

    <div class="max-w-7xl mx-auto px-6 text-center relative z-10">
        <!-- Hero Pill Tag -->
        <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-white/80 backdrop-blur-xl border border-white shadow-[0_4px_20px_rgba(0,0,0,0.03)] text-xs font-semibold text-[#0071e3] mb-8">
            <i class="fas fa-sparkles text-amber-500"></i> Built for High-Performance Bangladesh Enterprise
        </div>

        <!-- Typography Headline -->
        <h1 class="text-4xl md:text-7xl lg:text-8xl font-extrabold tracking-tight text-[#1d1d1f] max-w-5xl mx-auto leading-[1.08] mb-8">
            Software built with <br class="hidden sm:block"/>
            <span class="bg-gradient-to-r from-[#0071e3] via-indigo-600 to-purple-600 bg-clip-text text-transparent">purity, power & speed.</span>
        </h1>

        <!-- Subheading -->
        <p class="text-lg md:text-2xl text-[#86868b] max-w-3xl mx-auto font-normal leading-relaxed mb-10">
            Intelligent POS, Inventory, and Custom ERP platforms engineered to automate operations with seamless elegance.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
            <a href="#contact" class="w-full sm:w-auto bg-[#0071e3] hover:bg-[#0077ed] text-white font-semibold text-base px-8 py-4 rounded-full shadow-xl shadow-blue-500/25 hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-2">
                Explore Solutions <i class="fas fa-arrow-right text-xs"></i>
            </a>
            <a href="#video-showcase" class="w-full sm:w-auto bg-white/80 hover:bg-white text-[#1d1d1f] font-semibold text-base px-8 py-4 rounded-full border border-white shadow-lg shadow-gray-200/50 backdrop-blur-xl hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-2">
                <i class="fas fa-play text-xs text-[#0071e3]"></i> Watch Experience Loop
            </a>
        </div>

        <!-- ATTRACTION VIDEO #1: Interactive System Showcase (Apple Device Mockup) -->
        <div class="relative max-w-5xl mx-auto rounded-3xl p-3 bg-white/50 backdrop-blur-2xl border border-white/80 shadow-[0_30px_100px_rgba(0,0,0,0.08)] group">
            <!-- Glass Header Dots -->
            <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-100/50 bg-white/40 rounded-t-2xl">
                <div class="w-3 h-3 rounded-full bg-rose-400"></div>
                <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                <span class="text-[11px] font-medium text-[#86868b] mx-auto tracking-wide">Globix OS — Realtime POS & Analytics Suite</span>
            </div>

            <!-- Video Container -->
            <div class="relative overflow-hidden rounded-2xl bg-slate-900 aspect-video shadow-inner">
                <video 
                    class="w-full h-full object-cover rounded-2xl opacity-95 group-hover:scale-105 transition-transform duration-700" 
                    autoplay 
                    loop 
                    muted 
                    playsinline
                >
                    <source src="/videos/test-hero.mp4" type="video/mp4" />
                    Your browser does not support video preview.
                </video>

                <!-- Overlay Glass Metrics Floating Badge -->
                <div class="absolute bottom-6 left-6 p-4 rounded-2xl bg-white/80 backdrop-blur-2xl border border-white/90 shadow-2xl text-left hidden sm:block">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center font-bold text-lg">
                            <i class="fas fa-bolt"></i>
                        </div>
                        <div>
                            <div class="text-xs text-[#86868b] font-medium">Checkout Speed</div>
                            <div class="text-lg font-bold text-[#1d1d1f]">0.4s / Transaction</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
