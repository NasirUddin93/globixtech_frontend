---
import { Image } from "astro:assets";
import logo from "../../assets/logo.png";
---

<header class="sticky top-0 z-50 w-full px-4 sm:px-8 py-3 transition-all duration-300">
    <!-- Top Announcement Bar -->
    <div class="max-w-7xl mx-auto mb-2 text-center hidden md:block">
        <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-white/60 backdrop-blur-md border border-white/80 shadow-xs text-xs text-[#86868b]">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="font-medium text-[#1d1d1f]">GlobixTech v4.0</span> Next-Gen Software Suite Live in Bangladesh
            <a href="#contact" class="text-[#0071e3] hover:underline font-semibold ml-1">Learn more &rarr;</a>
        </div>
    </div>

    <!-- Floating Glass Navigation Pill -->
    <nav class="max-w-7xl mx-auto bg-white/70 backdrop-blur-2xl border border-white/80 rounded-full shadow-[0_8px_32px_0_rgba(0,0,0,0.04)] px-6 py-3 flex items-center justify-between transition-all">
        <a href="/test-landing" class="flex items-center gap-2 group">
            <Image src={logo} alt="GlobixTech Logo" class="h-8 w-auto group-hover:scale-105 transition-transform" />
        </a>

        <!-- Desktop Links -->
        <div class="hidden lg:flex items-center gap-8 text-sm font-medium text-[#1d1d1f]">
            <a href="/test-landing" class="hover:text-[#0071e3] transition-colors">Home</a>

            <!-- Software Dropdown -->
            <div class="relative group">
                <button class="flex items-center gap-1.5 hover:text-[#0071e3] transition-colors py-2 focus:outline-none">
                    Solutions <i class="fas fa-chevron-down text-[10px] text-[#86868b] group-hover:rotate-180 transition-transform"></i>
                </button>
                <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-72 bg-white/90 backdrop-blur-2xl border border-white/90 shadow-[0_20px_40px_rgba(0,0,0,0.08)] rounded-3xl p-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform group-hover:translate-y-0 translate-y-2">
                    <a href="/solutions/pos-system" class="flex items-center gap-3 p-2.5 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                        <div class="w-8 h-8 rounded-xl bg-blue-50 flex items-center justify-center text-[#0071e3]"><i class="fas fa-cash-register text-xs"></i></div>
                        <div>
                            <div class="font-semibold text-xs text-[#1d1d1f]">POS System</div>
                            <div class="text-[11px] text-[#86868b]">Retail & Restaurant checkout</div>
                        </div>
                    </a>
                    <a href="/solutions/inventory" class="flex items-center gap-3 p-2.5 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                        <div class="w-8 h-8 rounded-xl bg-purple-50 flex items-center justify-center text-purple-600"><i class="fas fa-boxes text-xs"></i></div>
                        <div>
                            <div class="font-semibold text-xs text-[#1d1d1f]">Inventory Control</div>
                            <div class="text-[11px] text-[#86868b]">Multi-warehouse tracking</div>
                        </div>
                    </a>
                    <a href="/solutions/erp-system" class="flex items-center gap-3 p-2.5 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                        <div class="w-8 h-8 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600"><i class="fas fa-th-large text-xs"></i></div>
                        <div>
                            <div class="font-semibold text-xs text-[#1d1d1f]">Enterprise ERP</div>
                            <div class="text-[11px] text-[#86868b]">Accounts, HR & Operations</div>
                        </div>
                    </a>
                    <a href="/solutions/school-management-system" class="flex items-center gap-3 p-2.5 rounded-2xl hover:bg-[#f5f5f7] transition-colors">
                        <div class="w-8 h-8 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600"><i class="fas fa-graduation-cap text-xs"></i></div>
                        <div>
                            <div class="font-semibold text-xs text-[#1d1d1f]">Education (SMS)</div>
                            <div class="text-[11px] text-[#86868b]">School management platform</div>
                        </div>
                    </a>
                </div>
            </div>

            <a href="#rd-wing" class="hover:text-[#0071e3] transition-colors">R&D Lab</a>
            <a href="#featured-products" class="hover:text-[#0071e3] transition-colors">Products</a>
            <a href="#workflow-showcase" class="hover:text-[#0071e3] transition-colors">Ecosystem</a>
            <a href="#contact" class="hover:text-[#0071e3] transition-colors">Contact</a>
        </div>

        <!-- Right Action Pill -->
        <div class="flex items-center gap-3">
            <a href="#contact" class="bg-[#0071e3] hover:bg-[#0077ed] text-white text-xs font-semibold px-5 py-2.5 rounded-full shadow-md shadow-blue-500/20 hover:shadow-lg hover:scale-[1.02] active:scale-95 transition-all">
                Get Free Demo
            </a>
            <button id="menu-btn" class="lg:hidden w-8 h-8 flex items-center justify-center rounded-full bg-[#f5f5f7] text-[#1d1d1f]">
                <i class="fas fa-bars text-sm"></i>
            </button>
        </div>
    </nav>
</header>
