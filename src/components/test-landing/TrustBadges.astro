---
const badges = [
    { icon: "fa-award", value: "5+", label: "Years of Excellence", color: "text-[#0071e3]", bg: "bg-blue-50" },
    { icon: "fa-users", value: "80+", label: "Happy Clients", color: "text-emerald-600", bg: "bg-emerald-50" },
    { icon: "fa-map-marker-alt", value: "100%", label: "Bangladesh Based", color: "text-purple-600", bg: "bg-purple-50" },
    { icon: "fa-shield-alt", value: "Secure", label: "& Reliable", color: "text-amber-600", bg: "bg-amber-50" },
];
---

<section class="py-12 bg-[#fbfbfd] relative">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            {badges.map((badge) => (
                <div class="bg-white/70 backdrop-blur-2xl border border-white/80 rounded-[2rem] p-6 text-center shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.05)] hover:-translate-y-1 transition-all duration-300 flex flex-col items-center">
                    <div class={`w-14 h-14 ${badge.bg} rounded-2xl flex items-center justify-center ${badge.color} text-2xl mb-4 shadow-sm`}>
                        <i class={`fas ${badge.icon}`}></i>
                    </div>
                    <div class="text-2xl md:text-3xl font-extrabold text-[#1d1d1f] mb-1">{badge.value}</div>
                    <div class="text-xs font-semibold text-[#86868b]">{badge.label}</div>
                </div>
            ))}
        </div>
    </div>
</section>
