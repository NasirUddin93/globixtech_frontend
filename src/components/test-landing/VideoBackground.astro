---
interface Props {
  mp4?: string;
  webm?: string;
  poster?: string;
  overlay?: "light" | "dark" | "none";
  class?: string;
}

const {
  mp4 = "/videos/test-hero.mp4",
  webm,
  poster,
  overlay = "light",
  class: className = "",
} = Astro.props;
---

<div class={`absolute inset-0 overflow-hidden z-0 pointer-events-none ${className}`}>
  <video
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={poster}
    class="w-full h-full object-cover scale-105"
  >
    {webm && <source src={webm} type="video/webm" />}
    {mp4 && <source src={mp4} type="video/mp4" />}
  </video>
  
  {overlay === "light" && (
    <div class="absolute inset-0 bg-gradient-to-b from-white/30 via-white/55 to-white/80 backdrop-blur-[1px]"></div>
  )}
  
  {overlay === "dark" && (
    <div class="absolute inset-0 bg-gradient-to-b from-[#0f172a]/40 via-[#0f172a]/65 to-[#0f172a]/90 backdrop-blur-[1px]"></div>
  )}
</div>
