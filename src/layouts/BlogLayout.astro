---
import MainLayout from "./MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const { title, description, publishDate, author, image } = Astro.props;
---

<MainLayout title={title}>
    <Navbar />
    <div class="py-24 bg-gray-50 min-h-screen">
        <div class="container mx-auto px-6 max-w-4xl">
            <!-- Article Header -->
            <div class="mb-12 text-center">
                <div
                    class="flex items-center justify-center gap-4 text-sm text-gray-500 mb-6"
                >
                    <span
                        class="bg-blue-100 text-blue-600 px-3 py-1 rounded-full font-medium"
                        >Blog</span
                    >
                    <span>&bull;</span>
                    <time>{publishDate}</time>
                </div>
                <h1
                    class="text-3xl md:text-5xl font-extrabold text-[#0c1b3d] mb-6 leading-tight"
                >
                    {title}
                </h1>
                {
                    description && (
                        <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
                            {description}
                        </p>
                    )
                }
                <div class="flex items-center justify-center gap-3">
                    <div
                        class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-gray-500"
                    >
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="text-left">
                        <p class="font-bold text-[#0c1b3d] text-sm">
                            {author || "GlobixTech Team"}
                        </p>
                        <p class="text-xs text-gray-500">Editor</p>
                    </div>
                </div>
            </div>

            <!-- Featured Image -->
            {
                image && (
                    <div class="rounded-3xl overflow-hidden shadow-2xl mb-12 border border-gray-100">
                        <img
                            src={image}
                            alt={title}
                            class="w-full h-auto object-cover"
                        />
                    </div>
                )
            }

            <!-- Content -->
            <article
                class="prose prose-lg prose-blue mx-auto bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-gray-100"
            >
                <slot />
            </article>

            <!-- Back Link -->
            <div class="mt-12 text-center">
                <a
                    href="/blog"
                    class="inline-flex items-center gap-2 text-gray-600 hover:text-blue-600 font-bold transition-colors"
                >
                    <i class="fas fa-arrow-left"></i> Back to Blog
                </a>
            </div>
        </div>
    </div>
    <Footer />
</MainLayout>
