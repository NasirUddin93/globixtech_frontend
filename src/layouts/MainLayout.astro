---
import "../styles/global.css";
import SEO from "../components/SEO.astro";

import BackToTop from "../components/BackToTop.astro";

const { title = "Globix Tech - Software Solutions" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<SEO title={title} />
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
		/>
		<script is:inline>
			// Theme Checking Logic (Run immediately)
			const theme = (() => {
				if (
					typeof localStorage !== "undefined" &&
					localStorage.getItem("theme")
				) {
					return localStorage.getItem("theme");
				}
				if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					return "dark";
				}
				return "light";
			})();

			if (theme === "dark") {
				document.documentElement.classList.add("dark");
			} else {
				document.documentElement.classList.remove("dark");
			}
		</script>
	</head>
	<body
		class="font-poppins bg-light text-dark dark:bg-[#0f172a] dark:text-white transition-colors duration-300"
	>
		<slot />
		<BackToTop />

		<!-- Fast-to-Slow Number Counter Script -->
		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const easeOutExpo = (t: number): number => {
					return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
				};

				const animateCounter = (el: HTMLElement) => {
					const targetStr = el.getAttribute("data-counter") || el.innerText.trim();
					// Matches patterns like "500+", "50k+", "99.9%", "1000+", "10k+", "99.9%+"
					const match = targetStr.match(/^([^\d]*)([\d\.,]+)([a-zA-Z]*[\+%]*)$/);
					if (!match) return;

					const prefix = match[1] || "";
					const numericVal = parseFloat(match[2].replace(/,/g, ""));
					const suffix = match[3] || "";
					if (isNaN(numericVal)) return;

					const hasDecimals = match[2].includes(".");
					const duration = 5000; // 5 seconds overall
					const startTime = performance.now();

					const updateCounter = (now: number) => {
						const elapsed = now - startTime;
						const progress = Math.min(elapsed / duration, 1);
						const easedProgress = easeOutExpo(progress);
						const currentVal = easedProgress * numericVal;

						const isSmallInt = !hasDecimals && numericVal < 10;
						let formattedVal: string;
						if (hasDecimals) {
							formattedVal = currentVal.toFixed(1);
						} else if (isSmallInt && progress < 1) {
							formattedVal = currentVal.toFixed(1);
						} else {
							formattedVal = Math.floor(currentVal).toString();
						}

						el.innerText = `${prefix}${formattedVal}${suffix}`;

						if (progress < 1) {
							requestAnimationFrame(updateCounter);
						} else {
							el.innerText = targetStr;
						}
					};

					requestAnimationFrame(updateCounter);
				};

				const initCounters = () => {
					const elements = Array.from(
						document.querySelectorAll("[data-counter]")
					) as HTMLElement[];

					document.querySelectorAll("div, h2, h3, h4, span, p").forEach((node) => {
						const el = node as HTMLElement;
						if (el.children.length === 0 && !el.hasAttribute("data-counter")) {
							const text = el.innerText.trim();
							// Catch stat digits like 500+, 50k+, 1000+, 99.9%
							if (/^[^\d]*[\d\.,]+[a-zA-Z]*[\+%]*$/.test(text) && /\d/.test(text) && text.length <= 12) {
								el.setAttribute("data-counter", text);
								elements.push(el);
							}
						}
					});

					const observer = new IntersectionObserver(
						(entries, obs) => {
							entries.forEach((entry) => {
								if (entry.isIntersecting) {
									animateCounter(entry.target as HTMLElement);
									obs.unobserve(entry.target);
								}
							});
						},
						{ threshold: 0.15 }
					);

					elements.forEach((el) => observer.observe(el));
				};

				initCounters();
			});
		</script>
	</body>
</html>
