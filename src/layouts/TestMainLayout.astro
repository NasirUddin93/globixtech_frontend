---
import "../styles/global.css";
import SEO from "../components/landing/SEO.astro";
import BackToTop from "../components/landing/BackToTop.astro";

const { title = "Test Landing Page - Globix Tech" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<SEO title={title} />
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body
		class="font-['Plus_Jakarta_Sans',sans-serif] bg-[#fbfbfd] text-[#1d1d1f] antialiased selection:bg-[#0071e3]/10 selection:text-[#0071e3] overflow-x-hidden min-h-[100dvh]"
	>
		<!-- Apple Glass Background Blur Gradients -->
		<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
			<div class="absolute -top-[20%] -left-[10%] w-[80vw] sm:w-[50vw] h-[80vw] sm:h-[50vw] bg-gradient-to-br from-blue-200/20 sm:from-blue-200/30 to-purple-200/10 sm:to-purple-200/20 rounded-full blur-[70px] sm:blur-[120px]"></div>
			<div class="absolute top-[40%] -right-[10%] w-[75vw] sm:w-[45vw] h-[75vw] sm:h-[45vw] bg-gradient-to-br from-sky-200/20 sm:from-sky-200/30 to-indigo-100/10 sm:to-indigo-100/20 rounded-full blur-[80px] sm:blur-[140px]"></div>
			<div class="absolute -bottom-[10%] left-[20%] w-[70vw] sm:w-[40vw] h-[70vw] sm:h-[40vw] bg-gradient-to-tr from-blue-100/30 sm:from-blue-100/40 to-emerald-100/20 sm:to-emerald-100/30 rounded-full blur-[75px] sm:blur-[130px]"></div>
		</div>

		<div class="relative z-10">
			<slot />
		</div>

		<BackToTop />

		<!-- Fast-to-Slow Number Counter Script -->
		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const easeOutExpo = (t: number): number => {
					return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
				};

				const animateCounter = (el: HTMLElement) => {
					const targetStr = el.getAttribute("data-counter") || el.innerText.trim();
					// Matches patterns like "500+", "50k+", "99.9%", "1000+", "10k+", "99.9%+"
					const match = targetStr.match(/^([^\d]*)([\d\.,]+)([a-zA-Z]*[\+%]*)$/);
					if (!match) return;

					const prefix = match[1] || "";
					const numericVal = parseFloat(match[2].replace(/,/g, ""));
					const suffix = match[3] || "";
					if (isNaN(numericVal)) return;

					const hasDecimals = match[2].includes(".");
					const duration = 5000; // 5 seconds overall
					const startTime = performance.now();

					const updateCounter = (now: number) => {
						const elapsed = now - startTime;
						const progress = Math.min(elapsed / duration, 1);
						const easedProgress = easeOutExpo(progress);
						const currentVal = easedProgress * numericVal;

						const isSmallInt = !hasDecimals && numericVal < 10;
						let formattedVal: string;
						if (hasDecimals) {
							formattedVal = currentVal.toFixed(1);
						} else if (isSmallInt && progress < 1) {
							formattedVal = currentVal.toFixed(1);
						} else {
							formattedVal = Math.floor(currentVal).toString();
						}

						el.innerText = `${prefix}${formattedVal}${suffix}`;

						if (progress < 1) {
							requestAnimationFrame(updateCounter);
						} else {
							el.innerText = targetStr;
						}
					};

					requestAnimationFrame(updateCounter);
				};

				const initCounters = () => {
					const elements = Array.from(
						document.querySelectorAll("[data-counter]")
					) as HTMLElement[];

					document.querySelectorAll("div, h2, h3, h4, span, p").forEach((node) => {
						const el = node as HTMLElement;
						if (el.children.length === 0 && !el.hasAttribute("data-counter")) {
							const text = el.innerText.trim();
							// Catch stat digits like 500+, 50k+, 1000+, 99.9%
							if (/^[^\d]*[\d\.,]+[a-zA-Z]*[\+%]*$/.test(text) && /\d/.test(text) && text.length <= 12) {
								el.setAttribute("data-counter", text);
								elements.push(el);
							}
						}
					});

					const observer = new IntersectionObserver(
						(entries, obs) => {
							entries.forEach((entry) => {
								if (entry.isIntersecting) {
									animateCounter(entry.target as HTMLElement);
									obs.unobserve(entry.target);
								}
							});
						},
						{ threshold: 0.15 }
					);

					elements.forEach((el) => observer.observe(el));
				};

				initCounters();
			});
		</script>
	</body>
</html>
