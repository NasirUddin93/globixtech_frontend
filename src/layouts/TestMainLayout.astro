---
import "../styles/global.css";
import SEO from "../components/landing/SEO.astro";
import BackToTop from "../components/landing/BackToTop.astro";

const { title = "Test Landing Page - Globix Tech" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<SEO title={title} />
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body
		class="font-['Plus_Jakarta_Sans',sans-serif] bg-[#fbfbfd] text-[#1d1d1f] antialiased selection:bg-[#0071e3]/10 selection:text-[#0071e3] overflow-x-hidden"
	>
		<!-- Apple Glass Background Blur Gradients -->
		<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
			<div class="absolute -top-[20%] -left-[10%] w-[50vw] h-[50vw] bg-gradient-to-br from-blue-200/30 to-purple-200/20 rounded-full blur-[120px]"></div>
			<div class="absolute top-[40%] -right-[10%] w-[45vw] h-[45vw] bg-gradient-to-br from-sky-200/30 to-indigo-100/20 rounded-full blur-[140px]"></div>
			<div class="absolute -bottom-[10%] left-[20%] w-[40vw] h-[40vw] bg-gradient-to-tr from-blue-100/40 to-emerald-100/30 rounded-full blur-[130px]"></div>
		</div>

		<div class="relative z-10">
			<slot />
		</div>

		<BackToTop />
	</body>
</html>
