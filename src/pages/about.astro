---
import TestMainLayout from "../layouts/TestMainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FounderMessage from "../components/FounderMessage.astro";
import Team from "../components/Team.astro";
import WhoWeAre from "../components/WhoWeAre.astro";
import WorkProcess from "../components/WorkProcess.astro";
import VideoBackground from "../components/landing/VideoBackground.astro";
import { Image } from "astro:assets";
import ceoImage from "../assets/CEO2.png";

const companyInfo = {
	founded: 2020,
	vision: "To be Bangladesh's most trusted technology partner, delivering innovation with integrity and empowering businesses to achieve digital excellence.",
	mission:
		"To provide affordable, cutting-edge software solutions that solve real business problems and drive measurable growth for our clients.",
	values: [
		{
			title: "Innovation",
			desc: "We embrace new technologies and creative solutions to stay ahead.",
			icon: "fa-lightbulb",
			color: "text-[#0071e3]",
			bg: "bg-blue-50"
		},
		{
			title: "Integrity",
			desc: "We build trust through transparency, honesty, and ethical practices.",
			icon: "fa-handshake",
			color: "text-purple-600",
			bg: "bg-purple-50"
		},
		{
			title: "Excellence",
			desc: "We deliver quality in every project, exceeding client expectations.",
			icon: "fa-star",
			color: "text-amber-600",
			bg: "bg-amber-50"
		},
		{
			title: "Partnership",
			desc: "We work alongside our clients as long-term technology partners.",
			icon: "fa-users",
			color: "text-emerald-600",
			bg: "bg-emerald-50"
		},
	],
};
---

<TestMainLayout title="About Us — Technology Partner | Globix Tech">
	<Navbar />

	<main class="min-h-screen bg-[#f5f5f7]">
		<!-- Hero Header Section with Ambient Video Background -->
		<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
			<VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" overlay="light" />

			<div class="max-w-7xl mx-auto px-6 relative z-10 text-center max-w-3xl mx-auto">
				<span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#0071e3] bg-blue-50/90 backdrop-blur-md px-4 py-1.5 rounded-full border border-blue-100 shadow-xs mb-6">
					<i class="fas fa-info-circle text-xs"></i> Technology Partner
				</span>
				<h1 class="text-4xl md:text-6xl font-extrabold text-[#1d1d1f] tracking-tight leading-[1.15] mb-6">
					Innovating for a <br class="hidden sm:block"/>
					<span class="bg-gradient-to-r from-[#0071e3] via-indigo-600 to-purple-600 bg-clip-text text-transparent">Digital Future.</span>
				</h1>
				<p class="text-[#1d1d1f] text-base md:text-xl font-medium leading-relaxed max-w-2xl mx-auto">
					Empowering Bangladesh businesses with smart software solutions, intelligent POS, inventory control, and enterprise ERP systems since {companyInfo.founded}.
				</p>
			</div>
		</section>

		<!-- Who We Are Section -->
		<WhoWeAre />

		<!-- Founder Message -->
		<FounderMessage />

		<!-- CEO Message Section -->
		<section class="py-24 bg-[#f5f5f7] relative overflow-hidden">
			<!-- Video with faded borders -->
			<div
				class="absolute inset-6 overflow-hidden pointer-events-none z-0 rounded-3xl"
				style="-webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent), linear-gradient(to bottom, transparent, black 12%, black 88%, transparent); mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent), linear-gradient(to bottom, transparent, black 12%, black 88%, transparent); -webkit-mask-composite: destination-in; mask-composite: intersect;"
			>
				<VideoBackground mp4="/videos/generated_video_july_24.mp4" overlay="light" />
			</div>
			<div class="max-w-7xl mx-auto px-6 relative z-10">
				<div class="max-w-5xl mx-auto">
					<div class="text-center max-w-2xl mx-auto mb-16">
						<span class="text-xs font-bold uppercase tracking-widest text-[#0071e3] bg-blue-50 px-4 py-1.5 rounded-full border border-blue-100">From Our Leadership</span>
						<h2 class="text-3xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-4 mb-4">
							Message from Our CEO
						</h2>
					</div>

					<div class="bg-white/80 backdrop-blur-2xl rounded-[2.5rem] p-8 md:p-16 border border-white shadow-[0_20px_60px_rgba(0,0,0,0.03)] relative">
						<div class="absolute top-0 left-12 w-32 h-1 bg-gradient-to-r from-[#0071e3] to-indigo-600 rounded-full"></div>

						<!-- CEO Photo and Info -->
						<div class="flex flex-col md:flex-row items-center gap-10 mb-12">
							<div class="relative">
								<div class="absolute -inset-4 bg-gradient-to-r from-[#0071e3] to-indigo-600 rounded-full opacity-15 blur-xl"></div>
								<Image
									src={ceoImage}
									alt="Syed Mominul Islam"
									class="relative w-44 h-44 rounded-full object-cover border-4 border-white shadow-2xl"
								/>
							</div>
							<div class="text-center md:text-left">
								<h3 class="text-3xl md:text-4xl font-extrabold text-[#1d1d1f] mb-2">
									Syed Mominul Islam
								</h3>
								<p class="text-xl text-[#0071e3] font-bold mb-3">
									Chief Executive Officer
								</p>
								<div class="flex items-center justify-center md:justify-start gap-2 text-[#86868b] font-medium text-sm">
									<i class="fas fa-building text-[#0071e3]"></i> GlobixTech Solutions Ltd.
								</div>
							</div>
						</div>

						<!-- Content Area -->
						<div class="max-w-4xl">
							<blockquote class="relative mb-10 pl-6 border-l-4 border-[#0071e3]">
								<p class="text-xl md:text-2xl text-[#1d1d1f] italic font-medium leading-relaxed">
									"At GlobixTech, we believe technology should empower businesses, not complicate them. Our mission is to deliver smart, affordable software solutions that help Bangladesh businesses grow and compete globally."
								</p>
							</blockquote>

							<div class="space-y-6 text-[#86868b] leading-relaxed text-base md:text-lg mb-10">
								<p>
									Since our founding in {companyInfo.founded}, we've been committed to understanding the unique challenges faced by local businesses and creating solutions that truly work. From small retail shops to large enterprises, we've helped hundreds of companies transform their operations through technology.
								</p>

								<p>
									In today's digital age, businesses need more than just software – they need a technology partner who understands their industry, their challenges, and their goals. That's exactly what we strive to be. Every solution we build is designed with the end-user in mind, ensuring it's intuitive, robust, and scalable.
								</p>

								<p>
									Our team of dedicated developers, designers, and support staff work tirelessly to ensure every solution we deliver exceeds expectations. What sets us apart is our commitment to affordability without compromising quality.
								</p>

								<p class="font-bold text-[#1d1d1f] text-lg">
									Thank you for choosing GlobixTech. Together, let's build something extraordinary.
								</p>
							</div>

							<!-- Signature -->
							<div class="pt-8 border-t border-gray-100 flex flex-col sm:flex-row justify-between items-center gap-6">
								<div>
									<p class="text-xl font-extrabold text-[#1d1d1f]">Syed Mominul Islam</p>
									<p class="text-xs font-bold uppercase tracking-wider text-[#0071e3]">CEO, GlobixTech</p>
								</div>
								<div class="flex gap-3">
									<a href="mailto:ceo@globix.tech" class="w-10 h-10 bg-[#f5f5f7] rounded-full flex items-center justify-center text-[#0071e3] hover:bg-[#0071e3] hover:text-white transition-all text-sm">
										<i class="fas fa-envelope"></i>
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Vision & Mission -->
		<section class="py-24 bg-[#f5f5f7]">
			<div class="max-w-7xl mx-auto px-6">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
					<!-- Vision -->
					<div class="bg-white/80 backdrop-blur-2xl p-10 rounded-[2rem] border border-white shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
						<div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-[#0071e3] text-2xl mb-6">
							<i class="fas fa-eye"></i>
						</div>
						<h3 class="text-2xl font-bold text-[#1d1d1f] mb-4">Our Vision</h3>
						<p class="text-[#86868b] leading-relaxed text-base">
							{companyInfo.vision}
						</p>
					</div>

					<!-- Mission -->
					<div class="bg-white/80 backdrop-blur-2xl p-10 rounded-[2rem] border border-white shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
						<div class="w-14 h-14 bg-emerald-50 rounded-2xl flex items-center justify-center text-emerald-600 text-2xl mb-6">
							<i class="fas fa-bullseye"></i>
						</div>
						<h3 class="text-2xl font-bold text-[#1d1d1f] mb-4">Our Mission</h3>
						<p class="text-[#86868b] leading-relaxed text-base">
							{companyInfo.mission}
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Core Values -->
		<section class="py-24 bg-[#f5f5f7] relative overflow-hidden">
			<!-- Video with faded borders -->
			<div
				class="absolute inset-6 overflow-hidden pointer-events-none z-0 rounded-3xl"
				style="-webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent), linear-gradient(to bottom, transparent, black 12%, black 88%, transparent); mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent), linear-gradient(to bottom, transparent, black 12%, black 88%, transparent); -webkit-mask-composite: destination-in; mask-composite: intersect;"
			>
				<VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" overlay="light" />
			</div>
			<div class="max-w-7xl mx-auto px-6 relative z-10">
				<div class="text-center max-w-2xl mx-auto mb-16">
					<span class="text-xs font-bold uppercase tracking-widest text-[#0071e3] bg-blue-50 px-4 py-1.5 rounded-full border border-blue-100">Foundational Principles</span>
					<h2 class="text-3xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-4 mb-4">
						Our Core Values
					</h2>
					<p class="text-[#86868b] text-base md:text-lg">
						The guiding standards behind every line of code we craft.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
					{companyInfo.values.map((value) => (
						<div class="bg-white/80 backdrop-blur-2xl border border-white rounded-[2rem] p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] hover:-translate-y-1.5 transition-all duration-300 text-center">
							<div class={`w-14 h-14 ${value.bg} ${value.color} rounded-2xl flex items-center justify-center text-2xl mx-auto mb-6`}>
								<i class={`fas ${value.icon}`} />
							</div>
							<h3 class="text-xl font-bold text-[#1d1d1f] mb-3">{value.title}</h3>
							<p class="text-[#86868b] text-sm leading-relaxed">{value.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Team Section -->
		<Team />

		<!-- Work Process -->
		<WorkProcess />
	</main>

	<Footer />
</TestMainLayout>
