---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FounderMessage from "../components/FounderMessage.astro";
import Team from "../components/Team.astro";
import WhoWeAre from "../components/WhoWeAre.astro";
import WorkProcess from "../components/WorkProcess.astro";
import PageHeader from "../components/PageHeader.astro";
import { Image } from "astro:assets";
import ceoImage from "../assets/CEO.png";

const companyInfo = {
	founded: 2020,
	vision: "To be Bangladesh's most trusted technology partner, delivering innovation with integrity and empowering businesses to achieve digital excellence.",
	mission:
		"To provide affordable, cutting-edge software solutions that solve real business problems and drive measurable growth for our clients.",
	values: [
		{
			title: "Innovation",
			desc: "We embrace new technologies and creative solutions to stay ahead.",
			icon: "fa-lightbulb",
		},
		{
			title: "Integrity",
			desc: "We build trust through transparency, honesty, and ethical practices.",
			icon: "fa-handshake",
		},
		{
			title: "Excellence",
			desc: "We deliver quality in every project, exceeding client expectations.",
			icon: "fa-star",
		},
		{
			title: "Partnership",
			desc: "We work alongside our clients as long-term technology partners.",
			icon: "fa-users",
		},
	],
};
---

<MainLayout title="About Us - GlobixTech">
	<Navbar />

	<main class="min-h-screen bg-white">
		<PageHeader
			title="About"
			spanTitle="GlobixTech"
			description={`Empowering Bangladesh businesses with smart software solutions since ${companyInfo.founded}`}
			badge="Technology Partner"
			badgeIcon="fa-info-circle"
		/>

		<!-- Who We Are Section -->
		<WhoWeAre />

		<!-- Founder Message - Full Version -->
		<FounderMessage />

		<!-- CEO Message - Full Version -->
		<section class="py-24 bg-white relative overflow-hidden">
			<!-- Decorative Background Orbs -->
			<div
				class="absolute -top-24 -right-24 w-96 h-96 bg-blue-50 rounded-full blur-3xl opacity-60"
			>
			</div>
			<div
				class="absolute -bottom-24 -left-24 w-96 h-96 bg-cyan-50 rounded-full blur-3xl opacity-60"
			>
			</div>

			<div class="container mx-auto px-6 relative z-10">
				<div class="max-w-5xl mx-auto">
					<div class="text-center mb-16">
						<div
							class="inline-block bg-blue-100 text-blue-600 px-4 py-2 rounded-full text-sm font-bold mb-4 uppercase tracking-wider"
						>
							From Our Leadership
						</div>
						<h2
							class="text-3xl md:text-5xl font-bold text-[#0c1b3d] mb-4"
						>
							Message from Our CEO
						</h2>
					</div>

					<div
						class="bg-white rounded-[2.5rem] p-8 md:p-16 border border-gray-100 shadow-2xl relative"
					>
						<div
							class="absolute top-0 left-10 w-32 h-1 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full"
						>
						</div>

						<!-- CEO Photo and Info -->
						<div
							class="flex flex-col md:flex-row items-center gap-10 mb-12"
						>
							<div class="relative">
								<div
									class="absolute -inset-4 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full opacity-10 blur-xl"
								>
								</div>
								<Image
									src={ceoImage}
									alt="Syed Mominul Islam"
									class="relative w-44 h-44 rounded-full object-cover border-4 border-white shadow-2xl"
								/>
							</div>
							<div class="text-center md:text-left">
								<h3
									class="text-4xl font-bold text-[#0c1b3d] mb-3"
								>
									Syed Mominul Islam
								</h3>
								<p
									class="text-2xl text-blue-600 font-bold mb-3"
								>
									CEO
								</p>
								<div
									class="flex items-center justify-center md:justify-start gap-2 text-gray-500 font-medium"
								>
									<i class="fas fa-building text-blue-500"
									></i>
									GlobixTech Solutions
								</div>
							</div>
						</div>

						<!-- Content Area -->
						<div class="max-w-4xl">
							<!-- Opening Quote -->
							<blockquote class="relative mb-12">
								<i
									class="fas fa-quote-left absolute -top-6 -left-8 text-6xl text-blue-500/10"
								></i>
								<p
									class="text-2xl md:text-3xl text-gray-700 italic leading-relaxed font-serif relative z-10"
								>
									"At GlobixTech, we believe technology should
									empower businesses, not complicate them. Our
									mission is to deliver smart, affordable
									software solutions that help Bangladesh
									businesses grow and compete globally."
								</p>
							</blockquote>

							<!-- Message Content -->
							<div
								class="space-y-6 text-gray-600 leading-relaxed text-lg mb-12 text-justify"
							>
								<p>
									Since our founding in {companyInfo.founded},
									we've been committed to understanding the
									unique challenges faced by local businesses
									and creating solutions that truly work. From
									small startups to large enterprises, we've
									helped hundreds of companies transform their
									operations through technology.
								</p>

								<p>
									In today's digital age, businesses need more
									than just software – they need a technology
									partner who understands their industry,
									their challenges, and their goals. That's
									exactly what we strive to be. Every solution
									we build is designed with the end-user in
									mind, ensuring it's not just powerful, but
									also intuitive and easy to use.
								</p>

								<p>
									Our team of dedicated developers, designers,
									and support staff work tirelessly to ensure
									every solution we deliver exceeds
									expectations. We invest heavily in research
									and development, staying ahead of technology
									trends so our clients always have access to
									the latest innovations.
								</p>

								<p>
									What sets us apart is our commitment to
									affordability without compromising quality.
									We believe that cutting-edge technology
									should be accessible to businesses of all
									sizes. Whether you're a small shop or a
									large corporation, you deserve the same
									level of excellence and support.
								</p>

								<p>
									As we continue to grow, our commitment
									remains unchanged: to be Bangladesh's most
									trusted technology partner, delivering
									innovation with integrity. We're not just
									building software – we're building the
									future of Bangladesh's digital economy, one
									business at a time.
								</p>

								<p class="font-bold text-[#0c1b3d] text-xl">
									Thank you for choosing GlobixTech. Together,
									let's build something extraordinary.
								</p>
							</div>

							<!-- Signature -->
							<div class="pt-10 border-t border-gray-100">
								<div
									class="flex flex-col md:flex-row justify-between items-center gap-6"
								>
									<div class="text-center md:text-left">
										<p
											class="text-2xl font-black text-[#0c1b3d] mb-1"
										>
											Syed Mominul Islam
										</p>
										<p
											class="text-blue-600 font-bold tracking-wide uppercase text-sm"
										>
											CEO, GlobixTech
										</p>
									</div>
									<div class="flex gap-4">
										<a
											href="#"
											class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center text-[#0a66c2] hover:bg-blue-600 hover:text-white transition-all shadow-sm"
										>
											<i
												class="fab fa-linkedin-in text-xl"
											></i>
										</a>
										<a
											href="mailto:ceo@globix.tech"
											class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center text-blue-600 hover:bg-blue-600 hover:text-white transition-all shadow-sm"
										>
											<i class="fas fa-envelope text-xl"
											></i>
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Company Vision & Mission -->
		<section class="py-20 bg-gray-50">
			<div class="container mx-auto px-6">
				<div class="max-w-6xl mx-auto">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
						<!-- Vision -->
						<div
							class="bg-white p-10 rounded-3xl border border-gray-100 shadow-lg hover:shadow-xl transition-shadow"
						>
							<div
								class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center text-blue-600 text-3xl mb-6"
							>
								<i class="fas fa-eye"></i>
							</div>
							<h3 class="text-2xl font-bold text-[#0c1b3d] mb-4">
								Our Vision
							</h3>
							<p class="text-gray-600 leading-relaxed text-lg">
								{companyInfo.vision}
							</p>
						</div>

						<!-- Mission -->
						<div
							class="bg-white p-10 rounded-3xl border border-gray-100 shadow-lg hover:shadow-xl transition-shadow"
						>
							<div
								class="w-16 h-16 bg-green-100 rounded-2xl flex items-center justify-center text-green-600 text-3xl mb-6"
							>
								<i class="fas fa-bullseye"></i>
							</div>
							<h3 class="text-2xl font-bold text-[#0c1b3d] mb-4">
								Our Mission
							</h3>
							<p class="text-gray-600 leading-relaxed text-lg">
								{companyInfo.mission}
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Core Values -->
		<section class="py-20 bg-white">
			<div class="container mx-auto px-6">
				<div class="max-w-6xl mx-auto">
					<div class="text-center mb-16">
						<h2
							class="text-3xl md:text-5xl font-bold text-[#0c1b3d] mb-4"
						>
							Our Core Values
						</h2>
						<p class="text-gray-600 max-w-2xl mx-auto text-lg">
							The principles that guide everything we do
						</p>
					</div>

					<div
						class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
					>
						{
							companyInfo.values.map((value) => (
								<div class="text-center p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-blue-200 hover:shadow-lg transition-all">
									<div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 text-2xl mx-auto mb-6">
										<i class={`fas ${value.icon}`} />
									</div>
									<h3 class="text-xl font-bold text-[#0c1b3d] mb-3">
										{value.title}
									</h3>
									<p class="text-gray-600 leading-relaxed">
										{value.desc}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- Team Section -->
		<Team />

		<!-- Company Stats -->
		<section class="py-20 bg-gradient-to-br from-[#0c1b3d] to-blue-900">
			<div class="container mx-auto px-6">
				<div class="max-w-6xl mx-auto">
					<div
						class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center"
					>
						<div>
							<div
								class="text-4xl md:text-5xl font-extrabold text-white mb-2"
							>
								{
									new Date().getFullYear() -
										companyInfo.founded
								}+
							</div>
							<div
								class="text-blue-300 font-semibold uppercase tracking-wider text-sm"
							>
								Years of Excellence
							</div>
						</div>
						<div>
							<div
								class="text-4xl md:text-5xl font-extrabold text-white mb-2"
							>
								80+
							</div>
							<div
								class="text-blue-300 font-semibold uppercase tracking-wider text-sm"
							>
								Happy Clients
							</div>
						</div>
						<div>
							<div
								class="text-4xl md:text-5xl font-extrabold text-white mb-2"
							>
								50+
							</div>
							<div
								class="text-blue-300 font-semibold uppercase tracking-wider text-sm"
							>
								Team Members
							</div>
						</div>
						<div>
							<div
								class="text-4xl md:text-5xl font-extrabold text-white mb-2"
							>
								100+
							</div>
							<div
								class="text-blue-300 font-semibold uppercase tracking-wider text-sm"
							>
								Projects Delivered
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Work Process -->
		<WorkProcess />

		<!-- CTA Section -->
		<section class="py-20 bg-white">
			<div class="container mx-auto px-6">
				<div class="max-w-4xl mx-auto text-center">
					<h2
						class="text-3xl md:text-5xl font-bold text-[#0c1b3d] mb-6"
					>
						Ready to Work Together?
					</h2>
					<p class="text-xl text-gray-600 mb-10">
						Let's discuss how we can help transform your business
						with technology.
					</p>
					<div class="flex flex-col sm:flex-row justify-center gap-4">
						<a
							href="/#contact"
							class="bg-blue-600 hover:bg-blue-700 text-white px-10 py-4 rounded-xl font-bold transition-all shadow-lg shadow-blue-600/20 text-lg"
						>
							Get in Touch
						</a>
						<a
							href="tel:+8801707568468"
							class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-10 py-4 rounded-xl font-bold transition-all flex items-center justify-center gap-2 text-lg"
						>
							<i class="fas fa-phone-alt"></i> +880 1707 568468
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</MainLayout>
