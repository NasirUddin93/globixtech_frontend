---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

export const prerender = false;

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD;

// Handle logout
if (Astro.url.searchParams.get("logout") === "true") {
    Astro.cookies.delete("admin_auth", { path: "/" });
    return Astro.redirect("/admin");
}

interface Submission {
    id: string;
    name: string;
    email: string;
    phone?: string;
    service: string;
    message: string;
    timestamp: string;
}

let submissions: Submission[] = [];
let error: string | null = null;
let isAuthenticated = false;

// Check password from cookie
const authCookie = Astro.cookies.get("admin_auth");
if (authCookie && ADMIN_PASSWORD && authCookie.value === ADMIN_PASSWORD) {
    isAuthenticated = true;
}

// Handle login
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const password = formData.get("password")?.toString();

    console.log("Login Attempt:", {
        submittedLength: password?.length,
        matches: password === ADMIN_PASSWORD,
    });

    if (ADMIN_PASSWORD && password === ADMIN_PASSWORD) {
        Astro.cookies.set("admin_auth", password as string, {
            path: "/",
            httpOnly: true,
            sameSite: "strict",
            maxAge: 60 * 60 * 24, // 24 hours
        });
        return Astro.redirect("/admin");
    } else {
        error = "Invalid password. Please check your .env file.";
    }
}

// Load submissions if authenticated (from env for Vercel compatibility)
if (isAuthenticated) {
    const submissionsJson = import.meta.env.SUBMISSIONS_DATA;
    if (submissionsJson) {
        try {
            submissions = JSON.parse(submissionsJson) as Submission[];
        } catch (e) {
            submissions = [];
        }
    }
}
---

<MainLayout title="Admin Dashboard - Globix Tech">
    <Navbar />

    <div class="min-h-screen bg-gray-50 py-24">
        <div class="container mx-auto px-6">
            {
                !isAuthenticated ? (
                    <div class="max-w-md mx-auto bg-white p-8 rounded-[2rem] shadow-xl border border-gray-100">
                        <div class="text-center mb-8">
                            <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-lock text-3xl" />
                            </div>
                            <h1 class="text-2xl font-bold text-[#0c1b3d]">
                                Admin Login
                            </h1>
                            <p class="text-gray-500 text-sm mt-2">
                                Enter your password to view submissions
                            </p>
                        </div>

                        <form method="POST" class="space-y-4">
                            <div>
                                <input
                                    type="password"
                                    name="password"
                                    placeholder="Enter Password"
                                    class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all font-mono text-black font-extrabold placeholder:font-normal placeholder:text-gray-400"
                                    style="color: #000000; -webkit-text-fill-color: #000000;"
                                    required
                                />
                            </div>
                            {error && (
                                <p class="text-red-500 text-sm font-medium">
                                    {error}
                                </p>
                            )}
                            <button
                                type="submit"
                                class="w-full bg-[#0c1b3d] text-white py-4 rounded-xl font-bold hover:bg-blue-900 transition-all shadow-lg"
                            >
                                Access Dashboard
                            </button>
                        </form>
                    </div>
                ) : (
                    <div class="space-y-8">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div>
                                <h1 class="text-3xl font-bold text-[#0c1b3d]">
                                    Contact Submissions
                                </h1>
                                <p class="text-gray-500">
                                    Manage and view leads from your website.
                                </p>
                            </div>
                            <div class="flex items-center gap-4">
                                <span class="bg-blue-100 text-blue-700 px-4 py-2 rounded-full text-sm font-bold">
                                    {submissions.length} Total Leads
                                </span>
                                <div
                                    class="relative inline-block text-left"
                                    id="export-dropdown"
                                >
                                    <button
                                        type="button"
                                        class="bg-white border border-gray-200 text-[#0c1b3d] px-4 py-2 rounded-xl text-sm font-bold flex items-center gap-2 hover:bg-gray-50 transition-all shadow-sm"
                                        id="export-btn"
                                    >
                                        <i class="fas fa-download" />
                                        <span>Export Leads</span>
                                        <i class="fas fa-chevron-down text-[10px]" />
                                    </button>
                                    <div
                                        class="hidden absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-xl border border-gray-100 z-50 py-2"
                                        id="export-menu"
                                    >
                                        <button
                                            class="w-full text-left px-4 py-2 text-sm hover:bg-blue-50 text-gray-700 flex items-center gap-2"
                                            id="export-excel"
                                        >
                                            <i class="fas fa-file-excel text-green-600 w-4" />{" "}
                                            Excel (XLSX)
                                        </button>
                                        <button
                                            class="w-full text-left px-4 py-2 text-sm hover:bg-blue-50 text-gray-700 flex items-center gap-2"
                                            id="export-pdf"
                                        >
                                            <i class="fas fa-file-pdf text-red-600 w-4" />{" "}
                                            PDF Document
                                        </button>
                                        <button
                                            class="w-full text-left px-4 py-2 text-sm hover:bg-blue-50 text-gray-700 flex items-center gap-2"
                                            id="export-word"
                                        >
                                            <i class="fas fa-file-word text-blue-600 w-4" />{" "}
                                            Word Document
                                        </button>
                                    </div>
                                </div>
                                <a
                                    href="/admin?logout=true"
                                    class="text-gray-500 hover:text-red-500 transition-colors text-sm font-bold flex items-center gap-2"
                                >
                                    <i class="fas fa-sign-out-alt" />
                                    <span>Logout</span>
                                </a>
                            </div>
                        </div>

                        <div class="bg-white rounded-[2rem] shadow-sm border border-gray-100 overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left">
                                    <thead class="bg-gray-50 border-b border-gray-100">
                                        <tr>
                                            <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                                Date
                                            </th>
                                            <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                                Contact
                                            </th>
                                            <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                                Phone
                                            </th>
                                            <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                                Service
                                            </th>
                                            <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">
                                                Message
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-50">
                                        {submissions.length === 0 ? (
                                            <tr>
                                                <td
                                                    colspan="5"
                                                    class="px-6 py-20 text-center"
                                                >
                                                    <div class="flex flex-col items-center gap-3 text-gray-400">
                                                        <i class="far fa-folder-open text-4xl" />
                                                        <p class="font-medium text-lg">
                                                            No submissions yet.
                                                        </p>
                                                    </div>
                                                </td>
                                            </tr>
                                        ) : (
                                            submissions.map((sub) => (
                                                <tr class="hover:bg-gray-50/50 transition-colors">
                                                    <td class="px-6 py-4 whitespace-nowrap">
                                                        <div class="text-sm font-medium text-gray-900">
                                                            {new Date(
                                                                sub.timestamp,
                                                            ).toLocaleDateString()}
                                                        </div>
                                                        <div class="text-xs text-gray-500">
                                                            {new Date(
                                                                sub.timestamp,
                                                            ).toLocaleTimeString(
                                                                [],
                                                                {
                                                                    hour: "2-digit",
                                                                    minute: "2-digit",
                                                                },
                                                            )}
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4">
                                                        <div class="text-sm font-bold text-[#0c1b3d]">
                                                            {sub.name}
                                                        </div>
                                                        <div class="text-xs text-blue-600 font-medium">
                                                            {sub.email}
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4 whitespace-nowrap">
                                                        <div class="text-sm text-gray-600">
                                                            {sub.phone || (
                                                                <span class="text-gray-300 italic text-xs">
                                                                    Not provided
                                                                </span>
                                                            )}
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4 whitespace-nowrap">
                                                        <span class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-[10px] font-bold uppercase tracking-wider">
                                                            {sub.service ||
                                                                "General"}
                                                        </span>
                                                    </td>
                                                    <td class="px-6 py-4">
                                                        <p
                                                            class="text-sm text-gray-600 line-clamp-2 max-w-md"
                                                            title={sub.message}
                                                        >
                                                            {sub.message}
                                                        </p>
                                                    </td>
                                                </tr>
                                            ))
                                        )}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                )
            }
        </div>
    </div>

    <Footer />
</MainLayout>

<style>
    /* Custom scrollbar for table */
    ::-webkit-scrollbar {
        height: 6px;
        width: 6px;
    }
    ::-webkit-scrollbar-track {
        background: transparent;
    }
    ::-webkit-scrollbar-thumb {
        background: #e2e8f0;
        border-radius: 10px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: #cbd5e1;
    }
</style>

<script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"
></script>
<script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"
></script>
<script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"
></script>

<script define:vars={{ submissions }}>
    // Dropdown Logic
    const exportBtn = document.getElementById("export-btn");
    const exportMenu = document.getElementById("export-menu");

    if (exportBtn && exportMenu) {
        exportBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            exportMenu.classList.toggle("hidden");
        });

        document.addEventListener("click", () => {
            exportMenu.classList.add("hidden");
        });
    }

    // Export Logic
    document.getElementById("export-excel")?.addEventListener("click", () => {
        if (!submissions || submissions.length === 0) {
            alert("No data to export");
            return;
        }
        const data = submissions.map((s) => ({
            Date: new Date(s.timestamp).toLocaleDateString(),
            Name: s.name,
            Email: s.email,
            Phone: s.phone || "N/A",
            Service: s.service || "General",
            Message: s.message,
        }));

        const ws = XLSX.utils.json_to_sheet(data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Submissions");
        XLSX.writeFile(
            wb,
            `Globix_Leads_${new Date().toISOString().split("T")[0]}.xlsx`,
        );
    });

    document.getElementById("export-pdf")?.addEventListener("click", () => {
        if (!submissions || submissions.length === 0) {
            alert("No data to export");
            return;
        }
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        doc.setFontSize(18);
        doc.text("Globix Tech - Contact Submissions", 14, 22);
        doc.setFontSize(11);
        doc.setTextColor(100);
        doc.text(`Generated on: ${new Date().toLocaleString()}`, 14, 30);

        const head = [["Date", "Contact", "Phone", "Service", "Message"]];
        const body = submissions.map((s) => [
            new Date(s.timestamp).toLocaleDateString(),
            `${s.name}\n${s.email}`,
            s.phone || "N/A",
            s.service || "General",
            s.message,
        ]);

        doc.autoTable({
            head: head,
            body: body,
            startY: 40,
            theme: "striped",
            headStyles: { fillColor: [12, 27, 61] },
            styles: { fontSize: 8, cellPadding: 3 },
        });

        doc.save(`Globix_Leads_${new Date().toISOString().split("T")[0]}.pdf`);
    });

    document.getElementById("export-word")?.addEventListener("click", () => {
        if (!submissions || submissions.length === 0) {
            alert("No data to export");
            return;
        }
        let content = `
            <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
            <head><meta charset='utf-8'><title>Contact Leads</title></head>
            <body>
                <h1>Globix Tech - Contact Leads</h1>
                <p>Generated: ${new Date().toLocaleString()}</p>
                <table border='1' cellspacing='0' cellpadding='5'>
                    <tr style='background-color: #0c1b3d; color: white;'>
                        <th>Date</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Service</th>
                        <th>Message</th>
                    </tr>
                    ${submissions
                        .map(
                            (s) => `
                        <tr>
                            <td>${new Date(s.timestamp).toLocaleDateString()}</td>
                            <td>${s.name}</td>
                            <td>${s.email}</td>
                            <td>${s.phone || "N/A"}</td>
                            <td>${s.service || "General"}</td>
                            <td>${s.message}</td>
                        </tr>
                    `,
                        )
                        .join("")}
                </table>
            </body>
            </html>
        `;

        const blob = new Blob(["\ufeff", content], {
            type: "application/msword",
        });

        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `Globix_Leads_${new Date().toISOString().split("T")[0]}.doc`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });
</script>
