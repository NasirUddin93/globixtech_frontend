---
import TestMainLayout from "../../layouts/TestMainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import VideoBackground from "../../components/landing/VideoBackground.astro";

const posts = await Astro.glob("./posts/*.md");
// Sort by date desc
posts.sort(
    (a, b) =>
        new Date(b.frontmatter.publishDate).valueOf() -
        new Date(a.frontmatter.publishDate).valueOf(),
);
---

<TestMainLayout title="Blog & Insights | Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-[#f5f5f7]">
        <!-- Hero Header Section with Ambient Video Background -->
        <section class="relative pt-28 pb-12 sm:pt-32 sm:pb-20 md:pt-40 md:pb-28 overflow-hidden">
            <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" overlay="light" />

            <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10 text-center max-w-3xl mx-auto space-y-3 sm:space-y-4">
                <div>
                    <span class="inline-flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs font-bold uppercase tracking-widest text-[#0071e3] bg-blue-50/90 backdrop-blur-md px-3 sm:px-4 py-1 sm:py-1.5 rounded-full border border-blue-100 shadow-xs mb-3 sm:mb-6">
                        <i class="fas fa-newspaper text-xs"></i> Insights & Updates
                    </span>
                </div>
                <h1 class="text-3xl sm:text-4xl md:text-6xl font-extrabold text-[#1d1d1f] tracking-tight leading-[1.15]">
                    Technology Trends & <br class="hidden sm:block"/>
                    <span class="bg-gradient-to-r from-[#0071e3] via-indigo-600 to-purple-600 bg-clip-text text-transparent">Engineering Guides.</span>
                </h1>
                <p class="text-[#1d1d1f] text-xs sm:text-base md:text-xl font-medium leading-relaxed max-w-2xl mx-auto pb-2 sm:pb-4">
                    Latest news, system architecture guides, POS strategies, and enterprise ERP insights from the Globix Tech engineering team.
                </p>

                <!-- Search Box Inside Header -->
                <div class="max-w-xl mx-auto relative group">
                    <input
                        type="search"
                        id="blog-search"
                        placeholder="Search articles & engineering guides..."
                        class="w-full px-4 sm:px-6 py-3 sm:py-4 rounded-xl sm:rounded-2xl bg-white/80 backdrop-blur-2xl border border-white text-[#1d1d1f] placeholder:text-[#86868b] focus:outline-none focus:ring-2 focus:ring-[#0071e3] focus:bg-white shadow-[0_8px_30px_rgba(0,0,0,0.04)] transition-all pl-10 sm:pl-12 font-medium text-xs sm:text-sm"
                    />
                    <i class="fas fa-search absolute left-4 sm:left-5 top-1/2 -translate-y-1/2 text-[#86868b] group-focus-within:text-[#0071e3] transition-colors text-xs sm:text-sm"></i>
                </div>
            </div>
        </section>

        <!-- Blog Posts Grid -->
        <section class="py-12 sm:py-20 relative overflow-hidden">
            <VideoBackground mp4="/videos/generated_video_july_24.mp4" double={true} />

            <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
                <div class="bg-white/70 backdrop-blur-2xl rounded-2xl sm:rounded-[2.5rem] border border-white/90 shadow-[0_20px_60px_rgba(0,0,0,0.06)] p-4 sm:p-6 md:p-10">
                    <div
                        id="posts-grid"
                        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-8"
                    >
                        {
                            posts.map((post) => (
                                <a
                                    href={post.url}
                                    class="group blog-post-item"
                                    data-title={post.frontmatter.title}
                                    data-category={post.frontmatter.category}
                                >
                                    <article class="bg-white/90 backdrop-blur-2xl rounded-2xl sm:rounded-[2rem] p-4 sm:p-6 border border-slate-100 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] hover:-translate-y-1.5 transition-all duration-300 h-full flex flex-col justify-between text-left">
                                        <div>
                                            <div class="relative h-44 sm:h-56 rounded-xl sm:rounded-2xl overflow-hidden mb-4 sm:mb-6 bg-gray-100">
                                                <img
                                                    src={post.frontmatter.image}
                                                    alt={post.frontmatter.title}
                                                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                                                />
                                                <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-20">
                                                    <span class="bg-white/90 backdrop-blur-md px-2.5 sm:px-3.5 py-0.5 sm:py-1 rounded-full text-[10px] sm:text-[11px] font-bold text-[#1d1d1f] shadow-xs">
                                                        {post.frontmatter.category}
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-2 sm:gap-3 text-[11px] sm:text-xs font-bold text-[#86868b] mb-2 sm:mb-3">
                                                <span class="flex items-center gap-1.5">
                                                    <i class="far fa-calendar text-[#0071e3]"></i>
                                                    {post.frontmatter.date}
                                                </span>
                                                <span>•</span>
                                                <span class="text-[#0071e3]">
                                                    {post.frontmatter.readTime || "5 min read"}
                                                </span>
                                            </div>

                                            <h2 class="text-lg sm:text-xl font-extrabold text-[#1d1d1f] mb-2 sm:mb-3 group-hover:text-[#0071e3] transition-colors leading-snug line-clamp-2">
                                                {post.frontmatter.title}
                                            </h2>

                                            <p class="text-[#86868b] text-xs sm:text-sm leading-relaxed line-clamp-3 mb-4 sm:mb-6">
                                                {post.frontmatter.description}
                                            </p>
                                        </div>

                                        <div class="pt-3 sm:pt-4 border-t border-gray-100/80 flex items-center text-[#0071e3] font-bold text-xs group-hover:translate-x-1 transition-transform">
                                            Read Full Article <i class="fas fa-chevron-right ml-1.5 text-[10px]"></i>
                                        </div>
                                    </article>
                                </a>
                            ))
                        }
                    </div>
                </div>

                {
                    posts.length === 0 && (
                        <div class="text-center py-14 sm:py-20 bg-white/80 backdrop-blur-2xl rounded-2xl sm:rounded-[2.5rem] border border-white max-w-2xl mx-auto shadow-xs px-4">
                            <div class="w-12 h-12 sm:w-14 sm:h-14 bg-blue-50 text-[#0071e3] rounded-2xl flex items-center justify-center mx-auto mb-4 text-xl sm:text-2xl">
                                <i class="far fa-newspaper"></i>
                            </div>
                            <h3 class="text-lg sm:text-xl font-bold text-[#1d1d1f]">No articles found</h3>
                            <p class="text-[#86868b] text-xs sm:text-sm mt-2">Check back soon for new tech insights & updates!</p>
                        </div>
                    )
                }
            </div>
        </section>
    </main>

    <Footer />
</TestMainLayout>

<script>
    const searchInput = document.getElementById('blog-search') as HTMLInputElement;
    const postItems = document.querySelectorAll('.blog-post-item');

    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const query = (e.target as HTMLInputElement).value.toLowerCase();
            postItems.forEach((item) => {
                const title = item.getAttribute('data-title')?.toLowerCase() || '';
                const category = item.getAttribute('data-category')?.toLowerCase() || '';
                if (title.includes(query) || category.includes(query)) {
                    (item as HTMLElement).style.display = 'block';
                } else {
                    (item as HTMLElement).style.display = 'none';
                }
            });
        });
    }
</script>
