---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

export const prerender = false;

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD;

let error: string | null = null;
let successMessage: string | null = null;

// Check if already authenticated
const authCookie = Astro.cookies.get("admin_auth");
if (authCookie && ADMIN_PASSWORD && authCookie.value === ADMIN_PASSWORD) {
    return Astro.redirect("/admin");
}

// Handle Form Submission
if (Astro.request.method === "POST") {
    let shouldRedirect = false;
    
    try {
        const formData = await Astro.request.formData();
        const email = formData.get("email")?.toString().trim();
        const password = formData.get("password")?.toString();
        const loginType = formData.get("login_type")?.toString() || "admin";

        if (loginType === "admin") {
            // Admin password verification
            if (ADMIN_PASSWORD && password === ADMIN_PASSWORD) {
                Astro.cookies.set("admin_auth", password as string, {
                    path: "/",
                    httpOnly: true,
                    sameSite: "strict",
                    maxAge: 60 * 60 * 24,
                });
                shouldRedirect = true;
            } else {
                error = "Invalid credentials.";
            }
        } else {
            // Client portal authentication
            if (email && password && password.length >= 6) {
                successMessage = "Client authentication successful! Redirecting to client portal...";
            } else {
                error = "Please provide a valid email and password (min 6 characters).";
            }
        }
    } catch (e) {
        console.error("Login Form Error:", e);
        error = "Could not process form request. Please try again.";
    }

    if (shouldRedirect) {
        return Astro.redirect("/admin");
    }
}
---

<MainLayout title="Login — Globix Tech Official Portal">
    <Navbar />

    <main class="min-h-screen pt-32 pb-20 flex items-center justify-center bg-gradient-to-b from-[#fbfbfd] via-white to-[#f5f5f7] relative overflow-hidden">
        <!-- Ambient Glowing Background Orbs -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-gradient-to-tr from-[#0071e3]/15 to-[#00b7ff]/20 rounded-full blur-3xl pointer-events-none -z-10 animate-pulse"></div>
        <div class="absolute bottom-10 right-10 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

        <div class="w-full max-w-md px-4 sm:px-6">
            <!-- Glassmorphic Login Card -->
            <div class="bg-white/85 backdrop-blur-2xl border border-white/90 shadow-[0_20px_60px_rgba(0,0,0,0.06)] rounded-[2.5rem] p-8 sm:p-10 transition-all relative overflow-hidden">
                
                <!-- Brand Badge Header -->
                <div class="text-center mb-8">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-[#0071e3] to-[#00b7ff] text-white flex items-center justify-center mx-auto mb-4 shadow-lg shadow-blue-500/25">
                        <i class="fas fa-shield-halved text-2xl"></i>
                    </div>
                    <h1 class="text-2xl font-bold text-[#1d1d1f] tracking-tight">Welcome Back</h1>
                    <p class="text-xs text-[#86868b] mt-1.5 font-medium">Access your Globix Tech Management System</p>
                </div>

                <!-- Interactive Tab Switcher -->
                <div class="bg-[#f5f5f7] p-1 rounded-2xl flex items-center mb-6 text-xs font-semibold text-[#86868b]" id="tab-switcher">
                    <button type="button" id="tab-admin" class="flex-1 py-2.5 rounded-xl text-center transition-all bg-white text-[#1d1d1f] shadow-sm">
                        <i class="fas fa-user-shield mr-1.5 text-[#0071e3]"></i> Admin Access
                    </button>
                    <button type="button" id="tab-client" class="flex-1 py-2.5 rounded-xl text-center transition-all hover:text-[#1d1d1f]">
                        <i class="fas fa-briefcase mr-1.5 text-purple-600"></i> Client Portal
                    </button>
                </div>

                <!-- Error & Success Alerts -->
                {error && (
                    <div class="mb-6 p-4 rounded-2xl bg-red-50/80 border border-red-100 text-red-600 text-xs flex items-start gap-3 animate-shake">
                        <i class="fas fa-circle-exclamation text-sm mt-0.5 shrink-0"></i>
                        <span>{error}</span>
                    </div>
                )}

                {successMessage && (
                    <div class="mb-6 p-4 rounded-2xl bg-emerald-50/80 border border-emerald-100 text-emerald-600 text-xs flex items-start gap-3">
                        <i class="fas fa-circle-check text-sm mt-0.5 shrink-0"></i>
                        <span>{successMessage}</span>
                    </div>
                )}

                <!-- Login Form -->
                <form id="login-form" method="POST" class="space-y-4">
                    <input type="hidden" name="login_type" id="login_type" value="admin" />

                    <!-- Email / Admin User Input -->
                    <div id="email-field-group" class="space-y-1.5">
                        <label for="email" class="block text-xs font-semibold text-[#1d1d1f]">Email Address / Username</label>
                        <div class="relative">
                            <input
                                type="text"
                                id="email"
                                name="email"
                                value="admin@gmail.com"
                                required
                                placeholder="name@domain.com"
                                class="w-full px-4 py-3 rounded-2xl bg-[#f5f5f7] border border-transparent focus:border-[#0071e3] focus:bg-white text-xs font-medium text-[#1d1d1f] placeholder:text-[#a1a1a6] outline-none transition-all pl-10"
                            />
                            <i class="far fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-[#86868b]"></i>
                        </div>
                    </div>

                    <!-- Password Input -->
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between">
                            <label for="password" class="block text-xs font-semibold text-[#1d1d1f]">Password</label>
                            <a href="/contact" class="text-[11px] font-medium text-[#0071e3] hover:underline">Forgot password?</a>
                        </div>
                        <div class="relative">
                            <input
                                type="password"
                                id="password"
                                name="password"
                                required
                                placeholder="••••••••••••"
                                class="w-full px-4 py-3 rounded-2xl bg-[#f5f5f7] border border-transparent focus:border-[#0071e3] focus:bg-white text-xs font-bold text-black placeholder:text-[#a1a1a6] outline-none transition-all pl-10 pr-10"
                                style="color: #000000; -webkit-text-fill-color: #000000;"
                            />
                            <i class="far fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-[#86868b]"></i>
                            <button type="button" id="toggle-password" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-[#86868b] hover:text-[#1d1d1f] focus:outline-none">
                                <i class="far fa-eye" id="eye-icon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Remember Me Option -->
                    <div class="flex items-center justify-between pt-1">
                        <label class="flex items-center gap-2 cursor-pointer select-none">
                            <input type="checkbox" name="remember" checked class="w-4 h-4 rounded border-gray-300 text-[#0071e3] focus:ring-[#0071e3] rounded-md" />
                            <span class="text-xs text-[#86868b] font-medium">Remember login</span>
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        class="w-full py-3.5 px-6 rounded-2xl bg-[#0071e3] hover:bg-[#0077ed] text-white text-xs font-bold shadow-lg shadow-blue-500/25 hover:shadow-xl hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2 mt-4"
                    >
                        <span>Sign In to Dashboard</span>
                        <i class="fas fa-arrow-right text-xs"></i>
                    </button>
                </form>

                <!-- Help & Quick Credentials Footer -->
                <div class="mt-8 pt-6 border-t border-gray-100 text-center space-y-2">
                    <p class="text-[11px] text-[#86868b]">
                        Need an account or technical support? 
                        <a href="/contact" class="text-[#0071e3] font-semibold hover:underline">Contact System Admin</a>
                    </p>
                    <div class="bg-blue-50/60 p-2.5 rounded-xl text-[10px] text-blue-700 font-mono inline-block border border-blue-100">
                        <i class="fas fa-info-circle mr-1"></i> Use the password set in environment variables
                    </div>
                </div>

            </div>
        </div>
    </main>

    <Footer />
</MainLayout>

<script>
    // Client-side interactions for tabs, password visibility, and direct authentication
    document.addEventListener("DOMContentLoaded", () => {
        const tabAdmin = document.getElementById("tab-admin");
        const tabClient = document.getElementById("tab-client");
        const loginTypeInput = document.getElementById("login_type") as HTMLInputElement;
        const passwordInput = document.getElementById("password") as HTMLInputElement;
        const togglePasswordBtn = document.getElementById("toggle-password");
        const eyeIcon = document.getElementById("eye-icon");
        const loginForm = document.getElementById("login-form") as HTMLFormElement;

        if (tabAdmin && tabClient && loginTypeInput) {
            tabAdmin.addEventListener("click", () => {
                loginTypeInput.value = "admin";
                tabAdmin.className = "flex-1 py-2.5 rounded-xl text-center transition-all bg-white text-[#1d1d1f] shadow-sm";
                tabClient.className = "flex-1 py-2.5 rounded-xl text-center transition-all hover:text-[#1d1d1f]";
            });

            tabClient.addEventListener("click", () => {
                loginTypeInput.value = "client";
                tabClient.className = "flex-1 py-2.5 rounded-xl text-center transition-all bg-white text-[#1d1d1f] shadow-sm";
                tabAdmin.className = "flex-1 py-2.5 rounded-xl text-center transition-all hover:text-[#1d1d1f]";
            });
        }

        if (togglePasswordBtn && passwordInput && eyeIcon) {
            togglePasswordBtn.addEventListener("click", () => {
                const isPassword = passwordInput.type === "password";
                passwordInput.type = isPassword ? "text" : "password";
                eyeIcon.className = isPassword ? "far fa-eye-slash" : "far fa-eye";
            });
        }

        if (loginForm) {
            // Client-side bypass removed for security — all auth handled server-side
        }
    });
</script>
