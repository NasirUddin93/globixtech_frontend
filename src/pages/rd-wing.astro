---
import TestMainLayout from "../layouts/TestMainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import VideoBackground from "../components/landing/VideoBackground.astro";

const researchPillars = [
    {
        title: "Paper Drafting",
        desc: "Professional structuring and academic formatting of research hypotheses and experimental findings.",
        icon: "fa-book-reader",
        color: "text-[#0071e3]",
        bg: "bg-blue-50"
    },
    {
        title: "Tech Model Validation",
        desc: "Rigorous simulation, architectural stress testing, and empirical verification of technical frameworks.",
        icon: "fa-vial",
        color: "text-purple-600",
        bg: "bg-purple-50"
    },
    {
        title: "Data Science & Metrics",
        desc: "Extracting actionable insights and statistical metrics using data science to validate hypotheses.",
        icon: "fa-chart-pie",
        color: "text-indigo-600",
        bg: "bg-indigo-50"
    },
    {
        title: "Global Impact & Publishing",
        desc: "Bridging the gap between theoretical computer science and high-impact industrial applications.",
        icon: "fa-globe",
        color: "text-emerald-600",
        bg: "bg-emerald-50"
    }
];

const researchHighlights = [
    {
        title: "Emerging Tech Research",
        desc: "Continual focus on blockchain architectures, deep learning models, neural networks, and quantum-safe cryptography.",
        icon: "fa-flask",
        color: "text-[#0071e3]",
        bg: "bg-blue-50"
    },
    {
        title: "Academic Publishing Assistance",
        desc: "We assist researchers, engineers, and academics in drafting, validating, and publishing technical papers in peer-reviewed international journals.",
        icon: "fa-file-invoice",
        color: "text-purple-600",
        bg: "bg-purple-50"
    },
    {
        title: "Journal & Industry Network",
        desc: "Strong collaboration network with technical journals to guarantee academic excellence and real-world industrial relevance.",
        icon: "fa-university",
        color: "text-emerald-600",
        bg: "bg-emerald-50"
    }
];
---

<TestMainLayout title="R&D Wing — Industrial Research & Development | Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-[#f5f5f7]">
        <!-- Hero Header Section with Ambient Video Background -->
        <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
            <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" overlay="light" />

            <div class="max-w-7xl mx-auto px-6 relative z-10 text-center max-w-3xl mx-auto">
                <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#0071e3] bg-blue-50/90 backdrop-blur-md px-4 py-1.5 rounded-full border border-blue-100 shadow-xs mb-6">
                    <i class="fas fa-flask text-xs"></i> Innovation Lab
                </span>
                <h1 class="text-4xl md:text-6xl font-extrabold text-[#1d1d1f] tracking-tight leading-[1.15] mb-6">
                    Research & Development <br class="hidden sm:block"/>
                    <span class="bg-gradient-to-r from-[#0071e3] via-indigo-600 to-purple-600 bg-clip-text text-transparent">(R&D) Wing</span>
                </h1>
                <p class="text-[#1d1d1f] text-base md:text-xl font-medium leading-relaxed max-w-2xl mx-auto">
                    At Globix Tech, we believe the future is built on rigorous research. Our R&D center is dedicated to exploring emerging technologies that solve real-world industrial challenges.
                </p>
            </div>
        </section>

        <!-- Main Research Overview & Video Demonstration -->
        <section class="py-20 bg-white/40 backdrop-blur-md relative overflow-hidden">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    
                    <!-- Left Information Column -->
                    <div class="lg:col-span-6 space-y-8 text-left">
                        <div>
                            <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 bg-indigo-50 px-4 py-1.5 rounded-full border border-indigo-100">Deep Tech Research</span>
                            <h2 class="text-3xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-4 mb-4">
                                Bridging the gap between theory and industry.
                            </h2>
                            <p class="text-[#86868b] leading-relaxed text-base">
                                Our Research & Development center explores next-generation algorithm design, machine learning pipelines, and publishes peer-reviewed research papers in high-impact international journals.
                            </p>
                        </div>

                        <div class="space-y-4">
                            {researchHighlights.map((item) => (
                                <div class="p-5 rounded-2xl bg-white/80 backdrop-blur-xl border border-white shadow-[0_4px_20px_rgba(0,0,0,0.02)] hover:shadow-md transition-all flex items-start gap-4">
                                    <div class={`w-12 h-12 rounded-2xl ${item.bg} ${item.color} flex items-center justify-center text-xl flex-shrink-0 mt-0.5`}>
                                        <i class={`fas ${item.icon}`}></i>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-base text-[#1d1d1f] mb-1">{item.title}</h4>
                                        <p class="text-xs text-[#86868b] leading-relaxed">{item.desc}</p>
                                    </div>
                                </div>
                            ))}
                        </div>

                        <!-- Published Paper Badge -->
                        <div class="p-6 rounded-2xl bg-[#1d1d1f] text-white flex items-center justify-between shadow-xl">
                            <div>
                                <span class="text-[10px] uppercase font-bold tracking-widest text-blue-400">Peer-Reviewed Article</span>
                                <h5 class="font-bold text-base mt-0.5">Latest Research Paper</h5>
                                <p class="text-xs text-slate-400">Published in Global IT Tech Journal, 2026</p>
                            </div>
                            <a href="#contact" class="bg-[#0071e3] hover:bg-[#0077ed] text-white text-xs font-bold px-4 py-2.5 rounded-xl transition-all flex items-center gap-1.5">
                                Read Paper <i class="fas fa-external-link-alt text-[10px]"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Right Video Loop Showcase -->
                    <div class="lg:col-span-6">
                        <div class="relative p-3 rounded-[2.5rem] bg-white/70 backdrop-blur-2xl border border-white shadow-[0_20px_70px_rgba(0,0,0,0.06)]">
                            <div class="relative rounded-3xl overflow-hidden aspect-video bg-black shadow-inner group">
                                <video 
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                                    autoplay 
                                    loop 
                                    muted 
                                    playsinline
                                >
                                    <source src="/videos/rd-wing/people_working_with_Bridging_t.mp4" type="video/mp4">
                                </video>
                                <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-white/80 backdrop-blur-2xl border border-white text-left text-xs text-[#1d1d1f] font-bold shadow-xl flex items-center justify-between">
                                    <span class="flex items-center gap-2">
                                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                        Real-Time Data Processing Algorithm
                                    </span>
                                    <span class="text-[#86868b] font-mono text-[11px]">R&D-2026-V8</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4 Core Pillars Grid -->
        <section class="py-24 bg-[#f5f5f7] relative overflow-hidden">
            <VideoBackground mp4="/videos/generated_video_july_24.mp4" overlay="light" />

            <div class="max-w-7xl mx-auto px-6 relative z-10">
                <div class="text-center max-w-2xl mx-auto mb-16">
                    <span class="text-xs font-bold uppercase tracking-widest text-[#0071e3] bg-blue-50 px-4 py-1.5 rounded-full border border-blue-100">Scientific Method</span>
                    <h2 class="text-3xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-4 mb-4">
                        R&D Execution Pillars
                    </h2>
                    <p class="text-[#86868b] text-base md:text-lg">
                        Structured methodology transforming raw research ideas into peer-reviewed publications and production software engines.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    {researchPillars.map((pillar) => (
                        <div class="bg-white/80 backdrop-blur-2xl border border-white rounded-[2rem] p-8 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] hover:-translate-y-1.5 transition-all duration-300">
                            <div class={`w-14 h-14 rounded-2xl ${pillar.bg} ${pillar.color} flex items-center justify-center text-2xl mb-6`}>
                                <i class={`fas ${pillar.icon}`}></i>
                            </div>
                            <h3 class="text-xl font-bold text-[#1d1d1f] mb-3">{pillar.title}</h3>
                            <p class="text-[#86868b] text-sm leading-relaxed">{pillar.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-24 bg-white relative overflow-hidden text-center">
            <div class="max-w-4xl mx-auto px-6 relative z-10">
                <span class="text-xs font-bold uppercase tracking-widest text-[#0071e3] bg-blue-50 px-4 py-1.5 rounded-full border border-blue-100">Collaborate With Us</span>
                <h2 class="text-3xl md:text-5xl font-extrabold text-[#1d1d1f] tracking-tight mt-4 mb-6">
                    Interested in Research Partnership?
                </h2>
                <p class="text-[#86868b] text-base md:text-lg mb-10 max-w-2xl mx-auto">
                    We're always looking for innovative industrial projects, academic papers, and technical research partnerships. Let's explore the possibilities together.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a
                        href="/contact"
                        class="bg-[#0071e3] hover:bg-[#0077ed] text-white font-bold px-9 py-4 rounded-2xl shadow-xl shadow-blue-500/20 hover:scale-[1.02] active:scale-95 transition-all text-base"
                    >
                        Initiate Research Inquiry &rarr;
                    </a>
                    <a
                        href="mailto:info@globix.tech"
                        class="bg-[#f5f5f7] hover:bg-gray-200 text-[#1d1d1f] font-bold px-8 py-4 rounded-2xl transition-all text-base flex items-center gap-2"
                    >
                        <i class="fas fa-envelope text-[#0071e3]"></i> Email R&D Team
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</TestMainLayout>
