    <script>
        // Business type tabs switching logic
        document.addEventListener("DOMContentLoaded", () => {
            const tabs = document.querySelectorAll(".business-tab");
            const contents = document.querySelectorAll(".business-content");

            tabs.forEach((tab) => {
                tab.addEventListener("click", () => {
                    const targetId = tab.getAttribute("data-id");

                    tabs.forEach((t) => {
                        t.classList.remove(
                            "bg-white",
                            "text-[#1D1D1F]",
                            "shadow-sm",
                            "font-semibold",
                        );
                        t.classList.add(
                            "text-slate-600",
                            "hover:text-slate-900",
                        );
                    });

                    tab.classList.remove(
                        "text-slate-600",
                        "hover:text-slate-900",
                    );
                    tab.classList.add("bg-white", "text-[#1D1D1F]", "shadow-sm", "font-semibold");

                    contents.forEach((content) => {
                        content.classList.remove("opacity-100", "relative");
                        content.classList.add(
                            "opacity-0",
                            "absolute",
                            "inset-0",
                            "pointer-events-none",
                        );
                    });

                    const targetContent = document.getElementById(
                        `business-${targetId}`,
                    );
                    if (targetContent) {
                        targetContent.classList.remove(
                            "opacity-0",
                            "absolute",
                            "inset-0",
                            "pointer-events-none",
                        );
                        targetContent.classList.add("opacity-100", "relative");
                    }
                });
            });
        });
    </script>
