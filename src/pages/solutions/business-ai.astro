    <script>
        // Module switching functionality
        document.addEventListener("DOMContentLoaded", () => {
            const moduleButtons = document.querySelectorAll(".module-btn");
            const moduleContents = document.querySelectorAll(".module-content");

            moduleButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    const targetId = button.getAttribute("data-id");

                    // Update button states
                    moduleButtons.forEach((btn) => {
                        btn.classList.remove(
                            "bg-white",
                            "border-purple-500",
                            "shadow-md",
                            "text-purple-600",
                            "ring-1",
                            "ring-purple-500",
                        );
                        btn.classList.add("bg-gray-50", "text-gray-600");
                        const arrow = btn.querySelector("i");
                        arrow.classList.remove("text-purple-600");
                        arrow.classList.add("text-gray-300");
                    });

                    button.classList.remove("bg-gray-50", "text-gray-600");
                    button.classList.add(
                        "bg-white",
                        "border-purple-500",
                        "shadow-md",
                        "text-purple-600",
                        "ring-1",
                        "ring-purple-500",
                    );
                    const activeArrow = button.querySelector("i");
                    activeArrow.classList.remove("text-gray-300");
                    activeArrow.classList.add("text-purple-600");

                    // Update content visibility
                    moduleContents.forEach((content) => {
                        content.classList.remove(
                            "opacity-100",
                            "z-10",
                            "translate-y-0",
                        );
                        content.classList.add(
                            "opacity-0",
                            "-z-10",
                            "translate-y-4",
                        );
                    });

                    const targetContent = document.getElementById(
                        `content-${targetId}`,
                    );
                    if (targetContent) {
                        targetContent.classList.remove(
                            "opacity-0",
                            "-z-10",
                            "translate-y-4",
                        );
                        targetContent.classList.add(
                            "opacity-100",
                            "z-10",
                            "translate-y-0",
                        );
                    }
                });
            });
        });
    </script>
