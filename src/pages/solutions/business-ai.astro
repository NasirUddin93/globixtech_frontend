            "Unlimited AI Solutions",
            "Custom Model Training",
            "Dedicated AI Team",
            "Cloud Infrastructure",
            "24/7 Support",
            "Quarterly Reviews",
        ],
        delivery: "60+ Days",
        support: "12 Months Support",
    },
];

const addOns = [
    { name: "Cloud Infrastructure", price: "Starting @ 20,000 BDT" },
    { name: "Data Pipeline Dev", price: "Starting @ 15,000 BDT" },
    { name: "Custom Model Training", price: "Ask for Quote" },
    { name: "Monthly Maintenance", price: "Starting @ 10,000 BDT" },
];

const technologies = [
    { name: "Machine Learning", icon: "fa-brain" },
    { name: "Deep Learning", icon: "fa-network-wired" },
    { name: "Natural Language Processing", icon: "fa-language" },
    { name: "Computer Vision", icon: "fa-eye" },
    { name: "Predictive Analytics", icon: "fa-chart-line" },
    { name: "Neural Networks", icon: "fa-project-diagram" },
];

const industryApplications = [
    {
        industry: "Manufacturing",
        icon: "fa-industry",
        solutions: [
            "Quality Control AI",
            "Predictive Maintenance",
            "Production Optimization",
        ],
    },
    {
        industry: "Retail",
        icon: "fa-store",
        solutions: [
            "Demand Forecasting",
            "Price Optimization",
            "Customer Segmentation",
        ],
    },
    {
