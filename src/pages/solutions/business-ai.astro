---

<MainLayout title="Business AI Solutions - Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-white text-slate-900 selection:bg-purple-500 selection:text-white relative overflow-hidden font-sans">
        <!-- 1. HERO SECTION WITH VIDEO ANIMATION #1 -->
        <section class="relative pt-28 pb-14 sm:pt-36 sm:pb-24 lg:pt-48 lg:pb-36 overflow-hidden bg-gradient-to-r from-purple-100/80 via-indigo-100/70 to-blue-100/60">
            <!-- Background Video with Top-Half Height Fade Cut -->
            <div class="absolute inset-0 pointer-events-none">
                <video
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover scale-105 opacity-50"
                    style="-webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%);"
                >
                    <source src="/videos/business-ai/High_Precision_AI_Engine_in_Ac (1).mp4" type="video/mp4" />
                </video>
                <div class="absolute inset-0 bg-gradient-to-r from-purple-500/25 via-indigo-500/25 to-blue-500/25"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-purple-50/20 to-[#FBFBFD]"></div>
            </div>

            <!-- Bottom Faded Soft Transition Layer -->
            <div class="absolute bottom-0 inset-x-0 h-48 sm:h-60 bg-gradient-to-b from-transparent via-[#FBFBFD]/90 to-[#FBFBFD] pointer-events-none z-10"></div>
            <!-- Soft Faded Bottom Border Line -->
            <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-200/30 to-transparent pointer-events-none z-20"></div>

            <div class="container mx-auto px-4 sm:px-6 relative z-10">
                <div class="max-w-4xl mx-auto text-center mb-8 sm:mb-16">
                    <!-- Glass Badge -->
                    <div class="inline-flex items-center gap-2 sm:gap-2.5 bg-white/70 backdrop-blur-xl border border-purple-200/60 shadow-lg shadow-purple-500/5 px-4 sm:px-5 py-1.5 sm:py-2.5 rounded-full text-purple-700 text-[11px] sm:text-xs md:text-sm font-semibold tracking-wide uppercase mb-4 sm:mb-8 hover:scale-105 transition-transform duration-300">
                        <span class="flex h-2 w-2 rounded-full bg-purple-600 animate-ping"></span>
                        <i class="fas fa-brain text-purple-600"></i> Next-Gen AI Operations
                    </div>

                    <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 leading-[1.1] mb-4 sm:mb-8">
                        Transform Your Business <br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 via-indigo-600 to-blue-600">
                            with Artificial Intelligence
                        </span>
                    </h1>

                    <p class="text-sm sm:text-lg md:text-2xl text-slate-600 max-w-3xl mx-auto font-light leading-relaxed mb-6 sm:mb-10">
                        Intelligent automation, predictive analytics, and data-driven insights. Make smarter decisions faster with AI.
                    </p>

                    <!-- CTAs -->
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-5">
                        <a
                            href="#contact"
                            class="w-full sm:w-auto bg-slate-900 hover:bg-purple-600 text-white px-7 sm:px-10 py-3.5 sm:py-4 rounded-full font-semibold transition-all duration-300 shadow-xl shadow-slate-900/10 hover:shadow-purple-500/25 hover:-translate-y-0.5 text-sm sm:text-base flex items-center justify-center gap-3 group"
                        >
                            <span>Schedule AI Consultation</span>
                            <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
                        </a>
                        <a
                            href="https://wa.me/8801707568468?text=I%20am%20interested%20in%20Business%20AI%20Solutions"
                            target="_blank"
                            class="w-full sm:w-auto bg-white/80 hover:bg-white backdrop-blur-md border border-slate-200 text-slate-800 hover:text-green-600 px-7 sm:px-10 py-3.5 sm:py-4 rounded-full font-semibold transition-all duration-300 shadow-lg shadow-slate-200/50 hover:-translate-y-0.5 text-sm sm:text-base flex items-center justify-center gap-2.5"
                        >
                            <i class="fab fa-whatsapp text-lg text-green-500"></i> WhatsApp Us
                        </a>
                    </div>
                </div>

                <!-- HERO VIDEO ANIMATION #1 (Apple Pro Display Style Glass Frame) -->
                <div class="relative max-w-5xl mx-auto">
                    <div class="relative rounded-2xl sm:rounded-3xl p-2 sm:p-3 md:p-4 bg-white/60 backdrop-blur-2xl border border-white/80 shadow-2xl shadow-slate-300/50">
                        <div class="relative overflow-hidden rounded-xl sm:rounded-2xl bg-slate-900 aspect-video group shadow-inner">
                            <video
                                class="w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-1000 ease-out opacity-90"
                                autoplay
                                loop
                                muted
                                playsinline
                            >
                                <source src="/videos/business-ai/Transform_Your_Business_with_A (1).mp4" type="video/mp4" />
                            </video>
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
                            
                            <!-- Floating Glass Dashboard Overlay -->
                            <div class="absolute bottom-3 left-3 right-3 sm:bottom-6 sm:left-6 sm:right-6 md:bottom-8 md:left-8 md:right-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-2.5 sm:gap-4 bg-white/10 backdrop-blur-xl border border-white/20 p-3.5 sm:p-5 rounded-xl sm:rounded-2xl text-white text-left">
                                <div class="flex items-center gap-3 sm:gap-4">
                                    <div class="w-8 h-8 sm:w-12 sm:h-12 rounded-lg sm:rounded-xl bg-purple-500/30 border border-purple-400/40 flex items-center justify-center text-purple-300 text-sm sm:text-xl shrink-0">
                                        <i class="fas fa-microchip animate-pulse"></i>
                                    </div>
                                    <div>
                                        <div class="text-[10px] sm:text-xs font-medium text-slate-300 uppercase tracking-widest">Live Engine Stream</div>
                                        <div class="text-xs sm:text-lg font-semibold tracking-tight text-white">Real-Time Neural Processing Grid</div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 sm:gap-3 text-[10px] sm:text-xs font-mono bg-white/10 px-2.5 sm:px-4 py-1 sm:py-2 rounded-lg border border-white/10">
                                    <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-emerald-400 animate-ping"></span>
                                    <span>Latency: 1.2ms • Accuracy: 99.4%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. STATS SECTION (Floating Translucent Glass Bar) -->
        <section class="py-6 sm:py-12 relative z-20">
            <div class="container mx-auto px-4 sm:px-6">
                <div class="max-w-5xl mx-auto bg-white/70 backdrop-blur-2xl border border-slate-200/80 shadow-xl shadow-slate-200/50 rounded-2xl sm:rounded-3xl p-5 sm:p-8 md:p-10">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 text-center divide-y-0 md:divide-x divide-slate-100/80">
                        {
                            stats.map((stat, idx) => (
                                <div class={`group ${idx === 0 ? '' : 'md:pl-4'}`}>
                                    <div class="text-2xl sm:text-3xl md:text-5xl font-black tracking-tight text-slate-900 group-hover:text-purple-600 transition-colors duration-300 mb-0.5 sm:mb-1">
                                        {stat.value}
                                    </div>
                                    <div class="text-[10px] sm:text-xs md:text-sm font-semibold text-slate-500 uppercase tracking-wider">
                                        {stat.label}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. TARGET AUDIENCE SECTION -->
        <section class="py-14 sm:py-20 lg:py-24 relative overflow-hidden">
            <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" />
            <div class="container mx-auto px-4 sm:px-6 relative z-10">
                <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-16">
                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-2 sm:mb-4">
                        Who Needs Business AI?
                    </h2>
                    <p class="text-slate-600 text-xs sm:text-base md:text-lg font-light">
                        Engineered to scale enterprises across every high-impact dynamic industry.
                    </p>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5 sm:gap-6 max-w-6xl mx-auto">
                    {
                        targetAudiences.map((item) => (
                            <div class="group bg-white/60 hover:bg-white backdrop-blur-xl border border-slate-200/70 p-4 sm:p-6 rounded-xl sm:rounded-2xl shadow-sm hover:shadow-xl hover:shadow-purple-500/10 hover:-translate-y-1 transition-all duration-300 text-center">
                                <div class="w-11 h-11 sm:w-14 sm:h-14 bg-purple-50 group-hover:bg-purple-600 rounded-xl sm:rounded-2xl flex items-center justify-center text-purple-600 group-hover:text-white mx-auto mb-3 sm:mb-4 text-lg sm:text-2xl transition-all duration-300 shadow-sm">
                                    <i class={`fas ${item.icon}`} />
                                </div>
                                <h3 class="font-bold text-slate-800 text-xs sm:text-sm md:text-base group-hover:text-purple-600 transition-colors">
                                    {item.title}
                                </h3>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 4. KEY BENEFITS SECTION -->
        <section class="py-14 sm:py-20 lg:py-24 bg-slate-50/50 backdrop-blur-3xl border-y border-slate-200/50">
            <div class="container mx-auto px-4 sm:px-6">
                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-20">
                    <h2 class="text-2xl sm:text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-2 sm:mb-4">
                        Why Choose AI for Your Business?
                    </h2>
                    <p class="text-slate-600 text-xs sm:text-base md:text-lg">
                        Unlock decisive competitive advantages with autonomous intelligent systems.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-8 max-w-7xl mx-auto">
                    {
                        benefits.map((benefit) => (
                            <div class="bg-white/80 backdrop-blur-xl p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-slate-200/80 shadow-lg shadow-slate-200/50 hover:shadow-2xl hover:shadow-purple-500/10 hover:-translate-y-1 transition-all duration-300 group text-center">
                                <div class={`w-12 h-12 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl flex items-center justify-center text-xl sm:text-2xl mx-auto mb-4 sm:mb-6 bg-purple-50 text-purple-600 group-hover:scale-110 transition-transform`}>
                                    <i class={`fas ${benefit.icon}`} />
                                </div>
                                <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 sm:mb-3">
                                    {benefit.title}
                                </h3>
                                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-light">
                                    {benefit.description}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 5. VIDEO ANIMATION #2 - FEATURE REVEAL (Apple Style Full Bleed Feature Card) -->
        <section class="py-14 sm:py-20 lg:py-24 relative overflow-hidden">
            <div class="container mx-auto px-4 sm:px-6">
                <div class="max-w-6xl mx-auto bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 rounded-2xl sm:rounded-[2.5rem] overflow-hidden shadow-2xl text-white relative">
                    <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
                        <div class="lg:col-span-6 p-6 sm:p-10 lg:p-16 relative z-10 text-left">
                            <span class="inline-block px-3 sm:px-4 py-1 sm:py-1.5 rounded-full bg-purple-500/20 border border-purple-400/30 text-purple-300 text-[11px] sm:text-xs font-semibold tracking-wider uppercase mb-4 sm:mb-6">
                                The Neural Core
                            </span>
                            <h2 class="text-2xl sm:text-3xl md:text-5xl font-extrabold tracking-tight leading-tight mb-4 sm:mb-6">
                                High-Precision AI Engine in Action
                            </h2>
                            <p class="text-slate-300 text-xs sm:text-base md:text-lg leading-relaxed font-light mb-6 sm:mb-8">
                                Seamlessly integrate computational models into your production workflow. Process unstructured data, automate complex decision trees, and gain complete operational clarity in milliseconds.
                            </p>
                            <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs sm:text-sm font-semibold text-slate-300">
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-shield-alt text-purple-400"></i> Enterprise Encrypted
                                </div>
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-bolt text-amber-400"></i> Ultra Low-Latency
                                </div>
