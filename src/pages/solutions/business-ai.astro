---

<MainLayout title="Business AI Solutions - Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-slate-50">
        <!-- Hero Section -->
        <section
            class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden bg-[#0c1b3d]"
        >
            <div
                class="absolute inset-0 bg-gradient-to-br from-[#0c1b3d] via-[#1a2c5a] to-[#0c1b3d]"
            >
            </div>
            <div
                class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-purple-500/10 to-transparent blur-3xl"
            >
            </div>

            <div class="container mx-auto px-6 relative z-10 text-center">
                <div
                    class="inline-flex items-center gap-2 bg-purple-500/10 border border-purple-500/20 px-4 py-2 rounded-full text-purple-400 text-sm font-semibold mb-6"
                >
                    <i class="fas fa-brain"></i> AI-Powered Business Intelligence
                </div>
                <h1
                    class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-[1.2]"
                >
                    Transform Your Business <br />with <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400"
                        >Artificial Intelligence</span
                    >
                </h1>
                <p
                    class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed"
                >
                    Intelligent automation, predictive analytics, and
                    data-driven insights. Make smarter decisions faster with AI.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a
                        href="#contact"
                        class="bg-purple-600 hover:bg-purple-700 text-white px-10 py-4 rounded-full font-bold transition-all shadow-lg shadow-purple-600/20 text-lg"
                    >
                        Schedule AI Consultation
                    </a>
                    <a
                        href="https://wa.me/8801707568468?text=I%20am%20interested%20in%20Business%20AI%20Solutions"
                        target="_blank"
                        class="bg-green-500 hover:bg-green-600 text-white px-10 py-4 rounded-full font-bold transition-all shadow-lg shadow-green-500/20 flex items-center justify-center gap-2 text-lg"
                    >
                        <i class="fab fa-whatsapp"></i> WhatsApp Us
                    </a>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="py-16 bg-white border-b border-gray-100">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                    {
                        stats.map((stat) => (
                            <div class="group">
                                <div class="text-4xl font-extrabold text-[#0c1b3d] mb-2 group-hover:text-purple-600 transition-colors">
                                    {stat.value}
                                </div>
                                <div class="text-sm font-bold text-gray-400 uppercase tracking-widest">
                                    {stat.label}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Who Needs Business AI -->
        <section class="py-16 bg-slate-50 border-y border-gray-100">
            <div class="container mx-auto px-6">
                <h2
                    class="text-2xl md:text-3xl font-bold text-center text-[#0c1b3d] mb-12"
                >
                    Who Needs Business AI?
                </h2>
                <div
                    class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6"
                >
                    {
                        targetAudiences.map((item) => (
                            <div class="bg-white p-6 rounded-xl shadow-sm text-center hover:shadow-md transition-shadow">
                                <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center text-purple-600 mx-auto mb-4 text-xl">
                                    <i class={`fas ${item.icon}`} />
                                </div>
                                <h3 class="font-bold text-gray-800 text-sm">
                                    {item.title}
                                </h3>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Key Benefits -->
        <section class="py-20 bg-white">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-bold text-[#0c1b3d] mb-4">
                        Why Choose AI for Your Business?
                    </h2>
                    <p class="text-gray-600">
                        Unlock competitive advantages with intelligent
                        automation
                    </p>
                </div>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    {
                        benefits.map((benefit) => (
                            <div class="text-center p-6 border border-gray-100 rounded-2xl hover:border-purple-200 transition-colors">
                                <div
                                    class={`w-16 h-16 bg-${benefit.color}-50 rounded-2xl flex items-center justify-center text-${benefit.color}-600 text-3xl mx-auto mb-6`}
                                >
                                    <i class={`fas ${benefit.icon}`} />
                                </div>
                                <h3 class="text-xl font-bold mb-2">
                                    {benefit.title}
                                </h3>
                                <p class="text-gray-500 text-sm">
                                    {benefit.description}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- AI Solutions Breakdown -->
        <section class="py-20 bg-slate-50">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-bold text-[#0c1b3d] mb-4">
                        Comprehensive AI Solutions
                    </h2>
                    <p class="text-gray-600">
                        From automation to analytics, we cover all your AI needs
                    </p>
                </div>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    {
                        aiSolutions.map((category) => (
                            <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-gray-100">
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center text-purple-600 text-xl">
                                        <i class={`fas ${category.icon}`} />
                                    </div>
                                    <h3 class="font-bold text-[#0c1b3d] text-lg">
                                        {category.title}
                                    </h3>
                                </div>
                                <ul class="space-y-3">
                                    {category.items.map((item) => (
                                        <li class="flex items-center gap-3 text-gray-600 text-sm font-medium">
                                            <i class="fas fa-check-circle text-green-500" />{" "}
                                            {item}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- AI Use Cases / Interactive Modules -->
        <section class="py-24 bg-white" id="use-cases">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl md:text-5xl font-bold text-[#0c1b3d] mb-4"
                    >
                        AI Solutions That Drive Results
                    </h2>
                    <p class="text-gray-600 max-w-3xl mx-auto">
                        Real-world AI applications that transform how you do
                        business
                    </p>
                </div>

                <div
                    class="bg-white rounded-3xl shadow-xl border border-gray-100 p-8 md:p-12"
                >
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                        <!-- Sidebar Navigation -->
                        <div class="lg:col-span-4 flex flex-col gap-3">
                            {
                                useCases.map((useCase, index) => (
                                    <button
                                        class={`module-btn w-full text-left px-6 py-4 rounded-xl border border-gray-100 font-semibold transition-all duration-300 flex items-center justify-between group
                    ${index === 0 ? "bg-white border-purple-500 shadow-md text-purple-600 ring-1 ring-purple-500" : "bg-gray-50 text-gray-600 hover:bg-white hover:shadow-md"}`}
                                        data-id={useCase.id}
                                    >
                                        {useCase.title}
                                        <i
                                            class={`fas fa-arrow-right transform transition-transform group-hover:translate-x-1 ${index === 0 ? "text-purple-600" : "text-gray-300"}`}
                                        />
                                    </button>
                                ))
                            }
                        </div>

                        <!-- Content Area -->
                        <div class="lg:col-span-8 relative min-h-[400px]">
                            {
                                useCases.map((useCase, index) => (
                                    <div
                                        id={`content-${useCase.id}`}
                                        class={`module-content transition-all duration-500 absolute inset-0 
                    ${index === 0 ? "opacity-100 z-10 translate-y-0" : "opacity-0 -z-10 translate-y-4"}`}
                                    >
                                        <div class="flex flex-col h-full justify-center">
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                                                <div>
                                                    <h3 class="text-3xl font-bold text-[#0c1b3d] mb-4 border-l-4 border-purple-500 pl-4">
                                                        {useCase.title}
                                                    </h3>
                                                    <p class="text-gray-600 mb-8 leading-relaxed text-lg">
                                                        {useCase.description}
                                                    </p>
                                                    <a
                                                        href={useCase.link}
                                                        class="inline-block bg-purple-500 hover:bg-purple-600 text-white px-8 py-3 rounded-full font-bold transition-colors shadow-lg shadow-purple-500/30"
                                                    >
                                                        Learn More
                                                    </a>
                                                </div>
                                                <div class="relative group">
                                                    <div class="absolute -inset-4 bg-purple-500/10 blur-xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                                                    <img
                                                        src={useCase.image}
                                                        alt={useCase.title}
                                                        class="rounded-lg shadow-2xl border border-gray-100 relative z-10 transform transition-transform duration-500 hover:scale-[1.02]"
                                                    />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Process / How It Works -->
        <section class="py-20 bg-slate-50 border-b border-gray-100">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-bold text-[#0c1b3d] mb-4">
                        Our AI Implementation Process
                    </h2>
                    <p class="text-gray-600">
                        From discovery to deployment in 5 strategic steps
                    </p>
                </div>

                <div class="relative">
                    <!-- Connecting Line (Desktop) -->
                    <div
                        class="hidden md:block absolute top-1/2 left-0 w-full h-1 bg-gray-100 -translate-y-1/2 z-0"
                    >
                    </div>

                    <div
                        class="grid grid-cols-1 md:grid-cols-5 gap-8 relative z-10"
                    >
                        {
                            processSteps.map((step, index) => (
                                <div class="group">
                                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm group-hover:shadow-md transition-all text-center relative">
                                        <div class="w-10 h-10 bg-purple-600 text-white rounded-full flex items-center justify-center font-bold absolute -top-5 left-1/2 -translate-x-1/2 border-4 border-white shadow-sm">
                                            {index + 1}
                                        </div>
                                        <div class="mt-6 mb-3 text-purple-600 text-3xl">
                                            <i class={`fas ${step.icon}`} />
                                        </div>
                                        <h3 class="font-bold text-[#0c1b3d] text-sm">
                                            {step.title}
                                        </h3>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Packages -->
        <section class="py-20 bg-white">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-bold text-[#0c1b3d] mb-4">
                        AI Solutions for Every Business Size
                    </h2>
                    <p class="text-gray-600">
                        Flexible pricing to match your needs and budget
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto mb-16"
                >
                    {
                        pricingPackages.map((pkg) => (
                            <div
                                class={`relative bg-white rounded-2xl p-8 border-2 transition-transform hover:-translate-y-2 ${pkg.isPopular ? "border-purple-500 shadow-xl" : "border-gray-100 shadow-sm"}`}
                            >
                                {pkg.isPopular && (
                                    <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-purple-500 text-white px-4 py-1 rounded-full text-sm font-bold shadow-md">
                                        Most Popular
                                    </div>
                                )}
                                <div class="text-center mb-8">
                                    <h3 class="text-2xl font-bold text-gray-800 mb-2">
                                        {pkg.name}
                                    </h3>
                                    <div
                                        class={`inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-4 bg-${pkg.color}-50 text-${pkg.color}-600`}
                                    >
                                        {pkg.bestFor}
                                    </div>
                                    <div class="text-3xl font-bold text-[#0c1b3d]">
                                        {pkg.price}
                                    </div>
                                </div>

                                <div class="space-y-4 mb-8">
                                    <h4 class="font-bold text-gray-700 text-sm uppercase border-b pb-2">
                                        What's Included
                                    </h4>
                                    <ul class="space-y-3">
                                        {pkg.features.map((feature) => (
                                            <li class="flex items-start gap-3 text-sm text-gray-600">
                                                <i class="fas fa-check text-green-500 mt-1" />
                                                <span>{feature}</span>
                                            </li>
