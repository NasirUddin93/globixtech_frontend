    <script>
        // Interactive Use Cases Tab Switcher Logic
        document.addEventListener("DOMContentLoaded", () => {
            const moduleButtons = document.querySelectorAll(".module-btn");
            const moduleContents = document.querySelectorAll(".module-content");

            moduleButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    const targetId = button.getAttribute("data-id");

                    moduleButtons.forEach((btn) => {
                        btn.classList.remove("bg-slate-900", "border-slate-900", "shadow-xl", "text-white");
                        btn.classList.add("bg-slate-50/80", "border-slate-200/70", "text-slate-700", "hover:bg-white");
                        const icon = btn.querySelector("i");
                        if (icon) {
                            icon.classList.remove("text-purple-400");
                            icon.classList.add("text-slate-400");
                        }
                    });

                    button.classList.remove("bg-slate-50/80", "border-slate-200/70", "text-slate-700", "hover:bg-white");
                    button.classList.add("bg-slate-900", "border-slate-900", "shadow-xl", "text-white");
                    const activeIcon = button.querySelector("i");
                    if (activeIcon) {
                        activeIcon.classList.remove("text-slate-400");
                        activeIcon.classList.add("text-purple-400");
                    }

                    moduleContents.forEach((content) => {
                        content.classList.remove("block", "opacity-100", "translate-y-0", "scale-100");
                        content.classList.add("hidden", "opacity-0", "translate-y-6", "scale-95");
                    });

                    const targetContent = document.getElementById(`content-${targetId}`);
                    if (targetContent) {
                        targetContent.classList.remove("hidden");
                        setTimeout(() => {
                            targetContent.classList.remove("opacity-0", "translate-y-6", "scale-95");
                            targetContent.classList.add("block", "opacity-100", "translate-y-0", "scale-100");
                        }, 20);
                    }
                });
            });
        });
    </script>
