];

const comparisons = [
    {
        aspect: "Speed",
        ai: "Instant Analysis",
        traditional: "Hours to Days",
        aiIcon: "fa-bolt",
    },
    {
        aspect: "Accuracy",
        ai: "99%+ Precision",
        traditional: "70-80% Accuracy",
        aiIcon: "fa-bullseye",
    },
    {
        aspect: "Cost",
        ai: "Low Long-term",
        traditional: "High Ongoing",
        aiIcon: "fa-dollar-sign",
    },
    {
        aspect: "Scalability",
        ai: "Unlimited Scale",
        traditional: "Limited by Staff",
        aiIcon: "fa-expand-arrows-alt",
    },
    {
        aspect: "Availability",
        ai: "24/7 Operations",
        traditional: "Business Hours",
        aiIcon: "fa-clock",
    },
];

const caseStudies = [
    {
        name: "Bangladesh Garments Ltd",
        industry: "Manufacturing",
        rating: 5,
        text: "AI-powered quality control reduced defects by 60% and saved us millions. The predictive maintenance system prevents machine breakdowns before they happen.",
        result: "60% Defect Reduction",
        location: "Dhaka",
    },
    {
        name: "ShopBD Online",
        industry: "E-commerce",
        rating: 5,
        text: "Sales forecasting AI helped us optimize inventory and increase revenue by 40%. We now know exactly what to stock and when. Customer segmentation boosted our marketing ROI significantly.",
        result: "40% Revenue Increase",
        location: "Chittagong",
    },
    {
        name: "Swift Logistics",
        industry: "Logistics",
        rating: 5,
        text: "Route optimization AI cut our delivery costs by 30% and improved on-time delivery to 95%. The system learns from traffic patterns and weather to find the best routes automatically.",
        result: "30% Cost Savings",
        location: "Sylhet",
    },
];

const faqs = [
    {
        question: "What is Business AI?",
        answer: "Business AI refers to artificial intelligence solutions designed specifically for business operations. It includes automation tools, predictive analytics, data processing, and intelligent decision-making systems that help businesses work smarter, faster, and more efficiently.",
    },
    {
        question: "Do I need technical knowledge to use AI?",
        answer: "No! We design our AI solutions with user-friendly interfaces that anyone can use. We provide complete training and ongoing support. You focus on your business decisions while AI handles the complex technical work behind the scenes.",
    },
    {
        question: "How long does AI implementation take?",
        answer: "It depends on complexity. Starter solutions take 15-20 days, Business AI takes 30-45 days, and Enterprise solutions take 60+ days. We work in phases so you can start seeing benefits early in the process.",
    },
    {
