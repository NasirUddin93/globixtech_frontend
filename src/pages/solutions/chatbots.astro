    {
        title: "Automation",
        icon: "fa-robot",
        items: [
            "Auto-replies",
            "Lead Capture",
            "Appointment Booking",
            "Order Tracking",
        ],
    },
    {
        title: "Analytics",
        icon: "fa-chart-bar",
        items: [
            "Conversation Logs",
            "User Insights",
            "Performance Metrics",
            "Export Reports",
        ],
    },
];

const useCases = [
    {
        id: "customer-support",
        title: "Customer Support Bot",
        description:
            "Handle FAQs, complaints, and general inquiries automatically. Your bot can answer common questions about business hours, return policies, shipping info, and more. Escalate complex issues to human agents seamlessly.",
        image: "/sms_mockup.png",
        link: "#",
    },
    {
        id: "ecommerce",
        title: "E-commerce Bot",
        description:
            "Provide product recommendations based on customer preferences, track orders in real-time, recover abandoned carts with personalized messages, and process simple transactions directly through chat.",
        image: "/sms_mockup.png",
        link: "#",
    },
    {
        id: "appointment",
        title: "Appointment Booking Bot",
        description:
            "Let customers schedule meetings, consultations, or service appointments 24/7. Send automated reminders via SMS or chat, handle rescheduling requests, and sync with your calendar system.",
        image: "/sms_mockup.png",
        link: "#",
    },
    {
        id: "lead-gen",
        title: "Lead Generation Bot",
        description:
            "Qualify leads through intelligent conversation flows, collect contact information, assess customer needs, and route high-quality leads to your sales team with complete conversation context.",
        image: "/sms_mockup.png",
        link: "#",
    },
    {
        id: "restaurant",
        title: "Restaurant Bot",
        description:
            "Display your menu with photos and prices, take orders directly through Facebook or WhatsApp, track delivery status, handle table reservations, and collect customer feedback automatically.",
        image: "/sms_mockup.png",
        link: "#",
    },
    {
        id: "education",
        title: "Education Bot",
        description:
            "Answer course inquiries, provide admission information, handle fee payment queries, share class schedules, send assignment reminders, and keep students and parents informed about important updates.",
        image: "/sms_mockup.png",
        link: "#",
    },
];

const processSteps = [
    { title: "Requirement Analysis", icon: "fa-comments" },
    { title: "Bot Design", icon: "fa-pencil-ruler" },
    { title: "Development & Training", icon: "fa-code" },
    { title: "Integration", icon: "fa-plug" },
    { title: "Launch & Support", icon: "fa-rocket" },
];

const pricingPackages = [
    {
        name: "Basic",
        price: "8,000–12,000 BDT",
        bestFor: "Small Business",
        color: "blue",
        features: [
            "Single Platform (Facebook OR Website)",
            "Up to 500 Conversations/Month",
            "Basic NLP",
            "Bangla + English Support",
            "Standard Response Templates",
        ],
        delivery: "7-10 Days",
        support: "1 Month Free Support",
    },
    {
        name: "Standard",
        price: "20,000–30,000 BDT",
        bestFor: "Growing Business",
        isPopular: true,
        color: "green",
        features: [
            "Multi-Platform (Facebook + Website + WhatsApp)",
            "Up to 2000 Conversations/Month",
            "Advanced NLP & AI",
            "CRM Integration",
            "Analytics Dashboard",
            "Custom Conversation Flows",
        ],
        delivery: "15-20 Days",
        support: "3 Months Free Support",
    },
    {
        name: "Premium",
        price: "50,000+ BDT",
        bestFor: "Enterprise",
        color: "purple",
        features: [
            "Unlimited Platforms",
            "Unlimited Conversations",
            "Custom AI Training",
            "API Integration",
            "Voice Bot (Optional)",
            "Dedicated Support Team",
            "Priority Updates",
        ],
        delivery: "30+ Days",
        support: "6 Months Free Support",
    },
];

const addOns = [
    { name: "Voice Bot Integration", price: "Starting @ 15,000 BDT" },
    { name: "CRM Integration", price: "Starting @ 5,000 BDT" },
    { name: "Custom AI Training", price: "Ask for Quote" },
    { name: "Monthly Maintenance", price: "Starting @ 2,000 BDT" },
];

const platforms = [
    {
        name: "Facebook Messenger",
        icon: "fa-facebook-messenger",
        color: "blue",
    },
    { name: "WhatsApp Business", icon: "fa-whatsapp", color: "green" },
    { name: "Website Widget", icon: "fa-globe", color: "purple" },
    { name: "Instagram DM", icon: "fa-instagram", color: "pink" },
    { name: "Telegram", icon: "fa-telegram", color: "cyan" },
    { name: "Viber", icon: "fa-viber", color: "purple" },
];

const industrySolutions = [
    {
        industry: "E-commerce",
        icon: "fa-shopping-bag",
        solutions: ["Product Search", "Order Status", "Returns & Refunds"],
    },
    {
        industry: "Healthcare",
        icon: "fa-heartbeat",
        solutions: [
            "Appointment Booking",
            "Symptom Checker",
            "Prescription Reminder",
        ],
    },
    {
        industry: "Education",
        icon: "fa-graduation-cap",
        solutions: ["Course Info", "Admission Process", "Fee Payment"],
    },
    {
        industry: "Real Estate",
        icon: "fa-home",
        solutions: ["Property Search", "Viewing Schedule", "Price Inquiry"],
    },
    {
        industry: "Banking",
        icon: "fa-university",
        solutions: ["Balance Inquiry", "Transaction History", "Card Services"],
    },
    {
        industry: "Hospitality",
        icon: "fa-hotel",
        solutions: ["Room Booking", "Menu Orders", "Service Requests"],
    },
];

const techStack = [
    { name: "Natural Language Processing", icon: "fa-brain" },
    { name: "Machine Learning Models", icon: "fa-robot" },
    { name: "Sentiment Analysis", icon: "fa-smile" },
    { name: "Multi-language Support", icon: "fa-language" },
    { name: "Cloud Infrastructure", icon: "fa-cloud" },
    { name: "Secure Encryption", icon: "fa-lock" },
];

const testimonials = [
    {
        name: "Sadia Rahman",
        business: "Fashion Store BD",
        rating: 5,
        text: "Our chatbot handles 80% of customer inquiries automatically! We can now focus on complex orders while the bot answers size, shipping, and return questions 24/7.",
        location: "Dhaka",
    },
    {
        name: "Dr. Kamal Hossain",
        business: "City Dental Clinic",
        rating: 5,
        text: "Appointment booking is now completely automated. Patients can book, reschedule, and get reminders through Facebook Messenger. It's been a game-changer for our clinic.",
        location: "Chittagong",
    },
    {
        name: "Rifat Ahmed",
        business: "Tech Solutions Ltd",
        rating: 5,
        text: "The lead generation bot qualifies prospects before they reach our sales team. We've seen a 3x increase in quality leads and our conversion rate has doubled!",
        location: "Sylhet",
    },
];

const faqs = [
    {
        question: "How does the chatbot understand Bangla?",
        answer: "Our chatbots use advanced Natural Language Processing (NLP) trained specifically for Bangla and Bengali dialects. They can understand informal chat language, common misspellings, and mixed Bangla-English (Banglish) conversations.",
    },
    {
        question: "Can it integrate with my existing website?",
        answer: "Yes! We provide a simple embed code that works with any website platform including WordPress, Shopify, custom HTML sites, and more. Installation takes just 5 minutes.",
    },
    {
        question: "What platforms are supported?",
        answer: "We support Facebook Messenger, WhatsApp Business, Instagram DM, Telegram, Viber, and website chat widgets. You can have one bot working across all platforms simultaneously.",
    },
    {
        question: "Is there a monthly cost?",
        answer: "Our packages include free support for 1-6 months depending on the plan. After that, optional monthly maintenance starts from 2,000 BDT for updates, monitoring, and improvements.",
    },
    {
        question: "How long does setup take?",
        answer: "Basic bots can be ready in 7-10 days. Standard bots take 15-20 days, and custom enterprise solutions take 30+ days depending on complexity and integrations required.",
    },
    {
        question: "Can I customize the responses?",
        answer: "Absolutely! You get full control over conversation flows, responses, and bot personality. We provide a user-friendly dashboard where you can update responses anytime without coding.",
    },
];
---

<MainLayout title="AI Chatbot Solutions - Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-slate-50">
        <!-- Hero Section -->
        <section
            class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden bg-[#0c1b3d]"
        >
            <div
                class="absolute inset-0 bg-gradient-to-br from-[#0c1b3d] via-[#1a2c5a] to-[#0c1b3d]"
            >
            </div>
            <div
                class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-cyan-500/10 to-transparent blur-3xl"
            >
            </div>

            <div class="container mx-auto px-6 relative z-10 text-center">
                <div
                    class="inline-flex items-center gap-2 bg-cyan-500/10 border border-cyan-500/20 px-4 py-2 rounded-full text-cyan-400 text-sm font-semibold mb-6"
                >
                    <i class="fas fa-robot"></i> AI-Powered Automation
                </div>
                <h1
                    class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-[1.2]"
                >
                    AI-Powered Chatbots <br />for <span class="text-cyan-400"
                        >Your Business</span
                    >
                </h1>
                <p
                    class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed"
                >
                    Automate customer support, generate leads, and boost sales
                    with intelligent chatbots. Available 24/7 in Bangla &
                    English.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a
                        href="#contact"
                        class="bg-cyan-600 hover:bg-cyan-700 text-white px-10 py-4 rounded-full font-bold transition-all shadow-lg shadow-cyan-600/20 text-lg"
                    >
                        Get Free Demo
                    </a>
                    <a
                        href="https://wa.me/8801707568468?text=I%20am%20interested%20in%20Chatbot%20Solution"
                        target="_blank"
                        class="bg-green-500 hover:bg-green-600 text-white px-10 py-4 rounded-full font-bold transition-all shadow-lg shadow-green-500/20 flex items-center justify-center gap-2 text-lg"
                    >
                        <i class="fab fa-whatsapp"></i> Call / WhatsApp
                    </a>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="py-16 bg-white border-b border-gray-100">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                    {
                        stats.map((stat) => (
                            <div class="group">
                                <div class="text-4xl font-extrabold text-[#0c1b3d] mb-2 group-hover:text-cyan-600 transition-colors">
                                    {stat.value}
                                </div>
                                <div class="text-sm font-bold text-gray-400 uppercase tracking-widest">
                                    {stat.label}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Who This Is For -->
        <section class="py-16 bg-slate-50 border-y border-gray-100">
            <div class="container mx-auto px-6">
                <h2
                    class="text-2xl md:text-3xl font-bold text-center text-[#0c1b3d] mb-12"
                >
                    Perfect for Every Business
                </h2>
                <div
                    class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6"
                >
                    {
                        targetAudiences.map((item) => (
                            <div class="bg-white p-6 rounded-xl shadow-sm text-center hover:shadow-md transition-shadow">
                                <div class="w-12 h-12 bg-cyan-100 rounded-full flex items-center justify-center text-cyan-600 mx-auto mb-4 text-xl">
                                    <i class={`fas ${item.icon}`} />
                                </div>
                                <h3 class="font-bold text-gray-800 text-sm">
                                    {item.title}
                                </h3>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Key Benefits -->
        <section class="py-20 bg-white">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-bold text-[#0c1b3d] mb-4">
                        Why Choose Our Chatbots?
                    </h2>
                    <p class="text-gray-600">
                        Powerful AI to transform your customer experience
                    </p>
                </div>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    {
                        benefits.map((benefit) => (
                            <div class="text-center p-6 border border-gray-100 rounded-2xl hover:border-cyan-200 transition-colors">
                                <div
                                    class={`w-16 h-16 bg-${benefit.color}-50 rounded-2xl flex items-center justify-center text-${benefit.color}-600 text-3xl mx-auto mb-6`}
                                >
                                    <i class={`fas ${benefit.icon}`} />
                                </div>
                                <h3 class="text-xl font-bold mb-2">
                                    {benefit.title}
                                </h3>
                                <p class="text-gray-500 text-sm">
                                    {benefit.description}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Features Breakdown -->
        <section class="py-20 bg-slate-50">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-bold text-[#0c1b3d] mb-4">
                        Powerful Chatbot Features
                    </h2>
                    <p class="text-gray-600">
                        Everything you need to automate customer interactions
                    </p>
                </div>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    {
                        featuresByCategory.map((category) => (
                            <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-gray-100">
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="w-12 h-12 bg-cyan-50 rounded-xl flex items-center justify-center text-cyan-600 text-xl">
                                        <i class={`fas ${category.icon}`} />
                                    </div>
                                    <h3 class="font-bold text-[#0c1b3d] text-lg">
                                        {category.title}
                                    </h3>
                                </div>
                                <ul class="space-y-3">
                                    {category.items.map((item) => (
                                        <li class="flex items-center gap-3 text-gray-600 text-sm font-medium">
                                            <i class="fas fa-check-circle text-green-500" />{" "}
                                            {item}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Use Cases / Interactive Modules -->
        <section class="py-24 bg-white" id="use-cases">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl md:text-5xl font-bold text-[#0c1b3d] mb-4"
                    >
                        Chatbot Solutions for Every Need
                    </h2>
                    <p class="text-gray-600 max-w-3xl mx-auto">
                        From customer support to sales automation, our
                        intelligent bots handle it all with natural
                        conversations.
                    </p>
                </div>

                <div
                    class="bg-white rounded-3xl shadow-xl border border-gray-100 p-8 md:p-12"
                >
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                        <!-- Sidebar Navigation -->
                        <div class="lg:col-span-4 flex flex-col gap-3">
                            {
                                useCases.map((useCase, index) => (
                                    <button
                                        class={`module-btn w-full text-left px-6 py-4 rounded-xl border border-gray-100 font-semibold transition-all duration-300 flex items-center justify-between group
                    ${index === 0 ? "bg-white border-cyan-500 shadow-md text-cyan-600 ring-1 ring-cyan-500" : "bg-gray-50 text-gray-600 hover:bg-white hover:shadow-md"}`}
                                        data-id={useCase.id}
                                    >
                                        {useCase.title}
                                        <i
                                            class={`fas fa-arrow-right transform transition-transform group-hover:translate-x-1 ${index === 0 ? "text-cyan-600" : "text-gray-300"}`}
                                        />
                                    </button>
                                ))
                            }
                        </div>

                        <!-- Content Area -->
                        <div class="lg:col-span-8 relative min-h-[400px]">
                            {
                                useCases.map((useCase, index) => (
                                    <div
                                        id={`content-${useCase.id}`}
                                        class={`module-content transition-all duration-500 absolute inset-0 
                    ${index === 0 ? "opacity-100 z-10 translate-y-0" : "opacity-0 -z-10 translate-y-4"}`}
                                    >
                                        <div class="flex flex-col h-full justify-center">
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                                                <div>
                                                    <h3 class="text-3xl font-bold text-[#0c1b3d] mb-4 border-l-4 border-cyan-500 pl-4">
                                                        {useCase.title}
                                                    </h3>
                                                    <p class="text-gray-600 mb-8 leading-relaxed text-lg">
                                                        {useCase.description}
                                                    </p>
                                                    <a
                                                        href={useCase.link}
                                                        class="inline-block bg-cyan-500 hover:bg-cyan-600 text-white px-8 py-3 rounded-full font-bold transition-colors shadow-lg shadow-cyan-500/30"
                                                    >
                                                        See Demo
                                                    </a>
                                                </div>
                                                <div class="relative group">
                                                    <div class="absolute -inset-4 bg-cyan-500/10 blur-xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                                                    <img
                                                        src={useCase.image}
                                                        alt={useCase.title}
                                                        class="rounded-lg shadow-2xl border border-gray-100 relative z-10 transform transition-transform duration-500 hover:scale-[1.02]"
                                                    />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Process / How It Works -->
        <section class="py-20 bg-slate-50 border-b border-gray-100">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-bold text-[#0c1b3d] mb-4">
                        How It Works
                    </h2>
                    <p class="text-gray-600">
                        Our simple 5-step process to get your bot live
                    </p>
                </div>

                <div class="relative">
                    <!-- Connecting Line (Desktop) -->
                    <div
                        class="hidden md:block absolute top-1/2 left-0 w-full h-1 bg-gray-100 -translate-y-1/2 z-0"
                    >
                    </div>

                    <div
                        class="grid grid-cols-1 md:grid-cols-5 gap-8 relative z-10"
                    >
                        {
                            processSteps.map((step, index) => (
                                <div class="group">
                                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm group-hover:shadow-md transition-all text-center relative">
                                        <div class="w-10 h-10 bg-cyan-600 text-white rounded-full flex items-center justify-center font-bold absolute -top-5 left-1/2 -translate-x-1/2 border-4 border-white shadow-sm">
                                            {index + 1}
                                        </div>
                                        <div class="mt-6 mb-3 text-cyan-600 text-3xl">
                                            <i class={`fas ${step.icon}`} />
                                        </div>
                                        <h3 class="font-bold text-[#0c1b3d] text-sm">
                                            {step.title}
                                        </h3>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Packages -->
        <section class="py-20 bg-white">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-bold text-[#0c1b3d] mb-4">
                        Transparent Pricing Packages
                    </h2>
                    <p class="text-gray-600">
                        Choose the plan that fits your business needs. No hidden
                        costs.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto mb-16"
                >
                    {
                        pricingPackages.map((pkg) => (
                            <div
                                class={`relative bg-white rounded-2xl p-8 border-2 transition-transform hover:-translate-y-2 ${pkg.isPopular ? "border-green-500 shadow-xl" : "border-gray-100 shadow-sm"}`}
                            >
                                {pkg.isPopular && (
                                    <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-green-500 text-white px-4 py-1 rounded-full text-sm font-bold shadow-md">
                                        Most Popular
                                    </div>
                                )}
                                <div class="text-center mb-8">
                                    <h3 class="text-2xl font-bold text-gray-800 mb-2">
                                        {pkg.name}
                                    </h3>
                                    <div
                                        class={`inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-4 bg-${pkg.color}-50 text-${pkg.color}-600`}
                                    >
                                        {pkg.bestFor}
                                    </div>
                                    <div class="text-3xl font-bold text-[#0c1b3d]">
                                        {pkg.price}
                                    </div>
                                </div>

                                <div class="space-y-4 mb-8">
                                    <h4 class="font-bold text-gray-700 text-sm uppercase border-b pb-2">
                                        What's Included
                                    </h4>
                                    <ul class="space-y-3">
                                        {pkg.features.map((feature) => (
                                            <li class="flex items-start gap-3 text-sm text-gray-600">
                                                <i class="fas fa-check text-green-500 mt-1" />
                                                <span>{feature}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>

                                <div class="bg-gray-50 -mx-8 -mb-8 p-6 rounded-b-2xl border-t border-gray-100">
                                    <div class="grid grid-cols-2 gap-4 text-center text-sm mb-6">
                                        <div>
                                            <div class="text-gray-400 font-semibold text-xs uppercase">
                                                Delivery
                                            </div>
                                            <div class="font-bold text-[#0c1b3d]">
                                                {pkg.delivery}
                                            </div>
                                        </div>
                                        <div>
                                            <div class="text-gray-400 font-semibold text-xs uppercase">
