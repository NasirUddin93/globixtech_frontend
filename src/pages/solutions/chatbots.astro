---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const stats = [
    { label: "Conversations/Day", value: "1000+" },
    { label: "Response Accuracy", value: "95%" },
    { label: "Availability", value: "24/7" },
    { label: "Cost Reduction", value: "50%" },
];

const targetAudiences = [
    { title: "E-commerce Stores", icon: "fa-shopping-cart" },
    { title: "Service Businesses", icon: "fa-briefcase" },
    { title: "Educational Institutes", icon: "fa-graduation-cap" },
    { title: "Healthcare Providers", icon: "fa-heartbeat" },
    { title: "Real Estate Agencies", icon: "fa-building" },
    { title: "Restaurants & Cafes", icon: "fa-utensils" },
];

const benefits = [
    {
        title: "24/7 Customer Support",
        description: "Never miss a customer inquiry, even at midnight",
        icon: "fa-clock",
        color: "blue",
    },
    {
        title: "Lead Generation",
        description: "Capture and qualify leads automatically",
        icon: "fa-chart-line",
        color: "pink",
    },
    {
        title: "Multi-Platform",
        description: "Facebook, Website, WhatsApp integration",
        icon: "fa-globe",
        color: "green",
    },
    {
        title: "Bangla + English",
        description: "Full bilingual support for Bangladesh",
        icon: "fa-language",
        color: "purple",
    },
];

