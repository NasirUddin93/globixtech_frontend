    {
        title: "Core Features",
        icon: "fa-brain",
        items: [
            "Natural Language Processing",
            "Multi-language Support",
            "Intent Recognition",
            "Context Awareness",
        ],
    },
    {
        title: "Integration",
        icon: "fa-plug",
        items: [
            "Facebook Messenger",
            "WhatsApp Business",
            "Website Widget",
            "Instagram DM",
