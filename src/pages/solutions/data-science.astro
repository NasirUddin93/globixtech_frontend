    { name: "Monthly Maintenance", price: "Starting @ 8,000 BDT" },
];

const tools = [
    { name: "Python & R", icon: "fa-code" },
    { name: "Power BI", icon: "fa-chart-bar" },
    { name: "Tableau", icon: "fa-chart-pie" },
    { name: "SQL Databases", icon: "fa-database" },
    { name: "Apache Spark", icon: "fa-fire" },
