            "Complete Data Science Platform",
            "AI/ML Integration",
            "Custom Data Pipelines",
            "Dedicated Data Scientist",
            "24/7 Monitoring",
            "12 Months Support",
        ],
        delivery: "45-60 Days",
        support: "12 Months Support",
    },
];

const addOns = [
    { name: "Data Pipeline Setup", price: "Starting @ 15,000 BDT" },
    { name: "ML Model Training", price: "Starting @ 25,000 BDT" },
