---

<MainLayout title="Data Science Solutions - Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-[#fbfbfd] text-slate-900 font-sans selection:bg-blue-500 selection:text-white relative overflow-hidden">
        

        <!-- HERO SECTION -->
        <section class="relative pt-28 pb-14 sm:pt-36 sm:pb-24 lg:pt-48 lg:pb-36 px-4 sm:px-6 overflow-hidden bg-gradient-to-r from-blue-100/80 via-indigo-100/70 to-cyan-100/60">
            <!-- Background Video with Top-Half Height Fade Cut -->
            <div class="absolute inset-0 pointer-events-none">
                <video
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover scale-105 opacity-50"
                    style="-webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%);"
                >
                    <source src="/videos/data-science/Turn_Raw_Data_into_Actionable.mp4" type="video/mp4" />
                </video>
                <div class="absolute inset-0 bg-gradient-to-r from-blue-500/25 via-indigo-500/25 to-cyan-500/25"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-blue-50/20 to-[#FBFBFD]"></div>
            </div>

            <!-- Bottom Faded Soft Transition Layer -->
            <div class="absolute bottom-0 inset-x-0 h-48 sm:h-60 bg-gradient-to-b from-transparent via-[#FBFBFD]/90 to-[#FBFBFD] pointer-events-none z-10"></div>
            <!-- Soft Faded Bottom Border Line -->
            <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-200/30 to-transparent pointer-events-none z-20"></div>

            <div class="max-w-7xl mx-auto text-center relative z-10">
                
                <!-- Apple-Style Translucent Badge -->
                <div class="inline-flex items-center gap-2 sm:gap-2.5 px-4 sm:px-5 py-1.5 sm:py-2 rounded-full bg-white/70 backdrop-blur-xl border border-white/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] text-blue-600 text-[11px] sm:text-xs md:text-sm font-semibold tracking-wide mb-4 sm:mb-8 animate-fade-in">
                    <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
                    <span>Data-Driven Intelligence • Next-Gen Platform</span>
                </div>

                <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-slate-900 tracking-tight leading-[1.1] mb-4 sm:mb-8 max-w-5xl mx-auto">
                    Turn Raw Data into <br />
                    <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500">
                        Actionable Intelligence.
                    </span>
                </h1>

                <p class="text-sm sm:text-lg md:text-2xl text-slate-600 max-w-3xl mx-auto font-normal tracking-tight leading-relaxed mb-6 sm:mb-10">
                    Advanced predictive modeling, real-time analytics, and hyper-intuitive visualizations. Transform complex datasets into high-precision business growth.
                </p>

                <!-- High Gloss CTA Group -->
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4 mb-10 sm:mb-16">
                    <a
                        href="#contact"
                        class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-medium px-7 sm:px-9 py-3.5 sm:py-4 rounded-full transition-all duration-300 shadow-[0_10px_25px_rgba(37,99,235,0.25)] hover:shadow-[0_15px_35px_rgba(37,99,235,0.35)] hover:scale-[1.02] text-sm sm:text-base flex items-center justify-center gap-2"
                    >
                        <span>Get Free Data Analysis</span>
                        <i class="fas fa-arrow-right text-xs"></i>
                    </a>
                    <a
                        href="https://wa.me/8801707568468?text=I%20am%20interested%20in%20Data%20Science%20Solutions"
                        target="_blank"
                        class="w-full sm:w-auto bg-white/80 hover:bg-white text-slate-800 border border-slate-200/80 backdrop-blur-xl font-medium px-7 sm:px-9 py-3.5 sm:py-4 rounded-full transition-all duration-300 shadow-sm hover:shadow-md hover:scale-[1.02] text-sm sm:text-base flex items-center justify-center gap-2"
                    >
                        <i class="fab fa-whatsapp text-emerald-500 text-base sm:text-lg"></i>
                        <span>WhatsApp Us</span>
                    </a>
                </div>

                <!-- VIDEO SHOWCASE 1: Apple Glass Hardware Frame Hero Visual -->
                <div class="relative max-w-5xl mx-auto group">
                    <div class="absolute -inset-1 bg-gradient-to-r from-blue-400/20 via-indigo-300/30 to-cyan-400/20 rounded-2xl sm:rounded-[2.5rem] blur-2xl opacity-75 group-hover:opacity-100 transition duration-1000"></div>
                    
                    <div class="relative rounded-2xl sm:rounded-[2rem] bg-white/60 backdrop-blur-2xl border border-white/90 p-2 sm:p-3 shadow-[0_25px_70px_rgba(0,0,0,0.07)]">
                        <div class="relative rounded-xl sm:rounded-[1.5rem] overflow-hidden bg-slate-900 border border-slate-200/40 aspect-[16/9]">
                            <!-- Video Player Showcase 1 -->
                            <video 
                                class="w-full h-full object-cover" 
                                autoplay 
                                loop 
                                muted 
                                playsinline
                                poster="/sms_mockup.png"
                            >
                                <source src="/videos/data-science/Turn_Raw_Data_into_Actionable.mp4" type="video/mp4" />
                                Your browser does not support video play.
                            </video>

                            <!-- Overlay Glass Accent Pill -->
                            <div class="absolute bottom-3 left-3 right-3 sm:bottom-6 sm:left-6 sm:right-auto bg-white/80 backdrop-blur-xl border border-white/60 p-3 sm:p-4 rounded-xl sm:rounded-2xl shadow-xl flex items-center gap-3 sm:gap-4 text-left">
                                <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-blue-600/10 text-blue-600 flex items-center justify-center text-sm sm:text-lg shrink-0">
                                    <i class="fas fa-brain"></i>
                                </div>
                                <div>
                                    <div class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Live Neural Engine</div>
                                    <div class="text-xs sm:text-sm font-semibold text-slate-800">Processing Real-Time Data Streams</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>


        <!-- STATS SECTION (Apple Floating Glass Bar) -->
        <section class="py-6 sm:py-12 px-4 sm:px-6">
            <div class="max-w-6xl mx-auto">
                <div class="bg-white/70 backdrop-blur-2xl border border-white/80 rounded-2xl sm:rounded-3xl p-5 sm:p-8 md:p-10 shadow-[0_10px_40px_rgba(0,0,0,0.03)] grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 divide-y-0 md:divide-x divide-slate-200/60 text-center">
                    {
                        stats.map((stat, idx) => (
                            <div class={`flex flex-col justify-center ${idx !== 0 ? "pt-2 md:pt-0" : ""}`}>
                                <div class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-0.5 sm:mb-1">
                                    {stat.value}
                                </div>
                                <div class="text-[10px] sm:text-xs font-semibold text-slate-500 uppercase tracking-widest">
                                    {stat.label}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>


        <!-- TARGET AUDIENCE (Who Benefits) -->
        <section class="py-14 sm:py-20 lg:py-24 px-4 sm:px-6 relative overflow-hidden">
            <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" />
            <div class="max-w-7xl mx-auto relative z-10">
                <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-16">
                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-2 sm:mb-4">
                        Designed for Industry Leaders
                    </h2>
                    <p class="text-slate-500 text-xs sm:text-base md:text-lg">
                        Tailored analytics architecture built for high-demand business sectors.
                    </p>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5 sm:gap-5">
                    {
                        targetAudiences.map((item) => (
                            <div class="group bg-white/60 hover:bg-white/90 backdrop-blur-xl border border-white/80 rounded-xl sm:rounded-2xl p-4 sm:p-6 text-center shadow-[0_4px_20px_rgba(0,0,0,0.02)] hover:shadow-[0_15px_30px_rgba(0,0,0,0.06)] hover:-translate-y-1 transition-all duration-300">
                                <div class="w-11 h-11 sm:w-14 sm:h-14 bg-gradient-to-br from-blue-50 to-indigo-50 text-blue-600 rounded-xl sm:rounded-2xl flex items-center justify-center mx-auto mb-3 sm:mb-4 text-lg sm:text-xl group-hover:scale-110 transition-transform duration-300 shadow-sm border border-blue-100/50">
                                    <i class={`fas ${item.icon}`} />
                                </div>
                                <h3 class="font-semibold text-slate-800 text-xs sm:text-sm tracking-tight">
                                    {item.title}
                                </h3>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>


        <!-- KEY BENEFITS (Glass Cards with Glow Accents) -->
        <section class="py-14 sm:py-20 px-4 sm:px-6">
            <div class="max-w-7xl mx-auto">
                <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-16">
                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-2 sm:mb-4">
                        Why Data Science Matters
                    </h2>
                    <p class="text-slate-500 text-xs sm:text-base md:text-lg">
                        Accelerate intelligence and eliminate guesswork from decision making.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-8">
                    {
                        benefits.map((benefit) => (
                            <div class="relative bg-white/70 hover:bg-white backdrop-blur-xl border border-white/90 rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-[0_8px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] transition-all duration-300 hover:-translate-y-1 text-left">
                                <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl bg-blue-50/80 text-blue-600 border border-blue-100/60 flex items-center justify-center text-xl sm:text-2xl mb-4 sm:mb-6 shadow-inner">
                                    <i class={`fas ${benefit.icon}`} />
                                </div>
                                <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-1.5 sm:mb-2 tracking-tight">
                                    {benefit.title}
                                </h3>
                                <p class="text-slate-500 text-xs sm:text-sm leading-relaxed">
                                    {benefit.description}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>


        <!-- SERVICES BREAKDOWN -->
        <section class="py-14 sm:py-20 lg:py-24 px-4 sm:px-6">
            <div class="max-w-7xl mx-auto">
                <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-16">
                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-2 sm:mb-4">
                        Complete Analytics Capabilities
                    </h2>
                    <p class="text-slate-500 text-xs sm:text-base md:text-lg">
                        End-to-end data pipelines, engineering, and predictive solutions.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-8">
                    {
                        services.map((category) => (
                            <div class="bg-white/70 backdrop-blur-xl border border-white/80 rounded-2xl sm:rounded-3xl p-6 sm:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:border-blue-200 transition-colors text-left">
                                <div class="flex items-center gap-3 sm:gap-4 mb-4 sm:mb-6 pb-3 sm:pb-4 border-b border-slate-100">
                                    <div class="w-10 h-10 sm:w-12 sm:h-12 bg-blue-600 text-white rounded-xl sm:rounded-2xl flex items-center justify-center text-base sm:text-lg shadow-lg shadow-blue-500/20 shrink-0">
                                        <i class={`fas ${category.icon}`} />
                                    </div>
                                    <h3 class="font-bold text-slate-900 text-base sm:text-lg tracking-tight">
                                        {category.title}
                                    </h3>
                                </div>
                                <ul class="space-y-2.5 sm:space-y-3.5">
                                    {category.items.map((item) => (
                                        <li class="flex items-center gap-2.5 sm:gap-3 text-slate-600 text-xs sm:text-sm font-medium">
                                            <i class="fas fa-check-circle text-blue-600 text-sm sm:text-base shrink-0" />
                                            <span>{item}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>


        <!-- VIDEO SHOWCASE 2 & INTERACTIVE USE CASES -->
        <section class="py-14 sm:py-20 lg:py-24 px-4 sm:px-6" id="use-cases">
            <div class="max-w-7xl mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
                    <div class="inline-block px-3 sm:px-4 py-1 sm:py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-600 font-semibold text-[11px] sm:text-xs uppercase tracking-wider mb-3 sm:mb-4">
                        Interactive Showcase
                    </div>
                    <h2 class="text-2xl sm:text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-2 sm:mb-4">
                        Solutions Built for Real Results
                    </h2>
