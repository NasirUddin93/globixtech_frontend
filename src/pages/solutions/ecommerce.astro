---

<MainLayout title="eCommerce Solution - Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-white text-slate-800 font-sans selection:bg-blue-500/20 selection:text-blue-900 relative overflow-x-hidden">
        


        <!-- HERO SECTION -->
        <section class="relative pt-28 pb-14 sm:pt-32 sm:pb-24 md:pt-48 md:pb-36 overflow-hidden bg-gradient-to-r from-blue-100/80 via-indigo-100/70 to-sky-100/60">
            <!-- Background Video with Top-Half Height Fade Cut -->
            <div class="absolute inset-0 pointer-events-none">
                <video
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover scale-105 opacity-50"
                    style="-webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%);"
                >
                    <source src="/videos/ecommerce/Instant_Payment_Express_Disp.mp4" type="video/mp4" />
                </video>
                <div class="absolute inset-0 bg-gradient-to-r from-blue-500/20 via-indigo-500/20 to-sky-400/20"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-blue-50/20 to-[#FBFBFD]"></div>
            </div>

            <!-- Bottom Faded Soft Transition Layer -->
            <div class="absolute bottom-0 inset-x-0 h-48 sm:h-60 bg-gradient-to-b from-transparent via-[#FBFBFD]/90 to-[#FBFBFD] pointer-events-none z-10"></div>
            <!-- Soft Faded Bottom Border Line -->
            <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-200/30 to-transparent pointer-events-none z-20"></div>

            <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-center">
                    
                    <!-- Left Hero Content -->
                    <div class="lg:col-span-7 text-left space-y-4 sm:space-y-8">
                        <div class="inline-flex items-center gap-2 sm:gap-2.5 bg-white/80 backdrop-blur-xl border border-slate-200/80 px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full shadow-[0_4px_20px_rgba(0,0,0,0.03)] text-slate-700 text-[11px] sm:text-xs font-semibold uppercase tracking-wider">
                            <span class="w-2 h-2 rounded-full bg-blue-500 animate-ping"></span>
                            <i class="fas fa-certificate text-blue-600"></i> #1 eCommerce Solution in Bangladesh
                        </div>

                        <h1 class="text-3xl sm:text-5xl lg:text-7xl font-extrabold text-slate-900 tracking-tight leading-[1.08]">
                            Professional <br />
                            <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-sky-500 bg-clip-text text-transparent">E-commerce Website</span> <br />
                            for Bangladeshi Brands
                        </h1>

                        <p class="text-sm sm:text-lg md:text-xl text-slate-600 font-normal leading-relaxed max-w-2xl">
                            Start selling online with automated payment, courier delivery, and Facebook integration. Everything engineered for high performance.
                        </p>

                        <!-- Call To Actions -->
                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 pt-2">
                            <a
                                href="https://ecommerce2.globix.tech/"
                                target="_blank"
                                class="bg-slate-900 hover:bg-slate-800 text-white px-7 sm:px-8 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl font-bold transition-all duration-300 shadow-xl shadow-slate-900/15 hover:shadow-2xl hover:scale-[1.02] active:scale-[0.98] text-center text-sm sm:text-base flex items-center justify-center gap-2 group"
                            >
                                <span>Get Free Demo</span>
                                <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
                            </a>
                            <a
                                href="https://wa.me/8801707568468?text=I%20am%20interested%20in%20eCommerce%20Solution"
                                target="_blank"
                                class="bg-white/80 backdrop-blur-xl hover:bg-white text-emerald-700 border border-emerald-500/30 hover:border-emerald-500/60 px-7 sm:px-8 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl font-bold transition-all duration-300 shadow-sm hover:shadow-md text-center text-sm sm:text-base flex items-center justify-center gap-3"
                            >
                                <i class="fab fa-whatsapp text-emerald-500 text-lg sm:text-xl"></i>
                                <span>Call / WhatsApp</span>
                            </a>
                        </div>
                    </div>

                    <!-- Right Hero Interactive Showcase Frame (VIDEO #1) -->
                    <div class="lg:col-span-5 relative">
                        <div class="relative mx-auto max-w-md lg:max-w-none">
                            <!-- Frosted Ambient Backdrop -->
                            <div class="absolute -inset-1 bg-gradient-to-r from-blue-400/20 to-indigo-400/20 rounded-2xl sm:rounded-[32px] blur-2xl opacity-70"></div>
                            
                            <!-- Glass Frame -->
                            <div class="relative bg-white/70 backdrop-blur-2xl border border-white/80 p-2 sm:p-3 rounded-2xl sm:rounded-[32px] shadow-[0_25px_60px_-15px_rgba(0,0,0,0.08)]">
                                <div class="bg-slate-900/5 rounded-xl sm:rounded-[24px] overflow-hidden border border-slate-200/50 aspect-[4/3] relative group">
                                    <!-- ANIMATION VIDEO #1 -->
                                    <video
                                        autoplay
                                        loop
                                        muted
                                        playsinline
                                        class="w-full h-full object-cover rounded-xl sm:rounded-[24px] transform group-hover:scale-[1.03] transition-transform duration-700 ease-out"
                                    >
                                        <source src="/videos/ecommerce/Professional_E_commerce_Websit.mp4" type="video/mp4" />
                                        Your browser does not support the video tag.
                                    </video>
                                    
                                    <!-- Floating Frosted UI Overlay Tag -->
                                    <div class="absolute top-2.5 left-2.5 sm:top-4 sm:left-4 bg-white/80 backdrop-blur-md border border-white/80 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-lg sm:rounded-xl shadow-lg flex items-center gap-1.5 sm:gap-2">
                                        <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                        <span class="text-[10px] sm:text-xs font-bold text-slate-800 tracking-tight">Live Storefront Engine</span>
                                    </div>
                                    <div class="absolute bottom-2.5 right-2.5 sm:bottom-4 sm:right-4 bg-slate-900/90 backdrop-blur-md text-white px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-semibold shadow-xl border border-white/10 flex items-center gap-1.5 sm:gap-2">
                                        <i class="fas fa-bolt text-yellow-400"></i> Ultra Fast 0.4s Load
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- STATS BAR (Apple Glass Strip) -->
        <section class="py-4 sm:py-6 relative z-20 -mt-4 sm:-mt-8">
            <div class="container mx-auto px-4 sm:px-6 max-w-6xl">
                <div class="bg-white/70 backdrop-blur-2xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.04)] rounded-2xl sm:rounded-3xl p-5 sm:p-8">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 divide-y-0 md:divide-x divide-slate-200/60">
                        {
                            stats.map((stat) => (
                                <div class="text-center pt-2 md:pt-0 first:pt-0">
                                    <div class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight bg-gradient-to-b from-slate-900 to-slate-700 bg-clip-text text-transparent">
                                        {stat.value}
                                    </div>
                                    <div class="text-[10px] sm:text-xs md:text-sm font-medium text-slate-500 mt-0.5 sm:mt-1 uppercase tracking-wider">
                                        {stat.label}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- WHO THIS IS FOR -->
        <section class="py-14 sm:py-20 lg:py-24 bg-slate-50/50 relative overflow-hidden">
            <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" />
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
                <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-16">
                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
                        Built for Every Business Scale
                    </h2>
                    <p class="text-slate-500 text-xs sm:text-base mt-2 sm:mt-3">Tailored e-commerce infrastructure designed to scale your operational workflow seamlessly.</p>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-6">
                    {
                        [
                            { title: "Small Business", icon: "fa-store", color: "text-blue-600", bg: "bg-blue-50" },
                            { title: "Facebook Seller", icon: "fa-facebook-f", color: "text-indigo-600", bg: "bg-indigo-50" },
                            { title: "Wholesale Business", icon: "fa-boxes", color: "text-sky-600", bg: "bg-sky-50" },
                            { title: "Startup", icon: "fa-rocket", color: "text-purple-600", bg: "bg-purple-50" },
                        ].map((item) => (
                            <div class="bg-white/80 backdrop-blur-xl p-5 sm:p-8 rounded-2xl sm:rounded-3xl border border-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center group">
                                <div class={`w-11 h-11 sm:w-14 sm:h-14 ${item.bg} rounded-xl sm:rounded-2xl flex items-center justify-center ${item.color} mx-auto mb-3 sm:mb-5 text-lg sm:text-xl group-hover:scale-110 transition-transform`}>
                                    <i class={`fas ${item.icon}`} />
                                </div>
                                <h3 class="font-bold text-slate-800 text-xs sm:text-base">
                                    {item.title}
                                </h3>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- KEY HIGHLIGHTS & VIDEO SHOWCASE #2 -->
        <section class="py-14 sm:py-20 lg:py-28 relative overflow-hidden">
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-16 items-center">
                    
                    <!-- Left: Benefit Grid -->
                    <div class="lg:col-span-6 space-y-6 sm:space-y-8 text-left">
                        <div>
                            <div class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 px-3 sm:px-3.5 py-1 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-bold uppercase tracking-wide mb-3 sm:mb-4">
                                Unified Store Architecture
                            </div>
                            <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
                                Everything You Need to Scale Online
                            </h2>
                            <p class="text-slate-600 mt-3 sm:mt-4 text-xs sm:text-base leading-relaxed">
                                Complete modular setup engineered specifically to meet Bangladeshi buyer habits, payment methods, and logistics.
                            </p>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-6">
                            <div class="bg-white/60 backdrop-blur-xl p-4 sm:p-6 rounded-xl sm:rounded-2xl border border-slate-100 shadow-sm hover:border-blue-200 transition-colors">
                                <div class="w-9 h-9 sm:w-10 sm:h-10 bg-blue-500/10 text-blue-600 rounded-lg sm:rounded-xl flex items-center justify-center text-base sm:text-lg mb-3 sm:mb-4">
                                    <i class="fas fa-mobile-alt"></i>
                                </div>
                                <h3 class="font-bold text-slate-900 text-sm sm:text-base mb-1">Mobile Friendly</h3>
                                <p class="text-slate-500 text-xs leading-relaxed">Responsive fluid UI optimized for modern mobile buyers.</p>
                            </div>

                            <div class="bg-white/60 backdrop-blur-xl p-4 sm:p-6 rounded-xl sm:rounded-2xl border border-slate-100 shadow-sm hover:border-pink-200 transition-colors">
                                <div class="w-9 h-9 sm:w-10 sm:h-10 bg-pink-500/10 text-pink-600 rounded-lg sm:rounded-xl flex items-center justify-center text-base sm:text-lg mb-3 sm:mb-4">
                                    <i class="fas fa-wallet"></i>
                                </div>
                                <h3 class="font-bold text-slate-900 text-sm sm:text-base mb-1">bKash / Nagad</h3>
                                <p class="text-slate-500 text-xs leading-relaxed">Automated instant payment gateway integration support.</p>
                            </div>

                            <div class="bg-white/60 backdrop-blur-xl p-4 sm:p-6 rounded-xl sm:rounded-2xl border border-slate-100 shadow-sm hover:border-emerald-200 transition-colors">
                                <div class="w-9 h-9 sm:w-10 sm:h-10 bg-emerald-500/10 text-emerald-600 rounded-lg sm:rounded-xl flex items-center justify-center text-base sm:text-lg mb-3 sm:mb-4">
                                    <i class="fas fa-truck"></i>
                                </div>
                                <h3 class="font-bold text-slate-900 text-sm sm:text-base mb-1">Courier Integration</h3>
                                <p class="text-slate-500 text-xs leading-relaxed">Automated delivery dispatch with Pathao & Steadfast APIs.</p>
                            </div>

                            <div class="bg-white/60 backdrop-blur-xl p-4 sm:p-6 rounded-xl sm:rounded-2xl border border-slate-100 shadow-sm hover:border-purple-200 transition-colors">
                                <div class="w-9 h-9 sm:w-10 sm:h-10 bg-purple-500/10 text-purple-600 rounded-lg sm:rounded-xl flex items-center justify-center text-base sm:text-lg mb-3 sm:mb-4">
                                    <i class="fas fa-cogs"></i>
                                </div>
                                <h3 class="font-bold text-slate-900 text-sm sm:text-base mb-1">Admin Panel</h3>
                                <p class="text-slate-500 text-xs leading-relaxed">Control inventory, orders & sales from one intuitive hub.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Right: VIDEO SHOWCASE #2 (Responsive Experience) -->
                    <div class="lg:col-span-6">
                        <div class="relative bg-white/70 backdrop-blur-2xl p-2.5 sm:p-4 rounded-2xl sm:rounded-[36px] border border-white/80 shadow-[0_20px_50px_rgba(0,0,0,0.06)]">
                            <div class="rounded-xl sm:rounded-[28px] overflow-hidden bg-slate-900 aspect-video relative group">
                                <!-- ANIMATION VIDEO #2 -->
                                <video
                                    autoplay
                                    loop
                                    muted
                                    playsinline
                                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                                >
                                    <source src="/videos/ecommerce/Everything_You_Need_to_Scale_O.mp4" type="video/mp4" />
                                </video>
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
                                <div class="absolute bottom-3 left-3 right-3 sm:bottom-6 sm:left-6 sm:right-6 flex items-center justify-between text-white">
                                    <div>
                                        <p class="text-[10px] sm:text-xs uppercase tracking-wider text-slate-300 font-medium">Fluid UX Architecture</p>
                                        <h4 class="text-sm sm:text-lg font-bold">End-to-End Buyer Engagement</h4>
                                    </div>
                                    <span class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/30 text-white shrink-0">
                                        <i class="fas fa-play text-[10px] sm:text-xs"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- MAIN MODULES SECTION (Interactive Glass Tabs) -->
