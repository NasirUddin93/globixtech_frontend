        // Tab Switching Logic
        const buttons = document.querySelectorAll(".module-btn");
        const contents = document.querySelectorAll(".module-content");

        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const targetId = btn.getAttribute("data-id");

                // Update Buttons
                buttons.forEach((b) => {
                    b.classList.remove(
                        "bg-white",
                        "border-green-500",
                        "shadow-md",
                        "text-green-600",
                        "ring-1",
                        "ring-green-500",
                    );
                    b.classList.add("bg-gray-50", "text-gray-600");
                    const arrow = b.querySelector(".fa-arrow-right");
                    if (arrow) {
                        arrow.classList.remove("text-green-600");
                        arrow.classList.add("text-gray-300");
                    }
                });

                btn.classList.remove("bg-gray-50", "text-gray-600");
                btn.classList.add(
                    "bg-white",
                    "border-green-500",
                    "shadow-md",
                    "text-green-600",
                    "ring-1",
                    "ring-green-500",
                );
                const arrow = btn.querySelector(".fa-arrow-right");
                if (arrow) {
                    arrow.classList.remove("text-gray-300");
                    arrow.classList.add("text-green-600");
                }

                // Update Content
                contents.forEach((content) => {
                    content.classList.remove(
                        "opacity-100",
                        "z-10",
                        "translate-y-0",
                    );
                    content.classList.add(
                        "opacity-0",
                        "-z-10",
                        "translate-y-4",
                    );
                });

                const activeContent = document.getElementById(
                    `content-${targetId}`,
                );
                if (activeContent) {
                    activeContent.classList.remove(
                        "opacity-0",
                        "-z-10",
                        "translate-y-4",
                    );
                    activeContent.classList.add(
                        "opacity-100",
                        "z-10",
                        "translate-y-0",
                    );
                }
            });
        });

        // FAQ Accordion Logic
        const faqButtons = document.querySelectorAll(".faq-btn");

        faqButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const content = btn.nextElementSibling;
                const icon = btn.querySelector("i");
                const toggleIcon = btn.querySelector(
                    "span.bg-blue-50, span.bg-blue-600",
                );

                if (
                    !content ||
                    !icon ||
                    !toggleIcon ||
                    !(content instanceof HTMLElement) ||
                    !(toggleIcon instanceof HTMLElement)
                )
                    return;

                // Check if currently expanded
                const isExpanded = content.classList.contains("expanded");

                if (isExpanded) {
                    // Collapse
                    content.style.height = "0px";
                    content.classList.remove("expanded");
                    icon.classList.remove("fa-minus");
                    icon.classList.add("fa-plus");
                    toggleIcon.classList.remove("bg-blue-600", "text-white");
                    toggleIcon.classList.add("bg-blue-50", "text-blue-600");
                } else {
                    // Expand
                    content.style.height = content.scrollHeight + "px";
                    content.classList.add("expanded");
                    icon.classList.remove("fa-plus");
                    icon.classList.add("fa-minus");
                    toggleIcon.classList.remove("bg-blue-50", "text-blue-600");
                    toggleIcon.classList.add("bg-blue-600", "text-white");
                }
            });
        });
    </script>
</MainLayout>
