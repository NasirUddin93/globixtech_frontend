---
// Location: frontend/src/pages/solutions/erp-system.astro
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import VideoBackground from "../../components/landing/VideoBackground.astro";
import { Image } from "astro:assets";
import smsMockup from "../../assets/sms_mockup.png";

import {
    pricingPlans,
    industryTypes,
    moduleCategories,
    stats,
    coreFeatures,
    faqs,
    erpVideos,
} from "../../data/erp";
---

<MainLayout title="ERP System - Globix Tech Solutions">
    <Navbar />

    <main class="min-h-screen bg-[#FAFBFD] text-slate-900 font-sans selection:bg-indigo-500 selection:text-white relative overflow-hidden">
        


        <!-- HERO SECTION -->
        <section class="relative pt-36 pb-20 md:pt-48 md:pb-32 z-10 overflow-hidden bg-gradient-to-r from-indigo-100/80 via-indigo-100/70 to-violet-100/60">
            <!-- Background Video with Top-Half Height Fade Cut -->
            <div class="absolute inset-0 pointer-events-none">
                <video
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover scale-105 opacity-50"
                    style="-webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%);"
                >
                    <source src={erpVideos.ecosystem.url} type="video/mp4" />
                </video>
                <div class="absolute inset-0 bg-gradient-to-r from-indigo-500/25 via-indigo-500/25 to-violet-500/25"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-indigo-50/20 to-[#FAFBFD]"></div>
            </div>

            <!-- Bottom Faded Soft Transition Layer -->
            <div class="absolute bottom-0 inset-x-0 h-72 bg-gradient-to-b from-transparent via-[#FAFBFD]/80 to-[#FAFBFD] pointer-events-none z-10"></div>

            <div class="container mx-auto px-6 relative z-10">
                <div class="max-w-4xl mx-auto text-center mb-16">
                    <!-- Apple Glass Badge -->
                    <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/70 backdrop-blur-xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] text-slate-800 text-xs md:text-sm font-semibold mb-8 hover:scale-[1.02] transition-transform">
                        <span class="flex h-2 w-2 rounded-full bg-indigo-600 animate-pulse"></span>
                        <i class="fas fa-th-large text-indigo-600"></i>
                        <span>Complete Business Management</span>
                        <span class="bg-indigo-50 text-indigo-700 text-[10px] font-bold px-2 py-0.5 rounded-full border border-indigo-200/50">Next-Gen</span>
                    </div>

                    <!-- Clean Premium Typography -->
                    <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-slate-900 tracking-tight leading-[1.08] mb-8">
                        Enterprise Resource Planning for <br class="hidden md:inline"/>
                        <span class="bg-gradient-to-r from-indigo-600 via-indigo-700 to-violet-600 bg-clip-text text-transparent">
                            Growing Businesses
                        </span>
                    </h1>

                    <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed mb-10 font-normal">
                        Manage finance, HR, inventory, sales, and operations from one integrated platform. Eliminate data silos and make smarter decisions.
                    </p>

                    <!-- CTA Glass Buttons -->
                    <div class="flex flex-wrap items-center justify-center gap-4">
                        <a
                            href="/#contact"
                            class="bg-slate-900 hover:bg-indigo-600 text-white px-9 py-4 rounded-full font-semibold transition-all duration-300 shadow-[0_10px_30px_rgba(15,23,42,0.15)] hover:shadow-[0_20px_40px_rgba(79,70,229,0.3)] hover:-translate-y-0.5 flex items-center gap-3 text-base"
                        >
                            Request Demo 
                            <i class="fas fa-arrow-right text-xs opacity-70"></i>
                        </a>
                        <a
                            href="tel:+8801707568468"
                            class="bg-white/80 hover:bg-white text-slate-800 border border-slate-200/90 backdrop-blur-xl px-9 py-4 rounded-full font-semibold transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-0.5 flex items-center gap-2.5 text-base"
                        >
                            <i class="fas fa-phone-alt text-indigo-600 text-sm"></i> Call Us
                        </a>
                    </div>
                </div>

                <!-- VIDEO 1: Hero Interactive Glass Mockup Video -->
                <div class="relative max-w-5xl mx-auto">
                    <div class="absolute -inset-1 bg-gradient-to-r from-indigo-500/20 via-purple-500/20 to-pink-500/20 rounded-[2.5rem] blur-2xl opacity-70"></div>
                    
                    <div class="relative bg-white/60 backdrop-blur-2xl border border-white/80 p-3 md:p-4 rounded-[2.2rem] shadow-[0_25px_70px_rgba(0,0,0,0.07)]">
                        <!-- Mac-style top bar -->
                        <div class="flex items-center justify-between px-4 py-2.5 border-b border-slate-100 mb-2">
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-rose-400/80 inline-block"></span>
                                <span class="w-3 h-3 rounded-full bg-amber-400/80 inline-block"></span>
                                <span class="w-3 h-3 rounded-full bg-emerald-400/80 inline-block"></span>
                            </div>
                            <div class="bg-slate-100/80 text-slate-500 text-[11px] font-mono px-4 py-1 rounded-full border border-slate-200/50 flex items-center gap-2">
                                <i class="fas fa-lock text-[9px] text-emerald-600"></i>
                                {erpVideos.hero.badge}
                            </div>
                            <div class="text-xs font-medium text-slate-400">Globix OS</div>
                        </div>

                        <!-- Embedded Animated Video Frame -->
                        <div class="relative overflow-hidden rounded-[1.5rem] aspect-video bg-slate-900 group">
                            <video 
                                class="w-full h-full object-cover opacity-90 transition-scale duration-700 group-hover:scale-105"
                                autoplay 
                                loop 
                                muted 
                                playsinline
                                poster={erpVideos.hero.poster}
                            >
                                <source src={erpVideos.hero.url} type="video/mp4" />
                            </video>

                            <!-- Overlay Frosted Badges -->
                            <div class="absolute bottom-6 left-6 right-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pointer-events-none">
                                <div class="bg-slate-950/70 backdrop-blur-md border border-white/20 p-4 rounded-2xl text-white">
                                    <div class="text-xs font-semibold text-indigo-300 uppercase tracking-wider mb-0.5">Live ERP Control</div>
                                    <div class="text-sm font-bold">{erpVideos.hero.title}</div>
                                </div>
                                <div class="hidden sm:flex items-center gap-3 bg-white/80 backdrop-blur-xl border border-white/90 px-4 py-2.5 rounded-2xl shadow-xl text-slate-800">
                                    <div class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold text-xs">
                                        <i class="fas fa-chart-line"></i>
                                    </div>
                                    <div>
                                        <div class="text-xs text-slate-500 font-medium">Efficiency Index</div>
                                        <div class="text-sm font-extrabold text-slate-900">+42.8% YoY</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Floating Glass Stats Bar -->
                <div class="mt-16 max-w-5xl mx-auto">
                    <div class="bg-white/70 backdrop-blur-2xl border border-slate-200/80 rounded-3xl p-8 shadow-[0_15px_40px_rgba(0,0,0,0.03)] grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                        {
                            stats.map((stat) => (
                                <div class="group">
                                    <div class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-1 group-hover:text-indigo-600 transition-colors">
                                        {stat.value}
                                    </div>
                                    <div class="text-xs font-bold text-slate-400 uppercase tracking-widest">
                                        {stat.label}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- CORE FEATURES BENTO GRID (WITH VIDEO 2) -->
        <section class="py-24 relative z-10">
            <div class="container mx-auto px-6">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
                        Powerful ERP Features
                    </h2>
                    <p class="text-slate-600 text-lg leading-relaxed">
                        Everything you need to manage your entire business from one platform.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
                    <!-- VIDEO 2 Feature Bento Highlight Card -->
                    <div class="lg:col-span-2 bg-white/70 backdrop-blur-2xl border border-slate-200/80 rounded-3xl p-8 md:p-10 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(79,70,229,0.08)] transition-all duration-500 flex flex-col justify-between overflow-hidden relative group">
                        <div class="relative z-10 mb-8">
                            <div class="inline-flex items-center gap-2 bg-indigo-50 border border-indigo-200/60 px-3.5 py-1.5 rounded-full text-indigo-700 text-xs font-bold mb-6">
                                <i class="fas fa-play text-[10px]"></i> AI & Real-Time Engine
                            </div>
                            <h3 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-3">
                                Autonomous Decision & Workflow Orchestration
                            </h3>
                            <p class="text-slate-600 leading-relaxed max-w-xl">
                                Streamline cross-department processes with real-time continuous calculations, automated notifications, and instant audit generation.
                            </p>
                        </div>

                        <!-- Video 2 Frame -->
                        <div class="relative rounded-2xl overflow-hidden aspect-[21/9] bg-slate-900 border border-slate-200/60 shadow-lg">
                            <video 
                                class="w-full h-full object-cover opacity-85 group-hover:scale-105 transition-transform duration-700" 
                                autoplay 
                                loop 
                                muted 
                                playsinline
                                poster={erpVideos.automation.poster}
                            >
                                <source src={erpVideos.automation.url} type="video/mp4" />
                            </video>
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                            <div class="absolute bottom-4 left-4 text-white font-mono text-xs flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                                {erpVideos.automation.title}
                            </div>
                        </div>
                    </div>

                    <!-- Regular Core Feature Bento Cards -->
                    {
                        coreFeatures.map((f) => (
                            <div class="bg-white/70 backdrop-blur-2xl border border-slate-200/80 p-8 md:p-10 rounded-3xl shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.06)] hover:-translate-y-1 transition-all duration-500 group flex flex-col justify-between">
                                <div>
                                    <div class={`w-14 h-14 ${f.bg} rounded-2xl flex items-center justify-center ${f.color} text-xl mb-6 group-hover:scale-110 transition-transform duration-300`}>
                                        <i class={`fas ${f.icon}`} />
                                    </div>
                                    <h3 class="text-xl font-bold text-slate-900 mb-3">
                                        {f.title}
                                    </h3>
                                    <p class="text-slate-600 text-sm leading-relaxed">
                                        {f.desc}
                                    </p>
                                </div>
                                <div class="mt-8 pt-4 border-t border-slate-100 flex items-center text-xs font-semibold text-indigo-600 group-hover:translate-x-1 transition-transform">
                                    <span>Learn operational impact</span>
                                    <i class="fas fa-chevron-right ml-1.5 text-[10px]"></i>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- INDUSTRY TYPES SECTION (WITH VIDEO 3) -->
        <section class="py-24 relative z-10 overflow-hidden">
            <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" />
            <div class="container mx-auto px-6 relative z-10">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
                        ERP Solutions for Every Industry
                    </h2>
                    <p class="text-slate-600 text-lg leading-relaxed">
                        Specialized features tailored for different business operational models.
                    </p>
                </div>

                <!-- Apple Floating Glass Dock Tabs -->
                <div class="max-w-6xl mx-auto">
                    <div class="flex flex-wrap justify-center gap-2 p-2 bg-white/70 backdrop-blur-2xl border border-slate-200/80 rounded-full shadow-[0_10px_30px_rgba(0,0,0,0.03)] mb-12" id="industry-tabs">
                        {
                            industryTypes.map((type, index) => (
                                <button
                                    class={`industry-tab px-6 py-3 rounded-full font-semibold text-sm transition-all duration-300 ${index === 0 ? "bg-slate-900 text-white shadow-md" : "text-slate-600 hover:text-slate-900 hover:bg-white/60"}`}
                                    data-id={type.id}
                                >
                                    {type.label}
                                </button>
                            ))
                        }
                    </div>

                    <!-- Industry Content Panels + VIDEO 3 Showcase -->
                    <div class="relative min-h-[520px]">
                        {
                            industryTypes.map((type, index) => (
                                <div
                                    id={`industry-${type.id}`}
                                    class={`industry-content transition-all duration-500 ${index === 0 ? "opacity-100 relative" : "opacity-0 absolute inset-0 pointer-events-none"}`}
                                >
                                    <div class="bg-white/70 backdrop-blur-2xl rounded-3xl p-8 md:p-12 border border-slate-200/80 shadow-[0_20px_50px_rgba(0,0,0,0.04)] grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                                        <div class="lg:col-span-7">
                                            <div class="inline-block px-3 py-1 bg-indigo-50 text-indigo-700 text-xs font-bold rounded-full mb-4">
                                                Tailored Solution
                                            </div>
                                            <h3 class="text-2xl md:text-4xl font-extrabold text-slate-900 mb-4">
                                                {type.title}
                                            </h3>
                                            <p class="text-slate-600 leading-relaxed text-base md:text-lg mb-8">
                                                {type.desc}
                                            </p>
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                                {type.features.map((feature) => (
                                                    <div class="flex items-center gap-3.5 bg-white/80 p-4 rounded-2xl border border-slate-200/60 shadow-sm">
                                                        <div class="w-9 h-9 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600 text-sm">
                                                            <i class={`fas ${feature.icon}`} />
                                                        </div>
                                                        <span class="font-semibold text-slate-800 text-sm">
                                                            {feature.name}
                                                        </span>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>

                                        <!-- VIDEO 3 Showcase Card -->
                                        <div class="lg:col-span-5">
                                            <div class="relative rounded-2xl overflow-hidden aspect-[4/3] bg-slate-900 shadow-2xl border border-slate-200/80 group">
                                                <video 
                                                    class="w-full h-full object-cover opacity-85 group-hover:scale-105 transition-transform duration-700" 
                                                    autoplay 
                                                    loop 
                                                    muted 
                                                    playsinline
                                                    poster={erpVideos.industry.poster}
                                                >
                                                    <source src={erpVideos.industry.url} type="video/mp4" />
                                                </video>
                                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                                                <div class="absolute bottom-4 left-4 right-4 text-white">
                                                    <span class="text-[10px] font-bold uppercase tracking-widest text-indigo-300 bg-indigo-950/60 backdrop-blur-md px-2.5 py-1 rounded-md border border-indigo-500/30">
                                                        {erpVideos.industry.badge}
                                                    </span>
                                                    <div class="text-xs font-semibold mt-2">{erpVideos.industry.title}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- DETAILED MODULES BREAKDOWN (WITH VIDEO 4) -->
        <section class="py-24 relative z-10">
            <div class="container mx-auto px-6">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
                        Complete ERP Modules
                    </h2>
                    <p class="text-slate-600 text-lg leading-relaxed">
                        Over 500+ features across 21 modules to handle every aspect of your business operations.
                    </p>
                </div>

                <!-- VIDEO 4: Connected Ecosystem Banner -->
                <div class="max-w-7xl mx-auto mb-12">
                    <div class="bg-slate-900 rounded-3xl py-20 md:py-28 px-8 md:px-10 text-white shadow-2xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative overflow-hidden">
                        <video autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover opacity-20 pointer-events-none" style="mask-image: linear-gradient(to right, black 0%, black 30%, transparent 100%); -webkit-mask-image: linear-gradient(to right, black 0%, black 30%, transparent 100%);">
                            <source src={erpVideos.ecosystem.url} type="video/mp4" />
                        </video>
                        <div class="lg:col-span-12 relative z-10">
                            <span class="text-indigo-300 text-xs font-extrabold tracking-widest uppercase">Ecosystem Architecture</span>
                            <h3 class="text-2xl md:text-3xl font-extrabold text-white mt-1 mb-3">
                                Seamless Data Flow Across All Modules
                            </h3>
                            <p class="text-slate-300 leading-relaxed text-sm md:text-base">
                                Every transaction in Finance updates Inventory, HR payroll, and Sales CRM live without batch delays or manual synchronization.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Module Categories Grid -->
                <div class="space-y-10 max-w-7xl mx-auto">
                    {
                        moduleCategories.map((category) => (
                            <div class="bg-white/70 backdrop-blur-2xl rounded-3xl p-8 md:p-10 border border-slate-200/80 shadow-[0_10px_30px_rgba(0,0,0,0.02)]">
                                <div class="flex items-center gap-4 mb-8">
                                    <div class={`w-12 h-12 ${category.bg} rounded-2xl flex items-center justify-center ${category.color} text-xl shadow-sm`}>
                                        <i class={`fas ${category.icon}`} />
                                    </div>
                                    <h3 class="text-2xl font-bold text-slate-900 tracking-tight">
                                        {category.title}
                                    </h3>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                    {category.modules.map((module) => (
                                        <div class="bg-white/80 p-6 rounded-2xl border border-slate-200/60 shadow-sm hover:shadow-md transition-all">
                                            <div class="flex items-start justify-between mb-4">
                                                <h4 class="font-bold text-slate-900 text-lg flex-1">
                                                    {module.name}
                                                </h4>
                                                <span class="bg-indigo-50 text-indigo-700 border border-indigo-200/50 px-2.5 py-0.5 rounded-full text-xs font-bold">
                                                    {module.count}+
                                                </span>
                                            </div>
                                            <ul class="space-y-2.5">
                                                {module.features.map((feature) => (
                                                    <li class="flex items-start gap-2.5 text-sm text-slate-600">
                                                        <i class="fas fa-check-circle text-indigo-600 text-xs mt-1" />
                                                        <span>{feature}</span>
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- PRICING SECTION -->
        <section class="py-24 relative z-10 overflow-hidden">
            <VideoBackground mp4="/videos/generated_video_july_24.mp4" />
            <div class="container mx-auto px-6 relative z-10">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
                        Flexible Pricing Plans
                    </h2>
                    <p class="text-slate-600 text-lg leading-relaxed">
                        Choose the plan based on your user count. Scale effortlessly as you grow.
                    </p>
                </div>

                <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    {
                        pricingPlans.map((plan, planIdx) => (
                            <div
                                class={`bg-white/80 backdrop-blur-2xl rounded-3xl p-8 border transition-all duration-300 flex flex-col justify-between ${plan.recommended ? "border-indigo-500 shadow-[0_20px_50px_rgba(79,70,229,0.15)] relative scale-[1.02]" : "border-slate-200/80 shadow-sm hover:shadow-lg"}`}
                            >
                                {plan.recommended && (
                                    <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-indigo-600 text-white px-4 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider shadow-md">
                                        Recommended
                                    </div>
                                )}

                                <div>
                                    <h3 class="text-2xl font-bold text-slate-900 mb-2">
                                        {plan.name}
                                    </h3>

                                    {plan.price === "Custom" ? (
                                        <>
                                            <div class="text-4xl font-extrabold text-indigo-600 mb-1 mt-4">
                                                {plan.price}
                                            </div>
                                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-6">
                                                {plan.subtitle}
                                            </p>
                                            <ul class="space-y-3 mb-8 border-t border-slate-100 pt-6">
                                                {plan.facilities.map((item) => (
                                                    <li class="flex items-start gap-2.5 text-sm text-slate-600">
                                                        <i class="fas fa-check text-indigo-600 text-xs mt-1" />
                                                        <span>{item}</span>
                                                    </li>
                                                ))}
                                            </ul>
                                        </>
                                    ) : (
                                        <>
                                            <div class="mb-6 mt-4">
                                                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                                    Starting from
                                                </div>
                                                <div class="text-4xl font-extrabold text-indigo-600 my-1">
                                                    ৳{plan.monthlyPrice}
                                                    <span class="text-sm font-normal text-slate-500">
                                                        /mo
                                                    </span>
                                                </div>
                                                <div class="text-xs text-slate-500 mt-1">
                                                    One-time setup: ৳{plan.oneTimeCharge}
                                                </div>
                                            </div>

                                            <div class="space-y-2.5 mb-8 border-t border-slate-100 pt-6">
                                                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">
                                                    Pricing by Users
                                                </div>
                                                {plan.ranges?.map((range) => (
                                                    <div class="flex justify-between text-xs py-1 border-b border-slate-50">
                                                        <span class="text-slate-600 font-medium">
                                                            {range.range}
                                                        </span>
                                                        <span class="font-bold text-slate-900">
                                                            ৳{range.price}/mo
                                                        </span>
                                                    </div>
                                                ))}
                                            </div>
                                        </>
                                    )}
                                </div>

                                <a
                                    href="/contact"
