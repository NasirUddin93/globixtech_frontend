    <script>
        // Industry Tabs Interactive Logic
        document.addEventListener("DOMContentLoaded", () => {
            const tabs = document.querySelectorAll(".industry-tab");
            const contents = document.querySelectorAll(".industry-content");

            tabs.forEach((tab) => {
                tab.addEventListener("click", () => {
                    const targetId = tab.getAttribute("data-id");

                    tabs.forEach((t) => {
                        t.classList.remove("bg-slate-900", "text-white", "shadow-md");
                        t.classList.add("text-slate-600", "hover:text-slate-900", "hover:bg-white/60");
                    });

                    tab.classList.remove("text-slate-600", "hover:text-slate-900", "hover:bg-white/60");
                    tab.classList.add("bg-slate-900", "text-white", "shadow-md");

                    contents.forEach((content) => {
                        content.classList.remove("opacity-100", "relative");
                        content.classList.add("opacity-0", "absolute", "inset-0", "pointer-events-none");
                    });

                    const targetContent = document.getElementById(`industry-${targetId}`);
                    if (targetContent) {
                        targetContent.classList.remove("opacity-0", "absolute", "inset-0", "pointer-events-none");
                        targetContent.classList.add("opacity-100", "relative");
                    }
                });
            });
        });
    </script>
