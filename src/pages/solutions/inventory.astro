---
// Location: frontend/src/pages/solutions/inventory.astro

import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import VideoBackground from "../../components/landing/VideoBackground.astro";

import {
    pricingPlans,
    businessTypes,
    moduleCategories,
    stats,
    coreFeatures,
    faqs,
    inventoryVideos,
} from "../../data/inventory";
---

<MainLayout title="Inventory Management System - Globix Tech Solutions">
    <Navbar />

    <main class="min-h-screen bg-[#FBFBFD] text-[#1D1D1F] selection:bg-emerald-500 selection:text-white font-sans antialiased overflow-hidden relative">
        


        <!-- ================= HERO SECTION ================= -->
        <section class="relative pt-28 pb-16 sm:pt-32 sm:pb-20 md:pt-48 md:pb-28 z-10 overflow-hidden">
            <!-- Background Video with Top-Half Height Fade Cut -->
            <div class="absolute inset-0 pointer-events-none">
                <video
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover scale-105 opacity-50"
                    style="-webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,0.8) 25%, rgba(0,0,0,0) 80%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,0.8) 25%, rgba(0,0,0,0) 80%);"
                >
                    <source src="/videos/inventory/People_working_for_Batch_Exp.mp4" type="video/mp4" />
                </video>
                <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/20 via-teal-500/20 to-blue-400/20"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-emerald-50/20 via-50% to-[#FBFBFD]"></div>
            </div>

            <!-- Bottom Faded Soft Transition Layer -->
            <div class="absolute bottom-0 inset-x-0 h-48 sm:h-72 bg-gradient-to-b from-transparent via-[#FBFBFD]/80 to-[#FBFBFD] pointer-events-none z-10"></div>

            <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
                
                <!-- Apple Pill Badge Tag -->
                <div class="flex justify-center mb-6 sm:mb-8">
                    <div class="inline-flex items-center gap-2 sm:gap-2.5 bg-white/80 backdrop-blur-2xl border border-black/5 shadow-[0_4px_20px_rgba(0,0,0,0.03)] px-4 sm:px-5 py-1.5 sm:py-2 rounded-full text-[11px] sm:text-xs font-semibold text-slate-700 tracking-wide uppercase">
                        <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-ping"></span>
                        <span class="flex h-2 w-2 rounded-full bg-emerald-500 -ml-4"></span>
                        Smart Stock Control Platform
                    </div>
                </div>

                <!-- Hero Headline & Subtitle -->
                <div class="text-center max-w-4xl mx-auto mb-8 sm:mb-14">
                    <h1 class="text-3xl sm:text-5xl lg:text-7xl font-extrabold tracking-tight text-[#1D1D1F] leading-[1.08] mb-4 sm:mb-6">
                        Inventory Software Built for <br class="hidden sm:inline" />
                        <span class="bg-gradient-to-r from-emerald-600 via-teal-600 to-blue-600 bg-clip-text text-transparent">
                            Bangladesh Businesses
                        </span>
                    </h1>
                    <p class="text-sm sm:text-lg md:text-2xl text-slate-500 max-w-2xl mx-auto font-normal leading-relaxed tracking-tight">
                        Real-time stock tracking across all locations. Automated reordering, barcode scanning, batch & expiry management, and deep analytics.
                    </p>

                    <!-- Primary Actions -->
                    <div class="mt-6 sm:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4">
                        <a
                            href="/#contact"
                            class="group bg-[#1D1D1F] hover:bg-black text-white px-7 sm:px-8 py-3.5 sm:py-4 rounded-full font-medium transition-all duration-300 shadow-xl shadow-black/10 hover:shadow-2xl hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-3 text-sm"
                        >
                            <span>Get Free Demo</span>
                            <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
                        </a>
                        <a
                            href="tel:+8801707568468"
                            class="bg-white/90 hover:bg-white text-[#1D1D1F] border border-slate-200/80 backdrop-blur-2xl px-7 sm:px-8 py-3.5 sm:py-4 rounded-full font-medium transition-all duration-300 shadow-sm hover:shadow-md hover:border-slate-300 active:scale-[0.98] flex items-center justify-center gap-2.5 text-sm"
                        >
                            <i class="fas fa-phone-alt text-emerald-600 text-xs"></i>
                            <span>Call Us Directly</span>
                        </a>
                    </div>
                </div>

                <!-- ANIMATION VIDEO #1: HERO MAIN VIDEO SHOWCASE -->
                <div class="relative max-w-5xl mx-auto mt-6 sm:mt-10">
                    <div class="relative rounded-2xl sm:rounded-[2.5rem] p-2 sm:p-4 bg-white/70 backdrop-blur-3xl border border-white shadow-[0_30px_90px_rgba(0,0,0,0.06)]">
                        <div class="relative rounded-xl sm:rounded-3xl overflow-hidden aspect-video bg-slate-100 group border border-slate-200/50">
                            <video 
                                autoplay 
                                loop 
                                muted 
                                playsinline 
                                poster={inventoryVideos.hero.poster}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]"
                            >
                                <source src={inventoryVideos.hero.src} type="video/mp4" />
                            </video>
                            
                            <!-- Sleek Light Glass Video Overlay Badge -->
                            <div class="absolute bottom-3 left-3 right-3 sm:bottom-6 sm:left-6 sm:right-6 flex flex-col md:flex-row md:items-center justify-between gap-2.5 sm:gap-4 p-3.5 sm:p-6 rounded-xl sm:rounded-2xl bg-white/85 backdrop-blur-2xl border border-white/90 shadow-xl">
                                <div class="flex items-center gap-3 sm:gap-4">
                                    <div class="w-9 h-9 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 text-sm sm:text-lg shrink-0">
                                        <i class="fas fa-boxes"></i>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-[#1D1D1F] text-xs sm:text-base">{inventoryVideos.hero.title}</h4>
                                        <p class="text-[10px] sm:text-xs text-slate-500 mt-0.5">{inventoryVideos.hero.desc}</p>
                                    </div>
                                </div>
                                <span class="self-start md:self-auto text-[10px] sm:text-[11px] font-bold tracking-wider text-emerald-800 uppercase bg-emerald-50/90 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full border border-emerald-200/80 shadow-sm flex items-center gap-1.5 sm:gap-2 shrink-0">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                    Live Warehouse
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= STATS SECTION ================= -->
        <section class="py-8 sm:py-12 z-10 relative">
            <div class="container mx-auto px-4 sm:px-6 max-w-6xl">
                <div class="bg-white/70 backdrop-blur-3xl border border-white rounded-2xl sm:rounded-[2rem] p-5 sm:p-8 md:p-10 shadow-[0_15px_40px_rgba(0,0,0,0.02)]">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-slate-200/60">
                        {
                            stats.map((stat, idx) => (
                                <div class={`pt-4 md:pt-0 ${idx !== 0 ? 'md:pl-6' : ''}`}>
                                    <div class="text-2xl sm:text-3xl md:text-5xl font-extrabold text-[#1D1D1F] tracking-tight mb-1" data-counter={stat.value}>
                                        {stat.value}
                                    </div>
                                    <div class="text-[10px] sm:text-xs font-semibold text-slate-400 uppercase tracking-widest mt-1">
                                        {stat.label}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= CORE FEATURES BENTO GRID ================= -->
        <section class="py-14 sm:py-20 lg:py-24 z-10 relative overflow-hidden">
            <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" overlayOpacityClass="bg-white/70" fadeColor="#FBFBFD" />
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#1D1D1F] mb-3 sm:mb-4">
                        Powerful Inventory Features
                    </h2>
                    <p class="text-slate-500 text-xs sm:text-base md:text-lg">
                        Everything required to run modern operations, eliminate shrinkage, and scale seamlessly.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-8">
                    {
                        coreFeatures.map((f) => (
                            <div class="group bg-white/70 backdrop-blur-2xl border border-white/90 p-6 sm:p-8 rounded-2xl sm:rounded-[2rem] shadow-[0_8px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_45px_rgba(0,0,0,0.06)] hover:bg-white/90 transition-all duration-300">
                                <div class={`w-11 h-11 sm:w-14 sm:h-14 ${f.bg} rounded-xl sm:rounded-2xl flex items-center justify-center ${f.color} text-lg sm:text-xl mb-4 sm:mb-6 group-hover:scale-105 transition-transform shadow-sm`}>
                                    <i class={`fas ${f.icon}`} />
                                </div>
                                <h3 class="text-lg sm:text-xl font-bold text-[#1D1D1F] mb-2 sm:mb-3">
                                    {f.title}
                                </h3>
                                <p class="text-slate-500 text-xs sm:text-sm leading-relaxed">
                                    {f.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- ================= ANIMATION VIDEO #2 & BUSINESS TYPES SECTION ================= -->
        <section class="py-14 sm:py-20 lg:py-24 z-10 relative">
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
                
                <!-- Video Banner Bar (Light Frosted Glass Theme) -->
                <div class="mb-12 sm:mb-20 bg-white/80 backdrop-blur-3xl border border-white/90 rounded-2xl sm:rounded-[2.5rem] p-5 sm:p-8 md:p-12 shadow-[0_20px_60px_rgba(0,0,0,0.03)]">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center">
                        <div class="lg:col-span-5 text-left">
                            <span class="text-[11px] sm:text-xs font-semibold tracking-wider text-emerald-700 uppercase bg-emerald-50 px-3 sm:px-3.5 py-1 sm:py-1.5 rounded-full border border-emerald-200/80 inline-block mb-3 sm:mb-4 shadow-sm">
                                Smart Operations
                            </span>
                            <h3 class="text-xl sm:text-3xl md:text-4xl font-extrabold text-[#1D1D1F] mb-3 sm:mb-4 leading-tight">
                                {inventoryVideos.businessWorkflow.title}
                            </h3>
                            <p class="text-slate-500 text-xs sm:text-sm md:text-base mb-4 sm:mb-6 leading-relaxed">
                                {inventoryVideos.businessWorkflow.desc}
                            </p>
                            <div class="flex items-center gap-2 sm:gap-3 text-xs font-semibold text-slate-600 bg-slate-100/70 py-1.5 sm:py-2 px-3 sm:px-4 rounded-full w-fit border border-slate-200/50">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                Multi-location & warehouse ready
                            </div>
                        </div>

                        <!-- Video Player Container #2 -->
                        <div class="lg:col-span-7">
                            <div class="relative rounded-xl sm:rounded-2xl overflow-hidden aspect-video shadow-lg border border-slate-200/60 bg-slate-100">
                                <video 
                                    autoplay 
                                    loop 
                                    muted 
                                    playsinline 
                                    poster={inventoryVideos.businessWorkflow.poster}
                                    class="w-full h-full object-cover"
                                >
                                    <source src={inventoryVideos.businessWorkflow.src} type="video/mp4" />
                                </video>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Business Types Selector Title -->
                <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-12">
                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#1D1D1F] mb-3 sm:mb-4">
                        Inventory Solutions for Every Industry
                    </h2>
                    <p class="text-slate-500 text-xs sm:text-base md:text-lg">
                        Specialized stock management features tailored to your operational workflow.
                    </p>
                </div>

                <!-- Apple Glass Segmented Switcher -->
                <div class="max-w-6xl mx-auto">
                    <div class="flex justify-center mb-8 sm:mb-12">
                        <div class="inline-flex p-1 sm:p-2 bg-slate-200/40 backdrop-blur-2xl rounded-xl sm:rounded-2xl border border-white/80 shadow-inner flex-wrap justify-center gap-1" id="business-tabs">
                            {
                                businessTypes.map((type, index) => (
                                    <button
                                        class={`business-tab px-3.5 sm:px-6 py-2 sm:py-3 rounded-lg sm:rounded-xl text-xs md:text-sm font-semibold transition-all duration-300 ${index === 0 ? "bg-white text-[#1D1D1F] shadow-sm" : "text-slate-500 hover:text-slate-900"}`}
                                        data-id={type.id}
                                    >
                                        {type.label}
                                    </button>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Business Tab Content Cards -->
                    <div class="relative min-h-[420px]">
                        {
                            businessTypes.map((type, index) => (
                                <div
                                    id={`business-${type.id}`}
                                    class={`business-content transition-all duration-500 ${index === 0 ? "opacity-100 relative" : "opacity-0 absolute inset-0 pointer-events-none"}`}
                                >
                                    <div class="bg-white/85 backdrop-blur-3xl rounded-2xl sm:rounded-[2.5rem] p-6 sm:p-8 md:p-12 border border-white shadow-[0_15px_45px_rgba(0,0,0,0.03)] text-left">
                                        <h3 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-[#1D1D1F] mb-3 sm:mb-4">
                                            {type.title}
                                        </h3>
                                        <p class="text-slate-500 mb-6 sm:mb-8 text-xs sm:text-base leading-relaxed max-w-4xl">
                                            {type.desc}
                                        </p>

                                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
                                            {type.features.map((feature) => (
                                                <div class="flex items-center gap-3 sm:gap-4 bg-slate-50/80 p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border border-slate-200/50 hover:bg-white hover:shadow-md transition-all">
                                                    <div class="w-8 h-8 sm:w-10 sm:h-10 bg-emerald-500/10 rounded-lg sm:rounded-xl flex items-center justify-center text-emerald-600 text-xs sm:text-sm shrink-0">
                                                        <i class={`fas ${feature.icon}`} />
                                                    </div>
                                                    <span class="font-semibold text-slate-800 text-xs sm:text-sm">
                                                        {feature.name}
                                                    </span>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= ANIMATION VIDEO #3 & COMPLETE MODULES BREAKDOWN ================= -->
        <section class="py-14 sm:py-20 lg:py-24 z-10 relative overflow-hidden">
            <VideoBackground mp4="/videos/generated_video_july_24.mp4" overlayOpacityClass="bg-white/70" fadeColor="#FBFBFD" />
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
                
                <!-- Video Feature Highlight #3 (Dark Theme) -->
                <div class="mb-12 sm:mb-20 bg-slate-900 rounded-2xl sm:rounded-3xl p-6 sm:p-8 md:p-12 text-white shadow-2xl relative overflow-hidden">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center relative z-10">
                        <div class="lg:col-span-7 order-2 lg:order-1">
                            <div class="rounded-xl sm:rounded-2xl overflow-hidden aspect-video border border-white/10 shadow-2xl bg-black relative">
                                <video 
                                    autoplay 
                                    loop 
                                    muted 
                                    playsinline 
                                    poster={inventoryVideos.trackingEngine.poster}
                                    class="w-full h-full object-cover"
                                >
                                    <source src={inventoryVideos.trackingEngine.src} type="video/mp4" />
                                </video>
                            </div>
                        </div>

                        <div class="lg:col-span-5 order-1 lg:order-2 text-left">
                            <span class="text-[11px] sm:text-xs font-bold tracking-wider text-emerald-300 uppercase bg-emerald-950/80 px-3 sm:px-3.5 py-1 sm:py-1.5 rounded-full border border-emerald-800/80 inline-block mb-3 sm:mb-4">
                                Stock Tracking Engine
                            </span>
                            <h3 class="text-xl sm:text-2xl md:text-4xl font-extrabold mb-3 sm:mb-4 leading-tight text-white">
                                {inventoryVideos.trackingEngine.title}
                            </h3>
                            <p class="text-slate-300 text-xs sm:text-sm md:text-base leading-relaxed mb-4 sm:mb-6">
                                {inventoryVideos.trackingEngine.desc}
                            </p>
                            <ul class="space-y-2 sm:space-y-3 text-xs sm:text-sm font-semibold text-slate-300">
                                <li class="flex items-center gap-2.5 sm:gap-3">
                                    <i class="fas fa-check-circle text-emerald-400 text-sm sm:text-base shrink-0"></i>
                                    <span>Automatic FIFO/LIFO valuation tracking</span>
                                </li>
                                <li class="flex items-center gap-2.5 sm:gap-3">
                                    <i class="fas fa-check-circle text-emerald-400 text-sm sm:text-base shrink-0"></i>
                                    <span>Zero-latency multi-branch stock transfers</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#1D1D1F] mb-3 sm:mb-4">
                        Complete Inventory Modules
                    </h2>
                    <p class="text-slate-500 text-xs sm:text-base md:text-lg">
                        Over 200+ features across 16 modules to handle every aspect of inventory operations.
                    </p>
                </div>

                <div class="space-y-8 sm:space-y-12">
                    {
                        moduleCategories.map((category) => (
                            <div class="bg-white/75 backdrop-blur-3xl rounded-2xl sm:rounded-[2.5rem] p-6 sm:p-8 md:p-10 border border-white shadow-[0_10px_35px_rgba(0,0,0,0.02)] text-left">
                                <div class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8 border-b border-slate-200/60 pb-4 sm:pb-6">
                                    <div class={`w-10 h-10 sm:w-12 sm:h-12 ${category.bg} rounded-xl sm:rounded-2xl flex items-center justify-center ${category.color} text-lg sm:text-xl shadow-sm shrink-0`}>
                                        <i class={`fas ${category.icon}`} />
                                    </div>
                                    <h3 class="text-lg sm:text-xl md:text-2xl font-extrabold text-[#1D1D1F] tracking-tight">
                                        {category.title}
                                    </h3>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
                                    {category.modules.map((module) => (
                                        <div class="bg-white/90 p-4 sm:p-6 rounded-xl sm:rounded-2xl border border-slate-200/60 hover:border-emerald-500/30 hover:shadow-lg transition-all">
                                            <div class="flex items-start justify-between mb-2 sm:mb-3">
                                                <h4 class="font-extrabold text-[#1D1D1F] text-sm sm:text-base">
                                                    {module.name}
                                                </h4>
                                                <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 sm:px-2.5 py-0.5 rounded-full text-[10px] sm:text-[11px] font-bold shadow-xs">
                                                    {module.count}+
                                                </span>
                                            </div>
                                            <ul class="space-y-1.5 sm:space-y-2 mt-3 sm:mt-4">
                                                {module.features.map((feature) => (
                                                    <li class="flex items-start gap-2 text-[11px] sm:text-xs text-slate-500 font-medium">
                                                        <i class="fas fa-check text-emerald-500 mt-0.5 text-[9px] sm:text-[10px] shrink-0" />
                                                        <span>{feature}</span>
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- ================= PRICING SECTION ================= -->
        <section class="py-14 sm:py-20 lg:py-24 z-10 relative">
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#1D1D1F] mb-3 sm:mb-4">
                        Flexible Pricing Plans
                    </h2>
                    <p class="text-slate-500 text-xs sm:text-base md:text-lg">
                        Transparent tiers tailored to your product catalog volume.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
                    {
                        pricingPlans.map((plan) => (
                            <div
                                class={`bg-white/80 backdrop-blur-3xl rounded-2xl sm:rounded-[2.5rem] p-6 sm:p-8 border transition-all duration-300 flex flex-col justify-between ${
                                    plan.recommended 
                                        ? "border-emerald-500 shadow-[0_20px_50px_rgba(16,185,129,0.15)] relative scale-[1.01] lg:scale-[1.02] ring-1 ring-emerald-500/20" 
                                        : "border-white shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-xl"
                                }`}
                            >
                                <div>
                                    {plan.recommended && (
                                        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-emerald-600 text-white px-3 sm:px-4 py-0.5 sm:py-1 rounded-full text-[10px] sm:text-xs font-bold tracking-wider uppercase shadow-md whitespace-nowrap">
                                            Most Popular
                                        </div>
                                    )}

                                    <h3 class="text-lg sm:text-xl font-extrabold text-[#1D1D1F] mb-3 sm:mb-4">
                                        {plan.name}
                                    </h3>

                                    {plan.price === "Custom" ? (
                                        <>
                                            <div class="text-2xl sm:text-4xl font-black text-emerald-600 mb-1">
                                                {plan.price}
                                            </div>
                                            <p class="text-[11px] sm:text-xs font-bold text-slate-400 mb-5 sm:mb-6 uppercase tracking-wider">
                                                {plan.subtitle}
                                            </p>
                                            <ul class="space-y-2.5 sm:space-y-3 mb-6 sm:mb-8 border-t border-slate-100 pt-5 sm:pt-6">
                                                {plan.facilities.map((item) => (
                                                    <li class="flex items-start gap-2 text-xs text-slate-600 font-medium">
                                                        <i class="fas fa-check text-emerald-500 mt-0.5" />
                                                        <span>{item}</span>
                                                    </li>
                                                ))}
                                            </ul>
                                        </>
                                    ) : (
