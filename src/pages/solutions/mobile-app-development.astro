---
// Location: frontend/src/pages/solutions/mobile-app-development.astro
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import VideoBackground from "../../components/landing/VideoBackground.astro";
import Button from "../../components/Button.astro";

const coreServices = [
    {
        icon: "fa-shopping-cart",
        color: "from-blue-500 to-indigo-600",
        badge: "E-Commerce",
        title: "Custom E-Commerce Apps",
        description: "We build high-converting e-commerce platforms with seamless UI/UX, secure payment gateways, and real-time inventory sync. Drive your sales with an app that customers love to use."
    },
    {
        icon: "fa-building",
        color: "from-emerald-500 to-teal-600",
        badge: "Enterprise",
        title: "Enterprise Management Systems",
        description: "Streamline your business operations with our custom management apps. From attendance and scheduling to complex reporting and ERP integration, we make business management effortless."
    },
    {
        icon: "fa-brain",
        color: "from-purple-500 to-pink-600",
        badge: "Intelligence",
        title: "AI & Machine Learning Integration",
        description: "Future-proof your business with intelligent apps. We integrate ML models for predictive analysis, personalized user experiences, and automated decision-making."
    },
    {
        icon: "fa-satellite-dish",
        color: "from-amber-500 to-orange-600",
        badge: "IoT & Hardware",
        title: "Sensor-Based & IoT Solutions",
        description: "Our team specializes in hardware-integrated apps using GPS, accelerometers, and smart sensors. Perfect for logistics, healthcare, and industrial automation."
    }
];

const lockerFeatures = [
    {
        icon: "fa-usb",
        title: "Hardware Lockdown",
        description: "USB Connection Disable: Prevent any unauthorized data transfer or 'juice jacking'."
    },
    {
        icon: "fa-power-off",
        title: "Anti-Tamper Protection",
        description: "Disable Factory Reset and Reboot functions so the device stays under your command."
    },
    {
        icon: "fa-shield-alt",
        title: "Persistence (Never-Delete)",
        description: "Our security app is locked into the system. It cannot be deleted by the user. If any bypass attempt is made, the app automatically re-installs itself instantly."
    },
    {
        icon: "fa-eye-slash",
        title: "Stealth & App Control",
        description: "App Hide/Unhide: Remotely control which apps are visible or usable on the device."
    },
    {
        icon: "fa-map-marked-alt",
        title: "Real-Time Surveillance",
        description: "High-precision real-time GPS tracking and authorized camera access for security audits."
    },
    {
        icon: "fa-comment-dots",
        title: "Secure Communication",
        description: "Integrated custom SMS system for encrypted, private internal messaging within the locker environment."
    }
];

const emiFeatures = [
    {
        icon: "fa-bell",
        title: "Custom EMI Reminders",
        description: "Customized reminders and notifications sent directly to the customer's mobile screen when payment is due."
    },
    {
        icon: "fa-lock",
        title: "Instant Remote Lock",
        description: "Lock the entire device with one click from the admin panel upon default. The customer can only access 'Payment' and 'Emergency Call'."
    },
    {
        icon: "fa-ban",
        title: "Anti-Wipe / Factory Reset Block",
        description: "Hard Reset or Recovery Mode is completely blocked. The customer cannot factory reset the device to remove the locker."
    },
    {
        icon: "fa-hands",
        title: "Zero Touch Enrollment",
        description: "Seamlessly deploy and configure devices in bulk right out of the box without manual setup."
    },
    {
        icon: "fa-power-off",
        title: "Reboot, Flash & Developer Mode Disable",
        description: "Completely restrict device rebooting, flashing custom ROMs, and accessing developer options without authorization."
    },
    {
        icon: "fa-map-marker-alt",
        title: "Real-Time GPS Tracking",
        description: "Precise real-time GPS tracking and IMEI-based location, even if the SIM is removed or the device is lost."
    }
];
---

<MainLayout title="Mobile App Development & MDM Solutions | Globix Tech">
    <Navbar />

    <!-- Pure White Apple-Style Theme Wrapper -->
    <div class="relative bg-white text-slate-900 font-sans selection:bg-blue-500 selection:text-white overflow-hidden">
        


        <!-- HERO SECTION WITH VIDEO ANIMATION 1 -->
        <section class="relative pt-28 pb-14 sm:pt-36 sm:pb-24 lg:pt-48 lg:pb-36 px-4 sm:px-6 overflow-hidden bg-gradient-to-r from-blue-100/80 via-indigo-100/70 to-cyan-100/60">
            <!-- Background Video with Top-Half Height Fade Cut -->
            <div class="absolute inset-0 pointer-events-none">
                <video
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover scale-105 opacity-50"
                    style="-webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%);"
                >
                    <source src="/videos/mobile-app-development/Globix_Secure_Locker__Beyond_E.mp4" type="video/mp4" />
                </video>
                <div class="absolute inset-0 bg-gradient-to-r from-blue-500/25 via-indigo-500/25 to-cyan-500/25"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-blue-50/20 to-[#FBFBFD]"></div>
            </div>

            <!-- Bottom Faded Soft Transition Layer -->
            <div class="absolute bottom-0 inset-x-0 h-48 sm:h-60 bg-gradient-to-b from-transparent via-[#FBFBFD]/90 to-[#FBFBFD] pointer-events-none z-10"></div>
            <!-- Soft Faded Bottom Border Line -->
            <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-200/30 to-transparent pointer-events-none z-20"></div>

            <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
                <div class="text-center max-w-4xl mx-auto space-y-4 sm:space-y-6">
                <!-- Apple-style Floating Badge -->
                <div class="inline-flex items-center gap-2 sm:gap-2.5 px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full bg-slate-100/80 backdrop-blur-xl border border-slate-200/60 shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
                    <i class="fas fa-mobile-alt text-blue-600 text-xs"></i>
                    <span class="text-[11px] sm:text-xs font-semibold tracking-wide uppercase text-slate-700">Development & Security</span>
                </div>

                <!-- Main Hero Headline -->
                <h1 class="text-3xl sm:text-5xl md:text-7xl font-extrabold tracking-tight text-slate-900 leading-[1.08]">
                    Mobile App <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 bg-clip-text text-transparent">Development</span>
                </h1>

                <p class="text-sm sm:text-lg md:text-2xl font-normal text-slate-600 max-w-3xl mx-auto leading-relaxed">
                    At Globix Tech, we don't just build apps; we create powerful digital experiences and secure mobile environments.
                </p>

                <div class="pt-2 sm:pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4">
                    <a href="#core-services" class="px-7 sm:px-8 py-3.5 sm:py-4 rounded-full bg-slate-900 text-white font-medium hover:bg-slate-800 transition-all duration-300 shadow-lg shadow-slate-900/10 hover:shadow-slate-900/20 hover:-translate-y-0.5 text-sm sm:text-base text-center">
                        Explore Services
                    </a>
                    <a href="mailto:info@globix.tech" class="px-7 sm:px-8 py-3.5 sm:py-4 rounded-full bg-white/80 backdrop-blur-xl text-slate-900 font-medium border border-slate-200 hover:bg-slate-50 transition-all duration-300 shadow-sm text-sm sm:text-base text-center">
                        Get in Touch
                    </a>
                </div>
            </div>

            <!-- VIDEO ANIMATION 1: Hero Dynamic Showcase Mockup -->
            <div class="mt-10 sm:mt-16 max-w-5xl mx-auto relative group">
                <!-- Ambient Glow behind phone/screen card -->
                <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 via-cyan-500 to-purple-600 rounded-2xl sm:rounded-[2.5rem] blur-2xl opacity-20 group-hover:opacity-30 transition duration-1000"></div>
                
                <div class="relative rounded-2xl sm:rounded-[2rem] p-2 sm:p-3 md:p-5 bg-white/70 backdrop-blur-2xl border border-white/80 shadow-[0_20px_60px_rgba(0,0,0,0.06)] overflow-hidden">
                    <div class="relative rounded-xl sm:rounded-[1.5rem] overflow-hidden aspect-video md:aspect-[21/9] bg-slate-950">
                        <video 
                            autoplay 
                            loop 
                            muted 
                            playsinline 
                            class="w-full h-full object-cover opacity-90 scale-105 group-hover:scale-100 transition-transform duration-1000 ease-out"
                        >
                            <source src="/videos/mobile-app-development/Mobile_App_Development_At_Glob.mp4" type="video/mp4" />
                            Your browser does not support the video tag.
                        </video>
                        
                        <!-- Transparent Glass Overlay Bar inside Video -->
                        <div class="absolute bottom-3 left-3 right-3 sm:bottom-6 sm:left-6 sm:right-6 p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-white/20 backdrop-blur-md border border-white/30 text-white flex items-center justify-between text-left">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-blue-600/90 flex items-center justify-center text-white shrink-0">
                                    <i class="fas fa-shield-alt text-sm sm:text-lg"></i>
                                </div>
                                <div>
                                    <div class="text-[10px] sm:text-xs uppercase tracking-wider text-slate-200 font-semibold">Globix Architecture</div>
                                    <div class="text-xs sm:text-sm font-bold">Ultra-Secure Native App Engines</div>
                                </div>
                            </div>
                            <span class="hidden sm:inline-block text-xs px-3 py-1.5 rounded-full bg-white/20 font-mono">MDM Ready</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 01: Core Development Services -->
        <section id="core-services" class="py-14 sm:py-20 lg:py-24 px-4 sm:px-6 max-w-7xl mx-auto relative">
            <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16 space-y-2 sm:space-y-3">
                <span class="text-[11px] sm:text-xs font-bold tracking-widest uppercase text-blue-600 bg-blue-50 px-3.5 py-1.5 rounded-full">01. Our Services</span>
                <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">Core Development Services</h2>
                <p class="text-xs sm:text-base md:text-lg text-slate-600 leading-relaxed pt-1 sm:pt-2">
                    Whether you are a startup or a global enterprise, our expert team delivers custom mobile applications that blend cutting-edge functionality with high security.
                </p>
            </div>

            <!-- Service Cards + Video Showcase Section -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-stretch">
                
                <!-- Left: 2x2 Glass Grid for Services -->
                <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                    {coreServices.map((service) => (
                        <div class="group relative rounded-2xl sm:rounded-3xl p-5 sm:p-7 bg-white/60 backdrop-blur-xl border border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between text-left">
                            <div>
                                <div class="flex items-center justify-between mb-4 sm:mb-6">
                                    <div class={`w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-gradient-to-br ${service.color} flex items-center justify-center text-white text-xl sm:text-2xl shadow-md group-hover:scale-110 transition-transform duration-300 shrink-0`}>
                                        <i class={`fas ${service.icon}`} />
                                    </div>
                                    <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-slate-400 bg-slate-100/80 px-2.5 py-1 rounded-full">{service.badge}</span>
                                </div>
                                <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 sm:mb-3 group-hover:text-blue-600 transition-colors">
                                    {service.title}
                                </h3>
                                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                                    {service.description}
                                </p>
                            </div>
                        </div>
                    ))}
                </div>

                <!-- Right: VIDEO ANIMATION 2 Showcase Card -->
                <div class="lg:col-span-5 rounded-2xl sm:rounded-3xl p-5 sm:p-6 bg-slate-900 text-white relative overflow-hidden flex flex-col justify-between shadow-2xl min-h-[360px] sm:min-h-[420px] text-left">
                    <div class="absolute inset-0">
                        <video 
                            autoplay 
                            loop 
                            muted 
                            playsinline 
                            class="w-full h-full object-cover"
                        >
                            <source src="/videos/mobile-app-development/Next_Gen_App_Experience_Engine.mp4" type="video/mp4" />
                        </video>
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/30 to-transparent"></div>
                    </div>

                    <div class="relative z-10 space-y-2.5 sm:space-y-4">
                        <span class="inline-block text-[10px] uppercase font-bold tracking-widest px-2.5 sm:px-3 py-0.5 sm:py-1 rounded-full bg-white/20 backdrop-blur-md">Live Tech Stack</span>
                        <h3 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight">Next-Gen App Experience</h3>
                        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                            Engineered with native frameworks, AI accelerators, and real-time synchronization pipelines for peak performance across devices.
                        </p>
                    </div>

                    <div class="relative z-10 pt-6 sm:pt-8 mt-auto">
                        <div class="p-3.5 sm:p-4 rounded-xl sm:rounded-2xl bg-white/10 backdrop-blur-xl border border-white/20 flex items-center gap-3 sm:gap-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-blue-500/30 flex items-center justify-center text-blue-400 text-lg sm:text-xl font-bold shrink-0">
                                <i class="fas fa-microchip"></i>
                            </div>
                            <div>
                                <div class="text-[10px] sm:text-xs text-slate-300">Architecture Standard</div>
                                <div class="text-xs sm:text-sm font-bold text-white">High-Speed & Secure Runtime</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- SECTION 02: Globix Secure-Locker (MDM) with VIDEO ANIMATION 3 -->
        <section class="py-14 sm:py-20 lg:py-24 px-4 sm:px-6 max-w-7xl mx-auto overflow-hidden relative">
            <div class="rounded-2xl sm:rounded-[2.5rem] bg-gradient-to-b from-slate-50 via-white to-slate-50 border border-slate-200/80 p-5 sm:p-8 md:p-16 shadow-[0_20px_50px_rgba(0,0,0,0.04)] relative overflow-hidden z-10 text-left">
                
                <!-- Background Glass Glow -->
                <div class="absolute top-0 right-0 w-96 h-96 bg-blue-200/30 blur-[100px] rounded-full pointer-events-none"></div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-center mb-10 sm:mb-16">
                    <div class="lg:col-span-7 space-y-4 sm:space-y-6">
                        <span class="text-[11px] sm:text-xs font-bold tracking-widest uppercase text-blue-600 bg-blue-100/70 px-3.5 py-1.5 rounded-full">02. Proprietary Tech</span>
                        <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
                            Globix Secure-Locker:<br />
                            <span class="bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">Beyond Enterprise Security</span>
                        </h2>
                        <p class="text-slate-600 text-xs sm:text-base md:text-lg leading-relaxed">
                            Security is the backbone of Globix Tech. While the world relies on third-party tools, we provide our own Proprietary High-Security MDM (Mobile Device Management) Locker. Our solution offers the same—and in many cases, superior—build quality and reliability as global standards like <strong>Samsung Knox, SOTI, and BK Locker</strong>.
                        </p>
                        <p class="text-slate-500 text-xs sm:text-base italic border-l-2 border-blue-500 pl-3 sm:pl-4 py-1">
                            Our locker is engineered for organizations that require absolute control. It is a "Zero-Trust" environment that protects your devices from tampering, theft, and unauthorized data access.
                        </p>
                    </div>

                    <!-- Right VIDEO ANIMATION 3: Security Locker Hardware Visual -->
                    <div class="lg:col-span-5">
                        <div class="relative rounded-2xl sm:rounded-3xl p-2 sm:p-3 bg-white/80 backdrop-blur-2xl border border-slate-200 shadow-xl overflow-hidden group">
                            <div class="rounded-xl sm:rounded-2xl overflow-hidden aspect-square relative bg-slate-900">
                                <video 
                                    autoplay 
                                    loop 
                                    muted 
                                    playsinline 
                                    class="w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-700"
                                >
                                    <source src="/videos/mobile-app-development/Globix_Secure_Locker__Beyond_E.mp4" type="video/mp4" />
                                </video>
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
                                <div class="absolute bottom-4 left-4 right-4 sm:bottom-6 sm:left-6 sm:right-6 text-white space-y-1">
                                    <div class="text-[10px] sm:text-xs font-mono uppercase tracking-wider text-blue-400">Zero-Trust Environment</div>
                                    <div class="text-sm sm:text-lg font-bold">Hardware-Level Enforcement</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Locker Features Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                    {lockerFeatures.map((feat) => (
                        <div class="p-5 sm:p-6 rounded-xl sm:rounded-2xl bg-white/80 backdrop-blur-xl border border-slate-200/70 shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300 group">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg sm:text-xl mb-3 sm:mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 shrink-0">
                                <i class={`fas ${feat.icon}`} />
                            </div>
                            <h4 class="text-base sm:text-lg font-bold text-slate-900 mb-1.5 sm:mb-2">{feat.title}</h4>
                            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{feat.description}</p>
                        </div>
                    ))}
                </div>

            </div>
        </section>

        <!-- SECTION 03: EMI Locker System with VIDEO ANIMATION 4 -->
        <section class="py-14 sm:py-20 lg:py-24 px-4 sm:px-6 max-w-7xl mx-auto">
            <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16 space-y-2 sm:space-y-3">
                <span class="text-[11px] sm:text-xs font-bold tracking-widest uppercase text-orange-600 bg-orange-50 px-3.5 py-1.5 rounded-full">03. EMI Solution</span>
                <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
                    Globix EMI Management & Anti-Theft Locker
                </h2>
                <p class="text-xs sm:text-base md:text-lg text-slate-600 leading-relaxed pt-1 sm:pt-2">
                    The biggest risk in the financing business is payment default. Globix Tech brings an advanced EMI Locker System, making mobile financing <strong>100% risk-free.</strong> If customers fail to pay their EMI on time, our system will seamlessly lock the device.
                </p>
            </div>

            <!-- Video Banner for EMI Locker -->
            <div class="mb-10 sm:mb-16 rounded-2xl sm:rounded-3xl p-1.5 sm:p-2 bg-gradient-to-r from-orange-100 via-amber-50 to-orange-100 border border-orange-200/60 shadow-lg overflow-hidden">
                <div class="relative rounded-xl sm:rounded-2xl overflow-hidden aspect-video md:aspect-[25/8] bg-slate-900">
                    <video 
                        autoplay 
                        loop 
                        muted 
                        playsinline 
                        class="w-full h-full object-cover opacity-75"
                    >
                        <source src="/videos/mobile-app-development/Automated_Default_Locking_Ma.mp4" type="video/mp4" />
                    </video>
                    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/60 to-transparent flex items-center p-5 sm:p-8 md:p-12 text-left">
                        <div class="max-w-xl text-white space-y-2 sm:space-y-3">
                            <span class="text-[10px] sm:text-xs font-mono uppercase tracking-widest text-orange-400 bg-orange-500/20 px-2.5 sm:px-3 py-0.5 sm:py-1 rounded-full border border-orange-500/30">Remote Telemetry</span>
                            <h3 class="text-xl sm:text-2xl md:text-4xl font-extrabold">Automated Default Locking & Management</h3>
                            <p class="text-slate-300 text-xs sm:text-sm hidden sm:block">Take total control over defaulted hardware via cloud-sync dashboard with zero friction.</p>
                        </div>
                    </div>
                </div>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-6 sm:mb-8 text-center">Special Features for EMI Business</h3>

            <!-- EMI Features Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-10 sm:mb-16">
                {emiFeatures.map((feat) => (
                    <div class="p-5 sm:p-6 rounded-xl sm:rounded-2xl bg-orange-50/40 backdrop-blur-xl border border-orange-100/80 shadow-sm hover:shadow-md hover:border-orange-300 transition-all duration-300 group text-left">
                        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-white text-orange-500 shadow-sm flex items-center justify-center text-lg sm:text-xl mb-3 sm:mb-4 group-hover:bg-orange-500 group-hover:text-white transition-colors duration-300 shrink-0">
                            <i class={`fas ${feat.icon}`} />
                        </div>
                        <h4 class="text-base sm:text-lg font-bold text-slate-900 mb-1.5 sm:mb-2">{feat.title}</h4>
                        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{feat.description}</p>
                    </div>
                ))}
            </div>

            <!-- Why Choose + Target Audience Split -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 text-left">
                
                <!-- Why Choose Globix EMI Locker? -->
                <div class="p-6 sm:p-8 md:p-10 rounded-2xl sm:rounded-3xl bg-white/80 backdrop-blur-2xl border border-slate-200/80 shadow-xl space-y-4 sm:space-y-6">
                    <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 pb-3 sm:pb-4 border-b border-slate-100">Why Choose Globix EMI Locker?</h3>
                    <ul class="space-y-3.5 sm:space-y-5">
                        <li class="flex items-start gap-3 sm:gap-4">
                            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
                                <i class="fas fa-check text-xs sm:text-sm"></i>
                            </div>
                            <div>
                                <h5 class="font-bold text-slate-900 text-sm sm:text-base">Risk Reduction</h5>
                                <p class="text-slate-600 text-xs sm:text-sm">Your investment remains 100% secure.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-3 sm:gap-4">
                            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
                                <i class="fas fa-check text-xs sm:text-sm"></i>
                            </div>
                            <div>
                                <h5 class="font-bold text-slate-900 text-sm sm:text-base">User-Friendly Dashboard</h5>
                                <p class="text-slate-600 text-xs sm:text-sm">Manage thousands of devices from a single dashboard.</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-3 sm:gap-4">
