---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
import PageHeader from "../../components/PageHeader.astro";

const coreServices = [
    {
        icon: "fa-shopping-cart",
        color: "text-blue-500",
        title: "Custom E-Commerce Apps",
        description: "We build high-converting e-commerce platforms with seamless UI/UX, secure payment gateways, and real-time inventory sync. Drive your sales with an app that customers love to use."
    },
    {
        icon: "fa-building",
        color: "text-green-500",
        title: "Enterprise Management Systems",
        description: "Streamline your business operations with our custom management apps. From attendance and scheduling to complex reporting and ERP integration, we make business management effortless."
    },
    {
        icon: "fa-brain",
        color: "text-purple-500",
        title: "AI & Machine Learning Integration",
        description: "Future-proof your business with intelligent apps. We integrate ML models for predictive analysis, personalized user experiences, and automated decision-making."
    },
    {
        icon: "fa-satellite-dish",
        color: "text-orange-500",
        title: "Sensor-Based & IoT Solutions",
        description: "Our team specializes in hardware-integrated apps using GPS, accelerometers, and smart sensors. Perfect for logistics, healthcare, and industrial automation."
    }
];

const lockerFeatures = [
    {
        icon: "fa-usb",
        title: "Hardware Lockdown",
        description: "USB Connection Disable: Prevent any unauthorized data transfer or 'juice jacking'."
    },
    {
        icon: "fa-power-off",
        title: "Anti-Tamper Protection",
        description: "Disable Factory Reset and Reboot functions so the device stays under your command."
    },
    {
        icon: "fa-shield-alt",
        title: "Persistence (Never-Delete)",
        description: "Our security app is locked into the system. It cannot be deleted by the user. If any bypass attempt is made, the app automatically re-installs itself instantly."
    },
    {
        icon: "fa-eye-slash",
        title: "Stealth & App Control",
        description: "App Hide/Unhide: Remotely control which apps are visible or usable on the device."
    },
    {
        icon: "fa-map-marked-alt",
        title: "Real-Time Surveillance",
        description: "High-precision real-time GPS tracking and authorized camera access for security audits."
    },
    {
        icon: "fa-comment-dots",
        title: "Secure Communication",
        description: "Integrated custom SMS system for encrypted, private internal messaging within the locker environment."
    }
];

const emiFeatures = [
    {
        icon: "fa-bell",
        title: "Custom EMI Reminders",
        description: "Customized reminders and notifications sent directly to the customer's mobile screen when payment is due."
    },
    {
        icon: "fa-lock",
        title: "Instant Remote Lock",
        description: "Lock the entire device with one click from the admin panel upon default. The customer can only access 'Payment' and 'Emergency Call'."
    },
    {
        icon: "fa-ban",
        title: "Anti-Wipe / Factory Reset Block",
        description: "Hard Reset or Recovery Mode is completely blocked. The customer cannot factory reset the device to remove the locker."
    },
    {
        icon: "fa-hands",
        title: "Zero Touch Enrollment",
        description: "Seamlessly deploy and configure devices in bulk right out of the box without manual setup."
    },
    {
        icon: "fa-power-off",
        title: "Reboot, Flash & Developer Mode Disable",
        description: "Completely restrict device rebooting, flashing custom ROMs, and accessing developer options without authorization."
    },
    {
        icon: "fa-map-marker-alt",
        title: "Real-Time GPS Tracking",
        description: "Precise real-time GPS tracking and IMEI-based location, even if the SIM is removed or the device is lost."
    }
];
---

<MainLayout title="Mobile App Development & MDM Solutions | Globix Tech">
    <Navbar />

    <div class="min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors duration-300">
        <PageHeader
            title="Mobile App"
            spanTitle="Development"
            description="At Globix Tech, we don't just build apps; we create powerful digital experiences and secure mobile environments."
            badge="Development & Security"
            badgeIcon="fa-mobile-alt"
        />

        <div class="container mx-auto px-6 py-20 mt-10">
            <!-- 01. Core Development Services -->
            <div class="mb-24">
                <div class="text-center mb-16">
                    <span class="text-blue-600 dark:text-blue-400 font-semibold tracking-wider uppercase text-sm">01. Our Services</span>
                    <h2 class="text-4xl font-bold text-gray-900 dark:text-white mt-2 mb-4">Core Development Services</h2>
                    <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-lg">Whether you are a startup or a global enterprise, our expert team delivers custom mobile applications that blend cutting-edge functionality with high security.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {
                        coreServices.map((service) => (
                            <Card class="bg-white dark:bg-gray-800 border-gray-100 dark:border-gray-700 h-full flex items-start gap-6 p-8 hover:shadow-xl transition-all duration-300">
                                <div class={`w-16 h-16 rounded-2xl flex items-center justify-center text-3xl shrink-0 ${service.color.replace('text', 'bg').replace('-500', '-100')} dark:bg-opacity-10`}>
                                    <i class={`fas ${service.icon} ${service.color}`} />
                                </div>
                                <div>
                                    <h3 class="text-2xl font-bold text-[#0c1b3d] dark:text-white mb-3">
                                        {service.title}
                                    </h3>
                                    <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-lg">
                                        {service.description}
                                    </p>
                                </div>
                            </Card>
                        ))
                    }
                </div>
            </div>

            <!-- 02. MDM Secure Locker -->
            <div class="mb-24 relative">
                <!-- Decorative Background -->
               <div class="absolute inset-0 bg-blue-600/[0.03] dark:bg-blue-900/10 rounded-[3rem] -z-10 transform -skew-y-2"></div>
               
               <div class="py-16 px-4 md:px-12">
                   <div class="text-center mb-16">
                        <span class="text-blue-600 dark:text-blue-400 font-semibold tracking-wider uppercase text-sm">02. Proprietary Tech</span>
                        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mt-2 mb-6 leading-tight">Globix Secure-Locker:<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">Beyond Enterprise Security</span></h2>
                        <p class="text-gray-600 dark:text-gray-300 max-w-3xl mx-auto text-lg mb-8">
                            Security is the backbone of Globix Tech. While the world relies on third-party tools, we provide our own Proprietary High-Security MDM (Mobile Device Management) Locker. Our solution offers the same—and in many cases, superior—build quality and reliability as global standards like <strong>Samsung Knox, SOTI, and BK Locker</strong>.
                        </p>
                        <p class="text-gray-600 dark:text-gray-300 max-w-3xl mx-auto text-lg opacity-90 italic">
                            Our locker is engineered for organizations that require absolute control. It is a "Zero-Trust" environment that protects your devices from tampering, theft, and unauthorized data access.
                        </p>
                   </div>
                   
                   <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {
                            lockerFeatures.map((feat) => (
                                <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-md rounded-2xl p-8 border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-lg transition-all duration-300 group">
                                    <div class="w-12 h-12 bg-gray-100 dark:bg-gray-700 rounded-xl flex items-center justify-center text-blue-600 dark:text-blue-400 text-xl mb-6 group-hover:scale-110 transition-transform">
                                        <i class={`fas ${feat.icon}`} />
                                    </div>
                                    <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-3">{feat.title}</h4>
                                    <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{feat.description}</p>
                                </div>
                            ))
                        }
                   </div>
               </div>
            </div>

            <!-- 03. EMI Locker System -->
            <div class="mb-24">
                <div class="text-center mb-16">
                    <span class="text-orange-600 dark:text-orange-400 font-semibold tracking-wider uppercase text-sm">03. EMI Solution</span>
                    <h2 class="text-4xl font-bold text-gray-900 dark:text-white mt-2 mb-4">Globix EMI Management & Anti-Theft Locker</h2>
                    <p class="text-gray-600 dark:text-gray-300 max-w-3xl mx-auto text-lg leading-relaxed">
                        The biggest risk in the financing business is payment default. Globix Tech brings an advanced EMI Locker System, making mobile financing <strong>100% risk-free.</strong> If customers fail to pay their EMI on time, our system will seamlessly lock the device.
                    </p>
                </div>

                <h3 class="text-2xl font-bold text-[#0c1b3d] dark:text-white mb-8 text-center">Special Features for EMI Business</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
                    {
                        emiFeatures.map((feat) => (
                            <div class="bg-orange-50/50 dark:bg-orange-900/10 rounded-2xl p-6 border border-orange-100 dark:border-orange-800/30 hover:-translate-y-1 transition-transform">
                                <div class="w-12 h-12 bg-white dark:bg-gray-800 rounded-xl flex items-center justify-center text-orange-500 shadow-sm mb-4">
                                    <i class={`fas ${feat.icon} text-xl`} />
                                </div>
                                <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{feat.title}</h4>
                                <p class="text-gray-600 dark:text-gray-400">{feat.description}</p>
                            </div>
                        ))
                    }
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                    <div class="bg-white dark:bg-gray-800 rounded-[2rem] p-8 border border-gray-100 dark:border-gray-700 shadow-lg">
                        <h3 class="text-2xl font-bold text-[#0c1b3d] dark:text-white mb-6 border-b border-gray-100 dark:border-gray-700 pb-4">Why Choose Globix EMI Locker?</h3>
                        <ul class="space-y-4">
                            <li class="flex items-start">
                                <i class="fas fa-check-circle text-green-500 mt-1 mr-4 text-xl"></i>
                                <div>
                                    <h5 class="font-bold text-gray-900 dark:text-white">Risk Reduction</h5>
                                    <p class="text-gray-600 dark:text-gray-400">Your investment remains 100% secure.</p>
                                </div>
                            </li>
                            <li class="flex items-start">
                                <i class="fas fa-check-circle text-green-500 mt-1 mr-4 text-xl"></i>
                                <div>
                                    <h5 class="font-bold text-gray-900 dark:text-white">User-Friendly Dashboard</h5>
                                    <p class="text-gray-600 dark:text-gray-400">Manage thousands of devices from a single dashboard.</p>
                                </div>
                            </li>
                            <li class="flex items-start">
                                <i class="fas fa-check-circle text-green-500 mt-1 mr-4 text-xl"></i>
                                <div>
                                    <h5 class="font-bold text-gray-900 dark:text-white">Low Cost, High Security</h5>
                                    <p class="text-gray-600 dark:text-gray-400">Get world-class security (similar to Samsung Knox) at a lower cost.</p>
                                </div>
                            </li>
                            <li class="flex items-start">
                                <i class="fas fa-check-circle text-green-500 mt-1 mr-4 text-xl"></i>
                                <div>
                                    <h5 class="font-bold text-gray-900 dark:text-white">Custom Branding</h5>
                                    <p class="text-gray-600 dark:text-gray-400">Your company logo and message integrated into the locker.</p>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <div class="bg-gradient-to-br from-orange-500 to-red-500 rounded-[2rem] p-8 text-white shadow-lg overflow-hidden relative">
                        <div class="absolute -bottom-10 -right-10 opacity-10">
                            <i class="fas fa-users text-[15rem]"></i>
                        </div>
                        <div class="relative z-10">
                            <h3 class="text-2xl font-bold mb-6 border-b border-white/20 pb-4">Target Audience</h3>
                            <p class="text-orange-50 mb-6">Our EMI management system is perfect for:</p>
                            <div class="space-y-4">
                                <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 flex items-center">
                                    <i class="fas fa-store text-2xl w-10"></i>
                                    <span class="font-semibold text-lg">Mobile Showroom Owners</span>
                                </div>
                                <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 flex items-center">
                                    <i class="fas fa-hand-holding-usd text-2xl w-10"></i>
                                    <span class="font-semibold text-lg">Micro-finance Organizations (NGO/Bank)</span>
                                </div>
                                <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 flex items-center">
                                    <i class="fas fa-building text-2xl w-10"></i>
                                    <span class="font-semibold text-lg">Corporate Device Management</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 04. iOS Security -->
            <div class="mb-24">
                <div class="bg-gradient-to-br from-gray-900 to-[#0c1b3d] dark:from-gray-800 dark:to-gray-900 rounded-[2.5rem] p-10 md:p-16 text-white relative overflow-hidden shadow-2xl">
                    <div class="absolute top-0 right-0 p-12 opacity-10 blur-xl">
                        <i class="fab fa-apple text-[15rem]"></i>
                    </div>
                    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                        <div>
                            <span class="text-blue-400 font-semibold tracking-wider uppercase text-sm mb-2 block">04. Innovation</span>
                            <h2 class="text-4xl font-bold mb-6">The Future of iOS Security</h2>
                            <p class="text-gray-300 text-lg mb-6 leading-relaxed">
                                Historically, the iPhone ecosystem has not supported 3rd party security lockers due to Apple's closed architecture. At Globix Tech, we are changing that.
                            </p>
                            <div class="bg-white/10 backdrop-blur-md rounded-xl p-6 border border-white/20">
                                <h4 class="font-bold text-xl mb-2 flex items-center"><i class="fas fa-flask text-blue-400 mr-3"></i>Current Research</h4>
                                <p class="text-gray-200">
                                    We are actively building a dedicated security framework for iOS. Our goal is to bring our signature "Never-Delete" and hardware-level locking features to iPhones, providing a level of security previously thought impossible on Apple devices.
                                </p>
                            </div>
                        </div>
                        <div class="space-y-6">
                            <h3 class="text-2xl font-bold border-b border-gray-700 pb-4 mb-6">Why Partner with Globix Tech?</h3>
                            <div class="flex items-start">
                                <i class="fas fa-check-circle text-green-400 mt-1 text-xl mr-4"></i>
                                <div>
                                    <h5 class="font-bold text-lg mb-1">Proprietary Technology</h5>
                                    <p class="text-gray-400">We provide our own built-in locker solution, ensuring direct support and updates.</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <i class="fas fa-check-circle text-green-400 mt-1 text-xl mr-4"></i>
                                <div>
                                    <h5 class="font-bold text-lg mb-1">End-to-End Development</h5>
                                    <p class="text-gray-400">From the first line of code to the final security layer, we handle it all.</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <i class="fas fa-check-circle text-green-400 mt-1 text-xl mr-4"></i>
                                <div>
                                    <h5 class="font-bold text-lg mb-1">Global Quality</h5>
                                    <p class="text-gray-400">Our systems are built to compete with the world's best security providers.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA Section -->
            <div
                class="bg-blue-600 dark:bg-blue-700 rounded-[2rem] p-12 text-center relative overflow-hidden text-white"
            >
                <div class="absolute inset-0 bg-gradient-to-r from-blue-700 to-cyan-500 opacity-50 z-0"></div>
                <div class="relative z-10">
                    <h2 class="text-3xl md:text-4xl font-bold mb-6">
                        Ready to Build Your Secure Mobile Future?
                    </h2>
                    <p class="text-blue-100 text-lg mb-8 max-w-2xl mx-auto">
                        Contact Globix Tech Today
                    </p>
                    <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
                        <Button href="mailto:info@globix.tech" variant="outline" class="!bg-white !text-blue-600 hover:!bg-blue-50 border-none px-8 py-3 text-lg rounded-xl font-bold">
                            <i class="fas fa-envelope mr-2"></i> info@globix.tech
                        </Button>
                        <Button href="https://globix.tech/" variant="outline" class="!bg-transparent !text-white border-2 border-white hover:!bg-white/10 px-8 py-3 text-lg rounded-xl font-bold">
                            <i class="fas fa-globe mr-2"></i> Visit globix.tech
                        </Button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <Footer />
</MainLayout>
