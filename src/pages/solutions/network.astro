---
// Location: frontend/src/pages/solutions/network.astro
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import VideoBackground from "../../components/landing/VideoBackground.astro";
---

<MainLayout title="Network Solutions - Globix Tech">
    <Navbar />


    <main class="relative z-10 min-h-screen bg-white text-slate-900 font-sans antialiased selection:bg-cyan-500/20 selection:text-cyan-900">
        
        <!-- ================= HERO SECTION ================= -->
        <section class="relative pt-28 pb-14 sm:pt-36 sm:pb-24 md:pt-48 md:pb-36 overflow-hidden bg-gradient-to-r from-cyan-100/80 via-blue-100/70 to-indigo-100/60">
            <!-- Background Video with Top-Half Height Fade Cut -->
            <div class="absolute inset-0 pointer-events-none">
                <video
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover scale-105 opacity-50"
                    style="-webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%);"
                >
                    <source src="/videos/network/Training_Programs_Industry_ori.mp4" type="video/mp4" />
                </video>
                <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/25 via-blue-500/25 to-indigo-500/25"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-cyan-50/20 to-[#FBFBFD]"></div>
            </div>

            <!-- Bottom Faded Soft Transition Layer -->
            <div class="absolute bottom-0 inset-x-0 h-48 sm:h-60 bg-gradient-to-b from-transparent via-[#FBFBFD]/90 to-[#FBFBFD] pointer-events-none z-10"></div>
            <!-- Soft Faded Bottom Border Line -->
            <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-200/30 to-transparent pointer-events-none z-20"></div>

            <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
                <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                    
                    <!-- Left Hero Content -->
                    <div class="lg:col-span-7 space-y-4 sm:space-y-8 text-left">
                        <!-- Apple-style Badge -->
                        <div class="inline-flex items-center gap-2 sm:gap-2.5 px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full bg-white/80 border border-slate-200/80 shadow-[0_2px_10px_rgba(0,0,0,0.03)] backdrop-blur-xl">
                            <span class="flex h-2 w-2 rounded-full bg-cyan-500 animate-pulse"></span>
                            <span class="text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-slate-700">
                                Enterprise Networking
                            </span>
                        </div>

                        <!-- Main Headline -->
                        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.08]">
                            Seamless Connectivity, <br />
                            <span class="bg-gradient-to-r from-cyan-600 via-blue-600 to-indigo-600 bg-clip-text text-transparent">
                                Robust Security.
                            </span>
                        </h1>

                        <!-- Lead Text -->
                        <p class="text-sm sm:text-lg lg:text-xl text-slate-600 max-w-2xl font-normal leading-relaxed">
                            We design, build, and manage scalable network infrastructures that keep your business connected and secure.
                        </p>

                        <!-- CTA Actions -->
                        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
                            <a
                                href="#contact"
                                class="inline-flex items-center justify-center gap-3 bg-slate-900 hover:bg-slate-800 text-white px-7 sm:px-8 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl font-semibold transition-all duration-300 shadow-[0_10px_25px_rgba(15,23,42,0.15)] hover:shadow-[0_15px_30px_rgba(15,23,42,0.25)] hover:-translate-y-0.5 text-sm sm:text-base"
                            >
                                <span>Get Started</span>
                                <i class="fas fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
                            </a>
                            <a
                                href="#pricing"
                                class="inline-flex items-center justify-center gap-2 bg-white/80 hover:bg-white text-slate-700 border border-slate-200/80 px-6 sm:px-7 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl font-semibold backdrop-blur-xl transition-all duration-300 shadow-sm hover:shadow-md text-sm sm:text-base"
                            >
                                View Packages
                            </a>
                        </div>
                    </div>

                    <!-- Right Hero Animation (VIDEO ANIMATION 1) -->
                    <div class="lg:col-span-5">
                        <div class="relative group mx-auto max-w-md lg:max-w-none">
                            <div class="absolute -inset-1 bg-gradient-to-r from-cyan-400/30 to-blue-500/30 rounded-2xl sm:rounded-[2.5rem] blur-2xl opacity-50 group-hover:opacity-75 transition duration-1000"></div>
                            
                            <!-- Glass Frame Video Wrapper -->
                            <div class="relative rounded-2xl sm:rounded-[2rem] p-2 sm:p-3 bg-white/70 border border-white/80 shadow-[0_20px_50px_rgba(0,0,0,0.06)] backdrop-blur-2xl overflow-hidden">
                                <div class="relative rounded-xl sm:rounded-[1.5rem] overflow-hidden aspect-[4/3] bg-slate-900">
                                    <video 
                                        autoplay 
                                        loop 
                                        muted 
                                        playsinline 
                                        class="w-full h-full object-cover opacity-90 scale-105"
                                    >
                                        <source src="/videos/network/Seamless_Connectivity__Robust.mp4" type="video/mp4" />
                                        Your browser does not support the video tag.
                                    </video>
                                    
                                    <!-- Video Overlay Glass Pill -->
                                    <div class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 p-3 sm:p-4 rounded-lg sm:rounded-xl bg-white/80 border border-white/60 backdrop-blur-md shadow-lg flex items-center justify-between text-left">
                                        <div class="flex items-center gap-2.5 sm:gap-3">
                                            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-600 text-xs sm:text-sm shrink-0">
                                                <i class="fas fa-network-wired"></i>
                                            </div>
                                            <div>
                                                <div class="text-xs font-bold text-slate-900">Core Network Status</div>
                                                <div class="text-[10px] sm:text-[11px] text-slate-500">99.99% Uptime Active</div>
                                            </div>
                                        </div>
                                        <span class="px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">Live</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>


        <!-- ================= CORPORATE & OFFICE SOLUTIONS ================= -->
        <section class="py-14 sm:py-20 lg:py-28 relative">
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
                
                <!-- Section Header -->
                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-20 space-y-2 sm:space-y-4">
                    <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-cyan-600 bg-cyan-50 px-3.5 py-1.5 rounded-full border border-cyan-100">
                        Enterprise Grade Infrastructure
                    </span>
                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
                        Corporate & Office Solutions
                    </h2>
                    <p class="text-slate-600 text-xs sm:text-base md:text-lg">
                        Reliable, scalable, and secure network solutions tailored for modern businesses.
                    </p>
                </div>

                <!-- Video Showcase & Feature Grid Hybrid -->
                <div class="grid lg:grid-cols-12 gap-6 sm:gap-8 items-stretch">
                    
                    <!-- Feature Highlight Video Banner (VIDEO ANIMATION 2) -->
                    <div class="lg:col-span-12 mb-2 sm:mb-4">
                        <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden bg-slate-900 border border-slate-700 shadow-[0_15px_35px_rgba(0,0,0,0.03)] p-1.5 sm:p-2 text-left">
                            <div class="grid md:grid-cols-12 gap-4 sm:gap-6 items-center">
                                <div class="md:col-span-7 relative h-48 sm:h-64 md:h-80 rounded-xl sm:rounded-2xl overflow-hidden">
                                    <video autoplay loop muted playsinline class="w-full h-full object-cover">
                                        <source src="https://assets.mixkit.co/videos/preview/mixkit-view-of-a-server-room-with-cables-and-lights-42861-large.mp4" type="video/mp4" />
                                    </video>
                                    <video autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover hidden md:block pointer-events-none" style="mask-image: linear-gradient(to right, black 40%, transparent 100%); -webkit-mask-image: linear-gradient(to right, black 40%, transparent 100%);">
                                        <source src="/videos/rd-wing/deep tech.mp4" type="video/mp4" />
                                    </video>
                                </div>
                                <div class="md:col-span-5 p-4 sm:p-6 md:p-8 space-y-2 sm:space-y-4">
                                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-cyan-500/20 border border-cyan-400/30 flex items-center justify-center text-cyan-300 text-lg sm:text-xl font-bold shrink-0">
                                        <i class="fas fa-microchip"></i>
                                    </div>
                                    <h3 class="text-xl sm:text-2xl font-bold text-white">Precision Infrastructure Engineering</h3>
                                    <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                                        We integrate high-density cabling, automated failover routing, and zero-trust perimeter firewalls into a single glass panel workflow.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Service Cards (4 Original Services) -->
                    <div class="lg:col-span-3 sm:col-span-6">
                        <div class="h-full p-6 sm:p-8 rounded-2xl sm:rounded-3xl bg-white/70 hover:bg-white border border-slate-200/70 hover:border-cyan-300 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_40px_rgba(6,182,212,0.08)] transition-all duration-300 backdrop-blur-xl group flex flex-col justify-between text-left">
                            <div>
                                <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-cyan-50 border border-cyan-100/80 flex items-center justify-center text-cyan-600 text-xl sm:text-2xl mb-4 sm:mb-6 group-hover:scale-110 transition-transform duration-300 shrink-0">
                                    <i class="fas fa-building"></i>
                                </div>
                                <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 sm:mb-3">Office Network Setup</h3>
                                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                                    Complete office network planning & deployment. From small startups to large corporate environments, we ensure secure internet access and internal segmentation.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-3 sm:col-span-6">
                        <div class="h-full p-6 sm:p-8 rounded-2xl sm:rounded-3xl bg-white/70 hover:bg-white border border-slate-200/70 hover:border-blue-300 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_40px_rgba(59,130,246,0.08)] transition-all duration-300 backdrop-blur-xl group flex flex-col justify-between text-left">
                            <div>
                                <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-blue-50 border border-blue-100/80 flex items-center justify-center text-blue-600 text-xl sm:text-2xl mb-4 sm:mb-6 group-hover:scale-110 transition-transform duration-300 shrink-0">
                                    <i class="fas fa-network-wired"></i>
                                </div>
                                <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 sm:mb-3">LAN Support Services</h3>
                                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                                    Expert switch configuration, structured cabling guidance, and rapid troubleshooting for end-user network issues.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-3 sm:col-span-6">
                        <div class="h-full p-6 sm:p-8 rounded-2xl sm:rounded-3xl bg-white/70 hover:bg-white border border-slate-200/70 hover:border-purple-300 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_40px_rgba(168,85,247,0.08)] transition-all duration-300 backdrop-blur-xl group flex flex-col justify-between text-left">
                            <div>
                                <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-purple-50 border border-purple-100/80 flex items-center justify-center text-purple-600 text-xl sm:text-2xl mb-4 sm:mb-6 group-hover:scale-110 transition-transform duration-300 shrink-0">
                                    <i class="fas fa-wifi"></i>
                                </div>
                                <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 sm:mb-3">Wireless Solutions</h3>
                                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                                    Enterprise-grade Wi-Fi deployment with heat mapping, seamless roaming, and secure guest access management.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-3 sm:col-span-6">
                        <div class="h-full p-6 sm:p-8 rounded-2xl sm:rounded-3xl bg-white/70 hover:bg-white border border-slate-200/70 hover:border-emerald-300 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_20px_40px_rgba(16,185,129,0.08)] transition-all duration-300 backdrop-blur-xl group flex flex-col justify-between text-left">
                            <div>
                                <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-emerald-50 border border-emerald-100/80 flex items-center justify-center text-emerald-600 text-xl sm:text-2xl mb-4 sm:mb-6 group-hover:scale-110 transition-transform duration-300 shrink-0">
                                    <i class="fas fa-shield-alt"></i>
                                </div>
                                <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 sm:mb-3">Secure Connectivity</h3>
                                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                                    Implementation of VLANs, VPNs for inter-branch connectivity, and QoS policies to prioritize critical business traffic.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>


        <!-- ================= ISP & TELECOM SOLUTIONS ================= -->
        <section class="py-14 sm:py-20 lg:py-28 relative overflow-hidden">
            <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" />
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
                
                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-20 space-y-2 sm:space-y-4">
                    <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-blue-600 bg-blue-50 px-3.5 py-1.5 rounded-full border border-blue-100">
                        Carrier-Grade Architecture
                    </span>
                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
                        ISP & Telecom Solutions
                    </h2>
                    <p class="text-slate-600 text-xs sm:text-base md:text-lg">
                        Core network design and optimization for Internet Service Providers.
                    </p>
                </div>

                <div class="grid lg:grid-cols-12 gap-6 sm:gap-8 items-center text-left">
                    
                    <!-- ISP Video Showcase Feature (VIDEO ANIMATION 3) -->
                    <div class="lg:col-span-5">
                        <div class="relative rounded-2xl sm:rounded-3xl p-2 sm:p-3 bg-white/80 border border-white/90 shadow-[0_20px_45px_rgba(0,0,0,0.04)] backdrop-blur-2xl">
                            <div class="relative rounded-xl sm:rounded-2xl overflow-hidden aspect-[4/5]">
                                <video autoplay loop muted playsinline class="w-full h-full object-cover">
                                    <source src="/videos/network/ISP_Telecom_Solutions_Core_n.mp4" type="video/mp4" />
                                </video>
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent"></div>
                                <div class="absolute bottom-4 left-4 right-4 sm:bottom-6 sm:left-6 sm:right-6 text-white space-y-1 sm:space-y-2">
                                    <div class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-cyan-400">High Speed Fiber Core</div>
                                    <div class="text-lg sm:text-xl font-bold">Ultra-low Latency BGP Peering</div>
                                    <p class="text-xs text-slate-300">Optimized traffic routing for Tier-1, Tier-2, and regional ISPs.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3 ISP Service Cards (Original Text Data) -->
                    <div class="lg:col-span-7 space-y-4 sm:space-y-6">
                        
                        <!-- ISP 1 -->
                        <div class="p-5 sm:p-8 rounded-2xl sm:rounded-3xl bg-white/80 hover:bg-white border border-slate-200/80 hover:border-cyan-400 shadow-[0_10px_30px_rgba(0,0,0,0.02)] transition-all duration-300 backdrop-blur-xl group">
                            <div class="flex items-start gap-4 sm:gap-5">
                                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-cyan-50 border border-cyan-100 flex items-center justify-center text-cyan-600 text-lg sm:text-xl font-bold shrink-0">
                                    <i class="fas fa-globe"></i>
                                </div>
                                <div class="space-y-2 sm:space-y-3">
                                    <h3 class="text-lg sm:text-xl font-bold text-slate-900">ISP Routing & Core Network</h3>
                                    <ul class="space-y-2 sm:space-y-2.5 text-slate-600 text-xs sm:text-sm">
                                        <li class="flex items-center gap-2 sm:gap-2.5">
                                            <i class="fas fa-check-circle text-cyan-500 text-sm sm:text-base shrink-0"></i>
                                            <span>Full ISP network design (Core, Distribution, Access)</span>
                                        </li>
                                        <li class="flex items-center gap-2 sm:gap-2.5">
                                            <i class="fas fa-check-circle text-cyan-500 text-sm sm:text-base shrink-0"></i>
                                            <span>BGP routing & Traffic Engineering</span>
                                        </li>
                                        <li class="flex items-center gap-2 sm:gap-2.5">
                                            <i class="fas fa-check-circle text-cyan-500 text-sm sm:text-base shrink-0"></i>
                                            <span>IPv6 Deployment & Redundancy</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- ISP 2 -->
                        <div class="p-5 sm:p-8 rounded-2xl sm:rounded-3xl bg-white/80 hover:bg-white border border-slate-200/80 hover:border-cyan-400 shadow-[0_10px_30px_rgba(0,0,0,0.02)] transition-all duration-300 backdrop-blur-xl group">
                            <div class="flex items-start gap-4 sm:gap-5">
                                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 text-lg sm:text-xl font-bold shrink-0">
                                    <i class="fas fa-sitemap"></i>
                                </div>
                                <div class="space-y-2 sm:space-y-3">
                                    <h3 class="text-lg sm:text-xl font-bold text-slate-900">OLT Expertise (Global Standard)</h3>
                                    <ul class="space-y-2 sm:space-y-2.5 text-slate-600 text-xs sm:text-sm">
                                        <li class="flex items-center gap-2.5">
                                            <i class="fas fa-check-circle text-cyan-500 text-sm sm:text-base shrink-0"></i>
                                            <span>EPON / GPON Architecture</span>
                                        </li>
                                        <li class="flex items-center gap-2.5">
                                            <i class="fas fa-check-circle text-cyan-500 text-sm sm:text-base shrink-0"></i>
                                            <span>OLT Configuration & Optimization</span>
                                        </li>
                                        <li class="flex items-center gap-2.5">
                                            <i class="fas fa-check-circle text-cyan-500 text-sm sm:text-base shrink-0"></i>
                                            <span>Vendor-neutral (Huawei, ZTE, V-SOL, etc.)</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- ISP 3 -->
                        <div class="p-5 sm:p-8 rounded-2xl sm:rounded-3xl bg-white/80 hover:bg-white border border-slate-200/80 hover:border-cyan-400 shadow-[0_10px_30px_rgba(0,0,0,0.02)] transition-all duration-300 backdrop-blur-xl group">
                            <div class="flex items-start gap-4 sm:gap-5">
                                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 text-lg sm:text-xl font-bold shrink-0">
                                    <i class="fas fa-tools"></i>
                                </div>
                                <div class="space-y-2 sm:space-y-3">
                                    <h3 class="text-lg sm:text-xl font-bold text-slate-900">Advanced Support & Troubleshooting</h3>
                                    <ul class="space-y-2 sm:space-y-2.5 text-slate-600 text-xs sm:text-sm">
                                        <li class="flex items-center gap-2.5">
                                            <i class="fas fa-check-circle text-cyan-500 text-sm sm:text-base shrink-0"></i>
                                            <span>Fault diagnosis and rapid resolution</span>
                                        </li>
                                        <li class="flex items-center gap-2.5">
                                            <i class="fas fa-check-circle text-cyan-500 text-sm sm:text-base shrink-0"></i>
                                            <span>End-to-end performance tuning</span>
                                        </li>
                                        <li class="flex items-center gap-2.5">
                                            <i class="fas fa-check-circle text-cyan-500 text-sm sm:text-base shrink-0"></i>
                                            <span>Support for both ISP and enterprise networks</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </section>


        <!-- ================= TRAINING SECTION (GLOBIX ACADEMY) ================= -->
        <section class="py-14 sm:py-20 lg:py-28 relative">
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
                
                <!-- Section Title Header -->
                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-20 space-y-2 sm:space-y-4">
                    <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-indigo-600 bg-indigo-50 px-3.5 sm:px-4 py-1.5 rounded-full border border-indigo-100">
                        Globix Academy
                    </span>
                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
                        Training Programs
                    </h2>
                    <p class="text-slate-600 text-xs sm:text-base md:text-lg">
                        Industry-oriented, real-world technical training delivered by active core network engineers.
                    </p>
                </div>

                <!-- Academy Interactive Visual Banner (VIDEO ANIMATION 4) -->
                <div class="mb-8 sm:mb-12 rounded-2xl sm:rounded-3xl p-2 sm:p-3 bg-white/80 border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] backdrop-blur-2xl">
                    <div class="relative rounded-xl sm:rounded-2xl h-44 sm:h-64 overflow-hidden">
                        <video autoplay loop muted playsinline class="w-full h-full object-cover">
                            <source src="/videos/network/Training_Programs_Industry_ori.mp4" type="video/mp4" />
                        </video>
                        <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-[2px] flex items-center justify-between p-5 sm:p-8 md:p-12 text-left">
                            <div class="max-w-xl text-white space-y-1.5 sm:space-y-2">
                                <h3 class="text-lg sm:text-2xl font-bold">Hands-on Laboratory Environment</h3>
