    <script>
        // Pricing Plan Interaction
        document
            .querySelectorAll('input[type="radio"]')
            .forEach((radio) => {
                radio.addEventListener("change", (e) => {
                    const planIdx = (e.target as HTMLInputElement).dataset
                        .planIndex;
                    const price = (e.target as HTMLInputElement).value;
                    const priceDisplay = document.getElementById(
                        `price-${planIdx}`,
                    );
                    if (priceDisplay) {
                        priceDisplay.textContent = `${price} BDT`;
                    }
                });
            });

        // Billing Toggle Animation
        const toggle = document.getElementById("billing-toggle");
        if (toggle) {
            toggle.addEventListener("click", () => {
                const dot = toggle.querySelector("div");
                dot?.classList.toggle("translate-x-7");
                toggle.classList.toggle("bg-gray-300");
                toggle.classList.toggle("bg-cyan-500");
            });
        }
