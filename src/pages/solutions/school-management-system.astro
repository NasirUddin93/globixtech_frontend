---
// Location: frontend/src/pages/solutions/school-management-system.astro

import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import { Image } from "astro:assets";
import smsMockup from "../../assets/sms_mockup.png";
import studentLifecycle from "../../assets/student_lifecycle.png";
import mobileAppsShowcase from "../../assets/mobile_apps_showcase.png";
import Footer from "../../components/Footer.astro";
import VideoBackground from "../../components/landing/VideoBackground.astro";

import {
    pricingPlans,
    institutionTypes,
    moduleCategories,
    stats,
    coreFeatures,
    faqs,
} from "../../data/sms";
---

<MainLayout title="School Management System - Globix Tech Solutions">
    <Navbar />

    <main class="min-h-screen bg-[#fafafa] text-slate-900 font-sans selection:bg-cyan-500 selection:text-white">
        


        <!-- Hero Section (Apple Ultra-Light Glass Aesthetic) -->
        <section class="relative pt-28 pb-14 sm:pt-36 sm:pb-24 md:pt-48 md:pb-36 overflow-hidden z-10 bg-gradient-to-r from-blue-100/80 via-cyan-100/70 to-indigo-100/60">
            <!-- Background Video with Top-Half Height Fade Cut -->
            <div class="absolute inset-0 pointer-events-none">
                <video
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover scale-105 opacity-50"
                    style="-webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 10%, rgba(0,0,0,0) 38%);"
                >
                    <source src="/videos/school-management-system/Powering_Next_Gen_Education_Ma.mp4" type="video/mp4" />
                </video>
                <div class="absolute inset-0 bg-gradient-to-r from-blue-500/25 via-cyan-500/25 to-indigo-500/25"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-blue-50/20 to-[#FBFBFD]"></div>
            </div>

            <!-- Bottom Faded Soft Transition Layer -->
            <div class="absolute bottom-0 inset-x-0 h-48 sm:h-60 bg-gradient-to-b from-transparent via-[#FBFBFD]/90 to-[#FBFBFD] pointer-events-none z-10"></div>
            <!-- Soft Faded Bottom Border Line -->
            <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-200/30 to-transparent pointer-events-none z-20"></div>

            <div class="container mx-auto px-4 sm:px-6 relative z-10">
                <div class="max-w-4xl mx-auto text-center mb-10 sm:mb-16">
                    
                    <!-- Glass Badge -->
                    <div class="inline-flex items-center gap-2 sm:gap-2.5 bg-white/80 backdrop-blur-xl border border-white/90 px-4 sm:px-5 py-1.5 sm:py-2.5 rounded-full text-blue-600 text-[11px] sm:text-sm font-semibold shadow-[0_4px_20px_rgba(0,0,0,0.03)] mb-6 sm:mb-8 transition-transform hover:scale-105">
                        <span class="flex h-2 w-2 rounded-full bg-cyan-500 animate-pulse"></span>
                        <i class="fas fa-graduation-cap text-blue-500 text-xs sm:text-sm"></i>
                        <span>Intelligent Education Platform</span>
                    </div>

                    <!-- Apple-Style Headline -->
                    <h1 class="text-3xl sm:text-5xl md:text-7xl font-extrabold tracking-tight text-slate-900 leading-[1.08] mb-4 sm:mb-8">
                        Education Management Software for <br class="hidden md:block"/>
                        <span class="bg-gradient-to-r from-blue-600 via-cyan-600 to-indigo-600 bg-clip-text text-transparent">
                            Kindergarten, Schools, and Madrasah
                        </span>
                    </h1>

                    <p class="text-sm sm:text-lg md:text-2xl text-slate-600 max-w-3xl mx-auto font-normal leading-relaxed mb-6 sm:mb-10">
                        Manage attendance, exams, fees, communication, admissions, and reporting in one unified dashboard. GlobixTech gives administrators, teachers, and guardians dedicated portals to stay organized in real time.
                    </p>

                    <!-- Hero Call-To-Action -->
                    <div class="flex flex-col sm:flex-row justify-center items-stretch sm:items-center gap-3 sm:gap-4">
                        <a
                            href="/#contact"
                            class="bg-slate-900 hover:bg-slate-800 text-white px-7 sm:px-8 py-3.5 sm:py-4.5 rounded-xl sm:rounded-2xl font-semibold transition-all shadow-xl shadow-slate-900/10 hover:shadow-2xl hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-3 text-sm md:text-base"
                        >
                            <span>Request a Live Demo</span>
                            <i class="fas fa-arrow-right text-xs opacity-70"></i>
                        </a>
                        <a
                            href="tel:+8801707568468"
                            class="bg-white/80 backdrop-blur-xl border border-white/90 hover:bg-white text-slate-800 px-7 sm:px-8 py-3.5 sm:py-4.5 rounded-xl sm:rounded-2xl font-semibold transition-all shadow-sm hover:shadow-md flex items-center justify-center gap-3 text-sm md:text-base"
                        >
                            <i class="fas fa-phone-alt text-cyan-600 text-sm"></i>
                            <span>Call for Consultation</span>
                        </a>
                    </div>
                </div>

                <!-- VIDEO SHOWCASE 1: Interactive Dashboard Platform Showcase -->
                <div class="relative max-w-5xl mx-auto mt-6 sm:mt-12">
                    <div class="absolute -inset-4 bg-gradient-to-r from-cyan-400/20 via-blue-500/20 to-indigo-400/20 rounded-2xl sm:rounded-[2.5rem] blur-2xl opacity-70"></div>
                    
                    <div class="relative rounded-2xl sm:rounded-[2rem] p-2 sm:p-5 bg-white/70 backdrop-blur-2xl border border-white/90 shadow-[0_30px_100px_rgba(0,0,0,0.08)]">
                        <!-- Frame Header Bar -->
                        <div class="flex items-center justify-between pb-2 sm:pb-3 px-2 sm:px-3 border-b border-slate-100 mb-2 sm:mb-3">
                            <div class="flex items-center gap-1.5 sm:gap-2">
                                <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-rose-400"></span>
                                <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-amber-400"></span>
                                <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-emerald-400"></span>
                            </div>
                            <div class="text-[10px] sm:text-[11px] font-medium text-slate-400 bg-slate-100/80 px-3 sm:px-4 py-0.5 sm:py-1 rounded-full border border-slate-200/50 truncate max-w-[200px] sm:max-w-none">
                                globixtech.com/solutions/school-management-system
                            </div>
                            <div class="w-8 sm:w-12"></div>
                        </div>

                        <!-- Video Player 1 -->
                        <div class="relative overflow-hidden rounded-xl sm:rounded-2xl bg-slate-900 aspect-video group">
                            <video 
                                class="w-full h-full object-cover transform group-hover:scale-[1.01] transition-transform duration-700" 
                                autoplay loop muted playsinline 
                                poster={smsMockup.src}
                            >
                                <source src="/videos/school-management-system/Education_Management_Software.mp4" type="video/mp4" />
                                <Image src={smsMockup} alt="SMS Dashboard Preview" class="w-full object-cover" />
                            </video>
                            
                            <!-- Video Overlay Badge -->
                            <div class="absolute bottom-2.5 left-2.5 sm:bottom-4 sm:left-4 bg-slate-900/80 backdrop-blur-md border border-white/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg sm:rounded-xl flex items-center gap-2 sm:gap-3 text-white text-[10px] sm:text-xs font-medium">
                                <span class="flex h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-emerald-400 animate-ping"></span>
                                Live Platform Engine Overview
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- Stats Bar (Frosted Glass Floating Card) -->
        <section class="py-8 sm:py-10 z-10 relative">
            <div class="container mx-auto px-4 sm:px-6">
                <div class="max-w-5xl mx-auto rounded-2xl sm:rounded-3xl bg-white/70 backdrop-blur-2xl border border-white/90 p-5 sm:p-8 shadow-[0_10px_40px_rgba(0,0,0,0.03)] grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 text-center divide-x-0 md:divide-x divide-slate-100">
                    <div class="group px-2">
                        <div class="text-2xl sm:text-4xl md:text-5xl font-extrabold bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent mb-1 group-hover:scale-105 transition-transform">
                            36+
                        </div>
                        <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-widest">
                            Industry Modules
                        </div>
                    </div>
                    <div class="group px-2">
                        <div class="text-2xl sm:text-4xl md:text-5xl font-extrabold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent mb-1 group-hover:scale-105 transition-transform">
                            900+
                        </div>
                        <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-widest">
                            Core Features
                        </div>
                    </div>
                    <div class="group px-2">
                        <div class="text-2xl sm:text-4xl md:text-5xl font-extrabold bg-gradient-to-r from-cyan-600 to-teal-600 bg-clip-text text-transparent mb-1 group-hover:scale-105 transition-transform">
                            24/7
                        </div>
                        <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-widest">
                            Expert Support
                        </div>
                    </div>
                    <div class="group px-2">
                        <div class="text-2xl sm:text-4xl md:text-5xl font-extrabold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent mb-1 group-hover:scale-105 transition-transform">
                            100%
                        </div>
                        <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-widest">
                            Cloud Reliable
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Core Features Section -->
        <section class="py-14 sm:py-20 lg:py-28 z-10 relative overflow-hidden">
            <VideoBackground mp4="/videos/rd-wing/generate_a_white_background_wi.mp4" />
            <div class="container mx-auto px-4 sm:px-6 relative z-10">
                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-20">
                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-3 sm:mb-5">
                        Designed for Effortless Academic Excellence
                    </h2>
                    <p class="text-slate-600 text-xs sm:text-base md:text-lg leading-relaxed">
                        GlobixTech brings attendance, exams, fees, communication, admissions, and reporting together into a seamless workflow.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-8">
                    {
                        [
                            {
                                title: "Student Attendance",
                                desc: "Mark attendance by class or subject. Teachers can do it from mobile and view daily or monthly records instantly.",
                                icon: "fa-calendar-check",
                                color: "text-blue-600",
                                bg: "bg-blue-50 border-blue-100",
                            },
                            {
                                title: "Student Information",
                                desc: "Each student has a full profile, including class, contact, guardian, fees, and academic records stored securely.",
                                icon: "fa-user-graduate",
                                color: "text-purple-600",
                                bg: "bg-purple-50 border-purple-100",
                            },
                            {
                                title: "Admission & Forms",
                                desc: "New student data, online forms, and class placements are managed from one screen. Filter by status or batch.",
                                icon: "fa-file-signature",
                                color: "text-cyan-600",
                                bg: "bg-cyan-50 border-cyan-100",
                            },
                            {
                                title: "Academic Activities",
                                desc: "Automate routine academic chores such as exam shifts, seating plans, and class timetables with zero friction.",
                                icon: "fa-tasks",
                                color: "text-amber-600",
                                bg: "bg-amber-50 border-amber-100",
                            },
                            {
                                title: "Online Fee Collection",
                                desc: "Accept payments by bKash, cards, or cash. Auto-generate digital receipts and track real-time dues effortlessly.",
                                icon: "fa-money-bill-wave",
                                color: "text-emerald-600",
                                bg: "bg-emerald-50 border-emerald-100",
                            },
                            {
                                title: "Exam & Report Cards",
                                desc: "Enter marks, auto-calculate GPA, and publish digital report cards accessible by students and guardians.",
                                icon: "fa-poll-h",
                                color: "text-rose-600",
                                bg: "bg-rose-50 border-rose-100",
                            },
                        ].map((f) => (
                            <div class="bg-white/80 backdrop-blur-xl p-6 sm:p-8 rounded-2xl sm:rounded-[2rem] border border-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] hover:-translate-y-1 transition-all duration-300 group text-left">
                                <div class={`w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl flex items-center justify-center ${f.bg} border ${f.color} text-xl sm:text-2xl mb-4 sm:mb-6 group-hover:scale-110 transition-transform`}>
                                    <i class={`fas ${f.icon}`} />
                                </div>
                                <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 sm:mb-3">
                                    {f.title}
                                </h3>
                                <p class="text-slate-600 leading-relaxed text-xs sm:text-sm">
                                    {f.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- VIDEO SHOWCASE 2: Student Lifecycle & Smart Workflows Highlight -->
        <section class="py-14 sm:py-20 lg:py-24 bg-white/50 border-y border-slate-200/60 backdrop-blur-lg relative z-10">
            <div class="container mx-auto px-4 sm:px-6">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-center text-left">
                    
                    <!-- Text Content Left -->
                    <div class="lg:col-span-5">
                        <div class="inline-flex items-center gap-2 bg-blue-50 border border-blue-100 text-blue-600 px-3.5 sm:px-4 py-1 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-bold uppercase tracking-wider mb-4 sm:mb-6">
                            Academic Foundation
                        </div>
                        <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 sm:mb-6">
                            Student Lifecycle Management
                        </h2>
                        
                        <p class="text-slate-600 text-xs sm:text-base md:text-lg leading-relaxed mb-6 sm:mb-8 border-l-4 border-cyan-500 pl-3 sm:pl-4 bg-slate-50/80 py-2.5 sm:py-3 rounded-r-xl">
                            "GlobixTech brings attendance, exams, fees, communication, admissions, and reporting together so institutions run every workflow smoothly."
                        </p>

                        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3.5 mb-6 sm:mb-8">
                            {
                                [
                                    "Admission (online + offline)",
                                    "Merit list & lottery",
                                    "Migration & TC",
                                    "Promotion / Detention",
                                    "Alumni management",
                                ].map((feat) => (
                                    <li class="flex items-center gap-2 sm:gap-2.5 text-slate-700 text-xs sm:text-sm font-semibold">
                                        <div class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center text-[10px] sm:text-xs shrink-0">
                                            <i class="fas fa-check" />
                                        </div>
                                        <span>{feat}</span>
                                    </li>
                                ))
                            }
                        </ul>

                        <div class="p-4 sm:p-5 bg-white/90 rounded-xl sm:rounded-2xl border border-slate-200/80 shadow-sm">
                            <h4 class="font-bold text-slate-900 mb-1 flex items-center gap-2 text-xs sm:text-sm">
                                <i class="fas fa-mobile-alt text-cyan-600"></i> Smart Attendance Integration
                            </h4>
                            <p class="text-slate-500 text-[11px] sm:text-xs leading-relaxed">
                                Mark attendance by class or subject. Teachers can do it from mobile and view daily or monthly records instantly.
                            </p>
                        </div>
                    </div>

                    <!-- Video Container Right (VIDEO 2) -->
                    <div class="lg:col-span-7 relative">
                        <div class="absolute -inset-4 sm:-inset-6 bg-gradient-to-r from-blue-400/20 to-indigo-300/20 blur-3xl rounded-2xl sm:rounded-[3rem]"></div>
                        
                        <div class="relative bg-white/80 backdrop-blur-2xl p-3 sm:p-6 rounded-2xl sm:rounded-[2.5rem] border border-white/90 shadow-[0_20px_60px_rgba(0,0,0,0.06)]">
                            <div class="relative overflow-hidden rounded-xl sm:rounded-[1.8rem] bg-slate-900 aspect-[16/10] group">
                                <video 
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                                    autoplay loop muted playsinline 
                                    poster={studentLifecycle.src}
                                >
                                    <source src="/videos/school-management-system/Student_Lifecycle_Management__.mp4" type="video/mp4" />
                                    <Image src={studentLifecycle} alt="Student Lifecycle Illustration" class="w-full object-cover" />
                                </video>
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
                                <div class="absolute bottom-3 left-3 right-3 sm:bottom-6 sm:left-6 sm:right-6 text-white flex justify-between items-end">
                                    <div>
                                        <div class="text-[10px] sm:text-xs font-semibold text-cyan-300 uppercase tracking-widest mb-0.5 sm:mb-1">Live Workflow</div>
                                        <div class="text-sm sm:text-lg font-bold">End-To-End Student Automation</div>
                                    </div>
                                    <div class="bg-white/20 backdrop-blur-md px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-lg sm:rounded-xl border border-white/30 text-[10px] sm:text-xs">
                                        Active Sync
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- VIDEO SHOWCASE 3: Specialized App Portals Ecosystem -->
        <section class="py-14 sm:py-20 lg:py-28 z-10 relative">
            <div class="container mx-auto px-4 sm:px-6">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-16 items-center">
                    
                    <!-- Video Container Left (VIDEO 3) -->
                    <div class="lg:col-span-6 order-2 lg:order-1 relative">
                        <div class="absolute -inset-4 sm:-inset-6 bg-gradient-to-r from-cyan-300/30 to-blue-300/30 blur-3xl rounded-2xl sm:rounded-[3rem]"></div>
                        
                        <div class="relative bg-white/80 backdrop-blur-2xl p-3 sm:p-6 rounded-2xl sm:rounded-[2.5rem] border border-white/90 shadow-[0_20px_60px_rgba(0,0,0,0.06)]">
                            <div class="relative overflow-hidden rounded-xl sm:rounded-[1.8rem] bg-slate-900 aspect-square md:aspect-[4/3] group">
                                <video 
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                                    autoplay loop muted playsinline 
                                    poster={mobileAppsShowcase.src}
                                >
                                    <source src="/videos/school-management-system/Mobile_Apps_for_Admins_Teache.mp4" type="video/mp4" />
                                    <Image src={mobileAppsShowcase} alt="Mobile Apps Showcase" class="w-full object-cover" />
                                </video>
                                <div class="absolute top-3 right-3 sm:top-4 sm:right-4 bg-slate-900/80 backdrop-blur-md border border-white/20 px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full text-white text-[10px] sm:text-xs font-medium">
                                    iOS & Android Native
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Text Right -->
                    <div class="lg:col-span-6 order-1 lg:order-2 text-left">
                        <div class="inline-flex items-center gap-2 bg-cyan-50 border border-cyan-100 text-cyan-600 px-3.5 sm:px-4 py-1 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-bold uppercase tracking-wider mb-4 sm:mb-6">
                            Cross-Platform Portals
                        </div>
                        
                        <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 sm:mb-6">
                            Mobile Apps for Admins, Teachers, and Guardians
                        </h2>
                        
                        <p class="text-slate-600 text-xs sm:text-base md:text-lg leading-relaxed mb-6 sm:mb-8">
                            GlobixTech's mobile application ecosystem gives teachers, administrators, and guardians full access to institutional operations anytime, anywhere.
                        </p>

                        <div class="space-y-3 sm:space-y-4">
                            <div class="p-4 sm:p-6 bg-white/80 backdrop-blur-xl rounded-xl sm:rounded-2xl border border-white/90 shadow-sm hover:shadow-md transition-all">
                                <h4 class="text-base sm:text-lg font-bold text-slate-900 mb-1 flex items-center gap-2">
                                    <i class="fas fa-user-shield text-blue-600"></i> Guardian Portal App
                                </h4>
                                <p class="text-slate-600 text-xs sm:text-sm">
                                    Connects parents directly with schools for fee payments, live attendance alerts, exam results, and instant announcements.
                                </p>
                            </div>

                            <div class="p-4 sm:p-6 bg-white/80 backdrop-blur-xl rounded-xl sm:rounded-2xl border border-white/90 shadow-sm hover:shadow-md transition-all">
                                <h4 class="text-base sm:text-lg font-bold text-slate-900 mb-1 flex items-center gap-2">
                                    <i class="fas fa-chalkboard-teacher text-cyan-600"></i> Teacher Portal App
                                </h4>
                                <p class="text-slate-600 text-xs sm:text-sm">
                                    Empowers academic staff with task management, class routine scheduling, and rapid mark submission tools.
                                </p>
                            </div>

                            <div class="p-4 sm:p-6 bg-white/80 backdrop-blur-xl rounded-xl sm:rounded-2xl border border-white/90 shadow-sm hover:shadow-md transition-all">
                                <h4 class="text-base sm:text-lg font-bold text-slate-900 mb-1 flex items-center gap-2">
                                    <i class="fas fa-user-cog text-indigo-600"></i> Admin Executive App
                                </h4>
                                <p class="text-slate-600 text-xs sm:text-sm">
                                    Complete institutional oversight, daily financial health reports, and staff HR administration on the go.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </section>

        <!-- Institution Targeting Section (Interactive Apple Glass Switcher) -->
        <section class="py-14 sm:py-20 lg:py-28 z-10 relative">
            <div class="container mx-auto px-4 sm:px-6">
                
                <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-6 sm:gap-8 mb-8 sm:mb-12">
                    <div class="max-w-2xl text-left">
                        <span class="text-xs font-bold uppercase tracking-widest text-cyan-600 mb-2 block">Tailored Solutions</span>
                        <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
                            Built for Any Educational Model
                        </h2>
                    </div>
                    
                    <!-- Glass Segmented Tab Bar -->
                    <div class="flex flex-wrap gap-1.5 sm:gap-2 bg-white/80 backdrop-blur-2xl p-1.5 sm:p-2 rounded-xl sm:rounded-2xl border border-white/90 shadow-sm">
                        {institutionTypes.map((type, idx) => (
                            <button 
                                data-tab-id={type.id}
                                class={`institution-tab px-3.5 sm:px-6 py-2 sm:py-3 rounded-lg sm:rounded-xl font-bold text-xs md:text-sm transition-all duration-300 ${idx === 0 ? 'bg-slate-900 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100/60'}`}
                            >
                                {type.label}
                            </button>
                        ))}
                    </div>
                </div>

