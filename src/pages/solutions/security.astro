---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<MainLayout title="Cybersecurity Solutions - Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-slate-50">
        <!-- Hero Section -->
        <section
            class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden bg-[#0a0a0a]"
        >
            <div
                class="absolute inset-0 bg-gradient-to-br from-[#0a0a0a] via-[#1f0f0f] to-[#0a0a0a]"
            >
            </div>
            <div
                class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-red-500/10 to-transparent blur-3xl"
            >
            </div>

            <div class="container mx-auto px-6 relative z-10 text-center">
                <div
                    class="inline-flex items-center gap-2 bg-red-500/10 border border-red-500/20 px-4 py-2 rounded-full text-red-500 text-sm font-bold mb-6"
                >
                    <i class="fas fa-shield-alt"></i> Advanced Cybersecurity
                </div>
                <h1
                    class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-[1.1]"
                >
                    Protect Your Business, <br />
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-500"
                        >Data, and Reputation</span
                    >
                </h1>
                <p
                    class="text-lg md:text-xl text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed"
                >
                    Comprehensive security services to identify vulnerabilities,
                    prevent attacks, and ensure compliance.
                </p>
                <div class="flex justify-center gap-4">
                    <a
                        href="#contact"
                        class="bg-red-600 hover:bg-red-700 text-white px-8 py-4 rounded-xl font-bold transition-all shadow-lg shadow-red-600/20 flex items-center gap-2"
                    >
                        Get Assessed <i class="fas fa-arrow-right text-sm"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- Services Overview -->
        <section class="py-24 bg-white">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl md:text-5xl font-bold text-[#0a0a0a] mb-4"
                    >
                        Security Services
                    </h2>
                    <p class="text-gray-600 max-w-3xl mx-auto">
                        Proactive protection against modern digital threats.
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <!-- Service 1 -->
                    <div
                        class="bg-slate-50 p-8 rounded-2xl hover:bg-white hover:shadow-xl transition-all border border-slate-100 group"
                    >
                        <div
                            class="w-14 h-14 bg-red-100 rounded-xl flex items-center justify-center text-red-600 text-2xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            <i class="fas fa-bug"></i>
                        </div>
                        <h3 class="text-xl font-bold text-[#0a0a0a] mb-3">
                            VAPT Services
                        </h3>
                        <p class="text-gray-600">
                            Vulnerability Assessment & Penetration Testing to
                            identify and fix weaknesses in your web, mobile, and
                            network infrastructure.
                        </p>
                    </div>

                    <!-- Service 2 -->
                    <div
                        class="bg-slate-50 p-8 rounded-2xl hover:bg-white hover:shadow-xl transition-all border border-slate-100 group"
                    >
                        <div
                            class="w-14 h-14 bg-orange-100 rounded-xl flex items-center justify-center text-orange-600 text-2xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            <i class="fas fa-file-contract"></i>
                        </div>
                        <h3 class="text-xl font-bold text-[#0a0a0a] mb-3">
                            Security Audits
                        </h3>
                        <p class="text-gray-600">
                            Comprehensive compliance audits (GDPR, ISO 27001) to
                            ensure your organization meets industry standards.
                        </p>
                    </div>

                    <!-- Service 3 -->
                    <div
                        class="bg-slate-50 p-8 rounded-2xl hover:bg-white hover:shadow-xl transition-all border border-slate-100 group"
                    >
                        <div
                            class="w-14 h-14 bg-rose-100 rounded-xl flex items-center justify-center text-rose-600 text-2xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            <i class="fas fa-eye"></i>
                        </div>
                        <h3 class="text-xl font-bold text-[#0a0a0a] mb-3">
                            Managed SOC
                        </h3>
                        <p class="text-gray-600">
                            24/7 Security Operations Center monitoring to detect
                            and respond to threats in real-time.
                        </p>
                    </div>

                    <!-- Service 4 -->
                    <div
                        class="bg-slate-50 p-8 rounded-2xl hover:bg-white hover:shadow-xl transition-all border border-slate-100 group"
                    >
                        <div
                            class="w-14 h-14 bg-amber-100 rounded-xl flex items-center justify-center text-amber-600 text-2xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            <i class="fas fa-user-graduate"></i>
                        </div>
                        <h3 class="text-xl font-bold text-[#0a0a0a] mb-3">
                            Employee Training
                        </h3>
                        <p class="text-gray-600">
                            Phishing simulations and cybersecurity awareness
                            training to strengthen your human firewall.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="py-24 bg-slate-50" id="pricing">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl md:text-5xl font-bold text-[#0a0a0a] mb-4"
                    >
                        Security Packages
                    </h2>
                    <p class="text-gray-600 max-w-3xl mx-auto">
                        Choose the level of protection your business needs.
                    </p>
                </div>

                <div class="overflow-x-auto pb-8">
                    <table
                        class="w-full min-w-[1000px] border-collapse border border-gray-200 bg-white shadow-sm"
                    >
                        <thead>
                            <tr class="bg-gray-50">
                                <th
                                    class="p-6 text-left border border-gray-200 w-1/4"
                                    >Features</th
                                >
                                <th
                                    class="p-6 text-center border border-gray-200 w-1/4 bg-blue-50/50"
                                >
                                    <div
                                        class="font-bold text-[#0a0a0a] text-xl mb-1"
                                    >
                                        Basic Audit
                                    </div>
                                    <div class="text-sm text-gray-500">
                                        One-time Assessment
                                    </div>
                                </th>
                                <th
                                    class="p-6 text-center border border-gray-200 w-1/4 bg-orange-50/50"
                                >
                                    <div
                                        class="font-bold text-[#0a0a0a] text-xl mb-1"
                                    >
                                        Standard Protection
                                    </div>
                                    <div class="text-sm text-gray-500">
                                        Continuous Security
                                    </div>
                                </th>
                                <th
                                    class="p-6 text-center border border-gray-200 w-1/4 bg-red-50/50"
                                >
                                    <div
                                        class="font-bold text-[#0a0a0a] text-xl mb-1"
                                    >
                                        Managed SOC
                                    </div>
                                    <div class="text-sm text-gray-500">
                                        24/7 Monitoring
                                    </div>
                                </th>
                            </tr>
                            <tr>
                                <th
                                    class="p-4 text-left border border-gray-200 font-bold text-gray-700"
                                    >Price</th
                                >
                                <th
                                    class="p-4 text-center border border-gray-200 font-bold text-xl text-blue-600"
                                    >৳ 15,000 / scan</th
                                >
                                <th
                                    class="p-4 text-center border border-gray-200 font-bold text-xl text-orange-600"
                                    >Starts @ ৳ 25,000 / mo</th
                                >
                                <th
                                    class="p-4 text-center border border-gray-200 font-bold text-xl text-red-600"
                                    >Custom Quote</th
                                >
                            </tr>
                        </thead>
                        <tbody class="text-sm">
                            {
                                [
                                    {
                                        name: "Vulnerability Scanning",
                                        vals: ["One-time", "Monthly", "Weekly"],
                                    },
                                    {
                                        name: "Penetration Testing",
                                        vals: ["Basic", "Standard", "Advanced"],
                                    },
                                    {
                                        name: "Report & Remediation",
                                        vals: [true, true, true],
                                    },
                                    {
                                        name: "Firewall Management",
                                        vals: [false, true, true],
                                    },
                                    {
                                        name: "Malware Protection",
                                        vals: [false, true, true],
                                    },
                                    {
                                        name: "Real-time Monitoring",
                                        vals: [false, false, "24/7 SOC"],
                                    },
                                    {
                                        name: "Incident Response",
                                        vals: [
                                            false,
                                            "Standard",
                                            "Priority (1hr)",
                                        ],
                                    },
                                    {
                                        name: "Compliance Support",
                                        vals: [false, false, true],
                                    },
                                ].map((row, idx) => (
                                    <tr
                                        class={
                                            idx % 2 === 0
                                                ? "bg-white"
                                                : "bg-gray-50/50"
                                        }
                                    >
                                        <td class="p-4 border border-gray-200 font-medium text-gray-700">
                                            {row.name}
                                        </td>
                                        {row.vals.map((val) => (
                                            <td class="p-4 border border-gray-200 text-center text-gray-600">
                                                {typeof val === "boolean" ? (
                                                    val ? (
                                                        <i class="fas fa-check text-red-500 text-lg" />
                                                    ) : (
                                                        <i class="fas fa-times text-gray-300 text-lg" />
                                                    )
                                                ) : (
                                                    val
                                                )}
                                            </td>
                                        ))}
                                    </tr>
                                ))
                            }
                            <tr class="bg-white">
                                <td class="p-4 border border-gray-200"></td>
                                {
                                    [
                                        "Book Audit",
                                        "Get Protected",
                                        "Contact SOC Team",
                                    ].map((btn, i) => (
                                        <td class="p-4 border border-gray-200 text-center">
                                            <a
                                                href="#contact"
                                                class={`inline-block px-6 py-2 rounded text-sm font-bold transition-colors text-white ${
                                                    i === 0
                                                        ? "bg-blue-500 hover:bg-blue-600"
                                                        : i === 1
                                                          ? "bg-orange-500 hover:bg-orange-600"
                                                          : "bg-red-600 hover:bg-red-700"
                                                }`}
                                            >
                                                {btn}
                                            </a>
                                        </td>
                                    ))
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="py-20 bg-[#0a0a0a] relative overflow-hidden">
            <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-10">
            </div>
            <div class="container mx-auto px-6 relative z-10 text-center">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
                    Worried About Digital Threats?
                </h2>
                <p class="text-gray-400 mb-10 max-w-2xl mx-auto">
                    Don't wait for a breach. Secure your infrastructure with
                    GlobixTech today.
                </p>
                <a
                    href="#contact"
                    class="bg-red-600 text-white px-10 py-4 rounded-full font-bold hover:bg-red-700 transition-colors inline-flex items-center gap-2"
                >
                    Talk to a Security Expert <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </section>
    </main>

    <Footer />
</MainLayout>
