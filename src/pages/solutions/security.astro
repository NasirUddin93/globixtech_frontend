---
// Location: frontend/src/pages/solutions/security.astro
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<MainLayout title="Cybersecurity Solutions - Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-[#FBFBFD] text-slate-900 font-sans antialiased overflow-hidden">
        
        <!-- ============================================ -->
        <!-- HERO SECTION (Full Glowing Red Aesthetic + Video 1) -->
        <!-- ============================================ -->
        <section class="relative pt-36 pb-24 md:pt-52 md:pb-36 overflow-hidden bg-gradient-to-r from-red-100/80 via-rose-100/60 to-orange-50/60 animate-slow-gradient">
            <!-- Intense Red Ambient Backdrop Lighting Glows -->
            <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1200px] h-[650px] bg-gradient-to-tr from-red-500/35 via-rose-500/45 to-orange-500/30 blur-[140px] rounded-full pointer-events-none -z-10 animate-pulse"></div>
            <div class="absolute top-1/4 -right-20 w-96 h-96 bg-red-500/40 blur-[120px] rounded-full pointer-events-none -z-10"></div>
            <div class="absolute top-1/4 -left-20 w-96 h-96 bg-rose-600/35 blur-[120px] rounded-full pointer-events-none -z-10"></div>
            <!-- Bottom Faded Soft Transition Layer -->
            <div class="absolute bottom-0 inset-x-0 h-36 bg-gradient-to-b from-transparent via-[#FBFBFD]/60 to-[#FBFBFD] pointer-events-none z-10"></div>

            <div class="container mx-auto px-6 max-w-7xl relative z-20">
                <div class="grid lg:grid-cols-12 gap-12 items-center">
                    
                    <!-- Left Hero Content -->
                    <div class="lg:col-span-7 text-left space-y-6">
                        <!-- Glowing Red Glass Badge -->
                        <div class="inline-flex items-center gap-2 bg-red-500/10 backdrop-blur-xl border border-red-500/20 shadow-[0_0_20px_rgba(239,68,68,0.15)] px-5 py-2 rounded-full text-red-600 text-xs md:text-sm font-bold tracking-wide uppercase">
                            <i class="fas fa-shield-alt text-red-500 text-base animate-pulse"></i> Advanced Cybersecurity Engine
                        </div>

                        <!-- Main Heading -->
                        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.08]">
                            Protect Your Business, <br />
                            <span class="bg-gradient-to-r from-red-600 via-rose-600 to-red-500 bg-clip-text text-transparent">
                                Data, and Reputation
                            </span>
                        </h1>

                        <!-- Subtitle -->
                        <p class="text-lg md:text-xl text-slate-700 max-w-2xl font-medium leading-relaxed tracking-tight">
                            Comprehensive security services to identify vulnerabilities, prevent attacks, and ensure compliance.
                        </p>

                        <!-- Hero CTA Buttons -->
                        <div class="pt-2 flex flex-wrap items-center gap-4">
                            <a
                                href="#contact"
                                class="group relative inline-flex items-center justify-center gap-3 bg-red-600 hover:bg-red-700 text-white px-8 py-4 rounded-full font-semibold text-base transition-all duration-300 shadow-[0_10px_30px_rgba(220,38,38,0.35)] hover:shadow-[0_15px_40px_rgba(220,38,38,0.5)] hover:-translate-y-0.5 active:translate-y-0"
                            >
                                <span>Get Assessed</span>
                                <i class="fas fa-arrow-right text-xs transition-transform duration-300 group-hover:translate-x-1"></i>
                            </a>
                            <a
                                href="#pricing"
                                class="inline-flex items-center justify-center gap-2 bg-white/80 hover:bg-white text-slate-800 border border-red-200/50 px-7 py-4 rounded-full font-semibold backdrop-blur-xl transition-all duration-300 shadow-sm hover:shadow-md"
                            >
                                Explore Plans
                            </a>
                        </div>
                    </div>

                    <!-- Right Hero Video Showcase (VIDEO 1) -->
                    <div class="lg:col-span-5">
                        <div class="relative rounded-3xl p-3.5 bg-gradient-to-b from-white/90 via-red-50/70 to-white/90 backdrop-blur-2xl border border-red-200/50 shadow-[0_20px_50px_rgba(239,68,68,0.12)]">
                            <div class="relative rounded-2xl overflow-hidden aspect-[4/3] bg-slate-900 border border-red-200/40 group shadow-inner">
                                <!-- High Quality Animation Video Placeholder / HTML5 Video -->
                                <video 
                                    class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-102 opacity-95" 
                                    autoplay 
                                    loop 
                                    muted 
                                    playsinline
                                    poster="https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1600&q=80"
                                >
                                    <source src="https://assets.mixkit.co/videos/preview/mixkit-digital-animation-of-screens-41481-large.mp4" type="video/mp4" />
                                </video>

                                <!-- Glowing Red Glass Overlay Badge on Video -->
                                <div class="absolute bottom-4 left-4 right-4 bg-slate-900/85 backdrop-blur-xl border border-red-500/40 px-4 py-3 rounded-2xl shadow-[0_0_20px_rgba(239,68,68,0.3)] flex items-center gap-3">
                                    <span class="relative flex h-3 w-3">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
                                    </span>
                                    <span class="text-xs font-bold text-white tracking-wider uppercase">Active Threat Mesh</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ============================================ -->
        <!-- SERVICES OVERVIEW SECTION (Bento Grid Style) -->
        <!-- ============================================ -->
        <section class="py-28 relative">
            <div class="container mx-auto px-6">
                <!-- Section Header -->
                <div class="text-center max-w-3xl mx-auto mb-20">
                    <h2 class="text-4xl md:text-6xl font-extrabold text-slate-900 tracking-tight mb-4">
                        Security Services
                    </h2>
                    <p class="text-lg md:text-xl text-slate-500 font-normal">
                        Proactive protection against modern digital threats.
                    </p>
                </div>

                <!-- Feature Grid with Videos 2 & 3 Integrated -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

                    <!-- CARD 1: VAPT Services (Large Card with Red Tint & VIDEO 2) -->
                    <div class="lg:col-span-7 bg-gradient-to-br from-red-50/90 via-rose-50/50 to-white/80 backdrop-blur-2xl rounded-3xl p-8 md:p-10 border border-red-200/80 shadow-[0_10px_35px_rgba(239,68,68,0.08)] hover:shadow-[0_20px_50px_rgba(239,68,68,0.15)] transition-all duration-500 flex flex-col justify-between group">
                        <div class="mb-8">
                            <div class="w-14 h-14 bg-red-500 text-white rounded-2xl flex items-center justify-center text-2xl mb-6 shadow-md shadow-red-500/30 group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-bug"></i>
                            </div>
                            <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4 tracking-tight">
                                VAPT Services
                            </h3>
                            <p class="text-slate-600 leading-relaxed text-base md:text-lg max-w-xl">
                                Vulnerability Assessment & Penetration Testing to identify and fix weaknesses in your web, mobile, and network infrastructure.
                            </p>
                        </div>

                        <!-- VIDEO 2: VAPT Scanning Animation -->
                        <div class="rounded-2xl overflow-hidden border border-red-200/70 bg-slate-900 aspect-[16/9] relative shadow-md">
                            <video class="w-full h-full object-cover opacity-90" autoplay loop muted playsinline>
                                <source src="https://assets.mixkit.co/videos/preview/mixkit-security-camera-recording-a-hallway-41538-large.mp4" type="video/mp4" />
                            </video>
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
                            <div class="absolute top-4 right-4 bg-slate-900/80 backdrop-blur-md px-3 py-1 rounded-full text-[10px] font-mono text-red-400 border border-red-500/20">
                                SCANNING_CORE_v2.4
                            </div>
                        </div>
                    </div>

                    <!-- CARD 2: Security Audits -->
                    <div class="lg:col-span-5 bg-white/70 backdrop-blur-2xl rounded-3xl p-8 md:p-10 border border-slate-200/80 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] transition-all duration-500 flex flex-col justify-between group">
                        <div>
                            <div class="w-14 h-14 bg-orange-50 border border-orange-100 rounded-2xl flex items-center justify-center text-orange-600 text-2xl mb-6 shadow-sm group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-file-contract"></i>
                            </div>
                            <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4 tracking-tight">
                                Security Audits
                            </h3>
                            <p class="text-slate-600 leading-relaxed text-base md:text-lg mb-6">
                                Comprehensive compliance audits (GDPR, ISO 27001) to ensure your organization meets industry standards.
                            </p>
                        </div>

                        <!-- VIDEO: Security Audit Compliance Scanning -->
                        <div class="rounded-2xl overflow-hidden border border-slate-200/70 bg-slate-900 aspect-video relative my-6">
                            <video class="w-full h-full object-cover opacity-90" autoplay loop muted playsinline>
                                <source src="https://assets.mixkit.co/videos/preview/mixkit-hand-typing-on-a-computer-keyboard-41561-large.mp4" type="video/mp4" />
                            </video>
                            <div class="absolute inset-0 bg-slate-950/20"></div>
                            <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-md px-3 py-1 rounded-lg text-xs font-semibold text-slate-800">
                                📋 Compliance Matrix & Verification
                            </div>
                        </div>

                        <div class="p-6 bg-gradient-to-br from-orange-50/50 to-amber-50/30 rounded-2xl border border-orange-100/60">
                            <div class="flex items-center gap-3 text-orange-700 font-semibold text-sm">
                                <i class="fas fa-check-circle text-orange-500 text-lg"></i>
                                <span>ISO 27001 & GDPR Certified Workflows</span>
                            </div>
                        </div>
                    </div>

                    <!-- CARD 3: Managed SOC (Large Card with Red Tint & VIDEO 3) -->
                    <div class="lg:col-span-5 bg-gradient-to-br from-rose-50/90 via-red-50/40 to-white/80 backdrop-blur-2xl rounded-3xl p-8 md:p-10 border border-rose-200/80 shadow-[0_10px_35px_rgba(225,29,72,0.08)] hover:shadow-[0_20px_50px_rgba(225,29,72,0.15)] transition-all duration-500 flex flex-col justify-between group">
                        <div>
                            <div class="w-14 h-14 bg-rose-600 text-white rounded-2xl flex items-center justify-center text-2xl mb-6 shadow-md shadow-rose-600/30 group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-eye"></i>
                            </div>
                            <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4 tracking-tight">
                                Managed SOC
                            </h3>
                            <p class="text-slate-600 leading-relaxed text-base md:text-lg mb-6">
                                24/7 Security Operations Center monitoring to detect and respond to threats in real-time.
                            </p>
                        </div>

                        <!-- VIDEO 3: Managed SOC Monitoring Video -->
                        <div class="rounded-2xl overflow-hidden border border-slate-200/70 bg-slate-900 aspect-video relative">
                            <video class="w-full h-full object-cover opacity-90" autoplay loop muted playsinline>
                                <source src="https://assets.mixkit.co/videos/preview/mixkit-cyber-security-network-code-31804-large.mp4" type="video/mp4" />
                            </video>
                            <div class="absolute inset-0 bg-slate-950/20"></div>
                            <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-md px-3 py-1 rounded-lg text-xs font-semibold text-slate-800">
                                ⚡ 24/7 Live Incident Stream
                            </div>
                        </div>
                    </div>

                    <!-- CARD 4: Employee Training (With VIDEO 4 Integration) -->
                    <div class="lg:col-span-7 bg-white/70 backdrop-blur-2xl rounded-3xl p-8 md:p-10 border border-slate-200/80 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] transition-all duration-500 flex flex-col justify-between group">
                        <div class="grid md:grid-cols-2 gap-8 items-center">
                            <div>
                                <div class="w-14 h-14 bg-amber-50 border border-amber-100 rounded-2xl flex items-center justify-center text-amber-600 text-2xl mb-6 shadow-sm group-hover:scale-110 transition-transform duration-300">
                                    <i class="fas fa-user-graduate"></i>
                                </div>
                                <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4 tracking-tight">
                                    Employee Training
                                </h3>
                                <p class="text-slate-600 leading-relaxed text-base md:text-lg">
                                    Phishing simulations and cybersecurity awareness training to strengthen your human firewall.
                                </p>
                            </div>

                            <!-- VIDEO 4: Phishing Simulation Video -->
                            <div class="rounded-2xl overflow-hidden border border-slate-200/70 bg-slate-900 aspect-square relative shadow-md">
                                <video class="w-full h-full object-cover opacity-85" autoplay loop muted playsinline>
                                    <source src="https://assets.mixkit.co/videos/preview/mixkit-futuristic-robotic-arm-working-in-a-laboratory-42898-large.mp4" type="video/mp4" />
                                </video>
                                <div class="absolute top-3 left-3 bg-amber-500 text-white font-bold text-[10px] uppercase px-2.5 py-1 rounded-md tracking-wider">
                                    Human Firewall
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ============================================ -->
        <!-- PRICING SECTION (Glassmorphic Table) -->
        <!-- ============================================ -->
        <section class="py-28 relative" id="pricing">
            <div class="container mx-auto px-6">
                <!-- Section Header -->
                <div class="text-center max-w-3xl mx-auto mb-20">
                    <h2 class="text-4xl md:text-6xl font-extrabold text-slate-900 tracking-tight mb-4">
                        Security Packages
                    </h2>
                    <p class="text-lg md:text-xl text-slate-500 font-normal">
                        Choose the level of protection your business needs.
                    </p>
                </div>

                <!-- Table Container with Ultra-Clean Glassmorphism -->
                <div class="max-w-6xl mx-auto overflow-hidden rounded-3xl bg-white/80 backdrop-blur-2xl border border-slate-200/80 shadow-[0_20px_50px_rgba(0,0,0,0.05)]">
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[900px] border-collapse text-left">
                            <thead>
                                <tr class="border-b border-slate-100 bg-slate-50/50">
                                    <th class="p-8 text-lg font-bold text-slate-900 w-1/4">Features</th>
                                    
                                    <!-- Basic Audit -->
                                    <th class="p-8 text-center w-1/4 border-l border-slate-100 bg-blue-50/30">
                                        <div class="font-bold text-slate-900 text-2xl mb-1">Basic Audit</div>
                                        <div class="text-xs font-semibold uppercase tracking-wider text-blue-600">One-time Assessment</div>
                                    </th>

                                    <!-- Standard Protection -->
                                    <th class="p-8 text-center w-1/4 border-l border-slate-100 bg-orange-50/30">
                                        <div class="font-bold text-slate-900 text-2xl mb-1">Standard Protection</div>
                                        <div class="text-xs font-semibold uppercase tracking-wider text-orange-600">Continuous Security</div>
                                    </th>

                                    <!-- Managed SOC -->
                                    <th class="p-8 text-center w-1/4 border-l border-slate-100 bg-red-50/30">
                                        <div class="font-bold text-slate-900 text-2xl mb-1">Managed SOC</div>
                                        <div class="text-xs font-semibold uppercase tracking-wider text-red-600">24/7 Monitoring</div>
                                    </th>
                                </tr>

                                <!-- Price Header Row -->
                                <tr class="border-b border-slate-200/70 bg-white">
                                    <th class="p-6 text-sm font-bold uppercase tracking-wider text-slate-400">Price</th>
                                    <th class="p-6 text-center border-l border-slate-100 font-black text-2xl text-blue-600">৳ 15,000 <span class="text-xs font-normal text-slate-500">/ scan</span></th>
                                    <th class="p-6 text-center border-l border-slate-100 font-black text-2xl text-orange-600">Starts @ ৳ 25,000 <span class="text-xs font-normal text-slate-500">/ mo</span></th>
                                    <th class="p-6 text-center border-l border-slate-100 font-black text-2xl text-red-600">Custom Quote</th>
                                </tr>
                            </thead>

                            <tbody class="divide-y divide-slate-100 text-sm">
                                {
                                    [
                                        {
                                            name: "Vulnerability Scanning",
                                            vals: ["One-time", "Monthly", "Weekly"],
                                        },
                                        {
                                            name: "Penetration Testing",
                                            vals: ["Basic", "Standard", "Advanced"],
                                        },
                                        {
                                            name: "Report & Remediation",
                                            vals: [true, true, true],
                                        },
                                        {
                                            name: "Firewall Management",
                                            vals: [false, true, true],
                                        },
                                        {
                                            name: "Malware Protection",
                                            vals: [false, true, true],
                                        },
                                        {
                                            name: "Real-time Monitoring",
                                            vals: [false, false, "24/7 SOC"],
                                        },
                                        {
                                            name: "Incident Response",
                                            vals: [
                                                false,
                                                "Standard",
                                                "Priority (1hr)",
                                            ],
                                        },
                                        {
                                            name: "Compliance Support",
                                            vals: [false, false, true],
                                        },
                                    ].map((row, idx) => (
                                        <tr class={idx % 2 === 0 ? "bg-white" : "bg-slate-50/40"}>
                                            <td class="p-5 font-semibold text-slate-700 pl-8">
                                                {row.name}
                                            </td>
                                            {row.vals.map((val) => (
                                                <td class="p-5 border-l border-slate-100 text-center font-medium text-slate-600">
                                                    {typeof val === "boolean" ? (
                                                        val ? (
                                                            <div class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-red-50 text-red-600">
                                                                <i class="fas fa-check text-sm" />
                                                            </div>
                                                        ) : (
                                                            <div class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-slate-100 text-slate-300">
                                                                <i class="fas fa-times text-sm" />
                                                            </div>
                                                        )
                                                    ) : (
                                                        <span class="text-slate-900 font-semibold">{val}</span>
                                                    )}
                                                </td>
                                            ))}
                                        </tr>
                                    ))
                                }

                                <!-- Table Action Buttons -->
                                <tr class="bg-white">
                                    <td class="p-6"></td>
                                    {
                                        [
                                            { text: "Book Audit", style: "bg-blue-600 hover:bg-blue-700 shadow-blue-500/20" },
                                            { text: "Get Protected", style: "bg-orange-500 hover:bg-orange-600 shadow-orange-500/20" },
                                            { text: "Contact SOC Team", style: "bg-red-600 hover:bg-red-700 shadow-red-500/20" },
                                        ].map((btn) => (
                                            <td class="p-6 border-l border-slate-100 text-center">
                                                <a
                                                    href="#contact"
                                                    class={`inline-block w-full py-3 px-4 rounded-xl font-bold text-xs uppercase tracking-wider text-white shadow-lg transition-all duration-300 hover:-translate-y-0.5 ${btn.style}`}
                                                >
                                                    {btn.text}
                                                </a>
                                            </td>
                                        ))
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <!-- ============================================ -->
        <!-- FINAL CTA SECTION (Apple Glass Callout) -->
        <!-- ============================================ -->
        <section class="py-28 relative" id="contact">
            <div class="container mx-auto px-6">
                <div class="max-w-5xl mx-auto rounded-3xl p-12 md:p-20 bg-gradient-to-br from-red-50/90 via-rose-50/70 to-orange-50/50 backdrop-blur-2xl border border-red-200/90 shadow-[0_30px_70px_rgba(239,68,68,0.12)] text-center relative overflow-hidden">
                    <!-- Subtle Ambient Light Glow inside CTA -->
                    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-red-300/40 blur-[90px] rounded-full pointer-events-none"></div>

                    <div class="relative z-10 max-w-2xl mx-auto">
                        <h2 class="text-4xl md:text-6xl font-black text-slate-900 tracking-tight mb-6 leading-tight">
                            Worried About Digital Threats?
                        </h2>
                        <p class="text-lg md:text-xl text-slate-700 mb-10 leading-relaxed font-normal">
                            Don't wait for a breach. Secure your infrastructure with GlobixTech today.
                        </p>
                        <a
                            href="/#contact"
                            class="inline-flex items-center justify-center gap-3 bg-red-600 hover:bg-red-700 text-white px-10 py-5 rounded-full font-semibold text-lg transition-all duration-300 shadow-xl shadow-red-600/30 hover:shadow-2xl hover:shadow-red-600/40 hover:-translate-y-0.5 active:translate-y-0"
                        >
                            <span>Talk to a Security Expert</span>
                            <i class="fas fa-arrow-right text-sm"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <Footer />
</MainLayout>
