---
// Location: frontend/src/pages/solutions/server-management.astro
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<MainLayout title="Server Management Services - Globix Tech">
    <Navbar />

    <main class="relative bg-[#fbfbfd] text-slate-900 font-sans selection:bg-emerald-500 selection:text-white overflow-hidden">
        <!-- Ambient Background Glow Elements (Apple Light Mesh) -->
        <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[800px] overflow-hidden opacity-60 z-0">
            <div class="absolute -top-[20%] left-[10%] w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-emerald-200/40 via-teal-100/50 to-transparent blur-3xl"></div>
            <div class="absolute top-[10%] right-[10%] w-[600px] h-[600px] rounded-full bg-gradient-to-bl from-blue-200/40 via-cyan-100/40 to-transparent blur-3xl"></div>
        </div>

        <!-- HERO SECTION -->
        <section class="relative pt-28 pb-14 sm:pt-36 sm:pb-24 md:pt-48 md:pb-36 z-10 bg-gradient-to-r from-emerald-50/80 via-teal-50/60 to-cyan-50/50">
            <!-- Bottom Faded Soft Transition Layer -->
            <div class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-b from-transparent via-[#FBFBFD]/60 to-[#FBFBFD] pointer-events-none z-10"></div>

            <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
                <!-- Top Badge -->
                <div class="flex justify-center mb-6 sm:mb-8">
                    <div class="inline-flex items-center gap-2 sm:gap-2.5 bg-white/70 backdrop-blur-xl border border-white/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] px-3.5 sm:px-5 py-1.5 sm:py-2 rounded-full text-slate-800 text-[11px] sm:text-xs font-semibold uppercase tracking-widest transition-transform hover:scale-105">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                        </span>
                        <i class="fas fa-server text-emerald-600 text-xs"></i>
                        <span>Proactive Server Management</span>
                    </div>
                </div>

                <!-- Main Hero Text -->
                <div class="text-center max-w-4xl mx-auto mb-8 sm:mb-12 space-y-3 sm:space-y-6">
                    <h1 class="text-3xl sm:text-5xl md:text-7xl font-extrabold text-slate-900 tracking-tight leading-[1.08]">
                        Secure, Reliable, and <br class="hidden sm:inline" />
                        <span class="bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 bg-clip-text text-transparent">
                            Optimized Solutions
                        </span>
                    </h1>
                    <p class="text-sm sm:text-lg md:text-2xl text-slate-600 font-normal leading-relaxed max-w-3xl mx-auto">
                        We ensure your servers are always running at peak performance with 24/7 monitoring, robust security, and expert support.
                    </p>
                    <div class="pt-2 sm:pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4">
                        <a
                            href="#contact"
                            class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white px-7 sm:px-9 py-3.5 sm:py-4 rounded-full font-semibold text-sm sm:text-base transition-all duration-300 shadow-[0_10px_25px_rgba(0,0,0,0.12)] hover:shadow-[0_15px_30px_rgba(0,0,0,0.2)] flex items-center justify-center gap-3 group text-center"
                        >
                            <span>Get Support</span>
                            <i class="fas fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
                        </a>
                        <a
                            href="#pricing"
                            class="w-full sm:w-auto bg-white/80 hover:bg-white text-slate-800 border border-slate-200/80 backdrop-blur-md px-7 sm:px-9 py-3.5 sm:py-4 rounded-full font-semibold text-sm sm:text-base transition-all duration-300 shadow-sm hover:shadow-md text-center"
                        >
                            Explore Plans
                        </a>
                    </div>
                </div>

                <!-- VIDEO 1: Main Server Infrastructure & Telemetry Hero Visual -->
                <div class="mt-8 sm:mt-12 relative max-w-5xl mx-auto rounded-2xl sm:rounded-3xl p-2 sm:p-3 bg-white/40 border border-white/80 backdrop-blur-2xl shadow-[0_20px_50px_rgba(0,0,0,0.06)]">
                    <div class="relative w-full aspect-video rounded-xl sm:rounded-2xl overflow-hidden bg-slate-900 shadow-inner group">
                        <video
                            autoplay
                            loop
                            muted
                            playsinline
                            class="w-full h-full object-cover opacity-90 transition-transform duration-1000 group-hover:scale-105"
                        >
                            <source src="/videos/server-management/Secure_Reliable_and_Optimize.mp4" type="video/mp4" />
                            Your browser does not support HTML5 video.
                        </video>
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                        <div class="absolute bottom-3 left-3 right-3 sm:bottom-6 sm:left-6 sm:right-6 flex justify-between items-end text-white">
                            <div class="bg-slate-900/60 backdrop-blur-md border border-white/10 px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-mono tracking-wider">
                                <i class="fas fa-circle text-emerald-400 text-[8px] sm:text-[10px] mr-1.5 sm:mr-2 animate-pulse"></i>SYSTEM STATUS: 99.99% UPTIME
                            </div>
                            <div class="hidden sm:block text-right text-xs text-slate-300 font-mono">
                                <span>DATACENTER TELEMETRY ENGINE v4.2</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SERVICES OVERVIEW SECTION -->
        <section class="py-14 sm:py-20 lg:py-28 relative z-10">
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-20 space-y-2 sm:space-y-4">
                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-bold text-slate-900 tracking-tight">
                        Core Management Services
                    </h2>
                    <p class="text-xs sm:text-base md:text-lg text-slate-600 leading-relaxed">
                        Comprehensive server administration to keep your business online and secure.
                    </p>
                </div>

                <!-- Grid of 5 Services -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-8 text-left">
                    <!-- Service 1 -->
                    <div class="group bg-white/60 hover:bg-white/90 backdrop-blur-xl border border-white/80 rounded-2xl sm:rounded-3xl p-5 sm:p-8 transition-all duration-500 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] hover:-translate-y-1">
                        <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 text-xl sm:text-2xl mb-4 sm:mb-6 group-hover:scale-110 transition-transform duration-300 shrink-0">
                            <i class="fas fa-clock"></i>
                        </div>
                        <h3 class="text-lg sm:text-2xl font-bold text-slate-900 mb-2 sm:mb-3 tracking-tight">24/7 Monitoring</h3>
                        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm md:text-base">
                            Real-time surveillance of server health, uptime, and resource usage to detect issues before they affect you.
                        </p>
                    </div>

                    <!-- Service 2 -->
                    <div class="group bg-white/60 hover:bg-white/90 backdrop-blur-xl border border-white/80 rounded-2xl sm:rounded-3xl p-5 sm:p-8 transition-all duration-500 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] hover:-translate-y-1">
                        <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-600 text-xl sm:text-2xl mb-4 sm:mb-6 group-hover:scale-110 transition-transform duration-300 shrink-0">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h3 class="text-lg sm:text-2xl font-bold text-slate-900 mb-2 sm:mb-3 tracking-tight">Security Hardening</h3>
                        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm md:text-base">
                            Advanced firewall configuration, malware scanning, and regular OS updates to protect against threats.
                        </p>
                    </div>

                    <!-- Service 3 -->
                    <div class="group bg-white/60 hover:bg-white/90 backdrop-blur-xl border border-white/80 rounded-2xl sm:rounded-3xl p-5 sm:p-8 transition-all duration-500 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] hover:-translate-y-1">
                        <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-600 text-xl sm:text-2xl mb-4 sm:mb-6 group-hover:scale-110 transition-transform duration-300 shrink-0">
                            <i class="fas fa-tachometer-alt"></i>
                        </div>
                        <h3 class="text-lg sm:text-2xl font-bold text-slate-900 mb-2 sm:mb-3 tracking-tight">Performance Tuning</h3>
                        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm md:text-base">
                            Optimization of databases, web servers (Nginx/Apache), and caching layers for maximum speed.
                        </p>
                    </div>

                    <!-- Service 4 -->
                    <div class="group bg-white/60 hover:bg-white/90 backdrop-blur-xl border border-white/80 rounded-2xl sm:rounded-3xl p-5 sm:p-8 transition-all duration-500 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] hover:-translate-y-1">
                        <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-600 text-xl sm:text-2xl mb-4 sm:mb-6 group-hover:scale-110 transition-transform duration-300 shrink-0">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <h3 class="text-lg sm:text-2xl font-bold text-slate-900 mb-2 sm:mb-3 tracking-tight">Backup Solutions</h3>
                        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm md:text-base">
                            Automated daily/weekly backups with off-site storage options to ensure data integrity and disaster recovery.
                        </p>
                    </div>

                    <!-- Service 5 -->
                    <div class="group bg-white/60 hover:bg-white/90 backdrop-blur-xl border border-white/80 rounded-2xl sm:rounded-3xl p-5 sm:p-8 transition-all duration-500 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] hover:-translate-y-1 sm:col-span-2 lg:col-span-2">
                        <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-600 text-xl sm:text-2xl mb-4 sm:mb-6 group-hover:scale-110 transition-transform duration-300 shrink-0">
                            <i class="fas fa-code"></i>
                        </div>
                        <h3 class="text-lg sm:text-2xl font-bold text-slate-900 mb-2 sm:mb-3 tracking-tight">Automation & Scripting</h3>
                        <p class="text-slate-600 leading-relaxed text-xs sm:text-sm md:text-base">
                            Custom scripts for OLT/ONU provisioning, configuration backups, and monitoring to reduce manual work and human error.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- HIGH TECH SHOWCASE SECTION WITH 3 ANIMATION VIDEOS -->
        <section class="py-14 sm:py-20 lg:py-24 relative z-10 bg-gradient-to-b from-transparent via-slate-100/50 to-transparent overflow-hidden">
            <div class="absolute inset-0 pointer-events-none">
                <video autoplay loop muted playsinline class="w-full h-full object-cover opacity-30"
                    style="-webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 90%, transparent 100%); mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 90%, transparent 100%);">
                    <source src="/videos/generated_video_july_24.mp4" type="video/mp4" />
                </video>
            </div>
            <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-300/40 to-transparent pointer-events-none z-20"></div>
            <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-300/40 to-transparent pointer-events-none z-20"></div>
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16 space-y-2 sm:space-y-3">
                    <span class="text-emerald-600 text-[11px] sm:text-xs font-bold uppercase tracking-widest bg-emerald-50 border border-emerald-200/60 px-3.5 py-1.5 rounded-full inline-block">Interactive Intelligence</span>
                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-bold text-slate-900 tracking-tight">
                        Next-Gen Infrastructure in Action
                    </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-8 text-left">
                    <!-- VIDEO 2: Real-time Telemetry & Server Operations Loop -->
                    <div class="bg-white/70 backdrop-blur-xl border border-white/80 p-3.5 sm:p-4 rounded-2xl sm:rounded-3xl shadow-[0_10px_30px_rgba(0,0,0,0.04)] flex flex-col justify-between">
                        <div>
                            <div class="relative w-full aspect-video rounded-xl sm:rounded-2xl overflow-hidden mb-4 sm:mb-6 bg-slate-950">
                                <video autoplay loop muted playsinline class="w-full h-full object-cover">
                                    <source src="/videos/server-management/Live_Telemetry_Diagnostics_C.mp4" type="video/mp4" />
                                </video>
                                <div class="absolute top-2.5 left-2.5 sm:top-3 sm:left-3 bg-slate-900/80 backdrop-blur-md px-2.5 sm:px-3 py-0.5 sm:py-1 rounded-md sm:rounded-lg text-[9px] sm:text-[10px] font-mono text-emerald-400 border border-white/10">
                                    VIDEO 02 // PROACTIVE SURVEILLANCE
                                </div>
                            </div>
                            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-1.5 sm:mb-2">Live Telemetry & Diagnostics</h3>
                            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-3 sm:mb-4">
                                Continuous health tracking across CPU, RAM, and disk vectors to preemptively stop service degradation.
                            </p>
                        </div>
                        <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-500">
                            <span>Real-Time Logs</span>
                            <span class="text-emerald-600">Active</span>
                        </div>
                    </div>

                    <!-- VIDEO 3: Cyber Security & Firewall Protection Loop -->
                    <div class="bg-white/70 backdrop-blur-xl border border-white/80 p-3.5 sm:p-4 rounded-2xl sm:rounded-3xl shadow-[0_10px_30px_rgba(0,0,0,0.04)] flex flex-col justify-between">
                        <div>
                            <div class="relative w-full aspect-video rounded-xl sm:rounded-2xl overflow-hidden mb-4 sm:mb-6 bg-slate-950">
                                <video autoplay loop muted playsinline class="w-full h-full object-cover">
                                    <source src="/videos/server-management/Threat_Shield_Hardening_Auto.mp4" type="video/mp4" />
                                </video>
                                <div class="absolute top-2.5 left-2.5 sm:top-3 sm:left-3 bg-slate-900/80 backdrop-blur-md px-2.5 sm:px-3 py-0.5 sm:py-1 rounded-md sm:rounded-lg text-[9px] sm:text-[10px] font-mono text-blue-400 border border-white/10">
                                    VIDEO 03 // SECURITY HARDENING
                                </div>
                            </div>
                            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-1.5 sm:mb-2">Threat Shield & Hardening</h3>
                            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-3 sm:mb-4">
                                Automated rule enforcement, patch deployment, and strict protocol isolation keeping zero-day threats out.
                            </p>
                        </div>
                        <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-500">
                            <span>Protection Matrix</span>
                            <span class="text-blue-600">Encrypted</span>
                        </div>
                    </div>

                    <!-- VIDEO 4: Automated Backup & Cloud Recovery Loop -->
                    <div class="bg-white/70 backdrop-blur-xl border border-white/80 p-3.5 sm:p-4 rounded-2xl sm:rounded-3xl shadow-[0_10px_30px_rgba(0,0,0,0.04)] flex flex-col justify-between">
                        <div>
                            <div class="relative w-full aspect-video rounded-xl sm:rounded-2xl overflow-hidden mb-4 sm:mb-6 bg-slate-950">
                                <video autoplay loop muted playsinline class="w-full h-full object-cover">
                                    <source src="/videos/server-management/Disaster_Sync_Storage_Off_si.mp4" type="video/mp4" />
                                </video>
                                <div class="absolute top-2.5 left-2.5 sm:top-3 sm:left-3 bg-slate-900/80 backdrop-blur-md px-2.5 sm:px-3 py-0.5 sm:py-1 rounded-md sm:rounded-lg text-[9px] sm:text-[10px] font-mono text-purple-400 border border-white/10">
                                    VIDEO 04 // AUTOMATED BACKUPS
                                </div>
                            </div>
                            <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-1.5 sm:mb-2">Disaster Sync & Storage</h3>
                            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-3 sm:mb-4">
                                Off-site encrypted backup pipelines ensure instant disaster recovery and seamless rollback flexibility.
                            </p>
                        </div>
                        <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-500">
                            <span>Backup Engine</span>
                            <span class="text-purple-600">Synchronized</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- PRICING SECTION -->
        <section class="py-14 sm:py-20 lg:py-28 relative z-10" id="pricing">
            <div class="container mx-auto px-4 sm:px-6 max-w-7xl">
                <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16 space-y-2 sm:space-y-4">
                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-bold text-slate-900 tracking-tight">
                        Management Plans
                    </h2>
                    <p class="text-xs sm:text-base md:text-lg text-slate-600">
                        Choose the right level of support for your infrastructure.
                    </p>
                </div>

                <!-- Glass Pricing Matrix Card -->
                <div class="bg-white/80 backdrop-blur-2xl border border-white/90 rounded-2xl sm:rounded-3xl p-2 sm:p-8 shadow-[0_20px_50px_rgba(0,0,0,0.04)] overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[700px] sm:min-w-[900px] border-collapse text-left">
                            <thead>
                                <tr class="border-b border-slate-200/80">
                                    <th class="p-4 sm:p-6 text-left w-1/4 align-bottom">
                                        <div class="text-base sm:text-lg font-bold text-slate-900">Features Matrix</div>
                                        <div class="text-[11px] sm:text-xs text-slate-500 font-normal">Compare plan tiers</div>
                                    </th>
                                    <th class="p-4 sm:p-6 text-center w-1/4 rounded-xl sm:rounded-2xl bg-blue-500/5 border border-blue-200/50">
                                        <div class="font-extrabold text-slate-900 text-lg sm:text-2xl mb-0.5 sm:mb-1">Standard</div>
                                        <div class="text-[11px] sm:text-xs text-slate-500 font-medium mb-2 sm:mb-4">Essential Maintenance</div>
                                        <div class="text-xl sm:text-3xl font-black text-blue-600">৳ 5,000</div>
                                    </th>
                                    <th class="p-4 sm:p-6 text-center w-1/4 rounded-xl sm:rounded-2xl bg-emerald-500/5 border border-emerald-200/50">
                                        <div class="inline-block bg-emerald-500 text-white text-[9px] sm:text-[10px] uppercase font-extrabold px-2 sm:px-2.5 py-0.5 rounded-full mb-1 sm:mb-2">Most Popular</div>
                                        <div class="font-extrabold text-slate-900 text-lg sm:text-2xl mb-0.5 sm:mb-1">Professional</div>
                                        <div class="text-[11px] sm:text-xs text-slate-500 font-medium mb-2 sm:mb-4">Proactive Support</div>
                                        <div class="text-xl sm:text-3xl font-black text-emerald-600">৳ 12,000</div>
                                    </th>
                                    <th class="p-4 sm:p-6 text-center w-1/4 rounded-xl sm:rounded-2xl bg-purple-500/5 border border-purple-200/50">
                                        <div class="font-extrabold text-slate-900 text-lg sm:text-2xl mb-0.5 sm:mb-1">Enterprise</div>
                                        <div class="text-[11px] sm:text-xs text-slate-500 font-medium mb-2 sm:mb-4">Full Infrastructure Mgmt</div>
                                        <div class="text-xl sm:text-3xl font-black text-purple-600">Custom</div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="text-xs sm:text-sm divide-y divide-slate-100">
                                {
                                    [
                                        {
                                            name: "Number of Servers",
                                            vals: ["1 Server", "Up to 3 Servers", "Unlimited"],
                                        },
                                        {
                                            name: "Response Time",
                                            vals: ["24 Hours", "4 Hours", "1 Hour (Critical)"],
                                        },
                                        {
                                            name: "24/7 Monitoring",
                                            vals: [true, true, true],
                                        },
                                        {
                                            name: "OS Updates & Patching",
                                            vals: ["Monthly", "Weekly", "As needed"],
                                        },
                                        {
                                            name: "Security Audits",
                                            vals: ["Quarterly", "Monthly", "Weekly"],
                                        },
                                        {
                                            name: "Backup Configuration",
                                            vals: ["Daily", "Daily + Offsite", "Real-time / Custom"],
                                        },
                                        {
                                            name: "Database Optimization",
                                            vals: [false, true, true],
                                        },
                                        {
                                            name: "Load Balancing Setup",
                                            vals: [false, false, true],
                                        },
                                        {
                                            name: "Disaster Recovery",
                                            vals: [false, false, true],
                                        },
                                        {
                                            name: "Monthly Reports",
                                            vals: [true, true, true],
                                        },
                                        {
                                            name: "Dedicated Account Manager",
                                            vals: [false, false, true],
                                        },
                                    ].map((row, idx) => (
                                        <tr class={idx % 2 === 0 ? "bg-white/40" : "bg-slate-50/40"}>
                                            <td class="p-3.5 sm:p-5 font-semibold text-slate-800 text-xs sm:text-sm">
                                                {row.name}
                                            </td>
                                            {row.vals.map((val) => (
                                                <td class="p-3.5 sm:p-5 text-center text-slate-600 font-medium text-xs sm:text-sm">
                                                    {typeof val === "boolean" ? (
                                                        val ? (
                                                            <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-emerald-100 text-emerald-600 inline-flex items-center justify-center text-[10px] sm:text-xs">
                                                                <i class="fas fa-check" />
                                                            </div>
                                                        ) : (
                                                            <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-slate-100 text-slate-300 inline-flex items-center justify-center text-[10px] sm:text-xs">
                                                                <i class="fas fa-times" />
                                                            </div>
                                                        )
                                                    ) : (
                                                        val
                                                    )}
                                                </td>
                                            ))}
                                        </tr>
                                    ))
                                }
                                <tr>
                                    <td class="p-3 sm:p-6"></td>
                                    {
                                        [
                                            { name: "Get Standard", color: "bg-blue-600 hover:bg-blue-700 shadow-blue-500/20" },
                                            { name: "Get Professional", color: "bg-emerald-600 hover:bg-emerald-700 shadow-emerald-500/20" },
                                            { name: "Contact Us", color: "bg-purple-600 hover:bg-purple-700 shadow-purple-500/20" },
                                        ].map((btn) => (
                                            <td class="p-2 sm:p-6 text-center">
                                                <a
                                                    href="/contact"
                                                    class={`inline-block w-full py-2.5 sm:py-3 px-2 sm:px-6 rounded-xl sm:rounded-2xl font-bold text-white text-[11px] sm:text-xs tracking-wider uppercase transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5 ${btn.color}`}
                                                >
                                                    {btn.name}
                                                </a>
                                            </td>
                                        ))
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="text-center sm:text-right text-slate-400 text-[11px] sm:text-xs italic mt-3 sm:mt-4">
                    * Prices are estimated and may vary based on specific requirements.
                </div>
            </div>
        </section>

        <!-- FINAL CTA SECTION -->
        <section class="py-14 sm:py-20 lg:py-24 relative z-10" id="contact">
            <div class="container mx-auto px-4 sm:px-6 max-w-5xl">
                <div class="relative rounded-2xl sm:rounded-3xl p-6 sm:p-12 md:p-16 bg-gradient-to-br from-white via-slate-50 to-emerald-50/30 border border-white/90 shadow-[0_30px_70px_rgba(0,0,0,0.06)] text-center overflow-hidden">
                    <div class="absolute inset-0 pointer-events-none">
                        <video autoplay loop muted playsinline class="w-full h-full object-cover opacity-20 rounded-2xl sm:rounded-3xl">
                            <source src="/videos/rd-wing/create_a_loop_bg_video_with_th.mp4" type="video/mp4" />
                        </video>
                    </div>
                    <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-emerald-200/40 blur-3xl pointer-events-none"></div>
                    <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-cyan-200/40 blur-3xl pointer-events-none"></div>

                    <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-3 sm:mb-6">
