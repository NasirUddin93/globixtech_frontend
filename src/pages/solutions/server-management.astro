---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<MainLayout title="Server Management Services - Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-slate-50">
        <!-- Hero Section -->
        <section
            class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden bg-[#0c1b3d]"
        >
            <div
                class="absolute inset-0 bg-gradient-to-br from-[#0c1b3d] via-[#1a2c5a] to-[#0c1b3d]"
            >
            </div>
            <div
                class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-emerald-500/10 to-transparent blur-3xl"
            >
            </div>

            <div class="container mx-auto px-6 relative z-10 text-center">
                <div
                    class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/20 px-4 py-2 rounded-full text-emerald-400 text-sm font-semibold mb-6"
                >
                    <i class="fas fa-server"></i> Proactive Server Management
                </div>
                <h1
                    class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-[1.1]"
                >
                    Secure, Reliable, and <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400"
                        >Optimized Solutions</span
                    >
                </h1>
                <p
                    class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed"
                >
                    We ensure your servers are always running at peak
                    performance with 24/7 monitoring, robust security, and
                    expert support.
                </p>
                <div class="flex justify-center gap-4">
                    <a
                        href="#contact"
                        class="bg-emerald-600 hover:bg-emerald-700 text-white px-8 py-4 rounded-xl font-bold transition-all shadow-lg shadow-emerald-600/20 flex items-center gap-2"
                    >
                        Get Support <i class="fas fa-arrow-right text-sm"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- Services Overview -->
        <section class="py-24 bg-white">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl md:text-5xl font-bold text-[#0c1b3d] mb-4"
                    >
                        Core Management Services
                    </h2>
                    <p class="text-gray-600 max-w-3xl mx-auto">
                        Comprehensive server administration to keep your
                        business online and secure.
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <!-- Service 1 -->
                    <div
                        class="bg-slate-50 p-8 rounded-2xl hover:bg-white hover:shadow-xl transition-all border border-slate-100 group"
                    >
                        <div
                            class="w-14 h-14 bg-emerald-100 rounded-xl flex items-center justify-center text-emerald-600 text-2xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            <i class="fas fa-clock"></i>
                        </div>
                        <h3 class="text-xl font-bold text-[#0c1b3d] mb-3">
                            24/7 Monitoring
                        </h3>
                        <p class="text-gray-600">
                            Real-time surveillance of server health, uptime, and
                            resource usage to detect issues before they affect
                            you.
                        </p>
                    </div>

                    <!-- Service 2 -->
                    <div
                        class="bg-slate-50 p-8 rounded-2xl hover:bg-white hover:shadow-xl transition-all border border-slate-100 group"
                    >
                        <div
                            class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center text-blue-600 text-2xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <h3 class="text-xl font-bold text-[#0c1b3d] mb-3">
                            Security Hardening
                        </h3>
                        <p class="text-gray-600">
                            Advanced firewall configuration, malware scanning,
                            and regular OS updates to protect against threats.
                        </p>
                    </div>

                    <!-- Service 3 -->
                    <div
                        class="bg-slate-50 p-8 rounded-2xl hover:bg-white hover:shadow-xl transition-all border border-slate-100 group"
                    >
                        <div
                            class="w-14 h-14 bg-purple-100 rounded-xl flex items-center justify-center text-purple-600 text-2xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            <i class="fas fa-tachometer-alt"></i>
                        </div>
                        <h3 class="text-xl font-bold text-[#0c1b3d] mb-3">
                            Performance Tuning
                        </h3>
                        <p class="text-gray-600">
                            Optimization of databases, web servers
                            (Nginx/Apache), and caching layers for maximum
                            speed.
                        </p>
                    </div>

                    <!-- Service 4 -->
                    <div
                        class="bg-slate-50 p-8 rounded-2xl hover:bg-white hover:shadow-xl transition-all border border-slate-100 group"
                    >
                        <div
                            class="w-14 h-14 bg-orange-100 rounded-xl flex items-center justify-center text-orange-600 text-2xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <h3 class="text-xl font-bold text-[#0c1b3d] mb-3">
                            Backup Solutions
                        </h3>
                        <p class="text-gray-600">
                            Automated daily/weekly backups with off-site storage
                            options to ensure data integrity and disaster
                            recovery.
                        </p>
                    </div>

                    <!-- Service 5 -->
                    <div
                        class="bg-slate-50 p-8 rounded-2xl hover:bg-white hover:shadow-xl transition-all border border-slate-100 group"
                    >
                        <div
                            class="w-14 h-14 bg-teal-100 rounded-xl flex items-center justify-center text-teal-600 text-2xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            <i class="fas fa-code"></i>
                        </div>
                        <h3 class="text-xl font-bold text-[#0c1b3d] mb-3">
                            Automation & Scripting
                        </h3>
                        <p class="text-gray-600">
                            Custom scripts for OLT/ONU provisioning,
                            configuration backups, and monitoring to reduce
                            manual work and human error.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="py-24 bg-slate-50" id="pricing">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl md:text-5xl font-bold text-[#0c1b3d] mb-4"
                    >
                        Management Plans
                    </h2>
                    <p class="text-gray-600 max-w-3xl mx-auto">
                        Choose the right level of support for your
                        infrastructure.
                    </p>
                </div>

                <div class="overflow-x-auto pb-8">
                    <table
                        class="w-full min-w-[1000px] border-collapse border border-gray-200 bg-white shadow-sm"
                    >
                        <thead>
                            <tr class="bg-gray-50">
                                <th
                                    class="p-6 text-left border border-gray-200 w-1/4"
                                    >Features</th
                                >
                                <th
                                    class="p-6 text-center border border-gray-200 w-1/4 bg-blue-50/50"
                                >
                                    <div
                                        class="font-bold text-[#0c1b3d] text-xl mb-1"
                                    >
                                        Standard
                                    </div>
                                    <div class="text-sm text-gray-500">
                                        Essential Maintenance
                                    </div>
                                </th>
                                <th
                                    class="p-6 text-center border border-gray-200 w-1/4 bg-emerald-50/50"
                                >
                                    <div
                                        class="font-bold text-[#0c1b3d] text-xl mb-1"
                                    >
                                        Professional
                                    </div>
                                    <div class="text-sm text-gray-500">
                                        Proactive Support
                                    </div>
                                </th>
                                <th
                                    class="p-6 text-center border border-gray-200 w-1/4 bg-purple-50/50"
                                >
                                    <div
                                        class="font-bold text-[#0c1b3d] text-xl mb-1"
                                    >
                                        Enterprise
                                    </div>
                                    <div class="text-sm text-gray-500">
                                        Full Infrastructure Mgmt
                                    </div>
                                </th>
                            </tr>
                            <tr>
                                <th
                                    class="p-4 text-left border border-gray-200 font-bold text-gray-700"
                                    >Monthly Price</th
                                >
                                <th
                                    class="p-4 text-center border border-gray-200 font-bold text-xl text-blue-600"
                                    >৳ 5,000</th
                                >
                                <th
                                    class="p-4 text-center border border-gray-200 font-bold text-xl text-emerald-600"
                                    >৳ 12,000</th
                                >
                                <th
                                    class="p-4 text-center border border-gray-200 font-bold text-xl text-purple-600"
                                    >Custom</th
                                >
                            </tr>
                        </thead>
                        <tbody class="text-sm">
                            {
                                [
                                    {
                                        name: "Number of Servers",
                                        vals: [
                                            "1 Server",
                                            "Up to 3 Servers",
                                            "Unlimited",
                                        ],
                                    },
                                    {
                                        name: "Response Time",
                                        vals: [
                                            "24 Hours",
                                            "4 Hours",
                                            "1 Hour (Critical)",
                                        ],
                                    },
                                    {
                                        name: "24/7 Monitoring",
                                        vals: [true, true, true],
                                    },
                                    {
                                        name: "OS Updates & Patching",
                                        vals: [
                                            "Monthly",
                                            "Weekly",
                                            "As needed",
                                        ],
                                    },
                                    {
                                        name: "Security Audits",
                                        vals: [
                                            "Quarterly",
                                            "Monthly",
                                            "Weekly",
                                        ],
                                    },
                                    {
                                        name: "Backup Configuration",
                                        vals: [
                                            "Daily",
                                            "Daily + Offsite",
                                            "Real-time / Custom",
                                        ],
                                    },
                                    {
                                        name: "Database Optimization",
                                        vals: [false, true, true],
                                    },
                                    {
                                        name: "Load Balancing Setup",
                                        vals: [false, false, true],
                                    },
                                    {
                                        name: "Disaster Recovery",
                                        vals: [false, false, true],
                                    },
                                    {
                                        name: "Monthly Reports",
                                        vals: [true, true, true],
                                    },
                                    {
                                        name: "Dedicated Account Manager",
                                        vals: [false, false, true],
                                    },
                                ].map((row, idx) => (
                                    <tr
                                        class={
                                            idx % 2 === 0
                                                ? "bg-white"
                                                : "bg-gray-50/50"
                                        }
                                    >
                                        <td class="p-4 border border-gray-200 font-medium text-gray-700">
                                            {row.name}
                                        </td>
                                        {row.vals.map((val) => (
                                            <td class="p-4 border border-gray-200 text-center text-gray-600">
                                                {typeof val === "boolean" ? (
                                                    val ? (
                                                        <i class="fas fa-check text-emerald-500 text-lg" />
                                                    ) : (
                                                        <i class="fas fa-times text-gray-300 text-lg" />
                                                    )
                                                ) : (
                                                    val
                                                )}
                                            </td>
                                        ))}
                                    </tr>
                                ))
                            }
                            <tr class="bg-white">
                                <td class="p-4 border border-gray-200"></td>
                                {
                                    [
                                        "Get Standard",
                                        "Get Professional",
                                        "Contact Us",
                                    ].map((btn, i) => (
                                        <td class="p-4 border border-gray-200 text-center">
                                            <a
                                                href="#contact"
                                                class={`inline-block px-6 py-2 rounded text-sm font-bold transition-colors text-white ${
                                                    i === 0
                                                        ? "bg-blue-500 hover:bg-blue-600"
                                                        : i === 1
                                                          ? "bg-emerald-500 hover:bg-emerald-600"
                                                          : "bg-purple-600 hover:bg-purple-700"
                                                }`}
                                            >
                                                {btn}
                                            </a>
                                        </td>
                                    ))
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="text-right text-gray-500 text-xs italic mt-2">
                    * Prices are estimated and may vary based on specific
                    requirements.
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="py-20 bg-[#0c1b3d] relative overflow-hidden">
            <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-10">
            </div>
            <div class="container mx-auto px-6 relative z-10 text-center">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
                    Need a Custom Server Solution?
                </h2>
                <p class="text-cyan-200 mb-10 max-w-2xl mx-auto">
                    We manage complex infrastructures so you can focus on
                    growing your business.
                </p>
                <a
                    href="#contact"
                    class="bg-white text-[#0c1b3d] px-10 py-4 rounded-full font-bold hover:bg-gray-100 transition-colors inline-flex items-center gap-2"
                >
                    Contact Us <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </section>
    </main>

    <Footer />
</MainLayout>
