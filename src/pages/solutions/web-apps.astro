---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { webPackages } from "../../data/webApps";
---

<MainLayout title="Web Apps Development - Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-slate-50">
        <!-- Hero Section -->
        <section
            class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden bg-[#0c1b3d]"
        >
            <div
                class="absolute inset-0 bg-gradient-to-br from-[#0c1b3d] via-[#1a2c5a] to-[#0c1b3d]"
            >
            </div>
            <div
                class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-cyan-500/10 to-transparent blur-3xl"
            >
            </div>

            <div class="container mx-auto px-6 relative z-10 text-center">
                <div
                    class="inline-flex items-center gap-2 bg-cyan-500/10 border border-cyan-500/20 px-4 py-2 rounded-full text-cyan-400 text-sm font-semibold mb-6"
                >
                    <i class="fas fa-code"></i> Custom Web Applications
                </div>
                <h1
                    class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-[1.1]"
                >
                    Tailored <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400"
                        >Web Solutions</span
                    ><br /> for Your Business
                </h1>
                <p
                    class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed"
                >
                    From simple CMS sites to complex enterprise web
                    applications, we build scalable and secure solutions using
                    the latest technologies.
                </p>
                <div class="flex justify-center gap-4">
                    <a
                        href="#contact"
                        class="bg-cyan-600 hover:bg-cyan-700 text-white px-8 py-4 rounded-xl font-bold transition-all shadow-lg shadow-cyan-600/20 flex items-center gap-2"
                    >
                        Get a Quote <i class="fas fa-arrow-right text-sm"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="py-24 bg-white" id="pricing">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl md:text-5xl font-bold text-[#0c1b3d] mb-4"
                    >
                        Packages and Prices
                    </h2>
                    <p class="text-gray-600 max-w-3xl mx-auto">
                        Web Design & Development Package and Prices
                    </p>
                </div>

                <div class="overflow-x-auto pb-8">
                    <table
                        class="w-full min-w-[1000px] border-collapse border border-gray-200"
                    >
                        <thead>
                            <tr class="bg-gray-50">
                                <th
                                    class="p-6 text-left border border-gray-200 w-1/6"
                                    >Packages</th
                                >
                                <th
                                    class="p-6 text-center border border-gray-200 bg-blue-50 w-1/6"
                                >
                                    <div class="font-bold text-[#0c1b3d] mb-1">
                                        Starter Package Basic
                                    </div>
                                    <div class="text-xs text-gray-500">
                                        Wordpress / CMS Web
                                    </div>
                                </th>
                                <th
                                    class="p-6 text-center border border-gray-200 bg-green-50 w-1/6"
                                >
                                    <div class="font-bold text-[#0c1b3d] mb-1">
                                        Starter Package Business
                                    </div>
                                    <div class="text-xs text-gray-500">
                                        Wordpress / CMS Web
                                    </div>
                                </th>
                                <th
                                    class="p-6 text-center border border-gray-200 bg-red-50 w-1/6"
                                >
                                    <div class="font-bold text-[#0c1b3d] mb-1">
                                        Bronze Package Advance
                                    </div>
                                    <div class="text-xs text-gray-500">
                                        Wordpress / Pro Web
                                    </div>
                                </th>
                                <th
                                    class="p-6 text-center border border-gray-200 bg-yellow-50 w-1/6"
                                >
                                    <div class="font-bold text-[#0c1b3d] mb-1">
                                        Silver Package Advance
                                    </div>
                                    <div class="text-xs text-gray-500">
                                        Laravel Web
                                    </div>
                                </th>
                                <th
                                    class="p-6 text-center border border-gray-200 bg-orange-50 w-1/6"
                                >
                                    <div class="font-bold text-[#0c1b3d] mb-1">
                                        Gold Package Enterprise
                                    </div>
                                    <div class="text-xs text-gray-500">
                                        Laravel Web
                                    </div>
                                </th>
                            </tr>
                            <tr>
                                <th
                                    class="p-4 text-left border border-gray-200 font-bold text-xl"
                                    >Price</th
                                >
                                <th
                                    class="p-4 text-center border border-gray-200 bg-blue-500 text-white font-bold text-xl"
                                    >৳ 25,000</th
                                >
                                <th
                                    class="p-4 text-center border border-gray-200 bg-green-500 text-white font-bold text-xl"
                                    >৳ 35,000</th
                                >
                                <th
                                    class="p-4 text-center border border-gray-200 bg-red-600 text-white font-bold text-xl"
                                    >৳ 65,000</th
                                >
                                <th
                                    class="p-4 text-center border border-gray-200 bg-yellow-500 text-white font-bold text-xl"
                                    >৳ 90,000</th
                                >
                                <th
                                    class="p-4 text-center border border-gray-200 bg-orange-400 text-white font-bold text-xl"
                                    >৳ 150,000</th
                                >
                            </tr>
                        </thead>
                        <tbody class="text-sm">
                            <tr class="bg-gray-50/50">
                                <td
                                    colspan="6"
                                    class="p-3 border border-gray-200 text-center font-medium text-gray-600 italic"
                                >
                                    Get started easily - It is impossible to buy
                                    good things for a cheap price.
                                </td>
                            </tr>
                            {
                                webPackages.map((row, idx) => (
                                    <tr
                                        class={
                                            idx % 2 === 0
                                                ? "bg-white"
                                                : "bg-gray-50"
                                        }
                                    >
                                        <td class="p-3 border border-gray-200 font-medium text-gray-700">
                                            {row.name}
                                        </td>
                                        {row.vals.map((val) => (
                                            <td class="p-3 border border-gray-200 text-center text-gray-600">
                                                {typeof val === "boolean" ? (
                                                    val ? (
                                                        <i class="fas fa-check text-green-500 text-lg" />
                                                    ) : (
                                                        <i class="fas fa-times text-red-500 text-lg" />
                                                    )
                                                ) : (
                                                    val
                                                )}
                                            </td>
                                        ))}
                                    </tr>
                                ))
                            }
                            <tr class="bg-white">
                                <td class="p-3 border border-gray-200"></td>
                                {
                                    [
                                        "Get Quote",
                                        "Get Quote",
                                        "Get Quote",
                                        "Get Quote",
                                        "Get Quote",
                                    ].map((btn) => (
                                        <td class="p-3 border border-gray-200 text-center">
                                            <a
                                                href="#contact"
                                                class="inline-block bg-[#3498db] hover:bg-[#2980b9] text-white px-6 py-2 rounded text-sm font-bold transition-colors"
                                            >
                                                {btn}
                                            </a>
                                        </td>
                                    ))
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div
                    class="text-right text-red-500 text-xs italic mt-2 font-bold"
                >
                    * All the prices mentioned above in BDT
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section class="py-20 bg-[#0c1b3d] relative overflow-hidden">
            <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-10">
            </div>
            <div class="container mx-auto px-6 relative z-10 text-center">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
                    Ready to Build Your Web Application?
                </h2>
                <p class="text-cyan-200 mb-10 max-w-2xl mx-auto">
                    Contact us today to discuss your project requirements.
                </p>
                <a
                    href="#contact"
                    class="bg-white text-[#0c1b3d] px-10 py-4 rounded-full font-bold hover:bg-gray-100 transition-colors inline-flex items-center gap-2"
                >
                    Contact Us <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </section>
    </main>

    <Footer />
</MainLayout>
