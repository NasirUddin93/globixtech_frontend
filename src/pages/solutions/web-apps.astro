---
// Location: frontend/src/pages/solutions/web-apps.astro
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { webPackages } from "../../data/webApps";
---

<MainLayout title="Web Apps Development - Globix Tech">
    <Navbar />

    <main class="min-h-screen bg-white text-slate-900 selection:bg-cyan-500 selection:text-white relative overflow-hidden font-sans">
        
        <!-- Ambient Glowing Lights (Apple-style Subtle Canvas Backdrop) -->
        <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[600px] overflow-hidden -z-10 opacity-70">
            <div class="absolute -top-40 left-1/4 w-[500px] h-[500px] bg-cyan-200/40 rounded-full blur-[140px]"></div>
            <div class="absolute top-20 right-1/4 w-[450px] h-[450px] bg-blue-200/30 rounded-full blur-[160px]"></div>
        </div>

        <!-- HERO SECTION -->
        <section class="relative pt-36 pb-24 md:pt-48 md:pb-36 overflow-hidden bg-gradient-to-r from-cyan-50/80 via-blue-50/60 to-indigo-50/50" animate-slow-gradient">
            <!-- Bottom Faded Soft Transition Layer -->
            <div class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-b from-transparent via-[#FBFBFD]/60 to-[#FBFBFD] pointer-events-none z-10"></div>

            <div class="container mx-auto px-6 relative z-10 text-center">
                
                <!-- Frosted Glass Pill Badge -->
                <div class="inline-flex items-center gap-2.5 backdrop-blur-2xl bg-white/70 border border-slate-200/80 px-5 py-2.5 rounded-full shadow-sm text-slate-800 text-xs md:text-sm font-semibold tracking-wide mb-8 hover:scale-105 transition-transform duration-300">
                    <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
                    <i class="fas fa-code text-cyan-600"></i>
                    <span>Custom Web Applications</span>
                </div>

                <!-- Headline -->
                <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight text-slate-900 mb-8 leading-[1.08]">
                    Tailored <span class="bg-clip-text text-transparent bg-gradient-to-r from-cyan-600 via-blue-600 to-indigo-600">Web Solutions</span><br />
                    <span class="font-normal text-slate-700">for Your Business</span>
                </h1>

                <!-- Subtitle -->
                <p class="text-lg md:text-2xl text-slate-600 mb-12 max-w-3xl mx-auto font-light leading-relaxed tracking-tight">
                    From simple CMS sites to complex enterprise web applications, we build scalable and secure solutions using the latest technologies.
                </p>

                <!-- CTA Actions -->
                <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
                    <a
                        href="#contact"
                        class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white px-9 py-4 rounded-full font-medium transition-all duration-300 shadow-xl shadow-slate-900/10 hover:shadow-2xl hover:shadow-slate-900/20 hover:-translate-y-0.5 flex items-center justify-center gap-3 text-base"
                    >
                        <span>Get a Quote</span>
                        <i class="fas fa-arrow-right text-xs opacity-70"></i>
                    </a>
                    <a
                        href="#pricing"
                        class="w-full sm:w-auto backdrop-blur-xl bg-white/70 hover:bg-white/90 text-slate-800 border border-slate-200/80 px-9 py-4 rounded-full font-medium transition-all duration-300 hover:shadow-lg flex items-center justify-center gap-2 text-base"
                    >
                        Explore Packages
                    </a>
                </div>
            </div>
        </section>


        <!-- 4 ANIMATION VIDEOS SHOWCASE (Apple Beyond Premium Feature Grid) -->
        <section class="py-20 relative">
            <div class="container mx-auto px-6">
                
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="text-xs uppercase tracking-[0.2em] font-bold text-cyan-600 mb-3">Architectured For Excellence</h2>
                    <p class="text-3xl md:text-5xl font-semibold tracking-tight text-slate-900">Designed to perform. Built to scale.</p>
                </div>

                <!-- 2x2 Video Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
                    
                    <!-- Video Card 1 -->
                    <div class="group relative rounded-3xl overflow-hidden backdrop-blur-2xl bg-white/60 border border-white/80 shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-1">
                        <div class="aspect-video relative overflow-hidden bg-slate-100">
                            <video 
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                                autoplay loop muted playsinline poster="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80"
                            >
                                <source src="https://assets.mixkit.co/videos/preview/mixkit-coding-code-on-a-computer-screen-27599-large.mp4" type="video/mp4" />
                            </video>
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent"></div>
                            
                            <!-- Video Overlay Badge -->
                            <div class="absolute top-4 left-4 backdrop-blur-xl bg-white/20 border border-white/30 text-white text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Dynamic Experience
                            </div>

                            <div class="absolute bottom-6 left-6 right-6 text-white">
                                <h3 class="text-xl font-semibold mb-1">Ultra-Fast Frontend Performance</h3>
                                <p class="text-xs text-slate-200/90 font-light">Engineered for lightning speeds, high Core Web Vitals, and responsive UI interactions.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Video Card 2 -->
                    <div class="group relative rounded-3xl overflow-hidden backdrop-blur-2xl bg-white/60 border border-white/80 shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-1">
                        <div class="aspect-video relative overflow-hidden bg-slate-100">
                            <video 
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                                autoplay loop muted playsinline poster="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80"
                            >
                                <source src="https://assets.mixkit.co/videos/preview/mixkit-data-animation-on-screen-41551-large.mp4" type="video/mp4" />
                            </video>
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent"></div>
                            
                            <!-- Video Overlay Badge -->
                            <div class="absolute top-4 left-4 backdrop-blur-xl bg-white/20 border border-white/30 text-white text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-2">
                                <i class="fas fa-layer-group text-xs text-cyan-300"></i> Scalable Architecture
                            </div>

                            <div class="absolute bottom-6 left-6 right-6 text-white">
                                <h3 class="text-xl font-semibold mb-1">Interactive CMS & Enterprise Portals</h3>
                                <p class="text-xs text-slate-200/90 font-light">Custom backend dashboards designed for effortless content and data management.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Video Card 3 -->
                    <div class="group relative rounded-3xl overflow-hidden backdrop-blur-2xl bg-white/60 border border-white/80 shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-1">
                        <div class="aspect-video relative overflow-hidden bg-slate-100">
                            <video 
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                                autoplay loop muted playsinline poster="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=80"
                            >
                                <source src="https://assets.mixkit.co/videos/preview/mixkit-software-developer-working-on-code-screen-41552-large.mp4" type="video/mp4" />
                            </video>
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent"></div>
                            
                            <!-- Video Overlay Badge -->
                            <div class="absolute top-4 left-4 backdrop-blur-xl bg-white/20 border border-white/30 text-white text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-2">
                                <i class="fas fa-mobile-alt text-xs text-blue-300"></i> Seamless Fluidity
                            </div>

                            <div class="absolute bottom-6 left-6 right-6 text-white">
                                <h3 class="text-xl font-semibold mb-1">Adaptive Cross-Platform Engine</h3>
                                <p class="text-xs text-slate-200/90 font-light">Flawless pixel-perfect layout responsiveness across desktop, tablet, and mobile displays.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Video Card 4 -->
                    <div class="group relative rounded-3xl overflow-hidden backdrop-blur-2xl bg-white/60 border border-white/80 shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-1">
                        <div class="aspect-video relative overflow-hidden bg-slate-100">
                            <video 
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                                autoplay loop muted playsinline poster="https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1200&q=80"
                            >
                                <source src="https://assets.mixkit.co/videos/preview/mixkit-cyber-security-system-animation-43407-large.mp4" type="video/mp4" />
                            </video>
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent"></div>
                            
                            <!-- Video Overlay Badge -->
                            <div class="absolute top-4 left-4 backdrop-blur-xl bg-white/20 border border-white/30 text-white text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-2">
                                <i class="fas fa-shield-alt text-xs text-emerald-300"></i> Fortified Security
                            </div>

                            <div class="absolute bottom-6 left-6 right-6 text-white">
                                <h3 class="text-xl font-semibold mb-1">Enterprise-Grade Security & Analytics</h3>
                                <p class="text-xs text-slate-200/90 font-light">Robust encrypted infrastructure built on modern web standards like Laravel & Node.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>


        <!-- PRICING SECTION (Apple Style Glass Comparison Matrix) -->
        <section class="py-24 relative" id="pricing">
            
            <div class="container mx-auto px-6">
                
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-slate-900 mb-4">
                        Packages and Prices
                    </h2>
                    <p class="text-lg text-slate-600 font-light">
                        Web Design & Development Package and Prices
                    </p>
                </div>

                <!-- Glass Container Frame -->
                <div class="backdrop-blur-2xl bg-white/80 border border-slate-200/80 rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.05)] overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[1000px] text-left border-collapse">
                            
                            <!-- Table Header -->
                            <thead>
                                <tr class="border-b border-slate-200/70 bg-slate-50/60 backdrop-blur-md">
                                    <th class="p-6 font-semibold text-slate-900 text-base w-1/6 align-bottom">
                                        Packages
                                    </th>
                                    
                                    <th class="p-6 text-center border-l border-slate-200/50 w-1/6">
                                        <div class="text-sm font-bold text-slate-900 mb-1">Starter Package Basic</div>
                                        <div class="text-xs text-slate-500 font-normal">Wordpress / CMS Web</div>
                                    </th>

                                    <th class="p-6 text-center border-l border-slate-200/50 w-1/6">
                                        <div class="text-sm font-bold text-slate-900 mb-1">Starter Package Business</div>
                                        <div class="text-xs text-slate-500 font-normal">Wordpress / CMS Web</div>
                                    </th>

                                    <th class="p-6 text-center border-l border-slate-200/50 w-1/6 bg-cyan-50/30">
                                        <div class="inline-block bg-cyan-500 text-white text-[10px] uppercase font-extrabold px-2 py-0.5 rounded-full mb-1 tracking-wider">Popular</div>
                                        <div class="text-sm font-bold text-slate-900 mb-1">Bronze Package Advance</div>
                                        <div class="text-xs text-slate-500 font-normal">Wordpress / Pro Web</div>
                                    </th>

                                    <th class="p-6 text-center border-l border-slate-200/50 w-1/6">
                                        <div class="text-sm font-bold text-slate-900 mb-1">Silver Package Advance</div>
                                        <div class="text-xs text-slate-500 font-normal">Laravel Web</div>
                                    </th>

                                    <th class="p-6 text-center border-l border-slate-200/50 w-1/6 bg-indigo-50/30">
                                        <div class="inline-block bg-slate-900 text-white text-[10px] uppercase font-extrabold px-2 py-0.5 rounded-full mb-1 tracking-wider">Enterprise</div>
                                        <div class="text-sm font-bold text-slate-900 mb-1">Gold Package Enterprise</div>
                                        <div class="text-xs text-slate-500 font-normal">Laravel Web</div>
                                    </th>
                                </tr>

                                <!-- Price Row -->
                                <tr class="border-b border-slate-200/70 bg-white/90">
                                    <th class="p-5 font-bold text-slate-900 text-lg">Price</th>
                                    
                                    <th class="p-5 text-center border-l border-slate-200/50">
                                        <span class="text-2xl font-bold text-slate-900">৳ 25,000</span>
                                    </th>

                                    <th class="p-5 text-center border-l border-slate-200/50">
                                        <span class="text-2xl font-bold text-slate-900">৳ 35,000</span>
                                    </th>

                                    <th class="p-5 text-center border-l border-slate-200/50 bg-cyan-50/30">
                                        <span class="text-2xl font-bold text-cyan-600">৳ 65,000</span>
                                    </th>

                                    <th class="p-5 text-center border-l border-slate-200/50">
                                        <span class="text-2xl font-bold text-slate-900">৳ 90,000</span>
                                    </th>

                                    <th class="p-5 text-center border-l border-slate-200/50 bg-indigo-50/30">
                                        <span class="text-2xl font-bold text-indigo-600">৳ 150,000</span>
                                    </th>
                                </tr>
                            </thead>

                            <!-- Table Body -->
                            <tbody class="text-sm text-slate-700 divide-y divide-slate-100">
                                
                                <!-- Disclaimer Banner -->
                                <tr class="bg-slate-50/40">
                                    <td colspan="6" class="p-3.5 text-center text-xs italic font-medium text-slate-500">
                                        "Get started easily - It is impossible to buy good things for a cheap price."
                                    </td>
                                </tr>

                                <!-- Dynamic Package Features Iteration -->
                                {
                                    webPackages.map((row, idx) => (
                                        <tr class={`transition-colors duration-150 ${idx % 2 === 0 ? "bg-white/80" : "bg-slate-50/30"} hover:bg-slate-100/50`}>
                                            <td class="p-4 font-medium text-slate-800">
                                                {row.name}
                                            </td>
                                            {row.vals.map((val, vIdx) => (
                                                <td class={`p-4 text-center border-l border-slate-200/40 text-slate-600 font-normal ${vIdx === 2 ? 'bg-cyan-50/10' : vIdx === 4 ? 'bg-indigo-50/10' : ''}`}>
                                                    {typeof val === "boolean" ? (
                                                        val ? (
                                                            <div class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100/80 text-emerald-600 text-xs">
                                                                <i class="fas fa-check" />
                                                            </div>
                                                        ) : (
                                                            <div class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-slate-100 text-slate-300 text-xs">
                                                                <i class="fas fa-minus" />
                                                            </div>
                                                        )
                                                    ) : (
                                                        <span class="font-medium text-slate-800">{val}</span>
                                                    )}
                                                </td>
                                            ))}
                                        </tr>
                                    ))
                                }

                                <!-- Table Footer CTA Buttons -->
                                <tr class="bg-slate-50/80 border-t border-slate-200/80">
                                    <td class="p-5 font-semibold text-slate-900">Get Started</td>
                                    {
                                        [0, 1, 2, 3, 4].map((idx) => (
                                            <td class={`p-5 text-center border-l border-slate-200/50 ${idx === 2 ? 'bg-cyan-50/20' : idx === 4 ? 'bg-indigo-50/20' : ''}`}>
                                                <a
                                                    href="#contact"
                                                    class={`inline-block px-5 py-2.5 rounded-full text-xs font-semibold tracking-wide transition-all duration-300 ${
                                                        idx === 2 
                                                            ? 'bg-cyan-600 hover:bg-cyan-700 text-white shadow-md shadow-cyan-600/20' 
                                                            : idx === 4
                                                            ? 'bg-slate-900 hover:bg-slate-800 text-white shadow-md shadow-slate-900/10'
                                                            : 'bg-white hover:bg-slate-100 border border-slate-300 text-slate-800'
                                                    }`}
                                                >
                                                    Get Quote
                                                </a>
                                            </td>
                                        ))
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Footnote -->
                <div class="text-right text-slate-500 text-xs mt-4 font-medium tracking-wide">
                    * All the prices mentioned above in BDT
                </div>

            </div>
        </section>


        <!-- BEYOND PREMIUM FINAL CTA -->
        <section class="py-24 relative overflow-hidden" id="contact">
            <div class="container mx-auto px-6 relative z-10">
                <div class="relative rounded-3xl overflow-hidden backdrop-blur-2xl bg-white/70 border border-slate-200/80 p-12 md:p-20 text-center shadow-[0_20px_70px_rgba(0,0,0,0.06)]">
                    
                    <!-- Ambient Inner Lighting -->
                    <div class="pointer-events-none absolute -top-20 -right-20 w-80 h-80 bg-cyan-200/50 rounded-full blur-3xl"></div>
                    <div class="pointer-events-none absolute -bottom-20 -left-20 w-80 h-80 bg-blue-200/50 rounded-full blur-3xl"></div>

                    <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-slate-900 mb-6 max-w-2xl mx-auto">
                        Ready to Build Your Web Application?
                    </h2>
                    <p class="text-lg md:text-xl text-slate-600 mb-10 max-w-xl mx-auto font-light leading-relaxed">
                        Contact us today to discuss your project requirements.
                    </p>
                    
                    <a
                        href="/#contact"
                        class="inline-flex items-center gap-3 bg-slate-900 hover:bg-slate-800 text-white px-10 py-4.5 rounded-full font-medium transition-all duration-300 shadow-xl shadow-slate-900/10 hover:shadow-2xl hover:-translate-y-0.5 text-base"
                    >
                        <span>Contact Us</span>
                        <i class="fas fa-arrow-right text-xs opacity-70"></i>
                    </a>
                </div>
            </div>
        </section>

    </main>

    <Footer />
</MainLayout>
